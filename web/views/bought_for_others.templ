package views

import (
	"fmt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
)

// The "Bought for" picker's values besides a person's id.
const (
	ForOthersMe      = "me"
	ForOthersSomeone = "someone"
)

// QuickPickForOthers is the "Bought for" quick pick's field.
const QuickPickForOthers = "for-others"

// TxForOthersEditable tells the details can change who the expense was
// bought for: it can be, and isn't bought by someone nor split.
func TxForOthersEditable(tx *models.Transaction) bool {
	return tx.CanBeForOthers() && len(tx.BoughtBy) == 0 && tx.SplitPeople == 0
}

func txForOthersURL(id string) string {
	return fmt.Sprintf("/transactions/%s/for-others", id)
}

// txDetailsForOthers is the details' "Bought for" row: you, or who it was
// bought for (out of every analysis), picked in place; "Ask back" schedules
// the income paying back what isn't yet.
templ txDetailsForOthers(tx *models.Transaction) {
	if editable := TxForOthersEditable(tx) || (tx.ForOthers && tx.CanBeForOthers()); editable || tx.ForOthers {
		@txDetailsRow("Bought for", icons.Users("15")) {
			@QuickPick(QuickPickProps{
				ID: QuickPickID("tx", tx.ID, QuickPickForOthers), Label: "who it was bought for",
				PickerURL: txForOthersURL(tx.ID), Display: forOthersDisplay(tx), Editable: editable,
			})
			if tx.ForOthers && editable && tx.ForOthersOwed() >= 0.01 {
				<button
					type="button"
					hx-put={ txForOthersURL(tx.ID) }
					hx-vals={ fmt.Sprintf(`{"for_person": %q, "payback": "1"}`, forOthersValue(tx)) }
					hx-target="#txd-panel"
					hx-swap="innerHTML"
					title="Schedule an income from them paying it back"
					class="txd-more"
				>
					@icons.Coins("14")
					Ask back
				</button>
			}
		}
	}
}

templ forOthersMeDisplay() {
	<span class="truncate text-zinc-400">Me</span>
}

templ forOthersSomeoneDisplay() {
	<span class="truncate">Someone</span>
	<span class="text-xs text-zinc-500">· not counted</span>
}

templ forOthersPersonDisplay(cp *models.Counterparty) {
	@counterpartyDisplay(cp)
	<span class="text-xs text-zinc-500">· not counted</span>
}

func forOthersDisplay(tx *models.Transaction) templ.Component {
	switch {
	case !tx.ForOthers:
		return forOthersMeDisplay()
	case tx.ForPerson != nil && tx.ForPerson.Name != "":
		return forOthersPersonDisplay(tx.ForPerson)
	default:
		return forOthersSomeoneDisplay()
	}
}

// forOthersValue is the picker's value for the expense.
func forOthersValue(tx *models.Transaction) string {
	switch {
	case !tx.ForOthers:
		return ForOthersMe
	case tx.ForPerson != nil:
		return tx.ForPerson.ID
	default:
		return ForOthersSomeone
	}
}

// TxForOthersPicker picks who the expense was bought for: you, someone
// unnamed or a person, the details answered into the drawer.
func TxForOthersPicker(tx *models.Transaction, cps []models.Counterparty) templ.Component {
	cur := forOthersValue(tx)
	var personID string
	if tx.ForPerson != nil {
		personID = tx.ForPerson.ID
	}
	opts := append([]form.ComboOption{
		{Value: ForOthersMe, Label: "Me", Leading: icons.User("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"})},
		{Value: ForOthersSomeone, Label: "Someone else", Leading: icons.Users("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"})},
	}, forOthersPeopleOptions(cps, personID)...)
	return QuickPicker(QuickPickerProps{
		ID: QuickPickID("tx", tx.ID, QuickPickForOthers),
		Combo: form.ComboboxProps{
			Name: "for_person", ID: "pick-for-" + tx.ID, Label: "Bought for", Placeholder: "Pick or type a name",
			Options: opts, Data: form.FDInput{Value: cur},
			CreateURL: "/counterparties/quick?person",
		},
		SaveURL: txForOthersURL(tx.ID),
		Target:  "#txd-panel", Swap: "innerHTML", Class: "txd-pick max-w-full",
	})
}
