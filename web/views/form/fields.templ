package form

import (
	"fmt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/icons"
	"slices"
	"strings"
)

// SegmentedRadio is a row of pills, one per option. The hx attrs go on the
// fieldset, so a change on any pill triggers them with the fieldset's id.
type RadioOption struct {
	Value string
	Label string
}

templ SegmentedRadio(label, name, id string, options []RadioOption, data FDInput, attrs templ.Attributes) {
	<fieldset
		id={ join(name, id) }
		if attrs != nil {
			{ attrs... }
		}
	>
		<legend class="sr-only">{ label }</legend>
		<div class="flex gap-1 p-1 rounded-2xl bg-zinc-800/60 border border-zinc-800">
			for _, o := range options {
				<label
					class="flex-1 min-w-0 cursor-pointer select-none rounded-xl px-2 py-2 text-center text-sm font-medium text-zinc-400 transition-colors hover:text-white has-checked:bg-(--accent) has-checked:text-zinc-950 has-checked:shadow has-focus-visible:ring-2 has-focus-visible:ring-(--accent)"
				>
					<input
						type="radio"
						name={ name }
						value={ o.Value }
						class="sr-only"
						if o.Value == data.Value {
							checked
						}
					/>
					<span class="block truncate">{ o.Label }</span>
				</label>
			}
		</div>
		@ErrorMessage(data.Error)
	</fieldset>
}

// Toggle is a checkbox drawn as a switch.
templ Toggle(label, name, id string, icon templ.Component, data FDInput, inputAttrs templ.Attributes) {
	<label for={ join(name, id) } class="flex items-center justify-between gap-4 cursor-pointer select-none">
		<span class="inline-flex items-center gap-2 text-zinc-300">
			if icon != nil {
				@icon
			}
			{ label }
		</span>
		<input
			id={ join(name, id) }
			type="checkbox"
			name={ name }
			class="peer sr-only"
			if data.Value != "" {
				checked
			}
			if inputAttrs != nil {
				{ inputAttrs... }
			}
		/>
		<span
			aria-hidden="true"
			class="relative shrink-0 w-11 h-6 rounded-full bg-zinc-700 transition-colors peer-checked:bg-(--accent) peer-focus-visible:ring-2 peer-focus-visible:ring-(--accent) peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-zinc-900 after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-5"
		></span>
	</label>
	@ErrorMessage(data.Error)
}

// HeroMoneyInput is a large, centered money input for a form's main amount.
templ HeroMoneyInput(label, name, currencySymbol, id string, data FDInput, inputAttrs templ.Attributes) {
	@HeroAmountInput(label, name, currencySymbol, 2, id, data, inputAttrs)
}

// HeroAmountInput is HeroMoneyInput keeping up to digits fraction digits.
templ HeroAmountInput(label, name, currencySymbol string, digits int, id string, data FDInput, inputAttrs templ.Attributes) {
	<div class="w-full">
		<label for={ join(name, id) } class="sr-only">{ label }</label>
		<input
			id={ join(name, id) }
			type="text"
			name={ name }
			value={ data.Value }
			placeholder={ fmt.Sprintf("%s 0.%s", currencySymbol, strings.Repeat("0", digits)) }
			autocomplete="off"
			inputmode="decimal"
			x-mask:dynamic={ MoneyMask(currencySymbol, digits) }
			class="amount-hero"
			if data.Error != "" {
				aria-invalid="true"
			}
			if inputAttrs != nil {
				{ inputAttrs... }
			}
		/>
		<div class="flex justify-center">
			@ErrorMessage(data.Error)
		</div>
	</div>
}

// MoneyMask is the x-mask of an amount prefixed with sym, keeping up to
// digits fraction digits.
func MoneyMask(sym string, digits int) string {
	return fmt.Sprintf("'%s ' + $money($input, '.', ',', %d)", sym, digits)
}

// MetalUnitToggle picks the unit (troy ounces or grams) a metal amount is
// typed in.
templ MetalUnitToggle(name, id string, selected models.MetalUnit, attrs templ.Attributes) {
	<fieldset
		id={ join(name, id) }
		class="inline-flex"
		if attrs != nil {
			{ attrs... }
		}
	>
		<legend class="sr-only">Unit</legend>
		<div class="flex gap-0.5 p-0.5 rounded-lg bg-zinc-800/60 border border-zinc-800 text-xs">
			for _, u := range models.MetalUnits {
				<label
					title={ metalUnitName(u) }
					class="cursor-pointer select-none rounded-md px-2.5 py-1 font-medium text-zinc-400 transition-colors hover:text-white has-checked:bg-(--accent) has-checked:text-zinc-950 has-focus-visible:ring-2 has-focus-visible:ring-(--accent)"
				>
					<input
						type="radio"
						name={ name }
						value={ string(u) }
						aria-label={ metalUnitName(u) }
						class="sr-only"
						if u == selected {
							checked
						}
					/>
					{ string(u) }
				</label>
			}
		</div>
	</fieldset>
}

func metalUnitName(u models.MetalUnit) string {
	if u == models.MetalUnitGram {
		return "Grams"
	}
	return "Troy ounces"
}

// SelectAccountChip is a pill combobox of accounts, searchable when there
// are many.
templ SelectAccountChip(label, name, id string, accs []models.Account, data FDInput, inputAttrs templ.Attributes) {
	@Combobox(ComboboxProps{
		Name:        name,
		ID:          id,
		Label:       label,
		Placeholder: "Select Account",
		Options:     AccountComboOptions(accs),
		Data:        data,
		Searchable:  len(accs) > 7,
		Chip:        true,
		InputAttrs:  inputAttrs,
	})
}

// SheetForm is a create form in a drawer kept in the page, shown by the
// Alpine openCreateForm in scope. The answer to it is the whole SheetForm
// again (fresh after creating), of which only the form is swapped in; a
// created one also closes the drawer (HX-Trigger drawer-saved).
templ SheetForm(title, postTo, submitStr, class string, attrs ...templ.Attributes) {
	{{ var a templ.Attributes }}
	if len(attrs) > 0 {
		{{ a = attrs[0] }}
	}
	@components.Drawer(components.DrawerProps{Label: title, Bind: "openCreateForm"}) {
		@DrawerForm(DrawerFormProps{
			Title: title, Method: "post", URL: postTo, Submit: submitStr,
			Select: true, Class: class, Attrs: a,
		}) {
			{ children... }
		}
	}
}

func AccountComboOptions(accs []models.Account) []ComboOption {
	opts := make([]ComboOption, len(accs))
	for i, a := range accs {
		opts[i] = ComboOption{
			Value:   a.ID,
			Label:   a.Name,
			Search:  a.Currency.String,
			Leading: icons.Card("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"}),
		}
	}
	return SortComboOptions(opts)
}

// SortComboOptions orders the options by label, case-insensitively.
func SortComboOptions(opts []ComboOption) []ComboOption {
	slices.SortStableFunc(opts, func(a, b ComboOption) int {
		return strings.Compare(strings.ToLower(a.Label), strings.ToLower(b.Label))
	})
	return opts
}

// Options maps structs by ID to their val field, for SelectControl.
func Options[T any](structs []T, val string) map[string]string {
	return idStructsToMap(structs, val)
}

// TagsInput edits a comma separated list as removable chips. Behavior lives
// in the "tagsInput" Alpine component (/js/tags-input.js).
templ TagsInput(name, placeholder, id string, data FDInput) {
	<div
		x-data="tagsInput"
		@click="$refs.draft.focus()"
		class="input-field tags-field flex! flex-wrap items-center gap-1.5 h-auto! min-h-11 py-1.5 cursor-text"
		if data.Error != "" {
			aria-invalid="true"
		}
	>
		<input type="hidden" x-ref="input" name={ name } value={ data.Value } :value="value"/>
		<template x-for="(tag, i) in tags" :key="tag">
			<span class="inline-flex items-center gap-1 h-7 pl-2.5 pr-1 rounded-lg bg-zinc-700/60 text-sm">
				<span x-text="tag"></span>
				<button
					type="button"
					@click.stop="remove(i)"
					:aria-label="'Remove ' + tag"
					class="grid place-items-center w-5 h-5 rounded text-zinc-400 cursor-pointer transition-colors hover:bg-zinc-600 hover:text-white"
				>
					@icons.X("12")
				</button>
			</span>
		</template>
		<input
			x-ref="draft"
			id={ join(name, id) }
			type="text"
			x-model="draft"
			@keydown.enter.prevent="add()"
			@keydown.comma.prevent="add()"
			@keydown.backspace="backspace()"
			@blur="add()"
			:placeholder={ fmt.Sprintf("tags.length ? '' : '%s'", placeholder) }
			autocomplete="off"
			class="flex-1 min-w-32 h-7 bg-transparent outline-none placeholder:text-zinc-500"
		/>
	</div>
}
