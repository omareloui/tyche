package form

templ SumbitButton(submitStr string) {
	<button
		type="submit"
		class="text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-lg w-full sm:w-auto px-5 py-2.5 text-center"
	>
		{ submitStr }
	</button>
}

templ EditFormButtons(entryGetUrl string) {
	<div class="flex gap-2 mt-2">
		<button
			type="submit"
			class="text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center grow"
		>
			Update
		</button>
		<button
			type="button"
			class="text-white bg-red-500 hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center w-1/6"
			hx-get={ string(templ.SafeURL(entryGetUrl)) }
			hx-trigger="click, keyup[key === 'Escape'] from:body"
		>Cancel</button>
	</div>
}

templ EditButton(getEditUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-get={ string(templ.SafeURL(getEditUrl)) }
		hx-swap="outerHTML"
	>Edit</button>
}

templ DeleteButton(deleteUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-red-500 hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-delete={ string(templ.SafeURL(deleteUrl)) }
		hx-swap="outerHTML"
		hx-confirm="Are you sure you want to delete this transaction?"
	>Delete</button>
}

templ SaveButton(text, putUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-green-500 hover:bg-green-600 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-put={ string(templ.SafeURL(putUrl)) }
		hx-swap="outerHTML"
	>{ text }</button>
}

templ PostButton(text, putUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-green-500 hover:bg-green-600 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-post={ string(templ.SafeURL(putUrl)) }
		hx-swap="outerHTML"
	>{ text }</button>
}
