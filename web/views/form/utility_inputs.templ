// SelectCategoryColor is a palette of color swatches. Picking one sets the
// Alpine `accent` of the enclosing scope, if any.
templ SelectCategoryColor(name, id string, data FDInput) {
	<fieldset>
		<legend class="input-label">Color</legend>
		<div class="flex flex-wrap gap-2.5">
			for _, c := range models.CategoryColors {
				{{ hex := models.CategoryColorToHex(c) }}
				<label
					title={ c }
					class="relative grid place-items-center size-8 rounded-full cursor-pointer transition-transform hover:scale-110 has-checked:ring-2 has-checked:ring-white/90 has-checked:ring-offset-2 has-checked:ring-offset-zinc-900 has-focus-visible:ring-2 has-focus-visible:ring-white/60 has-focus-visible:ring-offset-2 has-focus-visible:ring-offset-zinc-900"
					style={ "background-color: " + hex }
				>
					<input
						type="radio"
						name={ name }
						value={ c }
						aria-label={ c }
						class="peer sr-only"
						@change={ fmt.Sprintf("accent = '%s'", hex) }
						if c == data.Value {
							checked
						}
					/>
					@icons.Check("16", &templ.Attributes{"class": "invisible peer-checked:visible text-white drop-shadow"})
				</label>
			}
		</div>
		@ErrorMessage(data.Error)
	</fieldset>
}

func getId(id string) string {
	if id == "" {
		return "0"
	}
	return id
}

func GetCurOrDefault(curs []models.Currency, curID string, dflt *models.Currency) *models.Currency {
	cur := slicesutils.Find(curs, func(c models.Currency) bool {
		return c.ID == curID
	})
	if cur == nil && dflt != nil {
		return dflt
	}
	if cur == nil {
		cur = slicesutils.Find(curs, func(c models.Currency) bool { return c.IsDefault })
	}
	return cur
}

func GetCurOrDefaultIbanPrefix(curs []models.Currency, curID string, dflt *models.Currency) string {
	cur := GetCurOrDefault(curs, curID, dflt)
	if cur == nil {
		return ""
	}
	return cur.IbanPrefix
}

func GetCurOrDefaultSym(curs []models.Currency, curID string, dflt *models.Currency) string {
	cur := GetCurOrDefault(curs, curID, dflt)
	if cur == nil {
		return ""
	}
	return cur.Symbol
}

func GetAccoutSym(accs []models.Account, accId string, defaultCur *models.Currency) string {
	var symbol string
	acc := slicesutils.Find(accs, func(a models.Account) bool {
		return a.ID == accId
	})
	if acc != nil {
		symbol = acc.Currency.Symbol
	} else {
		symbol = defaultCur.Symbol
	}
	return symbol
}

func idStructsToMap[T any](structs []T, val string) map[string]string {
	return structutils.StructsToMap(structs, "ID", val)
}

// stringerOptions makes radio options valued and labeled by their String.
func stringerOptions[T fmt.Stringer](s []T) []RadioOption {
	opts := make([]RadioOption, len(s))
	for i, e := range s {
		opts[i] = RadioOption{Value: e.String(), Label: e.String()}
	}
	return opts
}

templ SelectRecurrentUnit(name, id string, data FDInput) {
	<div>
		<span aria-hidden="true" class="input-label">Unit</span>
		@SegmentedRadio("Unit", name, id, recurrentUnitOptions(), data, nil)
	</div>
}

func recurrentUnitOptions() []RadioOption {
	units := models.RecurrentUnits()
	opts := make([]RadioOption, len(units))
	for i, u := range units {
		opts[i] = RadioOption{Value: fmt.Sprintf("%d", u), Label: u.String()}
	}
	return opts
}
