templ SelectTxKind(name, id string, knds []models.TxKind, data FDInput, inputAttrs templ.Attributes) {
	@SegmentedRadio("Transaction Kind", name, id, stringerOptions(knds), data, inputAttrs)
}

// SelectTxKinds is a row of checkbox pills, one per kind.
templ SelectTxKinds(label string, knds []models.TxKind, data TxKindFDInputs) {
	{{ var err string }}
	<fieldset>
		<legend class="input-label">{ label }</legend>
		<div class="flex flex-wrap gap-2">
			for _, kind := range knds {
				{{ d := data[kind] }}
				if d.Error != "" {
					{{ err = d.Error }}
				}
				<label
					class="inline-flex items-center gap-1.5 h-10 px-4 rounded-full border border-zinc-700 bg-zinc-800/60 text-sm text-zinc-300 cursor-pointer select-none transition-colors hover:border-zinc-500 has-checked:border-(--accent) has-checked:bg-(--accent)/15 has-checked:text-white has-focus-visible:ring-2 has-focus-visible:ring-(--accent)"
				>
					<input
						type="checkbox"
						name="kind"
						value={ kind.String() }
						class="peer sr-only"
						if d.Value != "" {
							checked
						}
					/>
					@icons.Check("15", &templ.Attributes{"class": "hidden peer-checked:block text-(--accent)"})
					{ kind.String() }
				</label>
			}
		</div>
		@ErrorMessage(err)
	</fieldset>
}

templ SelectCounterparty(name, id string, cps []models.Counterparty, data FDInput, nullable bool, inputAttrs templ.Attributes) {
	@SelectInput("Counterparty", name, "Select Counterparty", id, idStructsToMap(cps, "Name"), data, nullable, inputAttrs, nil)
