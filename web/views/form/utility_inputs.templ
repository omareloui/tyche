package form

import (
	"fmt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/slicesutils"
	"github.com/omareloui/tyche/internal/structutils"
	"github.com/omareloui/tyche/web/views/icons"
)

templ AmountInputsWithCurrency(fd *AmountFD, id string, curs []models.Currency, defaultCur *models.Currency) {
	{{ sym := GetCurOrDefaultSym(curs, fd.CurrencyID.Value, defaultCur) }}
	{{ cur := fd.CurrencyID }}
	if cur.Value == "" && defaultCur != nil {
		{{ cur.Value = defaultCur.ID }}
	}
	<div hx-target="this" class="grid grid-cols-[1fr_9rem] gap-3">
		@Field("Amount", "amount", id, nil, fd.Amount.Error) {
			@Control("text", "amount", fmt.Sprintf("%s 1,000.00", sym), id, fd.Amount, templ.Attributes{
				"autocomplete":   "off",
				"inputmode":      "decimal",
				"x-mask:dynamic": fmt.Sprintf("'%s ' + $money($input, '.', ',')", sym),
			})
		}
		@Field("Currency", "currency_id", id, nil, fd.CurrencyID.Error) {
			@Combobox(ComboboxProps{
				Name: "currency_id", ID: id, Label: "Currency", Placeholder: "Currency",
				Options: CurrencyComboOptions(curs), Data: cur, Searchable: true,
				InputAttrs: templ.Attributes{
					"hx-post":    fmt.Sprintf("/amount-inputs-with-currency/%s", getId(id)),
					"hx-trigger": "change",
					"hx-swap":    "outerHTML",
					"hx-sync":    "closest form:abort",
				},
			})
		}
	</div>
}

func CurrencyComboOptions(curs []models.Currency) []ComboOption {
	opts := make([]ComboOption, len(curs))
	for i, c := range curs {
		opts[i] = ComboOption{
			Value:   c.ID,
			Label:   c.String,
			Search:  c.Symbol,
			Leading: currencySymbol(c.Symbol),
		}
	}
	return SortComboOptions(opts)
}

templ currencySymbol(sym string) {
	<span class="shrink-0 w-7 text-center text-xs text-zinc-400">{ sym }</span>
}

templ AmountInputsWithAccount(fd *AccountIFD, id string, accs []models.Account, defaultCur *models.Currency) {
	<div hx-target="this" class="grid grid-cols-3 gap-4">
		@MoneyInput("Amount", "amount", GetAccoutSym(accs, fd.AccountID.Value, defaultCur), id,
			fd.Amount, nil, templ.Attributes{"class": "col-span-2"})
		@SelectAccount("account_id", id, accs, fd.AccountID,
			templ.Attributes{
				"hx-post":    fmt.Sprintf("/amount-inputs-with-amounts/%s", getId(id)),
				"hx-trigger": "change",
				"hx-swap":    "outerHTML",
				"hx-sync":    "closest form:abort",
			})
	</div>
}

templ SelectAccKind(name, id string, aknds []models.AccountKind, data FDInput, inputAttrs templ.Attributes) {
	@SelectInput("Account Kind", name, "Select Account Kind", id, idStructsToMap(aknds, "Enum"), data, false, inputAttrs, nil)
}

templ SelectAccount(name, id string, accs []models.Account, data FDInput, inputAttrs templ.Attributes) {
	@SelectInput("Account", name, "Select Account", id, idStructsToMap(accs, "Name"), data, false, inputAttrs, nil)
}

templ SelectToAccount(name, id string, accs []models.Account, data FDInput, inputAttrs templ.Attributes) {
	@SelectInput("To Account", name, "Select Account", id, idStructsToMap(accs, "Name"), data, false, inputAttrs, nil)
