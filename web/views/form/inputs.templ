package form

import (
	"fmt"
	"github.com/omareloui/tyche/web/views/icons"
	"maps"
	"slices"
	"strings"
)

templ TextInput(label, name, placeholder, id string, data FDInput, inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	@Input(label, "text", name, placeholder, id, data, inputAttrs, wrapperAttrs)
}

templ NumberInput(label, name, placeholder, id string, data FDInput, inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	@Input(label, "number", name, placeholder, id, data, joinAttrs(templ.Attributes{
		"typemodel":    "decimal",
		"autocomplete": "off",
	}, inputAttrs), wrapperAttrs)
}

templ MoneyInput(label, name, currencySymbol, id string, data FDInput, inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	@TextInput(label, name, fmt.Sprintf("%s 1,000.00", currencySymbol), id, data, joinAttrs(templ.Attributes{
		"autocomplete":   "off",
		"x-mask:dynamic": fmt.Sprintf("'%s ' + $money($input, '.', ',')", currencySymbol),
	}, inputAttrs), wrapperAttrs)
}

templ CreditCardInput(label, name, id string, data FDInput, inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	@TextInput(label, name, "0000 0000 0000 0000", id, data, joinAttrs(templ.Attributes{
		"autocomplete":   "off",
		"x-mask:dynamic": "$input.startsWith('34') || $input.startsWith('37') ? '9999 999999 99999' : '9999 9999 9999 9999'",
	}, inputAttrs), wrapperAttrs)
}

templ IBANInput(label, name, id string, ibanPrefix string, data FDInput, inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	@TextInput(label, name, fmt.Sprintf("%s00 0000 0000 0000 0000 0000 0000 0", ibanPrefix), id, data, joinAttrs(templ.Attributes{
		"autocomplete": "off",
		"x-mask":       fmt.Sprintf("%s99 9999 9999 9999 9999 9999 9999 9", ibanPrefix),
	}, inputAttrs), wrapperAttrs)
}

templ DateInput(label, name, id string, data FDInput, inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	@TextInput(label, name, "yyyy-mm-dd", id, data, joinAttrs(templ.Attributes{
		"autocomplete":    "off",
		"x-mask":          "9999-99-99",
		"data-datepicker": true,
	}, inputAttrs), wrapperAttrs)
}

templ SelectInput(label, name, placeholder, id string,
	options map[string]string, data FDInput, nullable bool,
	inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	<div
		if wrapperAttrs != nil {
			{ wrapperAttrs... }
		}
	>
		@inputLabel(name, id, label)
		@SelectControl(name, placeholder, id, options, data, nullable, "input-field", inputAttrs)
		@ErrorMessage(data.Error)
	</div>
}

// SelectControl is a bare select with a chevron, styled by class
// (e.g. "input-field").
templ SelectControl(name, placeholder, id string,
	options map[string]string, data FDInput, nullable bool,
	class string, inputAttrs templ.Attributes) {
	<div class="relative min-w-0">
		<select
			id={ join(name, id) }
			name={ name }
			class={ class }
			if data.Error != "" {
				aria-invalid="true"
			}
			if inputAttrs != nil {
				{ inputAttrs... }
			}
		>
			<option
				value=""
				disabled
				if nullable {
					hidden
				}
				if !nullable || data.Value != "" {
					selected
				}
			>{ placeholder }</option>
			if nullable {
				<option value="" selected>None</option>
			}
			for _, k := range sortedOptionKeys(options) {
				<option
					value={ k }
					if k == data.Value {
						selected
					}
				>{ options[k] }</option>
			}
		</select>
		@icons.ChevronDown("18", &templ.Attributes{"class": "pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400"})
	</div>
}

// sortedOptionKeys orders the options by label, case-insensitively.
func sortedOptionKeys(options map[string]string) []string {
	return slices.SortedFunc(maps.Keys(options), func(a, b string) int {
		if c := strings.Compare(strings.ToLower(options[a]), strings.ToLower(options[b])); c != 0 {
			return c
		}
		return strings.Compare(a, b)
	})
}

templ Checkbox(label, name, id string, data FDInput, inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	<div
		if wrapperAttrs != nil {
			{ wrapperAttrs... }
		}
	>
		<input
			id={ join(name, id) }
			type="checkbox"
			name={ name }
			class="mr-2"
			if data.Value != "" {
				checked
			}
			if inputAttrs != nil {
				{ inputAttrs... }
			}
		/>
		<label for={ join(name, id) } class="cursor-pointer">{ label }</label>
		@ErrorMessage(data.Error)
	</div>
}

templ inputLabel(name, id, label string) {
	<label for={ join(name, id) } class="input-label">{ label }</label>
}

// Field labels a control with an optional leading icon and shows its error.
templ Field(label, name, id string, icon templ.Component, err string) {
	<div class="min-w-0">
		<label for={ join(name, id) } class="input-label">
			if icon != nil {
				@icon
			}
			{ label }
		</label>
		{ children... }
		@ErrorMessage(err)
	</div>
}

templ input(name, id, kind string, attrs templ.Attributes, data FDInput) {
	<input
		if attrs != nil {
			{ attrs... }
		}
		id={ join(name, id) }
		type={ kind }
		name={ name }
		value={ data.Value }
		class="input-field"
		if data.Error != "" {
			aria-invalid="true"
		}
	/>
}

// Control is a bare input, to put in a Field.
templ Control(kind, name, placeholder, id string, data FDInput, attrs templ.Attributes) {
	@input(name, id, kind, joinAttrs(attrs, templ.Attributes{"placeholder": placeholder}), data)
}

// Textarea is a bare multi-line input (e.g. a note), to put in a Field.
templ Textarea(name, placeholder, id string, data FDInput, attrs templ.Attributes) {
	<textarea
		if attrs != nil {
			{ attrs... }
		}
		id={ join(name, id) }
		name={ name }
		rows="2"
		dir="auto"
		placeholder={ placeholder }
		class="input-field h-auto! min-h-11 py-2.5"
		if data.Error != "" {
			aria-invalid="true"
		}
	>{ data.Value }</textarea>
}

templ Input(label, kind, name, placeholder, id string, data FDInput, inputAttrs templ.Attributes, wrapperAttrs templ.Attributes) {
	<div
		if wrapperAttrs != nil {
			{ wrapperAttrs... }
		}
	>
		@inputLabel(name, id, label)
		@input(name, id, kind, joinAttrs(inputAttrs, templ.Attributes{"placeholder": placeholder}), data)
		@ErrorMessage(data.Error)
	</div>
}

templ ErrorMessage(message string) {
	if message != "" {
		<div class="form-error-message">
			@icons.Error("18px")
			<span>{ message }</span>
		</div>
	}
}

// ClearableDate is an optional date Control (for a Field) with a button
// emptying it, shown while it has a value: the picker alone can't unset one.
templ ClearableDate(name, placeholder, id string, data FDInput) {
	<div class="relative" x-data={ fmt.Sprintf("{ set: %t }", data.Value != "") }>
		@Control("text", name, placeholder, id, data, templ.Attributes{
			"autocomplete":           "off",
			"x-mask":                 "9999-99-99",
			"data-datepicker":        true,
			"data-datepicker-change": true,
			"class":                  "input-field pr-10",
			"x-ref":                  "date",
			"@input":                 "set = $el.value !== ''",
			"@change":                "set = $el.value !== ''",
		})
		<button
			type="button"
			x-show="set"
			x-cloak
			@click="$refs.date.value = ''; set = false; $refs.date.dispatchEvent(new Event('change', { bubbles: true }))"
			aria-label="Clear the date"
			title="Clear"
			class="absolute inset-y-0 right-0 grid place-items-center w-10 rounded-r-xl text-zinc-500 cursor-pointer transition-colors hover:text-zinc-200"
		>
			@icons.X("16")
		</button>
	</div>
}
