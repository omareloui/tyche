package views

import (
	"strings"
	"fmt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/slicesutils"
)

type FDInput struct {
	Value string `json:"value"`
	Error string `json:"error"`
}

type AmountFD struct {
	Amount     FDInput
	CurrencyID FDInput
}

templ form(action, path string, attrs ...templ.Attributes) {
	<form
		{ templ.Attributes{fmt.Sprintf("hx-%s", action): string(templ.SafeURL(path))}... }
		if attrs != nil {
			{ attrs[0]... }
		}
		class="grid gap-2 entry-container"
		hx-swap="outerHTML"
	>
		{ children... }
	</form>
}

templ creationForm(title, postTo, submitStr string, close ...bool) {
	<div
		x-data={ fmt.Sprintf("{open: %v, toggle() {this.open = !this.open}}", close == nil || !close[0]) }
		class="px-6 py-3 mb-6 bg-gray-100 rounded-lg"
		hx-target="this"
	>
		<div
			class="flex flex-column justify-between items-center"
			@click="toggle"
		>
			<h2 class="text-xl font-bold">{ title }</h2>
			<button
				x-show="!open"
				class="form-visibility-button bg-gray-300"
				aria-label="expand form"
				type="button"
			>
				@downIcon("20px")
			</button>
			<button
				x-show="open"
				class="form-visibility-button bg-red-500 text-white"
				aria-label="collapse form"
				type="button"
			>
				@closeIcon("15px")
			</button>
		</div>
		@form("post", postTo, templ.Attributes{
			"x-show":                    "open",
			"x-collapse.duration.300ms": true,
			"class":                     "grid gap-2 entry-container mt-2",
		}) {
			{ children... }
			<button
				type="submit"
				class="text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-lg w-full sm:w-auto px-5 py-2.5 text-center"
			>
				{ submitStr }
			</button>
		}
	</div>
}

templ AmountInputsWithCurrency(fd *AmountFD, id string, curs []models.Currency) {
	<div hx-target="this" class="grid grid-cols-3 gap-4">
		@moneyInput("Amount", "amount", getCurSymbolByCurrency(curs, fd.CurrencyID.Value), id,
			fd.Amount, "col-span-2")
		@selectInput("Currency", "currency_id", "Select a Currency", id, currenciesToMap(curs), fd.CurrencyID,
			false, templ.Attributes{
				"hx-post":    fmt.Sprintf("/amount-inputs-with-currency/%s", id),
				"hx-trigger": "change",
				"hx-swap":    "outerHTML",
				"hx-sync":    "closest form:abort",
			})
	</div>
}

templ AmountInputsWithAccount(fd *AccountIFD, id string, accs []models.Account) {
	<div hx-target="this" class="grid grid-cols-3 gap-4">
		@moneyInput("Amount", "amount", getCurSymbolByAccount(accs, fd.AccountID.Value), id,
			fd.Amount, "col-span-2")
		@selectAccount("account_id", id, accs, fd.AccountID,
			templ.Attributes{
				"hx-post":    fmt.Sprintf("/amount-inputs-with-amounts/%s", id),
				"hx-trigger": "change",
				"hx-swap":    "outerHTML",
				"hx-sync":    "closest form:abort",
			})
	</div>
}

templ input(label, kind, name, placeholder, id string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, " ") }>
		<label class="input-label" for={ join(name, id) }>{ label }</label>
		<input
			id={ join(name, id) }
			type={ kind }
			name={ name }
			placeholder={ placeholder }
			class="input-field"
			value={ data.Value }
		/>
		@errorMessage(data.Error)
	</div>
}

templ numberInput(label, name, placeholder, id string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, " ") }>
		<label class="input-label" for={ join(name, id) }>{ label }</label>
		<input
			id={ join(name, id) }
			type="number"
			typemode="decimal"
			name={ name }
			placeholder={ placeholder }
			class="input-field"
			value={ data.Value }
			autocomplete="off"
		/>
		@errorMessage(data.Error)
	</div>
}

templ moneyInput(label, name, currencySymbol, id string, data FDInput, class string, attrs ...templ.Attributes) {
	<div class={ class }>
		<label class="input-label" for={ join(name, id) }>{ label }</label>
		<input
			id={ join(name, id) }
			name={ name }
			class="input-field"
			value={ data.Value }
			placeholder={ fmt.Sprintf("%s 1,000.00", currencySymbol) }
			inputmode="decimal"
			x-mask:dynamic={ fmt.Sprintf("'%s ' + $money($input, '.', ',')", currencySymbol) }
			autocomplete="off"
			if attrs != nil {
				{ attrs[0]... }
			}
		/>
		@errorMessage(data.Error)
	</div>
}

templ creditCardInput(label, name, id string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, " ") }>
		<label class="input-label" for={ join(name, id) }>{ label }</label>
		<input
			id={ join(name, id) }
			name={ name }
			class="input-field"
			value={ data.Value }
			placeholder="0000 0000 0000 0000"
			x-mask:dynamic="$input.startsWith('34') || $input.startsWith('37')
        ? '9999 999999 99999' : '9999 9999 9999 9999'"
		/>
		@errorMessage(data.Error)
	</div>
}

templ ibanInput(label, name, id string, ibanPrefix string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, " ") }>
		<label class="input-label" for={ join(name, id) }>{ label }</label>
		<input
			id={ join(name, id) }
			name={ name }
			class="input-field"
			value={ data.Value }
			placeholder={ fmt.Sprintf("%s00 0000 0000 0000 0000 0000 0000 0", ibanPrefix) }
			x-mask={ fmt.Sprintf("%s99 9999 9999 9999 9999 9999 9999 9", ibanPrefix) }
		/>
		@errorMessage(data.Error)
	</div>
}

templ dateInput(label, name, id string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, "") }>
		<label class="input-label" for={ join(name, id) }>{ label }</label>
		<input
			data-datepicker
			id={ join(name, id) }
			class="input-field"
			x-mask="9999-99-99"
			placeholder="yyyy-mm-dd"
			name={ name }
			value={ data.Value }
			autocomplete="off"
		/>
		@errorMessage(data.Error)
	</div>
}

templ selectInput(label, name, placeholder, id string,
	options map[string]string, data FDInput, nullable bool,
	inputAttrs ...templ.Attributes) {
	<div>
		<label for={ join(name, id) } class="input-label">{ label }</label>
		<select
			id={ join(name, id) }
			name={ name }
			class="input-field"
			if inputAttrs != nil {
				{ inputAttrs[0]... }
			}
		>
			<option
				value=""
				disabled
				if !nullable || data.Value != "" {
					selected
				}
			>{ placeholder }</option>
			if nullable {
				<option value="" selected>&lt;nil&gt;</option>
			}
			for k, v := range options {
				<option
					value={ k }
					if k == data.Value {
						selected
					}
				>{ v }</option>
			}
		</select>
		@errorMessage(data.Error)
	</div>
}

templ selectAccKind(name, id string, aknds []models.AccountKind, data FDInput, inputAttrs ...templ.Attributes) {
	@selectInput("Account Kind", name, "Select Account Kind", id, accKindsToMap(aknds), data, false, inputAttrs...)
}

templ selectAccount(name, id string, accs []models.Account, data FDInput, inputAttrs ...templ.Attributes) {
	@selectInput("Account", name, "Select Account", id, accountsToMap(accs), data, false, inputAttrs...)
}

templ selectToAccount(name, id string, accs []models.Account, data FDInput, inputAttrs ...templ.Attributes) {
	@selectInput("To Account", name, "Select Account", id, accountsToMap(accs), data, false, inputAttrs...)
}

templ selectCurrency(name, id string, curs []models.Currency, data FDInput, inputAttrs ...templ.Attributes) {
	@selectInput("Currency", name, "Select Currency", id, currenciesToMap(curs), data, false, inputAttrs...)
}

templ selectTxKind(name, id string, knds []models.TransactionKind, data FDInput, inputAttrs ...templ.Attributes) {
	@selectInput("Transaction Kind", name, "Select Kind", id, txKindsToMap(knds), data, false, inputAttrs...)
}

templ selectCounterparty(name, id string, cps []models.Counterparty, data FDInput, nullable bool, inputAttrs ...templ.Attributes) {
	@selectInput("Counterparty", name, "Select Counterparty", id, counterpartiesToMap(cps), data, nullable, inputAttrs...)
}

templ selectTxCat(name, id string, cats []models.Category, data FDInput, inputAttrs ...templ.Attributes) {
	@selectInput("Category", name, "Select Category", id, catsToMap(cats), data, true, inputAttrs...)
}

templ checkbox(label, name, id string, data FDInput, attrs ...templ.Attributes) {
	<div>
		<input
			id={ join(name, id) }
			type="checkbox"
			name={ name }
			if attrs != nil {
				{ attrs[0]... }
			}
			if  data.Value != "" {
				checked
			}
		/>
		<label for={ join(name, id) } class="cursor-pointer">{ label }</label>
	</div>
}

templ sumbitButton(submitStr string) {
	<button
		type="submit"
		class="text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-lg w-full sm:w-auto px-5 py-2.5 text-center"
	>
		{ submitStr }
	</button>
}

templ editFormButtons(entryGetUrl string) {
	<div class="flex gap-2 mt-2">
		<button
			type="submit"
			class="text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center grow"
		>
			Update
		</button>
		<button
			type="button"
			class="text-white bg-red-500 hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center w-1/6"
			hx-get={ string(templ.SafeURL(entryGetUrl)) }
			hx-trigger="click, keyup[key === 'Escape'] from:body"
		>Cancel</button>
	</div>
}

templ editButton(getEditUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-get={ string(templ.SafeURL(getEditUrl)) }
		hx-swap="outerHTML"
	>Edit</button>
}

templ deleteButton(deleteUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-red-500 hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-delete={ string(templ.SafeURL(deleteUrl)) }
		hx-swap="outerHTML"
		hx-confirm="Are you sure you want to delete this transaction?"
	>Delete</button>
}

templ saveButton(text, putUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-green-500 hover:bg-green-600 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-put={ string(templ.SafeURL(putUrl)) }
		hx-swap="outerHTML"
	>{ text }</button>
}

templ postButton(text, putUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-green-500 hover:bg-green-600 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-post={ string(templ.SafeURL(putUrl)) }
		hx-swap="outerHTML"
	>{ text }</button>
}

templ errorMessage(message string) {
	if message != "" {
		<div class="form-error-message">
			@errIcon("18px")
			<span>{ message }</span>
		</div>
	}
}

func join(prefix, suffix string, del ...string) string {
	_del := "-"
	if len(del) > 0 {
		_del = del[0]
	}
	if suffix == "" {
		return prefix
	}
	return strings.Join([]string{prefix, suffix}, _del)
}

func currenciesToMap(curs []models.Currency) map[string]string {
	m := make(map[string]string, len(curs))
	for _, c := range curs {
		m[c.ID] = c.Enum.String()
	}
	return m
}

func accountsToMap(accs []models.Account) map[string]string {
	m := make(map[string]string, len(accs))
	for _, a := range accs {
		m[a.ID] = a.Name
	}
	return m
}

func accKindsToMap(accs []models.AccountKind) map[string]string {
	m := make(map[string]string, len(accs))
	for _, a := range accs {
		m[a.ID] = a.Enum.String()
	}
	return m
}

func txKindsToMap(kinds []models.TransactionKind) map[string]string {
	m := make(map[string]string, len(kinds))
	for _, k := range kinds {
		m[k.ID] = k.Enum.String()
	}
	return m
}

func counterpartiesToMap(cps []models.Counterparty) map[string]string {
	m := make(map[string]string, len(cps))
	for _, cp := range cps {
		m[cp.ID] = cp.Name
	}
	return m
}

func catsToMap(cats []models.Category) map[string]string {
	m := make(map[string]string, len(cats))
	for _, c := range cats {
		m[c.ID] = c.Name
	}
	return m
}

func getCurSymbolByAccount(accs []models.Account, accId string) string {
	acc := slicesutils.Find(accs, func(a models.Account) bool {
		return a.ID == accId
	})
	if acc == nil {
		return models.DfltCurrency.Symbol()
	}
	return acc.Currency.Enum.Symbol()
}

func getCurSymbolByCurrency(curs []models.Currency, curId string) string {
	cur := slicesutils.Find(curs, func(c models.Currency) bool {
		return c.ID == curId
	})
	if cur == nil {
		return models.DfltCurrency.Symbol()
	}
	return cur.Enum.Symbol()
}

func getCurIbanPrefixByCurrency(curs []models.Currency, curId string) string {
	cur := slicesutils.Find(curs, func(c models.Currency) bool {
		return c.ID == curId
	})
	if cur == nil {
		return models.DfltCurrency.IbanPrefix()
	}
	return cur.Enum.IbanPrefix()
}
