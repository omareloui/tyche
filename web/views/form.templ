package views

import (
	"strings"
	"fmt"
)

type FDInput struct {
	Value string `json:"value"`
	Error string `json:"error"`
}

templ form(action, path string, attrs ...templ.Attributes) {
	<form
		{ templ.Attributes{fmt.Sprintf("hx-%s", action): string(templ.SafeURL(path))}... }
		if attrs != nil {
			{ attrs[0]... }
		}
		class="grid gap-2 entry-container"
		hx-swap="outerHTML"
	>
		{ children... }
	</form>
}

templ creationForm(title, postTo, submitStr string, close ...bool) {
	<div
		x-data={ fmt.Sprintf("{open: %v, toggle() {this.open = !this.open}}", close == nil || !close[0]) }
		class="px-6 py-3 mb-6 bg-gray-100 rounded-lg"
		hx-target="this"
	>
		<div
			class="flex flex-column justify-between items-center"
			@click="toggle"
		>
			<h2 class="text-xl font-bold">{ title }</h2>
			<button
				x-show="!open"
				class="form-visibility-button bg-gray-300"
				aria-label="expand form"
				type="button"
			>
				@downIcon("20px")
			</button>
			<button
				x-show="open"
				class="form-visibility-button bg-red-500 text-white"
				aria-label="collapse form"
				type="button"
			>
				@closeIcon("15px")
			</button>
		</div>
		@form("post", postTo, templ.Attributes{
			"x-show":                    "open",
			"x-collapse.duration.300ms": true,
			"class":                     "grid gap-2 entry-container mt-2",
		}) {
			{ children... }
			<button
				type="submit"
				class="text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-lg w-full sm:w-auto px-5 py-2.5 text-center"
			>
				{ submitStr }
			</button>
		}
	</div>
}

templ AmountInputs(fd *AmountFD, currencies map[string]string, currencySymbol string) {
	<div data-amount class="grid grid-cols-3 gap-4">
		@moneyInput("Amount", "amount", currencySymbol, "", fd.Amount, "col-span-2")
		@selectInput("Currency", "currency_id", "Select a Currency", "", currencies, fd.CurrencyID,
			templ.Attributes{
				"hx-post":    "/amount-inputs",
				"hx-trigger": "change",
				"hx-target":  "closest [data-amount]",
				"hx-swap":    "outerHTML",
				"hx-sync":    "closest form:abort",
			})
	</div>
}

templ input(label, kind, name, placeholder, idSuffix string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, " ") }>
		<label class="input-label" for={ join(name, idSuffix) }>{ label }</label>
		<input
			id={ join(name, idSuffix) }
			type={ kind }
			name={ name }
			placeholder={ placeholder }
			class="input-field"
			value={ data.Value }
		/>
		@errorMessage(data.Error)
	</div>
}

templ numberInput(label, name, placeholder, idSuffix string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, " ") }>
		<label class="input-label" for={ join(name, idSuffix) }>{ label }</label>
		<input
			id={ join(name, idSuffix) }
			type="number"
			typemode="decimal"
			name={ name }
			placeholder={ placeholder }
			class="input-field"
			value={ data.Value }
		/>
		@errorMessage(data.Error)
	</div>
}

templ moneyInput(label, name, currencySymbol, idSuffix string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, " ") }>
		<label class="input-label" for={ join(name, idSuffix) }>{ label }</label>
		<input
			id={ join(name, idSuffix) }
			name={ name }
			class="input-field"
			value={ data.Value }
			placeholder={ fmt.Sprintf("%s 1,000.00", currencySymbol) }
			x-mask:dynamic={ fmt.Sprintf("'%s ' + $money($input, '.', ',')", currencySymbol) }
		/>
		@errorMessage(data.Error)
	</div>
}

templ dateInput(label, name, idSuffix string, data FDInput, classes ...string) {
	<div class={ strings.Join(classes, "") }>
		<label class="input-label" for={ join(name, idSuffix) }>{ label }</label>
		<input
			data-datepicker
			id={ join(name, idSuffix) }
			class="input-field"
			x-mask="9999-99-99"
			placeholder="yyyy-mm-dd"
			name={ name }
			value={ data.Value }
			autocomplete="off"
		/>
		@errorMessage(data.Error)
	</div>
}

templ selectInput(label, name, placeholder, idSuffix string, options map[string]string, data FDInput, inputAttrs ...templ.Attributes) {
	<div>
		<label for={ join(name, idSuffix) } class="input-label">{ label }</label>
		<select
			id={ join(name, idSuffix) }
			name={ name }
			class="input-field"
			if inputAttrs != nil {
				{ inputAttrs[0]... }
			}
		>
			<option value="" disabled selected>{ placeholder }</option>
			for k, v := range options {
				if k == data.Value {
					<option value={ k } selected>{ v }</option>
				} else {
					<option value={ k }>{ v }</option>
				}
			}
		</select>
		@errorMessage(data.Error)
	</div>
}

templ checkbox(label, name, idSuffix string, data FDInput, attrs ...templ.Attributes) {
	<div>
		<input
			id={ join(name, idSuffix) }
			type="checkbox"
			name={ name }
			if attrs != nil {
				{ attrs[0]... }
			}
			if  data.Value != "" {
				checked
			}
		/>
		<label for={ join(name, idSuffix) } class="cursor-pointer">{ label }</label>
	</div>
}

templ sumbitButton(submitStr string) {
	<button
		type="submit"
		class="text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-lg w-full sm:w-auto px-5 py-2.5 text-center"
	>
		{ submitStr }
	</button>
}

templ editFormButtons(entryGetUrl string) {
	<div class="flex gap-2 mt-2">
		<button
			type="submit"
			class="text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center grow"
		>
			Update
		</button>
		<button
			type="button"
			class="text-white bg-red-500 hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center w-1/6"
			hx-get={ string(templ.SafeURL(entryGetUrl)) }
			hx-trigger="click, keyup[key === 'Escape'] from:body"
		>Cancel</button>
	</div>
}

templ editButton(getEditUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-blue-700 hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-get={ string(templ.SafeURL(getEditUrl)) }
		hx-swap="outerHTML"
	>Edit</button>
}

templ deleteButton(deleteUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-red-500 hover:bg-red-600 focus:outline-none focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-delete={ string(templ.SafeURL(deleteUrl)) }
		hx-swap="outerHTML"
		hx-confirm="Are you sure you want to delete this transaction?"
	>Delete</button>
}

templ saveButton(text, putUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-green-500 hover:bg-green-600 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-put={ string(templ.SafeURL(putUrl)) }
		hx-swap="outerHTML"
	>{ text }</button>
}

templ postButton(text, putUrl string) {
	<button
		class="px-5 py-2.5 my-2 text-white bg-green-500 hover:bg-green-600 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm sm:w-auto text-center"
		hx-post={ string(templ.SafeURL(putUrl)) }
		hx-swap="outerHTML"
	>{ text }</button>
}


templ errorMessage(message string) {
	if message != "" {
		<div class="form-error-message">
			@errIcon("18px")
			<span>{ message }</span>
		</div>
	}
}

func join(prefix, suffix string) string {
	if suffix == "" {
		return prefix
	}
	return strings.Join([]string{prefix, suffix}, "-")
}
