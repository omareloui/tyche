package views

import (
	"fmt"
	"time"

	"github.com/omareloui/tyche/internal/models"
)

type CounterpartyFD struct {
	Name FDInput
}

templ Counterparties(
	balances []models.Balance,
	fd *CounterpartyFD,
	counterparties []models.Counterparty) {
	@baseLayout("Counterparties", balances) {
		@container() {
			@mainHeader("Counterparties")
			@CreateCounterpartyForm(fd)
			@counterpartiesList(counterparties)
		}
	}
}

templ CreateCounterpartyForm(fd *CounterpartyFD) {
	@creationForm("Create Counterparty", "/counterparties", "Create Counterparty") {
		@counterpartyFormBody("", fd)
	}
}

templ EditCounterparty(id string, fd *CounterpartyFD) {
	@form("put", fmt.Sprintf("/counterparties/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@counterpartyFormBody(id, fd)
		@editFormButtons(fmt.Sprintf("/counterparties/%s", id))
	}
}

templ counterpartyFormBody(id string, fd *CounterpartyFD) {
	@input("Name", "text", "name", "Enter the name", id, fd.Name)
}

templ counterpartiesList(counterparties []models.Counterparty) {
	@list("counterparties-list") {
		for _, per := range counterparties {
			@Counterparty(&per)
		}
	}
}

templ Counterparty(per *models.Counterparty) {
	<div hx-target="this" hx-swap="outerHTML" class="entry-container">
		<p>ID: { per.ID }</p>
		<p>Name: { per.Name }</p>
		<p>CreatedAt: { per.CreatedAt.Format(time.RFC1123Z) }</p>
		<div class="flex gap-4">
			@editButton(fmt.Sprintf("/counterparties/%s/edit", per.ID))
			@deleteButton(fmt.Sprintf("/counterparties/%s", per.ID))
		</div>
	</div>
}

templ CounterpartyOOB(per *models.Counterparty) {
	<div id="counterparties-list" hx-swap-oob="afterbegin">
		@Counterparty(per)
	</div>
}
