package views

import (
	"fmt"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/web/views/layouts"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
)

type CounterpartyFD struct {
	Name form.FDInput
}

templ Counterparties(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *CounterpartyFD,
	counterparties []models.Counterparty) {
	@layouts.Main(claims, "Counterparties", balances, &layouts.Opts{IncludeAlpine: true, IncludeAlpineCollapse: true}) {
		@components.Container() {
			@components.MainHeader("Counterparties")
			@CreateCounterpartyForm(fd)
			@counterpartiesList(counterparties)
		}
	}
}

templ CreateCounterpartyForm(fd *CounterpartyFD) {
	@form.CreateForm("Create Counterparty", "/counterparties", "Create Counterparty") {
		@counterpartyFormBody("", fd)
	}
}

templ EditCounterparty(id string, fd *CounterpartyFD) {
	@form.Form("put", fmt.Sprintf("/counterparties/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@counterpartyFormBody(id, fd)
		@form.EditFormButtons(fmt.Sprintf("/counterparties/%s", id))
	}
}

templ counterpartyFormBody(id string, fd *CounterpartyFD) {
	@form.TextInput("Name", "name", "Enter the name", id, fd.Name, nil, nil)
}

templ counterpartiesList(counterparties []models.Counterparty) {
	@components.List("counterparties-list") {
		for _, per := range counterparties {
			@Counterparty(&per)
		}
	}
}

templ Counterparty(per *models.Counterparty) {
	<div hx-target="this" hx-swap="outerHTML" class="entry-container">
		<p>ID: { per.ID }</p>
		<p>Name: { per.Name }</p>
		<p>CreatedAt: { per.CreatedAt.Format(time.RFC1123Z) }</p>
		<div class="flex gap-4">
			@form.EditButton(fmt.Sprintf("/counterparties/%s/edit", per.ID))
			@form.DeleteButton(fmt.Sprintf("/counterparties/%s", per.ID))
		</div>
	</div>
}

templ CounterpartyOOB(per *models.Counterparty) {
	<div id="counterparties-list" hx-swap-oob="afterbegin">
		@Counterparty(per)
	</div>
}
