package views

import (
	"fmt"
	"strings"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/web/views/layouts"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
)

type CounterpartyFD struct {
	Name              form.FDInput
	Aliases           form.FDInput
	Icon              form.FDInput
	IsMerchant        form.FDInput
	DefaultCategoryID form.FDInput
}

templ Counterparties(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *CounterpartyFD,
	counterparties []models.Counterparty,
	cats []models.Category) {
	@layouts.WithCreateForm(claims, "Counterparties", balances, CreateCounterpartyForm(fd, cats)) {
		@counterpartiesList(counterparties)
	}
}

templ CreateCounterpartyForm(fd *CounterpartyFD, cats []models.Category) {
	@form.CreateForm("Create Counterparty", "/counterparties", "Create Counterparty") {
		@counterpartyFormBody("", fd, cats)
	}
}

templ EditCounterparty(id string, fd *CounterpartyFD, cats []models.Category) {
	@form.Form("put", fmt.Sprintf("/counterparties/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@counterpartyFormBody(id, fd, cats)
		@form.EditFormButtons(fmt.Sprintf("/counterparties/%s", id))
	}
}

templ counterpartyFormBody(id string, fd *CounterpartyFD, cats []models.Category) {
	@form.TextInput("Name", "name", "Enter the name", id, fd.Name, nil, nil)
	@form.TextInput("SMS Aliases", "aliases", "Comma separated, as in bank SMS, e.g. UBER *TRIP, UBER BV", id, fd.Aliases, nil, nil)
	<div class="contents" x-data={ fmt.Sprintf("{isMerchant: %t}", fd.IsMerchant.Value != "") }>
		@form.Checkbox("Merchant", "is_merchant", id, fd.IsMerchant, templ.Attributes{"x-model": "isMerchant"}, nil)
		<div class="contents" x-show="isMerchant" x-cloak?={ fd.IsMerchant.Value == "" }>
			@form.SelectDefaultTxCat("default_category_id", id, cats, fd.DefaultCategoryID, nil)
			if id == "" {
				@form.TextInput("Icon", "icon", "Leave empty to auto-detect, or a simpleicons.org slug", id, fd.Icon, nil, nil)
			} else {
				@form.TextInput("Icon", "icon", "A simpleicons.org slug, empty for no icon", id, fd.Icon, nil, nil)
			}
		</div>
	</div>
}

templ counterpartiesList(counterparties []models.Counterparty) {
	@components.Grid2ColOnSMUp("counterparties-list") {
		for _, cp := range counterparties {
			@Counterparty(&cp)
		}
	}
}

templ Counterparty(cp *models.Counterparty) {
	@components.EntryCard(components.WithCardTitle(cp.Name),
		components.WithCardIcon(components.CounterpartyIcon(cp.Name, cp.Icon, cp.Color, "w-8 h-8")),
		components.WithCardMenu([]templ.Component{
			components.EntryMenuAnchorItem("Edit", "get", fmt.Sprintf("/counterparties/%s/edit", cp.ID)),
			components.EntryMenuDeleteItem(fmt.Sprintf("/counterparties/%s", cp.ID)),
		}),
	) {
		<p>ID: { cp.ID }</p>
		if cp.IsMerchant {
			<p>Merchant</p>
		}
		if cp.DefaultCategory != nil {
			<p>Default category: { cp.DefaultCategory.Name }</p>
		}
		if len(cp.Aliases) > 0 {
			<p>Aliases: { strings.Join(cp.Aliases, ", ") }</p>
		}
		if cp.Icon != "" {
			<p>Icon: { cp.Icon }</p>
		}
		<p>CreatedAt: { cp.CreatedAt.Format(time.RFC1123Z) }</p>
	}
}

templ CounterpartyOOB(cp *models.Counterparty) {
	<div id="counterparties-list" hx-swap-oob="afterbegin">
		@Counterparty(cp)
	</div>
}
