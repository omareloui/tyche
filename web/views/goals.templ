package views

import (
	"fmt"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/web/views/layouts"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/internal/formatters"
	"github.com/omareloui/tyche/web/views/form"
)

type GoalFD struct {
	Name     form.FDInput
	AmountFD *form.AmountFD
}

templ Goals(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *GoalFD, goals []models.Goal,
	curs []models.Currency) {
	@layouts.WithCreateForm(claims, "Goals", balances,
		CreateGoalForm(fd, curs, &claims.DefaultCurrency),
		layouts.WithDatePicker(), layouts.WithAlpineMask()) {
		@goalsList(goals)
	}
}

templ CreateGoalForm(fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.CreateForm("Create Goal", "/goals", "Create Goal") {
		@goalFormBody("", fd, curs, defaultCur)
	}
}

templ EditGoal(id string, fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.Form("put", fmt.Sprintf("/goals/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@goalFormBody(id, fd, curs, defaultCur)
		@form.EditFormButtons(fmt.Sprintf("/goals/%s", id))
	}
}

templ goalFormBody(id string, fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.TextInput("Name", "name", "Enter goal title", id, fd.Name, nil, nil)
	@form.AmountInputsWithCurrency(fd.AmountFD, id, curs, defaultCur)
}

templ goalsList(goals []models.Goal) {
	@components.Grid2ColOnSMUp("goals-list") {
		for _, gl := range goals {
			@Goal(&gl)
		}
	}
}

templ Goal(gl *models.Goal) {
	<div hx-target="this" hx-swap="outerHTML" class="relative" x-data="{openMenu: false}">
		@components.EntryMenu("openMenu", getGoalMenuItems(gl))
		<div class="px-8 py-6 bg-zinc-700/20 rounded-3xl">
			<div class="flex justify-between gap-8">
				<p class="text-2xl mb-2">{ gl.Name }</p>
				<button
					@click="openMenu = !openMenu"
					class="cursor-pointer inline-block w-6 h-6"
				>
					<img src="/icons/dots-menu.svg" class="w-6 h-6"/>
				</button>
			</div>
			<div class="flex justify-between gap-2 items-center mb-4">
				<p class="bg-black px-4 py-2 rounded-full w-fit font-extrabold font-(family-name:--font-biorhyme-expanded) text-sm md:block hidden">{ formatters.FormatNum(gl.ProgressPercentage()) }%</p>
				<p class="font-(family-name:--font-biorhyme-expanded) md:text-xs text-[0.7rem] text-zinc-400 ">
					{ gl.ViewProgress() }/{ gl.ViewAmount() }
				</p>
			</div>
			<div class="relative h-4">
				<span class="absolute top-0 left-0 h-full w-full bg-zinc-200 rounded-full"></span>
				<span
					style={ fmt.Sprintf("width: min(%2.f%%, 100%%);", gl.ProgressPercentage()) }
					class={
						"absolute top-0 left-0 h-full rounded-full",
						templ.KV("bg-green-500 ", gl.ProgressPercentage() >= 100 || !gl.FulfilledAt.IsZero()),
						templ.KV("bg-black ", gl.ProgressPercentage() < 100 && gl.FulfilledAt.IsZero()),
					}
				></span>
			</div>
			if !gl.FulfilledAt.IsZero() {
				<time class="text-sm text-zinc-500 block mt-1 text-right">
					{ gl.FulfilledAt.Format(time.RFC822) }
				</time>
			}
		</div>
	</div>
}

templ GoalProgressForm(gl *models.Goal, fd *TransactionFD, accounts []models.Account, kinds []models.TransactionKind, defaultCur *models.Currency) {
	@form.Form("post", fmt.Sprintf("/goals/%s/progress", gl.ID), templ.Attributes{"hx-target": "this"}) {
		<h2 class="text-xl font-bold">{ gl.Name } <i class="text-gray-400 font-regular">({ gl.ViewAmount() })</i></h2>
		@form.AmountInputsWithAccount(&fd.AccountIFD, gl.ID, accounts, defaultCur)
		@form.DateInput("Date", "scheduled_to", gl.ID, fd.ScheduledTo, nil, nil)
		@form.EditFormButtons(fmt.Sprintf("/goals/%s", gl.ID))
		<script>
			loadDatePickers();
		</script>
	}
}

templ GoalOOB(gl *models.Goal) {
	<div id="goals-list" hx-swap-oob="afterbegin">
		@Goal(gl)
	</div>
}

func getGoalMenuItems(gl *models.Goal) []templ.Component {
	menuItems := []templ.Component{}

	if gl.FulfilledAt.IsZero() {
		menuItems = append(menuItems,
			components.EntryMenuAnchorItem("Fulfill", "put", fmt.Sprintf("/goals/%s/fulfill", gl.ID)),
			components.EntryMenuAnchorItem("Add progress", "get", fmt.Sprintf("/goals/%s/progress-form", gl.ID)),
		)
	} else {
		menuItems = append(menuItems, components.EntryMenuAnchorItem("Unfulfill", "put", fmt.Sprintf("/goals/%s/unfulfill", gl.ID)))
	}

	menuItems = append(menuItems,
		components.EntryMenuAnchorItem("Edit", "get", fmt.Sprintf("/goals/%s/edit", gl.ID)),
		components.EntryMenuAnchorItem("Delete", "delete", fmt.Sprintf("/goals/%s", gl.ID), "text-red-400"),
	)

	return menuItems
}
