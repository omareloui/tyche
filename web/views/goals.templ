package views

import (
	"fmt"
	"strings"
	"time"

	"github.com/omareloui/tyche/internal/formatters"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/slicesutils"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
	"github.com/omareloui/tyche/web/views/layouts"
)

type GoalFD struct {
	// From is GoalFromDetails when opened from the goal's details.
	From     string
	Name     form.FDInput
	AmountFD *form.AmountFD
}

templ Goals(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *GoalFD, goals []models.Goal,
	plans map[string]*GoalPlanCard,
	curs []models.Currency,
	openID string) {
	@layouts.WithCreateForm(claims, "Goals", balances,
		CreateGoalForm(fd, curs, &claims.DefaultCurrency)) {
		@goalsList(goals, plans, &claims.DefaultCurrency)
		if openID != "" {
			@components.DrawerOnLoad(goalDetailsURLOf(openID))
		}
	}
}

templ CreateGoalForm(fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.SheetForm("New goal", "/goals", "Create goal", "") {
		@goalFormBody("0", fd, curs, defaultCur)
	}
}

// EditGoal is the goal's edit form, in a drawer.
templ EditGoal(id string, fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@components.Drawer(components.DrawerProps{Label: "Edit goal"}) {
		@EditGoalForm(id, fd, curs, defaultCur)
	}
}

// EditGoalForm is EditGoal's form alone, answered with its errors.
templ EditGoalForm(id string, fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.DrawerForm(form.DrawerFormProps{
		Title: "Edit goal", Method: "put", URL: fmt.Sprintf("/goals/%s", id),
		Submit: "Save changes", CancelClick: goalBackCancel(id, fd.From),
	}) {
		@goalFromInput(fd.From)
		@goalFormBody(id, fd, curs, defaultCur)
	}
}

templ goalFormBody(id string, fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.Field("Name", "name", id, icons.Target("15"), fd.Name.Error) {
		@form.Control("text", "name", "e.g. New laptop", id, fd.Name, nil)
	}
	<div class="grid gap-3 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
		<div>
			<p class="text-zinc-300">Target</p>
			<p class="text-sm text-zinc-500">How much you need. Money from any account counts towards it.</p>
		</div>
		@form.AmountInputsWithCurrency(fd.AmountFD, id, curs, defaultCur)
	</div>
}

// GoalMoneyDir is which way a goal's money form moves money.
type GoalMoneyDir string

const (
	// GoalDeposit puts money from an account in the goal.
	GoalDeposit GoalMoneyDir = "deposit"
	// GoalWithdraw takes money out of the goal to an account.
	GoalWithdraw GoalMoneyDir = "withdraw"
	// GoalDeleteMove moves all that's left to an account, deleting the goal.
	GoalDeleteMove GoalMoneyDir = "delete"
)

// GoalMoneyFD is a goal's money form: Amount in the side money leaves (the
// account for a deposit, the goal's account HoldingID else), OtherAmount
// what the account receives when their currencies differ (a deposit goes to
// the goal's account of its currency, as is).
type GoalMoneyFD struct {
	// From is GoalFromDetails when opened from the goal's details.
	From        string
	Amount      form.FDInput
	AccountID   form.FDInput
	HoldingID   form.FDInput
	OtherAmount form.FDInput
	ScheduledTo form.FDInput
}

// GoalBuyFD is the form recording a goal's purchase.
type GoalBuyFD struct {
	Amount         form.FDInput
	CategoryID     form.FDInput
	CounterpartyID form.FDInput
	Description    form.FDInput
	ScheduledTo    form.FDInput
	// ScheduleLoan schedules the plan's loan payments, from LoanAccountID.
	ScheduleLoan  form.FDInput
	LoanAccountID form.FDInput
	// Conversions are what each holding with money (by account id) brings
	// in the goal's currency, converted before buying it.
	Conversions map[string]*form.FDInput
}

// GoalMoneyForm moves money between an account and the goal's, as a
// transfer, in a drawer.
templ GoalMoneyForm(gl *models.Goal, dir GoalMoneyDir, fd *GoalMoneyFD, accs []models.Account) {
	@components.Drawer(components.DrawerProps{Label: goalMoneyTitle(gl, dir)}) {
		@GoalMoneyFormFields(gl, dir, fd, accs)
	}
}

// GoalMoneyFormFields is GoalMoneyForm's form alone, answered with its
// errors.
templ GoalMoneyFormFields(gl *models.Goal, dir GoalMoneyDir, fd *GoalMoneyFD, accs []models.Account) {
	{{
		p := form.DrawerFormProps{
			Header: goalMoneyHeader(gl, dir), Method: "post", URL: fmt.Sprintf("/goals/%s/money?dir=%s", gl.ID, dir),
			Submit: "Add money", Class: "[--accent:var(--color-emerald-400)]",
		}
	}}
	switch dir {
		case GoalWithdraw:
			{{ p.Submit, p.Class = "Withdraw", "[--accent:var(--color-amber-300)]" }}
		case GoalDeleteMove:
			{{ p.URL, p.Submit, p.Class = fmt.Sprintf("/goals/%s/delete?dir=%s", gl.ID, dir), "Move and delete", "[--accent:var(--color-red-400)]" }}
	}
	{{ p.CancelClick = goalBackCancel(gl.ID, fd.From) }}
	@form.DrawerForm(p) {
		@goalFromInput(fd.From)
		@GoalMoneyInputs(gl, dir, fd, accs)
		if dir == GoalDeposit {
			<div x-data>
				@form.Field("Date", "scheduled_to", gl.ID, icons.Calendar("15"), fd.ScheduledTo.Error) {
					<div class="flex gap-2">
						<div class="flex-1 min-w-0">
							@form.Control("text", "scheduled_to", "yyyy-mm-dd", gl.ID, fd.ScheduledTo, templ.Attributes{
								"autocomplete":    "off",
								"x-mask":          "9999-99-99",
								"data-datepicker": true,
								"x-ref":           "date",
							})
						</div>
						@txDateChip("Today", 0)
						@txDateChip("Yesterday", 1)
					</div>
				}
				<p class="mt-1.5 text-sm text-zinc-500">A transfer to the goal: it's saved, not spent. A future date schedules it, counting once it's fulfilled.</p>
			</div>
		}
	}
}

func goalMoneyTitle(gl *models.Goal, dir GoalMoneyDir) string {
	switch dir {
	case GoalWithdraw:
		return "Withdraw from " + gl.Name
	case GoalDeleteMove:
		return "Delete " + gl.Name
	}
	return "Add to " + gl.Name
}

templ goalMoneyHeader(gl *models.Goal, dir GoalMoneyDir) {
	<div class="flex items-center gap-3">
		@goalRing(gl.ShownPercentage(), goalStateOf(gl), "size-11", "text-[0.65rem]")
		<div class="min-w-0">
			<h2 class="text-lg font-bold truncate">{ goalMoneyTitle(gl, dir) }</h2>
			<p class="sensitive text-sm text-zinc-500 tabular-nums">
				if dir == GoalDeposit {
					{ gl.ViewProgress() } of { gl.ViewAmount() } saved
				} else {
					{ gl.ViewBalance() } in it
				}
			</p>
		</div>
	</div>
}

// GoalMoneyInputs is the amounts and the accounts, rendered again when one
// of the accounts (so a currency) changes.
templ GoalMoneyInputs(gl *models.Goal, dir GoalMoneyDir, fd *GoalMoneyFD, accs []models.Account) {
	{{ acc := slicesutils.Find(accs, func(a models.Account) bool { return a.ID == fd.AccountID.Value }) }}
	{{ src := gl.AccountByID(fd.HoldingID.Value) }}
	if src == nil {
		{{ src = gl.Account }}
	}
	{{ sym := form.GetAccoutSym(accs, fd.AccountID.Value, &gl.Currency) }}
	if dir == GoalWithdraw {
		{{ sym = src.Currency.Symbol }}
	}
	{{ funded := gl.Funded() }}
	{{ otherCur := goalMoneyOtherCurrency(dir, acc, src, funded) }}
	{{ rest := goalRestIn(gl, accs, fd.AccountID.Value) }}
	{{ onChange := templ.Attributes{"hx-post": fmt.Sprintf("/goals/%s/money-inputs?dir=%s", gl.ID, dir), "hx-trigger": "change"} }}
	<div
		x-data
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="closest form:abort"
		class="grid justify-items-center gap-3 py-2"
	>
		if dir == GoalDeleteMove {
			<p class="text-center text-zinc-400">
				Move the <span class="sensitive text-zinc-100 tabular-nums">{ goalFundedText(gl, funded) }</span> left in it to an account first. Its transactions stay in the history.
			</p>
		} else {
			@form.HeroMoneyInput("Amount", "amount", sym, gl.ID, fd.Amount, templ.Attributes{
				"x-ref":      "amount",
				"hx-post":    fmt.Sprintf("/goals/%s/money-inputs?dir=%s", gl.ID, dir),
				"hx-trigger": "keyup changed delay:300ms",
			})
		}
		if dir == GoalWithdraw && len(funded) > 1 {
			<div class="flex flex-wrap items-center justify-center gap-2 max-w-full">
				<span class="text-sm text-zinc-500">out of</span>
				@form.Combobox(form.ComboboxProps{
					Name: "holding_id", ID: gl.ID, Label: "Money", Placeholder: "Select money",
					Options: goalHoldingOptions(funded), Data: fd.HoldingID, Chip: true, InputAttrs: onChange,
				})
			</div>
		} else if dir == GoalWithdraw {
			<input type="hidden" name="holding_id" value={ src.ID }/>
		}
		<div class="flex flex-wrap items-center justify-center gap-2 max-w-full">
			<span class="text-sm text-zinc-500">
				if dir == GoalDeposit {
					from
				} else {
					to
				}
			</span>
			@form.SelectAccountChip("Account", "account_id", gl.ID, accs, fd.AccountID, onChange)
		</div>
		@form.ErrorMessage(fd.AccountID.Error)
		if otherCur != nil {
			<label class="flex items-center gap-2 text-sm text-zinc-400">
				The account receives
				<input
					id={ "to_amount-" + gl.ID }
					type="text"
					name="to_amount"
					value={ fd.OtherAmount.Value }
					placeholder={ acc.Currency.Symbol + " 0.00" }
					autocomplete="off"
					inputmode="decimal"
					x-mask:dynamic={ fmt.Sprintf("'%s ' + $money($input, '.', ',')", acc.Currency.Symbol) }
					class="input-field w-48! h-9! text-center tabular-nums font-(family-name:--font-biorhyme-expanded)"
					if fd.OtherAmount.Error != "" {
						aria-invalid="true"
					}
				/>
			</label>
			@form.ErrorMessage(fd.OtherAmount.Error)
		}
		if dir == GoalDeleteMove && len(funded) > 1 && acc != nil {
			<ul class="grid gap-1 text-sm text-zinc-400 tabular-nums">
				for _, f := range funded {
					<li class="sensitive">
						{ f.Currency.Format(f.Amount) }
						if f.Currency.String != acc.Currency.String {
							→ { acc.Currency.Format(f.Amount * f.Currency.FxRate(acc.Currency.String)) } at today's rate
						}
					</li>
				}
			</ul>
		}
		if dir == GoalDeposit && acc != nil && acc.Currency.String != gl.Currency.String {
			<p class="max-w-sm text-center text-sm text-zinc-500">
				Kept in { strings.ToUpper(acc.Currency.String) }: the goal counts it at today's rate, so it follows the rate until it's bought.
			</p>
		}
		if dir == GoalDeposit && rest > 0 {
			<button
				type="button"
				@click={ fmt.Sprintf("$refs.amount.value = '%s %.2f'; $refs.amount.dispatchEvent(new Event('input')); $refs.amount.dispatchEvent(new KeyboardEvent('keyup')); $refs.amount.focus()", sym, rest) }
				class="inline-flex items-center gap-1.5 h-8 px-3 rounded-full border border-zinc-700 text-sm text-zinc-300 cursor-pointer transition-colors hover:border-(--accent) hover:text-(--accent)"
			>
				@icons.Sparkles("14")
				Fill the rest · <span class="sensitive tabular-nums">{ formatters.FormatAmount(rest, sym) }</span>
			</button>
		}
	</div>
}

// goalMoneyOtherCurrency is the currency the money form asks what the
// account receives in (nil when it doesn't): a withdraw's across
// currencies, or a delete's moving a single account of another currency.
func goalMoneyOtherCurrency(dir GoalMoneyDir, acc, src *models.Account, funded []models.Account) *models.Currency {
	if acc == nil {
		return nil
	}
	switch {
	case dir == GoalWithdraw && src.Currency.String != acc.Currency.String:
		return &acc.Currency
	case dir == GoalDeleteMove && len(funded) == 1 && funded[0].Currency.String != acc.Currency.String:
		return &acc.Currency
	}
	return nil
}

// goalHoldingOptions are the goal's accounts with money to pick one from,
// named after their currency.
func goalHoldingOptions(funded []models.Account) []form.ComboOption {
	opts := make([]form.ComboOption, len(funded))
	for i, a := range funded {
		opts[i] = form.ComboOption{
			Value:  a.ID,
			Label:  strings.ToUpper(a.Currency.String) + " · " + a.Currency.Format(a.Amount),
			Search: a.Currency.String,
		}
	}
	return opts
}

// goalFundedText is the money in the goal's accounts, each in its currency.
func goalFundedText(gl *models.Goal, funded []models.Account) string {
	if len(funded) == 0 {
		return gl.ViewBalance()
	}
	parts := make([]string, len(funded))
	for i, a := range funded {
		parts[i] = a.Currency.Format(a.Amount)
	}
	return strings.Join(parts, " + ")
}

// GoalBuyForm records buying the goal: an expense out of its account, the
// money it saved becoming spent.
templ GoalBuyForm(gl *models.Goal, fd *GoalBuyFD, cats []models.Category, cps []models.Counterparty, loan *models.InstallmentSchedule, accs []models.Account) {
	@components.Drawer(components.DrawerProps{Label: "Buy " + gl.Name}) {
		@GoalBuyFormFields(gl, fd, cats, cps, loan, accs)
	}
}

// GoalBuyFormFields is GoalBuyForm's form alone, answered with its errors.
templ GoalBuyFormFields(gl *models.Goal, fd *GoalBuyFD, cats []models.Category, cps []models.Counterparty, loan *models.InstallmentSchedule, accs []models.Account) {
	@form.DrawerForm(form.DrawerFormProps{
		Header: goalBuyHeader(gl), Method: "put", URL: fmt.Sprintf("/goals/%s/fulfill", gl.ID),
		Submit: "Mark as bought", Class: "[--accent:var(--color-emerald-400)]",
	}) {
		<div class="grid justify-items-center gap-2 py-2">
			if loan != nil {
				@form.HeroMoneyInput("Paid on the day", "amount", gl.Currency.Symbol, gl.ID, fd.Amount, nil)
				<p class="text-sm text-zinc-500">the down payment and fees, paid from the goal</p>
			} else {
				@form.HeroMoneyInput("Price paid", "amount", gl.Currency.Symbol, gl.ID, fd.Amount, nil)
				<p class="text-sm text-zinc-500">paid from the goal, it counts as spent today</p>
			}
		</div>
		if len(fd.Conversions) > 0 {
			@goalBuyConversions(gl, fd)
		}
		if loan != nil {
			@goalBuyLoan(gl, fd, loan, accs)
		}
		<div class="grid gap-5 sm:grid-cols-2">
			@form.Field("Category", "category_id", gl.ID, icons.Tag("15"), fd.CategoryID.Error) {
				@form.Combobox(form.ComboboxProps{
					Name: "category_id", ID: gl.ID, Label: "Category", Placeholder: "Select Category",
					Options: categoryComboOptions(cats),
					Data:    fd.CategoryID, Nullable: true, Searchable: true,
				})
			}
			@form.Field("Counterparty", "counterparty_id", gl.ID, icons.User("15"), fd.CounterpartyID.Error) {
				@form.Combobox(form.ComboboxProps{
					Name: "counterparty_id", ID: gl.ID, Label: "Counterparty", Placeholder: "Select Counterparty",
					Options: counterpartyComboOptions(cps, fd.CounterpartyID.Value),
					Data:    fd.CounterpartyID, Nullable: true, Searchable: true,
				})
			}
		</div>
		@form.Field("Description", "description", gl.ID, icons.Pencil("15"), fd.Description.Error) {
			@form.Control("text", "description", "What was it?", gl.ID, fd.Description, nil)
		}
		<div x-data>
			@form.Field("Date", "scheduled_to", gl.ID, icons.Calendar("15"), fd.ScheduledTo.Error) {
				<div class="flex gap-2">
					<div class="flex-1 min-w-0">
						@form.Control("text", "scheduled_to", "yyyy-mm-dd", gl.ID, fd.ScheduledTo, templ.Attributes{
							"autocomplete":    "off",
							"x-mask":          "9999-99-99",
							"data-datepicker": true,
							"x-ref":           "date",
						})
					</div>
					@txDateChip("Today", 0)
					@txDateChip("Yesterday", 1)
				</div>
			}
		</div>
	}
}

// goalBuyConversions asks what each holding with money brings in the goal's
// currency, converted to it before buying it (prefilled at today's rate).
templ goalBuyConversions(gl *models.Goal, fd *GoalBuyFD) {
	<fieldset class="grid gap-3 rounded-2xl border border-zinc-800 p-4">
		<legend class="px-1 text-sm text-zinc-400">Converted to { strings.ToUpper(gl.Currency.String) } first</legend>
		for _, h := range gl.Holdings {
			if in := fd.Conversions[h.ID]; in != nil {
				<label class="flex flex-wrap items-center justify-between gap-2 text-sm text-zinc-400">
					<span class="sensitive tabular-nums">{ h.Currency.Format(h.Amount) } becomes</span>
					<input
						type="text"
						name={ "convert_" + h.ID }
						value={ in.Value }
						placeholder={ gl.Currency.Symbol + " 0.00" }
						autocomplete="off"
						inputmode="decimal"
						x-data
						x-mask:dynamic={ fmt.Sprintf("'%s ' + $money($input, '.', ',')", gl.Currency.Symbol) }
						class="input-field w-48! h-9! text-center tabular-nums font-(family-name:--font-biorhyme-expanded)"
						if in.Error != "" {
							aria-invalid="true"
						}
					/>
				</label>
				@form.ErrorMessage(in.Error)
			}
		}
	</fieldset>
}

templ goalBuyHeader(gl *models.Goal) {
	<div class="flex items-center gap-3">
		@goalRing(gl.ShownPercentage(), goalStateOf(gl), "size-11", "text-[0.65rem]")
		<div class="min-w-0">
			<h2 class="text-lg font-bold truncate">Buy { gl.Name }</h2>
			<p class="sensitive text-sm text-zinc-500 tabular-nums">{ gl.ViewBalance() } saved in it</p>
		</div>
	</div>
}

templ goalsList(goals []models.Goal, plans map[string]*GoalPlanCard, defaultCur *models.Currency) {
	<div id="goals-list" class="grid gap-8">
		@goalsSummary(goals, defaultCur, false)
		<section class="hidden has-[[data-goal]]:block">
			<h2 class="flex items-center gap-2 mb-3 text-sm font-semibold uppercase tracking-wider text-zinc-500">
				@icons.Target("16")
				In progress
			</h2>
			@goalSectionGrid(goalSectionActive) {
				for _, gl := range goals {
					if goalSectionOf(&gl) == goalSectionActive {
						@Goal(&gl, plans[gl.ID])
					}
				}
			}
		</section>
		<details class="group hidden has-[[data-goal]]:block">
			<summary class="flex items-center gap-2 mb-3 list-none cursor-pointer select-none text-zinc-500 hover:text-zinc-300 [&::-webkit-details-marker]:hidden">
				@icons.Trophy("16")
				<h2 class="text-sm font-semibold uppercase tracking-wider">Achieved</h2>
				@icons.ChevronDown("16", &templ.Attributes{"class": "transition-transform group-open:rotate-180"})
			</summary>
			@goalSectionGrid(goalSectionAchieved) {
				for _, gl := range goals {
					if goalSectionOf(&gl) == goalSectionAchieved {
						@Goal(&gl, plans[gl.ID])
					}
				}
			}
		</details>
		@goalsEmpty()
	</div>
}

templ goalSectionGrid(section string) {
	<div id={ GoalSectionID(section) } class="grid sm:grid-cols-2 gap-4">
		{ children... }
	</div>
}

templ goalsEmpty() {
	<div class="goals-empty hidden place-items-center gap-3 py-16 text-center">
		<div class="relative grid place-items-center w-16 h-16 rounded-2xl bg-violet-400/15 text-violet-400">
			<div aria-hidden="true" class="absolute inset-0 rounded-2xl bg-violet-400/20 blur-xl"></div>
			@icons.Target("30", &templ.Attributes{"class": "relative"})
		</div>
		<p class="mt-2 text-xl font-semibold">No goals yet</p>
		<p class="max-w-sm text-zinc-500">Saving up for something? Set a target and watch it fill up with every bit you put aside.</p>
		<button type="button" @click="openCreateForm=true" class="btn-primary mt-2">
			@icons.Plus("18")
			New goal
		</button>
	</div>
}

// goalsSummary is the money saved towards the goals in progress, in the
// default currency. It's empty when there are no goals.
templ goalsSummary(goals []models.Goal, defaultCur *models.Currency, oob bool) {
	{{ s := summarizeGoals(goals, defaultCur) }}
	<div
		id="goals-summary"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(goals) > 0 {
			<section class="relative overflow-hidden grid gap-5 p-5 sm:p-6 rounded-3xl bg-zinc-700/20 ring-1 ring-zinc-800 [--accent:var(--color-violet-400)]">
				<div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-16 size-64 rounded-full bg-(--accent)/15 blur-3xl"></div>
				<div aria-hidden="true" class="pointer-events-none absolute -bottom-28 -left-20 size-56 rounded-full bg-emerald-400/10 blur-3xl"></div>
				<div class="relative flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
					if s.Active > 0 {
						<div class="min-w-0">
							<p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-(--accent)">
								@icons.PiggyBank("14")
								Saved so far
							</p>
							<p class="sensitive mt-1 text-3xl sm:text-4xl font-bold tabular-nums font-(family-name:--font-biorhyme-expanded)">
								{ defaultCur.Format(s.Saved) }
							</p>
							<p class="text-sm text-zinc-500 tabular-nums">
								of <span class="sensitive">{ defaultCur.Format(s.Target) }</span> across { fmt.Sprint(s.Active) } { plural(s.Active, "goal", "goals") }
							</p>
						</div>
					} else {
						<div class="min-w-0">
							<p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-400">
								@icons.Trophy("14")
								All done
							</p>
							<p class="mt-1 text-2xl font-bold font-(family-name:--font-biorhyme-expanded)">Every goal reached</p>
							<p class="text-sm text-zinc-500">Time to dream up the next one.</p>
						</div>
					}
					<div class="flex gap-2">
						@statTile(fmt.Sprint(s.Active), "In progress", "text-zinc-100")
						if s.Ready > 0 {
							@statTile(fmt.Sprint(s.Ready), "Ready", "text-amber-300")
						}
						@statTile(fmt.Sprint(s.Achieved), "Achieved", "text-emerald-400")
					</div>
				</div>
				if s.Active > 0 {
					<div class="relative">
						<div class="h-2.5 rounded-full bg-zinc-800 overflow-hidden">
							<div
								class="h-full rounded-full bg-linear-to-r from-violet-500 to-violet-300"
								style={ fmt.Sprintf("width: %.1f%%", s.Pct()) }
							></div>
						</div>
						<p class="mt-1.5 text-xs text-zinc-500 tabular-nums">{ fmt.Sprintf("%.0f%%", s.Pct()) } of the way there</p>
					</div>
				}
			</section>
		}
	</div>
}

templ statTile(value, label, valueClass string) {
	<div class="min-w-20 px-3 py-2 rounded-2xl bg-zinc-900/60 ring-1 ring-zinc-800 text-center">
		<p class={ "text-xl font-bold tabular-nums font-(family-name:--font-biorhyme-expanded)", valueClass }>{ value }</p>
		<p class="text-xs text-zinc-500">{ label }</p>
	</div>
}

templ Goal(gl *models.Goal, plan *GoalPlanCard) {
	@goalCard(gl, plan, false)
}

// goalCardData opens the card's details on a click on it, unless on one of
// its controls or selecting its text, like a counterparty's card.
const goalCardData = `{
	openMenu: false,
	openDetails(e, card) {
		if (e.target !== card && e.target.closest('button, a, input, label, [role=group], [role=menu]')) return
		if (getSelection()?.toString()) return
		htmx.ajax('GET', card.dataset.details, {target: '#drawer', swap: 'innerHTML'})
	},
}`

templ goalCard(gl *models.Goal, plan *GoalPlanCard, oob bool) {
	{{ st := goalStateOf(gl) }}
	{{ deposits, scheduled := goalDeposits(gl) }}
	<div
		id={ GoalID(gl.ID) }
		if oob {
			hx-swap-oob="true"
		}
		hx-target="this"
		hx-swap="outerHTML"
		data-goal
		class="relative"
		x-data={ goalCardData }
	>
		@components.EntryMenuAt("openMenu", "top-16 right-3 origin-top-right", getGoalMenuItems(gl, st))
		<div
			tabindex="0"
			data-details={ goalDetailsURL(gl) }
			@click="openDetails($event, $el)"
			@keydown.enter.self="openDetails($event, $el)"
			aria-label={ gl.Name + " details" }
			class={ "relative flex flex-col gap-4 h-full p-4 rounded-2xl bg-zinc-700/20 overflow-hidden cursor-pointer transition hover:bg-zinc-700/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--accent)/60", goalAccentClass(st) }
		>
			<div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-(--accent)/10 blur-2xl"></div>
			<div class="relative flex items-center gap-4 min-w-0">
				@goalRing(gl.ShownPercentage(), st, "size-14", "text-xs")
				<div class="flex-1 min-w-0">
					<p class="text-lg leading-tight truncate">{ gl.Name }</p>
					<p class="sensitive text-sm text-zinc-500 tabular-nums truncate">
						<span class="text-zinc-300">{ gl.ViewProgress() }</span> of { gl.ViewAmount() }
						if gl.FulfilledAt.IsZero() && gl.HasHoldings() {
							<span title="Part of it is kept in other currencies, counted at today's rates">· at today's rates</span>
						}
					</p>
				</div>
				@components.EntryMenuTrigger("openMenu", "Goal actions")
			</div>
			switch st {
				case goalActive:
					<div class="relative flex items-end justify-between gap-3 mt-auto">
						<div class="min-w-0">
							<p class="text-xs text-zinc-500">Still to go</p>
							<p class="sensitive text-xl font-bold tabular-nums truncate font-(family-name:--font-biorhyme-expanded)">{ gl.ViewRemaining() }</p>
						</div>
						@goalAddButton(gl.ID)
					</div>
					if plan != nil {
						@goalPlanSummary(gl, plan, false)
					} else {
						@goalPlan(gl)
					}
				case goalReady:
					<div class="relative flex items-center gap-3 mt-auto px-3 py-2.5 rounded-xl bg-(--accent)/8 ring-1 ring-(--accent)/20">
						@icons.Sparkles("18", &templ.Attributes{"class": "shrink-0 text-(--accent)"})
						<p class="flex-1 min-w-0 text-sm text-zinc-300">
							if gl.Plan.IsInstallments() {
								Down payment saved!
							} else {
								Target reached!
							}
						</p>
						<button
							hx-get={ fmt.Sprintf("/goals/%s/fulfill-form", gl.ID) }
							hx-target={ "#" + components.DrawerSlot }
							hx-swap="innerHTML"
							class="shrink-0 h-8 px-3 rounded-full bg-(--accent) text-sm font-semibold text-zinc-950 cursor-pointer transition hover:brightness-110 active:scale-[.98]"
						>Mark as bought</button>
					</div>
				case goalPaying:
					@goalPayingOff(gl)
				case goalAchieved:
					<div class="relative flex items-center gap-2 mt-auto text-sm text-(--accent)">
						@icons.Trophy("16")
						<span>Bought { gl.FulfilledAt.Local().Format("Jan 2, 2006") }</span>
					</div>
					if gl.Balance() > 0 {
						<p class="relative text-sm text-zinc-500"><span class="sensitive tabular-nums">{ gl.ViewBalance() }</span> left in it</p>
					}
			}
			if deposits > 0 || scheduled > 0 {
				<div class="relative flex flex-wrap items-center gap-1.5">
					if deposits > 0 {
						<span class="chip">
							@icons.PiggyBank("12")
							{ fmt.Sprint(deposits) } { plural(deposits, "deposit", "deposits") }
						</span>
					}
					if scheduled > 0 {
						<span class="chip">
							@icons.Calendar("12")
							{ fmt.Sprint(scheduled) } scheduled
						</span>
					}
					if last := goalLastDeposit(gl); !last.IsZero() {
						<span class="text-xs text-zinc-500">last { goalDay(last) }</span>
					}
				</div>
			}
		</div>
	</div>
}

templ goalAddButton(id string) {
	<button
		hx-get={ fmt.Sprintf("/goals/%s/money-form?dir=%s", id, GoalDeposit) }
		hx-target={ "#" + components.DrawerSlot }
		hx-swap="innerHTML"
		class="inline-flex shrink-0 items-center gap-1.5 h-9 pl-3 pr-4 rounded-full bg-(--accent)/15 text-sm font-medium text-(--accent) cursor-pointer transition-colors hover:bg-(--accent)/25"
	>
		@icons.Plus("16")
		Add money
	</button>
}

// goalPlan is how much to put aside every month to reach the goal in a few
// months, picked from pills or typed in.
templ goalPlan(gl *models.Goal) {
	<div
		x-data={ fmt.Sprintf("{m: 6, c: '', rem: %v}", gl.Remaining()) }
		class="relative flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-zinc-800/80 text-sm"
	>
		<p class="text-zinc-500 tabular-nums">
			<span class="sensitive text-zinc-200">
				if gl.Currency.Symbol != "" {
					{ gl.Currency.Symbol + " " }
				}
				<span x-text="(rem / m).toLocaleString('en-US', {maximumFractionDigits: 2})">
					{ formatters.FormatNum(gl.MonthlyFor(6)) }
				</span>
			</span>/mo to get there in
		</p>
		<div role="group" aria-label="Months to reach the goal" class="flex items-center gap-1 p-0.5 rounded-full bg-zinc-800/60">
			for _, m := range goalPlanMonths {
				<button
					type="button"
					@click={ fmt.Sprintf("m = %d; c = ''", m) }
					:class={ fmt.Sprintf("c === '' && m === %d ? 'bg-zinc-700 text-white' : 'text-zinc-500 hover:text-zinc-300'", m) }
					class="h-6 px-2 rounded-full text-xs tabular-nums cursor-pointer transition-colors"
				>{ fmt.Sprintf("%dmo", m) }</button>
			}
			<label
				:class="c !== '' ? 'bg-zinc-700 text-white' : 'text-zinc-500'"
				class="flex items-center h-6 px-1.5 rounded-full text-xs tabular-nums transition-colors"
			>
				<input
					type="number"
					min="1"
					max="600"
					step="1"
					inputmode="numeric"
					placeholder="#"
					aria-label="Custom number of months"
					x-model="c"
					@input="const n = parseInt($event.target.value, 10); m = n >= 1 ? Math.min(n, 600) : 6"
					class="w-[3ch] bg-transparent text-right outline-none placeholder:text-zinc-600 [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
				/>mo
			</label>
		</div>
	</div>
}

// goalRing is the goal's progress as a ring, with the percentage (or a
// trophy once achieved) in the middle.
templ goalRing(pct float64, st goalState, size, textSize string) {
	{{ arc := min(100, max(0, pct)) }}
	<div class={ "relative shrink-0", size, goalAccentClass(st) }>
		<svg viewBox="0 0 36 36" class="size-full -rotate-90" aria-hidden="true">
			<circle cx="18" cy="18" r="15.915" fill="none" stroke-width="3.5" class="stroke-zinc-800"></circle>
			if arc > 0 {
				<circle
					cx="18"
					cy="18"
					r="15.915"
					fill="none"
					stroke-width="3.5"
					stroke-linecap="round"
					stroke="var(--accent)"
					stroke-dasharray={ fmt.Sprintf("%.2f 100", arc) }
				></circle>
			}
		</svg>
		<span class={ "absolute inset-0 grid place-items-center font-bold tabular-nums", textSize }>
			if st == goalAchieved {
				@icons.Trophy("40%", &templ.Attributes{"class": "text-(--accent)"})
			} else {
				{ fmt.Sprintf("%.0f%%", min(pct, 999)) }
			}
		</span>
	</div>
}

templ GoalOOB(gl *models.Goal, plan *GoalPlanCard) {
	<div id={ GoalSectionID(goalSectionOf(gl)) } hx-swap-oob="afterbegin">
		@Goal(gl, plan)
	</div>
}

templ GoalsSummaryOOB(goals []models.Goal, defaultCur *models.Currency) {
	@goalsSummary(goals, defaultCur, true)
}

type goalState int

const (
	goalActive goalState = iota
	// goalReady has reached its target but isn't marked achieved yet.
	goalReady
	goalAchieved
	// goalPaying is bought with a loan not paid off yet.
	goalPaying
)

const (
	goalSectionActive   = "active"
	goalSectionAchieved = "achieved"
)

var goalPlanMonths = []int{3, 6, 12}

func GoalID(id string) string {
	return "goal-" + id
}

func GoalSectionID(section string) string {
	return "goals-" + section
}

func goalStateOf(gl *models.Goal) goalState {
	switch {
	case gl.PayingOff():
		return goalPaying
	case !gl.FulfilledAt.IsZero():
		return goalAchieved
	case gl.ProgressPercentage() >= 100,
		gl.Plan.IsInstallments() && gl.Progress() >= gl.SaveTarget()-0.005:
		return goalReady
	}
	return goalActive
}

func goalSectionOf(gl *models.Goal) string {
	if goalStateOf(gl) == goalAchieved {
		return goalSectionAchieved
	}
	return goalSectionActive
}

func goalAccentClass(st goalState) string {
	switch st {
	case goalReady:
		return "[--accent:var(--color-amber-300)]"
	case goalAchieved:
		return "[--accent:var(--color-emerald-400)]"
	case goalPaying:
		return "[--accent:var(--color-sky-300)]"
	}
	return "[--accent:var(--color-violet-400)]"
}

// goalDeposits counts the money put in the goal, fulfilled and scheduled.
func goalDeposits(gl *models.Goal) (deposits, scheduled int) {
	for _, tx := range gl.Transactions {
		if gl.TxAmount(&tx) <= 0 {
			continue
		}
		if tx.FulfilledAt.IsZero() {
			scheduled++
		} else {
			deposits++
		}
	}
	return deposits, scheduled
}

func goalLastDeposit(gl *models.Goal) time.Time {
	var last time.Time
	for _, tx := range gl.Transactions {
		if gl.TxAmount(&tx) > 0 && !tx.FulfilledAt.IsZero() && tx.ScheduledTo.After(last) {
			last = tx.ScheduledTo
		}
	}
	return last
}

// goalRestIn is what's left to save for the goal in the account's currency,
// 0 if it's reached or the rate is unknown.
func goalRestIn(gl *models.Goal, accs []models.Account, accID string) float64 {
	rest := gl.Remaining()
	if rest <= 0 {
		return 0
	}
	for _, a := range accs {
		if a.ID == accID && a.Currency.String != gl.Currency.String {
			return rest * gl.Currency.FxRate(a.Currency.String)
		}
	}
	return rest
}

type goalsSummaryData struct {
	Saved, Target           float64
	Active, Ready, Achieved int
}

func (s goalsSummaryData) Pct() float64 {
	if s.Target == 0 {
		return 0
	}
	return min(100, s.Saved/s.Target*100)
}

// summarizeGoals sums the goals in progress in the default currency, capping
// each at its target so one overshooting goal doesn't hide the others.
func summarizeGoals(gls []models.Goal, defaultCur *models.Currency) goalsSummaryData {
	var s goalsSummaryData
	for _, gl := range gls {
		switch goalStateOf(&gl) {
		case goalAchieved:
			s.Achieved++
			continue
		case goalPaying:
			// What's paid of what buying it costs.
			s.Active++
			rate := 1.0
			if gl.Currency.String != defaultCur.String {
				rate = gl.Currency.FxRate(defaultCur.String)
			}
			s.Saved += (gl.Purchased + gl.Loan.Paid) * rate
			s.Target += (gl.Purchased + gl.Loan.Total) * rate
			continue
		case goalReady:
			s.Ready++
		}
		s.Active++
		rate := 1.0
		if gl.Currency.String != defaultCur.String {
			rate = gl.Currency.FxRate(defaultCur.String)
		}
		s.Saved += min(max(0, gl.Progress()), gl.Price) * rate
		s.Target += gl.Price * rate
	}
	return s
}

func getGoalMenuItems(gl *models.Goal, st goalState) []templ.Component {
	items := []templ.Component{}
	moneyForm := func(dir GoalMoneyDir) string { return fmt.Sprintf("/goals/%s/money-form?dir=%s", gl.ID, dir) }

	items = append(items, components.EntryMenuDrawerItem("Details", goalDetailsURL(gl),
		components.WithEntryMenuItemIcon(icons.Eye("16"))))
	if !gl.FulfilledAt.IsZero() {
		items = append(items, components.EntryMenuAnchorItem("Undo bought", "put", fmt.Sprintf("/goals/%s/unfulfill", gl.ID),
			components.WithEntryMenuItemIcon(icons.RotateCcw("16")),
			components.WithEntryMenuItemConfirmMessage("Its purchase gets deleted and the money goes back in the goal, with the loan's payments not paid yet.")))
	} else {
		items = append(items,
			components.EntryMenuDrawerItem("Add money", moneyForm(GoalDeposit),
				components.WithEntryMenuItemIcon(icons.Plus("16"))),
			components.EntryMenuDrawerItem("Mark as bought", fmt.Sprintf("/goals/%s/fulfill-form", gl.ID),
				components.WithEntryMenuItemIcon(icons.Trophy("16"))),
		)
		planLabel := "Plan it"
		if gl.Plan != nil {
			planLabel = "Edit plan"
		}
		items = append(items, components.EntryMenuDrawerItem(planLabel, goalPlanURL(gl),
			components.WithEntryMenuItemIcon(icons.Calendar("16"))))
		if gl.Plan != nil {
			items = append(items, components.EntryMenuAnchorItem("Remove plan", "delete", goalPlanURL(gl),
				components.WithEntryMenuItemIcon(icons.X("16")),
				components.WithEntryMenuItemConfirmMessage("The plan goes, the money saved stays in the goal.")))
		}
	}
	if gl.Balance() > 0 {
		items = append(items, components.EntryMenuDrawerItem("Withdraw", moneyForm(GoalWithdraw),
			components.WithEntryMenuItemIcon(icons.Transfer("16"))))
	}

	items = append(items,
		components.EntryMenuSeparator(),
		components.EntryMenuEditItem(fmt.Sprintf("/goals/%s/edit", gl.ID)),
		components.EntryMenuSeparator(),
	)
	if gl.Balance() > 0 {
		return append(items, components.EntryMenuDrawerItem("Delete", fmt.Sprintf("/goals/%s/delete-form", gl.ID),
			components.WithEntryMenuItemIcon(icons.Trash("16")), components.WithEntryMenuItemDanger()))
	}
	return append(items, components.EntryMenuDeleteItem(fmt.Sprintf("/goals/%s", gl.ID)))
}

// goalDay is a deposit's day, relative when recent.
func goalDay(day time.Time) string {
	switch dateOf(time.Now()).Sub(dateOf(day)) {
	case 0:
		return "today"
	case 24 * time.Hour:
		return "yesterday"
	}
	if day.Year() != time.Now().Year() {
		return day.Format("Jan 2, 2006")
	}
	return day.Format("Jan 2")
}

// goalPayingOff is a goal bought with a loan, on its card: what's paid of
// what it costs and the next payment.
templ goalPayingOff(gl *models.Goal) {
	{{ next := goalNextLoanPayment(gl) }}
	<div class="relative grid gap-2 mt-auto">
		<div class="flex items-end justify-between gap-3">
			<div class="min-w-0">
				<p class="text-xs text-zinc-500">Paying off</p>
				<p class="sensitive text-xl font-bold tabular-nums truncate font-(family-name:--font-biorhyme-expanded)">{ gl.Currency.Format(gl.Purchased + gl.Loan.Paid) }</p>
				<p class="sensitive text-xs text-zinc-500 tabular-nums">of { gl.Currency.Format(gl.Purchased + gl.Loan.Total) } · { fmt.Sprint(gl.Loan.PaidPayments) }/{ fmt.Sprint(gl.Loan.Payments) } payments</p>
				{{ last := goalLastLoanPayment(gl) }}
				if last != nil {
					<span class="chip mt-1.5">
						@icons.Hourglass("12")
						{ fmt.Sprint(gl.Loan.Payments - gl.Loan.PaidPayments) } left · paid off { goalInMonths(monthsApart(time.Now(), last.ScheduledTo)) }
					</span>
				}
			</div>
			if next != nil {
				<p class="shrink-0 text-right text-xs text-zinc-500">
					Next
					<span class="sensitive block text-sm text-zinc-300 tabular-nums">{ next.Account.Currency.Format(next.Amount) }</span>
					{ formatTxDay(next.ScheduledTo) }
				</p>
			}
		</div>
		@goalProgressBar(gl)
	</div>
}

// goalLastLoanPayment is the last loan payment not made yet, nil without.
func goalLastLoanPayment(gl *models.Goal) *models.Transaction {
	var last *models.Transaction
	for i := range gl.Transactions {
		tx := &gl.Transactions[i]
		if tx.IsLoanPayment() && tx.FulfilledAt.IsZero() && (last == nil || tx.ScheduledTo.After(last.ScheduledTo)) {
			last = tx
		}
	}
	return last
}

// goalNextLoanPayment is the first loan payment not made yet, nil without.
func goalNextLoanPayment(gl *models.Goal) *models.Transaction {
	var next *models.Transaction
	for i := range gl.Transactions {
		tx := &gl.Transactions[i]
		if tx.IsLoanPayment() && tx.FulfilledAt.IsZero() && (next == nil || tx.ScheduledTo.Before(next.ScheduledTo)) {
			next = tx
		}
	}
	return next
}
