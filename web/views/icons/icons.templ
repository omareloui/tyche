package icons

// Error is red unless attrs set a class (e.g. another text color): it's
// filled with the current color.
templ Error(size string, attrs ...*templ.Attributes) {
	@squareIcon(size, errorIconAttrs(attrs)) {
		<path d="M0 0h24v24H0z" fill="none"></path>
		<path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm-1-7v2h2v-2h-2zm0-8v6h2V7h-2z"></path>
	}
}

templ squareIcon(size string, attrs ...*templ.Attributes) {
	<svg
		width={ size }
		height={ size }
		viewBox="0 0 24 24"
		if attrs != nil {
			{ *attrs[0]... }
		}
	>
		{ children... }
	</svg>
}

func appendToAttrs(attrs1 []*templ.Attributes, attrs2 []*templ.Attributes) []*templ.Attributes {
	for _, attr1 := range attrs1 {
		attrs2 = append(attrs2, attr1)
	}

	return attrs2
}

templ strokeIcon(size string, attrs ...*templ.Attributes) {
	<svg
		width={ size }
		height={ size }
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		if attrs != nil {
			{ *attrs[0]... }
		}
	>
		{ children... }
	</svg>
}

// Repeat marks a transaction generated from a recurrent transaction.
templ Repeat(size string, attrs ...*templ.Attributes) {
	@strokeIcon(size, attrs...) {
		<path d="M21 12a9 9 0 0 0-15.5-6.2L3 8"></path>
		<path d="M3 3v5h5"></path>
		<path d="M3 12a9 9 0 0 0 15.5 6.2L21 16"></path>
		<path d="M21 21v-5h-5"></path>
	}
}

