func errorIconAttrs(attrs []*templ.Attributes) *templ.Attributes {
	a := templ.Attributes{"fill": "currentColor", "class": "text-red-500"}
	if len(attrs) > 0 && attrs[0] != nil {
		for k, v := range *attrs[0] {
			a[k] = v
		}
	}
	return &a
}

