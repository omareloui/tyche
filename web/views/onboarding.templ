package views

import (
	"fmt"
	"math"
	"strconv"

	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
	"github.com/omareloui/tyche/web/views/layouts"
)

// WelcomeData is a step of the onboarding.
type WelcomeData struct {
	Step models.OnboardingStep

	// Region step. Suggest fetches it again with the browser's time zone and
	// languages, to preselect them, while the user hasn't picked any.
	Suggest     bool
	Currencies  []models.Currency
	CurrencyID  string
	Timezone    string
	RegionError string

	// Accounts step.
	Accounts        []models.Account
	Kinds           []models.AccountKind
	ShownCurrencies []models.Currency
	DefaultCurrency *models.Currency
	NewAccount      WelcomeAccountFD
	AccountsError   string

	// Security step.
	Encrypted    bool
	RecoveryCode string
}

// WelcomeAccountFD is the account being added on the accounts step.
type WelcomeAccountFD struct {
	KindID, Name, CurrencyID, Amount form.FDInput
}

// WelcomeTarget is the id of the element the steps swap in.
const WelcomeTarget = "welcome"

func welcomeURL(step models.OnboardingStep) string {
	return "/welcome?step=" + string(step)
}

// welcomeNav swaps another step in. Its own hx-disabled-elt: htmx 1.9 breaks
// on a "find <sel>" inherited from a form that matches nothing in the button.
func welcomeNav(step models.OnboardingStep) templ.Attributes {
	return templ.Attributes{
		"hx-disabled-elt": "this",
		"hx-get":          welcomeURL(step),
		"hx-target":       "#" + WelcomeTarget,
		"hx-swap":         "innerHTML show:window:top",
		"hx-push-url":     "true",
	}
}

templ Welcome(claims *jwt.AccessClaims, balances []models.Balance, d *WelcomeData) {
	@layouts.Main(claims, "Welcome", balances) {
		@components.Container() {
			<div class="flex flex-col justify-center min-h-[calc(100dvh-12rem)] py-10">
				<div id={ WelcomeTarget } class="w-full max-w-lg mx-auto grid gap-6">
					@WelcomeBody(d)
				</div>
			</div>
		}
	}
}

// WelcomeBody is the content of #welcome: the steps' progress and the current
// one.
templ WelcomeBody(d *WelcomeData) {
	@welcomeProgress(d.Step)
	switch d.Step {
		case models.OnboardingRegion:
			@welcomeRegion(d)
		case models.OnboardingAccounts:
			@welcomeAccounts(d)
		case models.OnboardingSecurity:
			@welcomeSecurity(d)
		case models.OnboardingBadge:
			@welcomeBadge(d)
		case models.OnboardingDone:
			@welcomeDone()
	}
}

templ welcomeProgress(step models.OnboardingStep) {
	<div class="flex items-center gap-4">
		if step.Index() > 0 {
			<button
				type="button"
				aria-label="Back"
				title="Back"
				class="grid place-items-center w-9 h-9 -ml-2 rounded-full text-zinc-400 cursor-pointer transition-colors hover:bg-zinc-800 hover:text-white"
				{ welcomeNav(step.Prev())... }
			>
				@icons.ArrowLeft("18")
			</button>
		}
		<ol class="flex items-center gap-2" aria-label="Setup progress">
			for i, s := range models.OnboardingSteps {
				<li
					class={ "h-1.5 rounded-full transition-all",
						templ.KV("w-8 bg-violet-400", s == step),
						templ.KV("w-4 bg-violet-400/50", i < step.Index()),
						templ.KV("w-4 bg-zinc-700", i > step.Index()) }
					if s == step {
						aria-current="step"
					}
				>
					<span class="sr-only">{ string(s) }</span>
				</li>
			}
		</ol>
		<span class="ml-auto text-sm text-zinc-500">
			{ fmt.Sprintf("Step %d of %d", step.Index()+1, len(models.OnboardingSteps)) }
		</span>
	</div>
}

templ welcomeHeading(icon templ.Component, title, subtitle string) {
	<div class="grid justify-items-center gap-3 text-center">
		@icon
		<h1 class="text-2xl font-(family-name:--font-biorhyme-expanded)">{ title }</h1>
		<p class="text-zinc-400 text-base">{ subtitle }</p>
	</div>
}

// welcomeFooter has the main button, a submit of the step's form (back is the
// arrow of welcomeProgress).
templ welcomeFooter(submit string) {
	<div class="grid">
		<button type="submit" data-step-submit class="btn-primary">{ submit }</button>
	</div>
}

templ welcomeSkip() {
	<p class="text-center text-sm text-zinc-500">
		Know your way around?
		<button
			type="button"
			hx-post="/welcome/finish"
			class="text-zinc-400 underline underline-offset-2 cursor-pointer hover:text-zinc-200"
		>Skip setup</button>
	</p>
}

templ welcomeRegion(d *WelcomeData) {
	if d.Suggest {
		<div
			hx-get={ welcomeURL(models.OnboardingRegion) }
			hx-vals="js:{tz: Intl.DateTimeFormat().resolvedOptions().timeZone, langs: (navigator.languages || [navigator.language]).join(',')}"
			hx-trigger="load"
			hx-target={ "#" + WelcomeTarget }
			hx-swap="innerHTML"
			class="h-96 rounded-3xl bg-zinc-700/20 ring-1 ring-zinc-800 animate-pulse"
		></div>
	} else {
		@components.GlassCard("p-6 sm:p-8 grid gap-6", "bg-violet-400/10") {
			@welcomeHeading(icons.Coins("32", &templ.Attributes{"class": "text-violet-400"}),
				"Welcome to tyche",
				"Pick the currency you mostly use. Totals, budgets and charts are shown in it, and new accounts start in it.")
			<form
				hx-post="/welcome/region"
				hx-target={ "#" + WelcomeTarget }
				hx-swap="innerHTML show:window:top"
				hx-disabled-elt="find [data-step-submit]"
				class="grid gap-5"
			>
				@form.Field("Main currency", "currency_id", "welcome", icons.Coins("15"), "") {
					@form.Combobox(form.ComboboxProps{
						Name: "currency_id", ID: "welcome", Label: "Main currency", Placeholder: "Currency",
						Options: form.CurrencyComboOptions(d.Currencies), Data: form.FDInput{Value: d.CurrencyID}, Searchable: true,
					})
				}
				<div class="grid gap-2" x-data>
					@form.Field("Time zone", "timezone", "welcome", icons.Clock("15"), "") {
						<input
							id="timezone-welcome"
							x-ref="tz"
							name="timezone"
							value={ d.Timezone }
							list="welcome-timezones"
							autocomplete="off"
							spellcheck="false"
							placeholder="Africa/Cairo"
							class="input-field"
						/>
					}
					<datalist id="welcome-timezones">
						for _, tz := range models.CommonTimezones {
							<option value={ tz }></option>
						}
					</datalist>
					<button
						type="button"
						@click="$refs.tz.value = Intl.DateTimeFormat().resolvedOptions().timeZone"
						class="justify-self-start text-sm text-zinc-500 cursor-pointer hover:text-zinc-300"
					>
						Use this device's time zone
					</button>
					<p class="text-sm text-zinc-500">The dates and times in your bank SMS are read in it.</p>
				</div>
				@form.ErrorMessage(d.RegionError)
				@welcomeFooter("Continue")
			</form>
			<p class="text-center text-sm text-zinc-500">You can change both later, in Settings.</p>
		}
		@welcomeSkip()
	}
}

templ welcomeAccounts(d *WelcomeData) {
	@components.GlassCard("p-6 sm:p-8 grid gap-6", "bg-emerald-400/10") {
		@welcomeHeading(icons.Wallet("32", &templ.Attributes{"class": "text-emerald-400"}),
			"Where's your money?",
			"Add the accounts you use and what each has today, so your balances start right.")
		<form
			hx-post="/welcome/balances"
			hx-target={ "#" + WelcomeTarget }
			hx-swap="innerHTML show:window:top"
			hx-disabled-elt="find [data-step-submit]"
			class="acc-form grid gap-5"
		>
			if len(d.Accounts) > 0 {
				<ul class="grid gap-2">
					for _, a := range d.Accounts {
						@welcomeBalanceRow(a)
					}
				</ul>
			}
			<fieldset x-data class="grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
				<legend class="px-1 text-sm font-semibold uppercase tracking-wider text-zinc-500">Add an account</legend>
				@selectAccKind("new_kind_id", "welcome", d.Kinds, d.NewAccount.KindID, nil)
				<div class="grid grid-cols-[1fr_8rem] gap-3">
					@form.Field("Name", "new_name", "welcome", icons.Pencil("15"), d.NewAccount.Name.Error) {
						@form.Control("text", "new_name", "e.g. CIB or Visa", "welcome", d.NewAccount.Name, addOnEnter)
					}
					@form.Field("Currency", "new_currency_id", "welcome", icons.Coins("15"), d.NewAccount.CurrencyID.Error) {
						@form.Combobox(form.ComboboxProps{
							Name: "new_currency_id", ID: "welcome", Label: "Currency", Placeholder: "Currency",
							Options: form.CurrencyComboOptions(d.ShownCurrencies), Data: d.NewAccount.CurrencyID, Searchable: true,
						})
					}
				</div>
				@form.Field("Balance today", "new_amount", "welcome", icons.Banknote("15"), d.NewAccount.Amount.Error) {
					@form.Control("text", "new_amount", "0.00", "welcome", d.NewAccount.Amount, templ.Attributes{
						"inputmode":              "decimal",
						"autocomplete":           "off",
						"x-data":                 true,
						"x-mask:dynamic":         "$money($input, '.', ',')",
						"@keydown.enter.prevent": addOnEnter["@keydown.enter.prevent"],
					})
				}
				<p class="-mt-2 text-sm text-zinc-500">For a credit card, what you owe on it. Card numbers and SMS references can be added on the Accounts page.</p>
				<button type="submit" id="welcome-add-account" hx-post="/welcome/accounts" hx-disabled-elt="this" class="justify-self-end btn-ghost ring-1 ring-zinc-700 inline-flex items-center gap-1.5">
					@icons.Plus("16")
					Add account
				</button>
			</fieldset>
			@form.ErrorMessage(d.AccountsError)
			@welcomeFooter("Continue")
		</form>
	}
	@welcomeSkip()
}

// addOnEnter adds the account on Enter in its fields, instead of submitting
// the step.
var addOnEnter = templ.Attributes{"@keydown.enter.prevent": "document.getElementById('welcome-add-account').click()"}

// welcomeBalanceRow edits an account's balance, what's owed for a credit
// card.
templ welcomeBalanceRow(a models.Account) {
	{{ id := "welcome-amount-" + a.ID }}
	<li class="flex items-center gap-3 p-3 rounded-2xl bg-zinc-800/30">
		<span class="shrink-0 text-zinc-400">
			@accKindIcon(a.Kind.Enum, "20")
		</span>
		<label for={ id } class="flex-1 min-w-0">
			<span class="block truncate text-zinc-200">{ a.Name }</span>
			<span class="block text-sm text-zinc-500">
				if a.Kind.Enum == models.AccKindCreditCard {
					Owed
				} else {
					Balance
				}
			</span>
		</label>
		<div class="flex items-center gap-2 w-40">
			<span class="text-sm text-zinc-500">{ a.Currency.Symbol }</span>
			<input
				id={ id }
				name={ "amount-" + a.ID }
				type="text"
				inputmode="decimal"
				autocomplete="off"
				value={ welcomeBalanceValue(a) }
				x-data
				x-mask:dynamic="$money($input, '.', ',')"
				class="input-field sensitive text-right tabular-nums"
			/>
		</div>
	</li>
}

func welcomeBalanceValue(a models.Account) string {
	return strconv.FormatFloat(math.Abs(a.Amount), 'f', 2, 64)
}

templ welcomeSecurity(d *WelcomeData) {
	if d.RecoveryCode != "" {
		@recoveryCodeCard(d.RecoveryCode, true)
		<button type="button" class="btn-primary" { welcomeNav(d.Step.Next())... }>I saved it, continue</button>
	} else if d.Encrypted {
		@components.GlassCard("p-6 sm:p-8 grid gap-6", "bg-violet-400/10") {
			@welcomeHeading(icons.ShieldCheck("32", &templ.Attributes{"class": "text-emerald-400"}),
				"Your data is encrypted",
				"Manage the password, recovery code, passkeys and unlocked browsers from Security in your menu.")
			<button type="button" class="btn-primary" { welcomeNav(d.Step.Next())... }>Continue</button>
		}
	} else {
		@components.GlassCard("p-6 sm:p-8 grid gap-6", "bg-violet-400/10") {
			@welcomeHeading(icons.Lock("32", &templ.Attributes{"class": "text-violet-400"}),
				"Encrypt your data with a password?",
				"Your database file will be unreadable without your password, even to whoever runs the server or has its backups. You'll enter it when you sign in, and every 12 hours you're away.")
			<p class="-mt-3 text-center text-zinc-500 text-sm">
				You get a recovery code in case you forget it. Lose both and your data is gone for good: nobody can recover it.
			</p>
			@encryptForm(true)
			<p class="text-center text-sm text-zinc-500">You can turn it on or off anytime from Security in your menu.</p>
		}
	}
}

// welcomeBadge turns the installed app's badge on (BadgeSwitches), or offers
// installing the app first: the badge is the installed app's.
templ welcomeBadge(d *WelcomeData) {
	@components.GlassCard("p-6 sm:p-8 grid gap-6", "bg-amber-400/10") {
		@welcomeHeading(icons.Bell("32", &templ.Attributes{"class": "text-amber-400"}),
			"Badge the app's icon?",
			"Tyche can count on its icon the SMS it couldn't read, the transactions to review and the overdue scheduled ones. It needs notifications, shown silently.")
		<div x-data="badgeSettings" class="grid gap-4">
			<template x-if="installed">
				<div class="grid gap-4">
					@BadgeSwitches()
				</div>
			</template>
			<div x-show="!installed" class="grid gap-4 text-center">
				<p class="text-zinc-400 text-base">
					The badge is for the installed app. Install Tyche, then turn it on from
					Settings, App badge, in the app.
				</p>
				<button
					type="button"
					x-data="{ can: canInstall() }"
					x-show="can"
					x-cloak
					@install-available.window="can = $event.detail"
					@click="installApp()"
					class="btn-ghost ring-1 ring-zinc-700 inline-flex items-center justify-center gap-2"
				>
					@icons.Download("16")
					Install app
				</button>
			</div>
		</div>
		<button type="button" class="btn-primary" { welcomeNav(d.Step.Next())... }>Continue</button>
	}
}

type welcomeNextStep struct {
	Href, Title, Text string
	Icon              templ.Component
}

func welcomeNextSteps() []welcomeNextStep {
	return []welcomeNextStep{
		{"/sms", "Forward your bank SMS", "Install the Android app: your bank's SMS become transactions on their own.", icons.Smartphone("20")},
		{"/transactions", "Add a transaction", "Log what you spend or earn by hand, or schedule what's coming.", icons.Transfer("20")},
		{"/categories", "Set budgets", "Give your categories a monthly budget to see how you're pacing.", icons.Tag("20")},
		{"/goals", "Save for a goal", "Put money aside for something and track how close you are.", icons.Target("20")},
	}
}

templ welcomeDone() {
	@components.GlassCard("p-6 sm:p-8 grid gap-6", "bg-sky-400/10") {
		@welcomeHeading(icons.Sparkles("32", &templ.Attributes{"class": "text-sky-400"}),
			"You're all set",
			"A few things worth doing next:")
		<ul class="grid gap-2">
			for _, s := range welcomeNextSteps() {
				<li>
					<a
						href={ templ.SafeURL(s.Href) }
						hx-post="/welcome/finish"
						hx-vals={ fmt.Sprintf(`{"next": %q}`, s.Href) }
						class="flex items-center gap-3 p-3 rounded-2xl bg-zinc-800/30 transition-colors hover:bg-zinc-800/60"
					>
						<span class="shrink-0 text-zinc-400">
							@s.Icon
						</span>
						<span class="flex-1 min-w-0">
							<span class="block text-zinc-200">{ s.Title }</span>
							<span class="block text-sm text-zinc-500">{ s.Text }</span>
						</span>
						@icons.ArrowRight("16", &templ.Attributes{"class": "shrink-0 text-zinc-500"})
					</a>
				</li>
			}
		</ul>
		<button type="button" class="btn-primary" hx-post="/welcome/finish">Go to the dashboard</button>
	}
}
