package components

import (
	"fmt"
	"strconv"
	"time"

	"github.com/omareloui/tyche/internal/formatters"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/icons"
)

// MerchantSpendingChart is a month's expenses per merchant as a ranked list
// of bars, most expensive first: the top ones, the rest behind "Show more".
// Each row opens the merchant's transactions of the month.
templ MerchantSpendingChart(ms *models.MerchantSpending) {
	<div id="merchant-spending">
		@GlassCard("grid content-start gap-4 p-5 sm:p-6", "bg-fuchsia-400/8") {
			<div class="flex items-center justify-between gap-4">
				<h2 class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-fuchsia-300">
					@icons.Tag("14")
					By merchant
				</h2>
				<div class="flex items-center gap-1 rounded-full bg-zinc-900/60 ring-1 ring-zinc-800 px-2 py-1 shrink-0">
					@monthNavButton(ms.Prev, "Previous month", "M3.828 7l4.95 4.95-1.414 1.414L1 7 7.364.636 8.778 2.05z")
					<span class="min-w-12 text-center" title={ ms.Period.RangeLabel() }>{ monthLabel(ms.Month) }</span>
					@monthNavButton(ms.Next, "Next month", "M6.172 7L1.222 2.05 2.636.636 9 7l-6.364 6.364-1.414-1.414z")
				</div>
			</div>
			if len(ms.Items) == 0 {
				<p class="py-10 text-center text-zinc-400">No merchant spending this month</p>
			} else {
				<p>
					<span class="sensitive text-2xl font-bold tabular-nums font-(family-name:--font-biorhyme-expanded)">{ ms.Currency.Format(ms.Total()) }</span>
					<span class="text-sm text-zinc-500">
						at { strconv.Itoa(len(ms.Items)) } { pluralWord(len(ms.Items), "merchant", "merchants") }
					</span>
				</p>
				<div x-data="{ all: false }" class="grid gap-1">
					<ul class="grid gap-1">
						for i, it := range ms.Items {
							if i < models.MerchantSpendingTop {
								<li>
									@merchantSpendLink(ms, it, i+1)
								</li>
							} else {
								<li x-show="all" x-cloak>
									@merchantSpendLink(ms, it, i+1)
								</li>
							}
						}
					</ul>
					if more := len(ms.Items) - models.MerchantSpendingTop; more > 0 {
						<button
							type="button"
							@click="all = !all"
							class="justify-self-start mt-1 px-2 py-1 rounded-lg text-sm text-sky-400 hover:text-sky-300 hover:bg-zinc-800/60 cursor-pointer"
						>
							<span x-show="!all">Show { strconv.Itoa(more) } more</span>
							<span x-show="all" x-cloak>Show less</span>
						</button>
					}
				</div>
			}
		}
	</div>
}

// merchantSpendLink is a merchant's row: its icon, name and share of the
// month, a bar in its brand color sized against the top merchant's, and
// what was spent.
templ merchantSpendLink(ms *models.MerchantSpending, it models.MerchantSpend, rank int) {
	{{ cp := it.Counterparty }}
	<a
		href={ templ.SafeURL(merchantTxsURL(ms, cp.ID)) }
		class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1.5 -mx-2 px-2 py-2 rounded-xl transition-colors hover:bg-zinc-800/50"
	>
		<span class="row-span-2">
			@CounterpartyIcon(cp.Name, cp.Icon, cp.Color, "w-9 h-9 text-sm")
		</span>
		<span class="flex items-baseline gap-2 min-w-0 text-sm">
			<span class="shrink-0 text-xs text-zinc-600 tabular-nums">{ strconv.Itoa(rank) }</span>
			<span class="truncate">{ cp.Name }</span>
		</span>
		<span class="sensitive text-right text-sm font-semibold tabular-nums">{ ms.Currency.Format(it.Amount) }</span>
		<span class="h-1.5 rounded-full bg-zinc-800/70">
			<span class="block h-full rounded-full" style={ merchantBarStyle(ms.BarPct(it.Amount), cp.Color) }></span>
		</span>
		<span class="w-10 text-right text-xs text-zinc-500 tabular-nums justify-self-end">{ fmt.Sprintf("%.0f%%", ms.Share(it.Amount)) }</span>
	</a>
}

func merchantTxsURL(ms *models.MerchantSpending, id string) string {
	return fmt.Sprintf("/transactions?%s=%s&%s=%s&%s=%s",
		models.TxFilterCounterparty, id,
		models.TxFilterFrom, ms.Period.From.Format(time.DateOnly),
		models.TxFilterTo, ms.Period.Last().Format(time.DateOnly))
}

func merchantBarStyle(pct float64, color string) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("width:%.2f%%;background-color:%s;", max(pct, 1.5), brandFill(color)))
}

func pluralWord(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}

templ monthNavButton(month, label, path string) {
	<button
		type="button"
		aria-label={ label }
		title={ label }
		class="p-1.5 rounded-full enabled:cursor-pointer enabled:hover:bg-zinc-700 disabled:opacity-30"
		if month == "" {
			disabled
		} else {
			hx-get={ "/merchant-spending?month=" + month }
			hx-target="#merchant-spending"
			hx-swap="outerHTML"
		}
	>
		<svg width="10" height="14" viewBox="0 0 10 14" fill="currentColor" aria-hidden="true">
			<path d={ path }></path>
		</svg>
	</button>
}

func monthLabel(month time.Time) string {
	if month.Year() == time.Now().Year() {
		return month.Format("Jan")
	}
	return month.Format("Jan 2006")
}

// CompactNum shortens axis labels, e.g. 2500 to 2.5k.
func CompactNum(n float64) string {
	switch {
	case n >= 1e6:
		return formatters.FormatNum(n/1e6) + "M"
	case n >= 1e3:
		return formatters.FormatNum(n/1e3) + "k"
	}
	return formatters.FormatNum(n)
}

func BottomPct(pct float64) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("bottom:%.2f%%;", pct))
}

func HeightPct(pct float64) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("height:%.2f%%;", pct))
}
