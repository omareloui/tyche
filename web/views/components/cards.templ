package components

type cardOpts struct {
	title     string
	icon      templ.Component
	menuItems []templ.Component
	isStale   bool
}

type cardOptsFunc func(o *cardOpts)

templ EntryCard(opts ...cardOptsFunc) {
	{{ o := getCardsOptions(opts) }}
	<div
		hx-target="this"
		hx-swap="outerHTML"
		class="relative"
		if len(o.menuItems) > 0 {
			x-data="{openMenu: false}"
			:class="{ 'z-30': openMenu }"
		}
	>
		if len(o.menuItems) > 0 {
			@EntryMenuAt("openMenu", "top-15 right-7 origin-top-right", o.menuItems)
		}
		<div
			class={
				"px-8 py-6 rounded-3xl",
				templ.KV("bg-zinc-700/20 ", !o.isStale),
				templ.KV("bg-zinc-400/20", o.isStale),
			}
		>
			if len(o.menuItems) > 0 && o.title != "" {
				<div class="flex justify-between gap-8">
					@cardTitle(o)
					@EntryMenuTrigger("openMenu", "Actions")
				</div>
			} else if o.title != "" {
				@cardTitle(o)
			} else if len(o.menuItems) > 0 {
				<div class="flex justify-end gap-8">
					@EntryMenuTrigger("openMenu", "Actions")
				</div>
			}
			{ children... }
		</div>
	</div>
}

templ cardTitle(o *cardOpts) {
	if o.icon != nil {
		<div class="flex items-center gap-3 mb-2 min-w-0">
			@o.icon
			<p class="text-2xl truncate">{ o.title }</p>
		</div>
	} else {
		<p class="text-2xl mb-2">{ o.title }</p>
	}
}

func WithCardIcon(icon templ.Component) cardOptsFunc {
	return func(o *cardOpts) {
		o.icon = icon
	}
}

func WithCardMenu(items []templ.Component) cardOptsFunc {
	return func(o *cardOpts) {
		o.menuItems = items
	}
}

func WithCardStale(stale bool) cardOptsFunc {
	return func(o *cardOpts) {
		o.isStale = stale
	}
}

func WithCardTitle(title string) cardOptsFunc {
	return func(o *cardOpts) {
		o.title = title
	}
}

func getCardsOptions(options []cardOptsFunc) *cardOpts {
	o := new(cardOpts)
	for _, fun := range options {
		fun(o)
	}
	return o
}
