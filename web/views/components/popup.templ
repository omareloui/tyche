package components

// PopupSurface is the translucent, blurred look of floating surfaces, for ones
// that can't use Popup itself (e.g. form.Combobox's panel, which needs its own
// attributes). Rounding is left to the caller.
const PopupSurface = "border border-white/10 bg-zinc-800/40 text-zinc-100 shadow-lg backdrop-blur-md"

// Popup is the shared floating surface (translucent, blurred box) for menus,
// hover cards and the like. Positioning and visibility are up to the caller;
// class adds to the base styles (padding, width, typography, ...).
templ Popup(class string) {
	<div class={ PopupSurface, "rounded-lg", class }>
		{ children... }
	</div>
}

// HoverPopup shows a Popup below-right of the closest `group/popup` ancestor
// while it is hovered or focused (a named group, so an outer `group`, e.g. a
// details of the list, doesn't show it), scaling in from its top-right corner (same timing
// as Alpine's x-transition.scale). The ancestor needs `relative` positioning.
// main.js shifts it back into the viewport when it would overflow (phones).
templ HoverPopup(class string) {
	<div
		data-hover-popup
		class={
			"absolute top-full right-0 z-20 pt-2 origin-top-right",
			"invisible scale-95 transition-[scale,visibility] duration-75 ease-in",
			"group-hover/popup:visible group-hover/popup:scale-100 group-hover/popup:duration-150 group-hover/popup:ease-out",
			"group-focus-within/popup:visible group-focus-within/popup:scale-100 group-focus-within/popup:duration-150 group-focus-within/popup:ease-out",
		}
	>
		@Popup(class) {
			{ children... }
		}
	</div>
}
