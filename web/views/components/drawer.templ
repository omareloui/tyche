package components

import "github.com/omareloui/tyche/web/views/icons"

// DrawerSlot is where drawers fetched on demand (e.g. an entry's edit form,
// hx-target="#drawer") open.
const DrawerSlot = "drawer"

type DrawerProps struct {
	Label string
	// XData is the drawer's Alpine component: "drawer" (the default) or one
	// built on drawerBase (drawer.js), e.g. the transaction details.
	XData string
	// PanelID is the id of the content swapped in place, if any.
	PanelID string
	// Bind, for a drawer kept in the page (e.g. a create form), is the Alpine
	// variable showing it, e.g. openCreateForm. Empty for one swapped in (into
	// #drawer), removed on closing.
	Bind string
	// Attrs go on the drawer's root, e.g. a data attribute to find it by.
	Attrs templ.Attributes
	// URLParam and URLValue, for a details drawer, are kept in the page's url
	// while it's open (e.g. ?cp=<id>), so reloading opens it again
	// (DrawerOnLoad). The param must be in drawer.js' DRAWER_URL_PARAMS.
	URLParam, URLValue string
}

// DrawerOnLoad opens the drawer url answers with as the page loads, e.g. the
// details its ?cp= asks for; nothing for an empty url.
templ DrawerOnLoad(url string) {
	if url != "" {
		<div hx-get={ url } hx-trigger="load" hx-target={ "#" + DrawerSlot } hx-swap="innerHTML" class="hidden"></div>
	}
}

// Drawer is the panel the add and edit forms (and the transaction details)
// open in: from the right on wide screens, a bottom sheet on phones. Escape,
// clicking outside and swiping the sheet down close it, asking first when its form has changes;
// a drawer-saved event (HX-Trigger of a form's answer) closes it.
templ Drawer(p DrawerProps) {
	<div
		if p.XData != "" {
			x-data={ p.XData }
		} else {
			x-data="drawer"
		}
		data-drawer
		if p.Attrs != nil {
			{ p.Attrs... }
		}
		if p.URLParam != "" {
			data-url-param={ p.URLParam }
			data-url-value={ p.URLValue }
		}
		if p.Bind != "" {
			data-drawer-static
			x-modelable="shown"
			x-model={ p.Bind }
			x-show="shown"
			x-cloak
		}
		@keyup.escape.window="escape($event)"
		@drawer-saved="saved()"
		class="drawer-root fixed inset-0 z-55 flex items-end sm:items-stretch sm:justify-end"
	>
		<div class="drawer-backdrop absolute inset-0 bg-zinc-950/60 backdrop-blur-sm" @click="backdrop()"></div>
		<aside
			role="dialog"
			aria-modal="true"
			aria-label={ p.Label }
			class="drawer-sheet relative flex flex-col w-full sm:w-[32rem] max-h-[92dvh] sm:max-h-none sm:h-dvh rounded-t-3xl sm:rounded-none sm:rounded-l-3xl bg-zinc-900 ring-1 ring-zinc-800 shadow-2xl shadow-black/50"
			@touchstart="dragStart($event)"
			@touchmove="dragMove($event)"
			@touchend="dragEnd()"
			@touchcancel="dragEnd()"
		>
			// The handle hints the sheet can be swiped down (phones).
			<div aria-hidden="true" class="sm:hidden absolute top-2 left-1/2 -translate-x-1/2 w-10 h-1 rounded-full bg-zinc-700"></div>
			if p.PanelID != "" {
				<div id={ p.PanelID } class="contents">
					{ children... }
				</div>
			} else {
				{ children... }
			}
		</aside>
	</div>
}

// DrawerClose closes the drawer it's in (asking first if its form changed).
templ DrawerClose() {
	<button
		type="button"
		x-ref="close"
		@click="requestClose()"
		aria-label="Close"
		class="grid place-items-center shrink-0 w-9 h-9 -mr-2 rounded-full text-zinc-400 cursor-pointer transition-colors hover:bg-zinc-800 hover:text-white"
	>
		@icons.X("20")
	</button>
}
