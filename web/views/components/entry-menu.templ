package components

import "strings"

type entryMenuItemOpts struct {
	classes        []string
	confirmMessage string
}

type entryMenuItemOptsFunc func(o *entryMenuItemOpts)

templ EntryMenuAnchorItem(label string, action string, url string, opts ...entryMenuItemOptsFunc) {
	{{ o := getEntryMenuItemOptions(opts) }}
	<a
		class={
			"block transition-transform hover:translate-x-0.5",
			strings.Join(o.classes, " "),
		}
		{ "hx-" + action }={ url }
		hx-swap="outerHTML"
		if o.confirmMessage != "" {
			hx-confirm={ o.confirmMessage }
		}
	>
		{ label }
	</a>
}

templ EntryMenuDeleteItem(url string, opts ...entryMenuItemOptsFunc) {
	@EntryMenuAnchorItem("Delete", "delete", url,
		WithEntryMenuItemConfirmMessage("Are you sure you want to delete this entry?"),
		WithEntryMenuItemClasses("text-red-400"),
	)
}

templ EntryMenu(showKey string, entries []templ.Component) {
	<div
		x-cloak
		x-show={ showKey }
		@click.away={ showKey + " = false" }
		x-transition
		class="absolute z-1 -top-8 right-8 bg-zinc-400/20 rounded-lg backdrop-blur-sm"
	>
		<ul class="py-2 min-w-28">
			for _, entry := range entries {
				<li class="transition-colors hover:bg-zinc-500/20 px-4 cursor-pointer">
					@entry
				</li>
			}
		</ul>
	</div>
}

func WithEntryMenuItemClasses(classes ...string) entryMenuItemOptsFunc {
	return func(o *entryMenuItemOpts) {
		o.classes = classes
	}
}

func WithEntryMenuItemConfirmMessage(message string) entryMenuItemOptsFunc {
	return func(o *entryMenuItemOpts) {
		o.confirmMessage = message
	}
}

func getEntryMenuItemOptions(options []entryMenuItemOptsFunc) *entryMenuItemOpts {
	o := new(entryMenuItemOpts)
	for _, fun := range options {
		fun(o)
	}
	return o
}
