package views

import "fmt"

templ container() {
	<div class="lg:max-w-screen-lg md:max-w-screen-md px-5 mx-auto max-w-full">
		{ children... }
	</div>
}

templ mainHeader(text string) {
	<h1 class="text-3xl font-bold mb-3 text-center">{ text }</h1>
}

templ link(href templ.SafeURL, text string) {
	<a href={ href } class="text font-bold text-blue-500 rounded-sm focus:ring focus:ring-blue-300 focus:outline-none">
		{ text }
	</a>
}

templ navlink(href templ.SafeURL, attrs ...templ.Attributes) {
	<a
		href={ href }
		class="text-sm font-bold text-blue-500 rounded-sm focus:ring focus:ring-blue-300 focus:outline-none"
		if attrs != nil {
			{ attrs[0]... }
		}
	>{ string(href) }</a>
}

templ list(id string) {
	<div id={ id } class="grid gap-4 no-entries">
		{ children... }
	</div>
}

templ button(color string, attrs ...templ.Attributes) {
	<button
		class={ fmt.Sprintf("px-5 py-2.5 my-2 text-white bg-%s-500 hover:bg-%s-600 focus:outline-none focus:ring-4 focus:ring-%s-300 font-medium rounded-lg text-sm sm:w-auto text-center", color, color, color) }
		if attrs != nil {
			{ attrs[0]... }
		}
	>
		{ children... }
	</button>
}
