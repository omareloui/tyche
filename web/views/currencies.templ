package views

import (
	"fmt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/web/views/layouts"
	"github.com/omareloui/tyche/web/views/components"
	"strings"
	"github.com/omareloui/tyche/internal/formatters"
)

templ Currencies(claims *jwt.AccessClaims, balances []models.Balance, currencies []models.Currency) {
	@layouts.Main(claims, "Currencies", balances, &layouts.Opts{
		IncludeAlpine: true,
	}) {
		@components.Container() {
			@mainHeader("Currencies")
			@currenciesList(currencies, &claims.DefaultCurrency)
		}
	}
}

templ currenciesList(currencies []models.Currency, defaultCur *models.Currency) {
	<div id="currencies-list" class="grid lg:grid-cols-3 grid-cols-2 gap-4 no-entries">
		for _, cur := range currencies {
			@Currency(&cur, defaultCur)
		}
	</div>
}

templ Currency(cur *models.Currency, defaultCur *models.Currency) {
	<div hx-target="this" class="relative" x-data="{openMenu: false}">
		if defaultCur != nil {
			if cur.ID != defaultCur.ID {
				@components.EntryMenu("openMenu", []templ.Component{
					components.EntryMenuAnchorItem("Set as Default", "put", fmt.Sprintf("/currencies/%s/set-default", cur.ID)),
				})
			} else {
				<div class="absolute -z-1 top-0 left-0 w-6 h-full bg-green-600 text-xs rounded-lg"></div>
			}
		}
		<div
			class={
				"entry-container flex flex-col justify-between place gap-4",
				templ.KV("backdrop-blur-xl", defaultCur != nil && cur.ID == defaultCur.ID),
			}
		>
			<div class="flex justify-between gap-8">
				<div class="flex place-items-center text-xl">
					<img
						src={ fmt.Sprintf("/icons/currency-kind-%s.svg", strings.ToLower(string(cur.Kind))) }
						alt={ cur.Kind.String() }
						class="w-6 h-6 mr-4"
					/>
					<p class="mr-2">{ cur.String }</p>
					<p class="text-zinc-400">{ cur.Symbol }</p>
				</div>
				if defaultCur != nil && cur.ID != defaultCur.ID {
					<div class="flex text-xl place-items-center gap-4">
						if cur.IsShown {
							<a
								hx-put={ fmt.Sprintf("/currencies/%s/hide", cur.ID) }
								hx-swap="outerHTML"
								class="cursor-pointer inline-block w-6 h-6"
							>
								<img src="/icons/show.svg" class="w-6 h-6"/>
							</a>
						} else {
							<a
								hx-put={ fmt.Sprintf("/currencies/%s/show", cur.ID) }
								hx-swap="outerHTML"
								class="cursor-pointer inline-block w-6 h-6"
							>
								<img src="/icons/hide.svg" class="w-6 h-6"/>
							</a>
						}
						<button
							@click="openMenu = !openMenu"
							class="cursor-pointer inline-block w-6 h-6"
						>
							<img src="/icons/dots-menu.svg" class="w-6 h-6"/>
						</button>
					</div>
				}
			</div>
			<hr class="border-2 border-t border-zinc-800 w-3/4 self-center"/>
			<div class="flex gap-2 place-items-center place-content-center">
				<img src="/icons/fx-rate.svg" class="w-4 h-4"/>
				<p class="text-zinc-400">{ formatters.FormatAmount(cur.FxRate(defaultCur.String), defaultCur.Symbol) }</p>
			</div>
		</div>
	</div>
}
