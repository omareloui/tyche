package views

import (
	"fmt"
	"time"
	"strconv"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
)

type FrequencyFD struct {
	IsFrequent FDInput
	FrequentBy FDInput
	Frequency  FDInput
	StopsOn    FDInput
}

type FrequentTxFD struct {
	FrequencyFD
	TransactionAmountsAndKindFD
	Description FDInput
}

templ FrequentTxs(claims *jwt.AccessClaims, balances []models.Balance, ftxs []models.FrequentTx) {
	@baseLayout(claims, "Frequent Transactions", balances, &layoutOpts{includeAlpine: true, includeAlpineCollapse: true}) {
		@container() {
			@mainHeader("Frequent Transactions")
			@ftxsList(ftxs)
		}
	}
}

templ FrequencyFormBody(id string, fd *FrequencyFD) {
	<div data-frequency-form class="grid gap-2">
		@checkbox("Is Frequent", "is_frequent", id, fd.IsFrequent,
			templ.Attributes{
				"hx-post":    fmt.Sprintf("/frequency-form/%s", id),
				"hx-trigger": "change",
				"hx-target":  "closest [data-frequency-form]",
				"hx-swap":    "outerHTML",
				"hx-sync":    "closest form:abort",
			})
		if fd.IsFrequent.Value != "" {
			@frequencyFormBody(id, fd)
		}
	</div>
}

templ frequencyFormBody(id string, fd *FrequencyFD) {
	<div class="grid grid-cols-3 gap-4">
		@input("Frequency", "number", "frequency", "Frequent every...", id, fd.Frequency)
		@selectInput("Frequent By", "frequent_by", "How frequent", id, models.FrequencyByOptions(), fd.FrequentBy, false)
		@dateInput("Stops on", "stops_on", id, fd.StopsOn)
	</div>
}

templ ftxFormBody(id string, fd *FrequentTxFD, accs []models.Account, knds []models.TransactionKind, cats []models.Category, cps []models.Counterparty, isSwitched bool) {
	@TransactionAmountsAndKindFormBody(&fd.TransactionAmountsAndKindFD, id, knds, cats, accs, cps)
	@input("Description", "text", "description", "Enter a description", id, fd.Description)
	@frequencyFormBody(id, &fd.FrequencyFD)
}

templ FrequentTransactionOOB(ftx *models.FrequentTx) {
	<div id="tx-list" hx-swap-oob="afterbegin">
		@FrequentTx(ftx)
	</div>
}

templ EditFrequentTx(
	ftx *models.FrequentTx, fd *FrequentTxFD,
	accs []models.Account, knds []models.TransactionKind,
	cats []models.Category, cps []models.Counterparty,
	isSwitched bool) {
	@form("put", fmt.Sprintf("/frequent-tx/%s", ftx.ID), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { ftx.ID }</p>
		@ftxFormBody(ftx.ID, fd, accs, knds, cats, cps, isSwitched)
		@editFormButtons(fmt.Sprintf("/frequent-tx/%s", ftx.ID))
	}
}

templ ftxsList(frequentTx []models.FrequentTx) {
	@list("tx-list") {
		for _, t := range frequentTx {
			@FrequentTx(&t)
		}
	}
}

templ FrequentTx(ftx *models.FrequentTx) {
	<div hx-target="this" class="entry-container">
		<p>ID: { ftx.ID }</p>
		<p>Account: { ftx.Account.Name }</p>
		<p>Amount: { ftx.ViewAmount() }</p>
		if ftx.ToAccount != nil {
			<p>To Account: { ftx.ToAccount.Name }</p>
			<p>To Amount: { ftx.ViewToAmount() }</p>
		}
		<p>Kind: { ftx.Kind.Enum.String() }</p>
		if ftx.Description != "" {
			<p>Description: { ftx.Description }</p>
		}
		if ftx.Category != nil {
			<p>Category ID: { ftx.Category.ID }</p>
			<p>Category Name: { ftx.Category.Name }</p>
		}
		if ftx.Counterparty != nil {
			<p>Counterparty ID: { ftx.Counterparty.ID }</p>
			<p>Counterparty Name: { ftx.Counterparty.Name }</p>
		}
		<p>Frequency: { strconv.FormatUint(uint64(ftx.Frequency), 10) }</p>
		<p>Frequency By: { ftx.FrequencyBy.String() }</p>
		<p>Starts At: { ftx.StartsAt.Format(time.RFC1123Z) }</p>
		if !ftx.StopsAt.IsZero() {
			<p>Stops At: { ftx.StopsAt.Format(time.RFC1123Z) }</p>
		}
		<p>Last Transaction Created At: { ftx.LastTransactionScheduledTo.Format(time.RFC1123Z) }</p>
		<p>Created At: { ftx.CreatedAt.Format(time.RFC1123Z) }</p>
		<div class="flex gap-4">
			@postButton(fmt.Sprintf("Generate Transactions"), fmt.Sprintf("/frequent-tx/%s/generate-txs", ftx.ID))
			@editButton(fmt.Sprintf("/frequent-tx/%s/edit", ftx.ID))
			@deleteButton(fmt.Sprintf("/frequent-tx/%s", ftx.ID))
		</div>
	</div>
}
