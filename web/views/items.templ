package views

import (
	"fmt"

	"github.com/omareloui/financial-planner/internal/models"
)

type ItemFD struct {
	Name FDInput
	AmountFD
}

templ Items(
	balances []models.Balance,
	fd *ItemFD,
	items []models.Item,
	curs []models.Currency) {
	@baseLayout("Items", balances) {
		@container() {
			@mainHeader("Items")
			@CreateItemForm(fd, curs)
			@itemsList(items)
		}
	}
}

templ CreateItemForm(fd *ItemFD, curs []models.Currency) {
	@creationForm("Create Item", "/items", "Create Item") {
		@itemFormBody(fd, "", curs)
	}
}

templ EditItem(fd *ItemFD, id string, curs []models.Currency) {
	@form("put", fmt.Sprintf("/items/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@itemFormBody(fd, id, curs)
		@editFormButtons(fmt.Sprintf("/items/%s", id))
	}
}

templ itemFormBody(fd *ItemFD, id string, curs []models.Currency) {
	@input("Name", "text", "name", "Enter item name", "", fd.Name)
	@AmountInputs(&fd.AmountFD, id, curs)
}

templ itemsList(items []models.Item) {
	@list("items-list") {
		for _, it := range items {
			@Item(&it)
		}
	}
}

templ Item(it *models.Item) {
	<div hx-target="this" class="entry-container">
		<p>ID: { it.ID }</p>
		<p>Name: { it.Name }</p>
		<p>
			Price:
			@itemPrice(it)
		</p>
		<div class="flex gap-4">
			@editButton(fmt.Sprintf("/items/%s/edit", it.ID))
			@deleteButton(fmt.Sprintf("/items/%s", it.ID))
		</div>
	</div>
}

templ itemPrice(it *models.Item) {
	{ it.ViewPrice() }
	if it.Currency.Enum != models.CurrencyEgp {
		<i class="text-gray-400">[{ it.ViewEgpPrice() }]</i>
	}
}

templ ItemOOB(it *models.Item) {
	<div id="items-list" hx-swap-oob="afterbegin">
		@Item(it)
	</div>
}
