package views

import (
	"fmt"
	"time"

	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/internal/markdown"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/tzctx"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
	"github.com/omareloui/tyche/web/views/layouts"
)

// TagDetailsParam is the tags page's query param holding the tag whose
// details are open.
const TagDetailsParam = "tg"

// TagsChangedEvent re-renders the tags list (HX-Trigger).
const TagsChangedEvent = "tags-changed"

func tagDetailsURL(id string) string { return fmt.Sprintf("/tags/%s/details", id) }

func tagDetailsURLIf(id string) string {
	if id == "" {
		return ""
	}
	return tagDetailsURL(id)
}

// TagTxsURL lists the tag's transactions.
func TagTxsURL(id string) string { return "/transactions?" + models.TxFilterTag + "=" + id }

// TagFD is a tag's form.
type TagFD struct {
	Name, Color, StartsOn, EndsOn, AutoTag, Note form.FDInput
	Budget                                       *form.AmountFD
	// Error is what went wrong apart from a field.
	Error string
}

// TagsData is the tags page's list: every tag's summary, live ones then
// archived.
type TagsData struct {
	Live, Archived []*models.TagSummary
	Def            *models.Currency
	Hero           *models.TagsHero
	Today          time.Time
}

templ Tags(claims *jwt.AccessClaims, balances []models.Balance, fd *TagFD, curs []models.Currency, d *TagsData, openID string) {
	@layouts.WithCreateForm(claims, "Tags", "New tag", balances, CreateTagForm(fd, curs, &claims.DefaultCurrency)) {
		@TagsList(d)
		@components.DrawerOnLoad(tagDetailsURLIf(openID))
	}
}

// TagsList is every tag's card, re-rendered on TagsChangedEvent.
templ TagsList(d *TagsData) {
	<div
		id="tags"
		hx-get="/tags/list"
		hx-trigger={ TagsChangedEvent + " from:body" }
		hx-swap="outerHTML"
		class="grid gap-8"
	>
		if len(d.Live) == 0 && len(d.Archived) == 0 {
			<div class="grid place-items-center gap-3 py-16 text-center text-zinc-400">
				@icons.Tag("32", &templ.Attributes{"class": "text-zinc-600"})
				<p>No tags yet. Add one, e.g. your next trip.</p>
			</div>
		}
		if len(d.Live) > 0 || len(d.Archived) > 0 {
			@tagsHero(d)
		}
		if len(d.Live) > 0 {
			<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
				for _, s := range d.Live {
					@tagCard(s)
				}
			</div>
		}
		if len(d.Archived) > 0 {
			<details class="group">
				<summary class="flex items-center gap-2 cursor-pointer text-sm font-semibold uppercase tracking-wider text-zinc-500 list-none">
					@icons.ChevronDown("16", &templ.Attributes{"class": "-rotate-90 group-open:rotate-0 transition-transform"})
					Archived · { fmt.Sprint(len(d.Archived)) }
				</summary>
				<div class="grid gap-4 mt-4 sm:grid-cols-2 xl:grid-cols-3 opacity-80">
					for _, s := range d.Archived {
						@tagCard(s)
					}
				</div>
			</details>
		}
	</div>
}

// tagsHero sums the tags up: what they spent this month and on which, the
// trips on now or next, and the budgets.
templ tagsHero(d *TagsData) {
	{{ h := d.Hero }}
	@components.GlassCard("grid content-start gap-5 p-5 sm:p-6", "bg-sky-400/10", "bg-fuchsia-400/10") {
		<div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
			<h2 class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-sky-300">
				@icons.Tag("14")
				Tagged this month
				<span class="font-normal normal-case tracking-normal text-zinc-500">· { h.Period.RangeLabel() }</span>
			</h2>
			<span class="text-xs text-zinc-500">{ fmt.Sprint(h.Live) } { plural(h.Live, "tag", "tags") }</span>
		</div>
		<p>
			<span class="sensitive text-2xl font-bold tabular-nums font-(family-name:--font-biorhyme-expanded)">{ d.Def.Format(h.Spent) }</span>
			<span class="text-sm text-zinc-500">
				if len(h.ByTag) == 0 {
					nothing tagged spent yet
				} else {
					over { fmt.Sprint(len(h.ByTag)) } { plural(len(h.ByTag), "tag", "tags") }
				}
			</span>
		</p>
		if len(h.OnNow) > 0 || h.Next != nil {
			<div class="flex flex-wrap gap-2">
				for _, s := range h.OnNow {
					@tagHeroTrip(s, "On now", tagDays(&s.Tag))
				}
				if h.Next != nil {
					@tagHeroTrip(h.Next, tagInDays(h.DaysUntil(d.Today)), tagDays(&h.Next.Tag))
				}
			</div>
		}
		if top := h.Top(models.TagHeroTop); len(top) > 0 {
			@budgetCollapse("tags-top", budgetSummaryTitle("Most spent on")) {
				<ul class="grid gap-1 mt-2">
					for _, ts := range top {
						<li>
							@tagHeroRow(ts.Summary, d.Def.Format(ts.Amount), pctLabel(ts.Amount, h.Spent), barPct(ts.Amount, top[0].Amount), ts.Summary.Tag.Hex())
						</li>
					}
				</ul>
			}
		}
		if len(h.Budgets) > 0 {
			@budgetCollapse("tags-budgets", budgetSummaryTitle("Budgets, all time")) {
				<ul class="grid gap-1 mt-2">
					for _, s := range h.Budgets {
						{{ color := s.Tag.Hex() }}
						if s.OverBudget() {
							{{ color = "#f87171" }}
						}
						<li>
							@tagHeroRow(s, d.Def.Format(s.Spent)+" of "+d.Def.Format(s.Budget), pctLabel(s.Spent, s.Budget), barPct(min(s.Spent, s.Budget), s.Budget), color)
						</li>
					}
				</ul>
			}
		}
		<p class="text-xs text-zinc-500">
			In your main currency at today's rates; a transaction with several tags counts in each.
		</p>
	}
}

// tagHeroTrip is a trip's pill: when, its name and days, opening its
// details.
templ tagHeroTrip(s *models.TagSummary, when, days string) {
	<button
		type="button"
		hx-get={ tagDetailsURL(s.Tag.ID) }
		hx-target={ "#" + components.DrawerSlot }
		hx-swap="innerHTML"
		title={ days }
		class="flex items-center gap-2 max-w-full rounded-full px-3 py-1.5 text-sm cursor-pointer ring-1 ring-zinc-700/70 bg-zinc-800/40 transition-colors hover:bg-zinc-800"
	>
		<span class="size-2 shrink-0 rounded-full" style={ "background-color:" + s.Tag.Hex() }></span>
		<span class="shrink-0 text-xs text-zinc-400">{ when }</span>
		<span class="truncate font-medium">{ s.Tag.Name }</span>
	</button>
}

// tagHeroRow is a tag's line in the hero: its name, amount and share, and a
// bar, opening its details.
templ tagHeroRow(s *models.TagSummary, amount, pct, width, hex string) {
	<button
		type="button"
		hx-get={ tagDetailsURL(s.Tag.ID) }
		hx-target={ "#" + components.DrawerSlot }
		hx-swap="innerHTML"
		class="grid gap-1.5 w-full px-2 py-1.5 rounded-lg text-left cursor-pointer transition-colors hover:bg-zinc-800/60"
	>
		<span class="flex items-center gap-2 min-w-0 text-sm">
			<span class="size-2 shrink-0 rounded-full" style={ "background-color:" + s.Tag.Hex() }></span>
			<span class="flex-1 min-w-0 truncate">{ s.Tag.Name }</span>
			<span class="sensitive shrink-0 tabular-nums">{ amount }</span>
			<span class="shrink-0 w-10 text-right text-xs text-zinc-500 tabular-nums">{ pct }</span>
		</span>
		<span class="h-1.5 rounded-full bg-zinc-800 overflow-hidden">
			<span class="block h-full rounded-full" style={ fmt.Sprintf("width:%s;background-color:%s", width, hex) }></span>
		</span>
	</button>
}

func pctLabel(part, whole float64) string {
	return fmt.Sprintf("%.0f%%", pctOf(part, whole))
}

// tagInDays is when a trip starts, e.g. "Tomorrow", "In 5 days".
func tagInDays(n int) string {
	if n <= 1 {
		return "Tomorrow"
	}
	return fmt.Sprintf("In %d days", n)
}

// tagDays is a trip's days, e.g. "Mar 3 – Mar 12, 2026 · 10 days".
func tagDays(t *models.Tag) string {
	if !t.IsTrip() {
		return ""
	}
	from, to := *t.StartsOn, *t.EndsOn
	var s string
	switch {
	case from.Equal(to):
		s = from.Format("Jan 2, 2006")
	case from.Year() == to.Year():
		s = from.Format("Jan 2") + " – " + to.Format("Jan 2, 2006")
	default:
		s = from.Format("Jan 2, 2006") + " – " + to.Format("Jan 2, 2006")
	}
	return fmt.Sprintf("%s · %d %s", s, t.Days(), plural(t.Days(), "day", "days"))
}

// tagState is where a trip is against today: upcoming, on now or over.
func tagState(t *models.Tag, today time.Time) string {
	switch {
	case !t.IsTrip():
		return ""
	case today.Before(*t.StartsOn):
		return "Upcoming"
	case today.After(*t.EndsOn):
		return ""
	default:
		return "On now"
	}
}

templ tagCard(s *models.TagSummary) {
	{{ t := &s.Tag }}
	<button
		type="button"
		hx-get={ tagDetailsURL(t.ID) }
		hx-target={ "#" + components.DrawerSlot }
		hx-swap="innerHTML"
		class="text-left cursor-pointer rounded-3xl transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-(--accent)"
	>
		@components.GlassCard("grid gap-4 p-5") {
			<div class="flex items-start gap-3">
				<div class="grid place-items-center shrink-0 w-10 h-10 rounded-xl" style={ fmt.Sprintf("color: %s; background-color: %s26", t.Hex(), t.Hex()) }>
					@icons.Tag("18")
				</div>
				<div class="flex-1 min-w-0">
					<p class="font-semibold truncate">{ t.Name }</p>
					<p class="text-xs text-zinc-400 truncate">
						if d := tagDays(t); d != "" {
							{ d }
						} else {
							{ fmt.Sprint(t.Txs) } { plural(t.Txs, "transaction", "transactions") }
						}
					</p>
				</div>
				if st := tagState(t, tzctx.Today(ctx)); st != "" {
					<span class="chip bg-emerald-400/10 text-emerald-300">{ st }</span>
				}
				if t.AutoTag && !t.IsArchived() {
					<span class="chip" title="Tags new transactions dated in its days">
						@icons.Zap("12")
						Auto
					</span>
				}
			</div>
			<div>
				<p class="text-xs text-zinc-500">Spent</p>
				<p class="sensitive text-2xl font-semibold tabular-nums">{ s.Currency.Format(s.Spent) }</p>
				if len(s.ByCurrency) > 1 {
					<p class="sensitive text-xs text-zinc-500 tabular-nums truncate">{ tagCurrencies(s) }</p>
				}
			</div>
			if s.Budget > 0 {
				@tagBudgetBar(s)
			}
			if top := s.TopCategories(models.TagTopCategories); len(top) > 0 {
				<div class="flex flex-wrap gap-1.5">
					for _, c := range top {
						<span class="chip max-w-40">
							if c.Category != nil {
								@categoryDot(c.Category.Color)
								<span class="truncate">{ c.Category.Name }</span>
							} else {
								<span class="truncate">Uncategorized</span>
							}
							<span class="sensitive text-zinc-500 tabular-nums">{ fmt.Sprintf("%.0f%%", pctOf(c.Amount, s.Spent)) }</span>
						</span>
					}
				</div>
			}
		}
	</button>
}

func pctOf(part, whole float64) float64 {
	if whole <= 0 {
		return 0
	}
	return part / whole * 100
}

// tagCurrencies is what a tag spent in each currency, e.g. "AED 1,200 · EGP
// 3,000".
func tagCurrencies(s *models.TagSummary) string {
	out := ""
	for i, c := range s.ByCurrency {
		if i > 0 {
			out += " · "
		}
		out += c.Currency.Format(c.Amount)
	}
	return out
}

templ tagBudgetBar(s *models.TagSummary) {
	{{ used := s.BudgetUsed() }}
	<div>
		<div class="h-2 rounded-full bg-zinc-800 overflow-hidden">
			<div
				class={ "h-full rounded-full", templ.KV("bg-red-400", s.OverBudget()), templ.KV("bg-(--accent)", !s.OverBudget()) }
				style={ fmt.Sprintf("width: %.1f%%", min(used, 1)*100) }
			></div>
		</div>
		<p class="sensitive mt-1.5 text-xs text-zinc-500 tabular-nums">
			{ fmt.Sprintf("%.0f%%", used*100) } of { s.Currency.Format(s.Budget) }
			if s.OverBudget() {
				· <span class="text-red-300">{ s.Currency.Format(s.Spent - s.Budget) } over</span>
			} else {
				· { s.Currency.Format(s.Budget - s.Spent) } left
			}
		</p>
	</div>
}

// TagDetails is a tag in full, in a drawer: what it spent per category, day
// and currency, and its actions.
templ TagDetails(s *models.TagSummary, m *models.TagMonth) {
	{{ t := &s.Tag }}
	{{ slot := "#" + components.DrawerSlot }}
	@components.Drawer(components.DrawerProps{Label: t.Name + " details", URLParam: TagDetailsParam, URLValue: t.ID}) {
		<div class="drawer-panel flex flex-col flex-1 min-h-0">
			<header class="flex items-start gap-3 px-5 sm:px-6 pt-5 pb-4">
				<div class="grid place-items-center shrink-0 w-11 h-11 rounded-xl" style={ fmt.Sprintf("color: %s; background-color: %s26", t.Hex(), t.Hex()) }>
					@icons.Tag("20")
				</div>
				<div class="flex-1 min-w-0">
					<h2 class="text-lg font-bold leading-snug break-words">{ t.Name }</h2>
					<p class="text-sm text-zinc-400 truncate">
						if d := tagDays(t); d != "" {
							Trip · { d }
						} else {
							Tag
						}
						if t.IsArchived() {
							· Archived
						}
					</p>
				</div>
				@components.DrawerClose()
			</header>
			<div class="flex-1 grid grid-cols-1 auto-rows-max content-start gap-6 px-5 sm:px-6 pb-6 overflow-y-auto overscroll-contain">
				<div class="grid gap-3">
					<div>
						<p class="sensitive text-3xl font-semibold font-(family-name:--font-biorhyme-expanded) tabular-nums break-words">{ s.Currency.Format(s.Spent) }</p>
						<p class="text-sm text-zinc-500">
							Spent over { fmt.Sprint(t.Txs) } { plural(t.Txs, "transaction", "transactions") }, refunds and reimbursements netted
							if s.Partial {
								· some currencies without a rate left out
							}
						</p>
					</div>
					if s.Budget > 0 {
						@tagBudgetBar(s)
					}
				</div>
				<div class="flex flex-wrap gap-2">
					<a href={ templ.SafeURL(TagTxsURL(t.ID)) } class="txd-action">
						@icons.Receipt("14")
						Transactions
					</a>
					if t.IsTrip() && !t.IsArchived() {
						<button type="button" hx-get={ fmt.Sprintf("/tags/%s/range", t.ID) } hx-target={ slot } hx-swap="innerHTML" class="txd-action">
							@icons.Calendar("14")
							Tag everything in its days
						</button>
					}
					<button type="button" hx-get={ fmt.Sprintf("/tags/%s/edit", t.ID) } hx-target={ slot } hx-swap="innerHTML" class="txd-action">
						@icons.Pencil("14")
						Edit
					</button>
					<button
						type="button"
						hx-put={ fmt.Sprintf("/tags/%s/archive?archived=%t", t.ID, !t.IsArchived()) }
						hx-target={ slot }
						hx-swap="innerHTML"
						class="txd-action"
					>
						@icons.Archive("14")
						if t.IsArchived() {
							Unarchive
						} else {
							Archive
						}
					</button>
					<button
						type="button"
						hx-delete={ fmt.Sprintf("/tags/%s", t.ID) }
						hx-swap="none"
						hx-confirm={ fmt.Sprintf("Delete %q? Its transactions stay, untagged.", t.Name) }
						data-confirm-label="Delete"
						data-confirm-danger
						class="txd-action"
					>
						@icons.Trash("14")
						Delete
					</button>
				</div>
				if t.Note != "" {
					@txDetailsSection("Note") {
						<div class="md-note">
							@markdown.HTML(t.Note)
						</div>
					}
				}
				if len(s.ByCurrency) > 1 {
					@txDetailsSection("By currency") {
						<ul class="grid gap-1.5 text-sm">
							for _, c := range s.ByCurrency {
								<li class="flex justify-between gap-3">
									<span>{ c.Currency.String }</span>
									<span class="sensitive tabular-nums">{ c.Currency.Format(c.Amount) }</span>
								</li>
							}
						</ul>
					}
				}
				if len(s.ByCategory) > 0 {
					@txDetailsSection("By category") {
						<ul class="grid gap-2">
							for _, c := range s.ByCategory {
								@tagCategoryRow(s, c, s.ByCategory[0].Amount, s.Spent, TagTxsURL(s.Tag.ID))
							}
						</ul>
					}
				}
				if len(s.ByDay) > 0 {
					@TagDaysSection(s, m)
				}
			</div>
		</div>
	}
}

// tagCatLook is a category's (nil = uncategorized) name, color and key (its
// id, models.TxFilterNone when uncategorized).
func tagCatLook(c *models.Category) (string, string, string) {
	if c == nil {
		return "Uncategorized", models.CategoryColorToHex("gray"), models.TxFilterNone
	}
	return c.Name, models.CategoryColorToHex(c.Color), c.ID
}

// tagCategoryRow is a category's bar against the top one's, its amount and
// share of whole, linking its transactions (txsURL narrowed to it).
templ tagCategoryRow(s *models.TagSummary, c models.TagCategorySpend, top, whole float64, txsURL string) {
	{{ name, hex, catID := tagCatLook(c.Category) }}
	<li class="grid grid-cols-[minmax(0,8rem)_1fr_auto] items-center gap-3 text-sm">
		<a
			href={ templ.SafeURL(fmt.Sprintf("%s&%s=%s", txsURL, models.TxFilterCategory, catID)) }
			class="flex items-center gap-2 min-w-0 hover:underline"
		>
			<span class="size-2.5 shrink-0 rounded-full" style={ "background-color:" + hex }></span>
			<span class="truncate">{ name }</span>
		</a>
		<div class="h-2 rounded-full bg-zinc-800/70">
			if top > 0 && c.Amount > 0 {
				<div class="h-full rounded-full" style={ fmt.Sprintf("width:%.2f%%;background-color:%s", c.Amount/top*100, hex) }></div>
			}
		</div>
		<span class="text-right tabular-nums">
			<span class="sensitive">{ s.Currency.Format(c.Amount) }</span>
			<span class="inline-block w-9 text-zinc-500">{ fmt.Sprintf("%.0f%%", pctOf(c.Amount, whole)) }</span>
		</span>
	</li>
}

func tagDaysID(id string) string { return "tag-days-" + id }

func tagDaysURL(id, month string) string {
	return fmt.Sprintf("/tags/%s/days?month=%s", id, month)
}

// tagMonthLabel names a user month by the month it's named after, with its
// year only when not this year's (e.g. "Nov", "Dec 2025").
func tagMonthLabel(p models.Period, today time.Time) string {
	if p.Month.Year() == today.Year() {
		return p.Month.Format("Jan")
	}
	return p.Month.Format("Jan 2006")
}

func tagMonthOptions(m *models.TagMonth, today time.Time) []form.ComboOption {
	opts := make([]form.ComboOption, len(m.Months))
	for i, o := range m.Months {
		opts[i] = form.ComboOption{Value: o.Period.Key(), Label: tagMonthLabel(o.Period, today)}
	}
	return opts
}

// tagRangeTxsURL lists the tag's transactions of r's days.
func tagRangeTxsURL(id string, r *models.TagRange) string {
	return fmt.Sprintf("%s&%s=%s&%s=%s", TagTxsURL(id), models.TxFilterFrom, r.From.Format(time.DateOnly), models.TxFilterTo, r.To.Format(time.DateOnly))
}

// TagDaysSection is the details' day chart of one of the user's months
// (picked by its chip and arrows), each day's bar split by category, and the
// breakdown of the days picked on it (dragging across bars, or tapping two),
// else of the month.
templ TagDaysSection(s *models.TagSummary, m *models.TagMonth) {
	{{ id := tagDaysID(s.Tag.ID) }}
	{{ url := fmt.Sprintf("/tags/%s/days", s.Tag.ID) }}
	<section id={ id } class="grid grid-cols-1 gap-3" hx-target={ "#" + id } hx-swap="outerHTML">
		<div class="flex items-center justify-between gap-2">
			<h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">By day</h3>
			<form hx-get={ url } hx-trigger="change" class="flex items-center gap-1 min-w-0">
				@tagMonthNav(s.Tag.ID, m.Prev, "Previous month", "M3.828 7l4.95 4.95-1.414 1.414L1 7 7.364.636 8.778 2.05z")
				@form.Combobox(form.ComboboxProps{
					Name: "month", ID: id + "-month", Label: "Month", Options: tagMonthOptions(m, tzctx.Today(ctx)),
					Data: form.FDInput{Value: m.Period.Key()}, Chip: true,
				})
				@tagMonthNav(s.Tag.ID, m.Next, "Next month", "M6.172 7L1.222 2.05 2.636.636 9 7l-6.364 6.364-1.414-1.414z")
			</form>
		</div>
		@tagDaysChart(s, m)
		@tagDaysBreakdown(s, m)
	</section>
}

templ tagMonthNav(id, month, label, path string) {
	<button
		type="button"
		aria-label={ label }
		title={ label }
		class="p-1.5 rounded-full enabled:cursor-pointer enabled:hover:bg-zinc-700 disabled:opacity-30"
		if month == "" {
			disabled
		} else {
			hx-get={ tagDaysURL(id, month) }
		}
	>
		<svg width="10" height="14" viewBox="0 0 10 14" fill="currentColor" aria-hidden="true">
			<path d={ path }></path>
		</svg>
	</button>
}

// tagDaysChart is a bar per day of the month, stacked by category; hovered
// (or scrubbed on touch screens) it tells the day per category. Its days are
// picked by the tagDaysChart Alpine component (main.js).
templ tagDaysChart(s *models.TagSummary, m *models.TagMonth) {
	{{ n := len(m.Days) }}
	<div
		x-data="tagDaysChart"
		data-url={ tagDaysURL(s.Tag.ID, m.Period.Key()) }
		data-target={ "#" + tagDaysID(s.Tag.ID) }
		data-has-selection?={ m.Selection != nil }
		data-picked?={ m.Selection != nil }
		@click.outside="away($event)"
		class="group/chart grid gap-1.5 select-none"
	>
		<div x-ref="bars" x-bind="bars" class="flex items-end gap-0.5 h-32 touch-pan-y cursor-crosshair">
			for i, d := range m.Days {
				<div
					data-day={ d.Day.Format(time.DateOnly) }
					data-selected?={ m.Selected(d.Day) }
					class="group relative flex-1 h-full flex flex-col justify-end min-w-0 rounded-t transition-opacity group-data-has-selection/chart:opacity-35 data-selected:opacity-100! hover:bg-zinc-800/40 [&.is-active]:bg-zinc-800/40"
				>
					if d.Amount > 0 {
						<div class="w-full flex flex-col-reverse overflow-hidden rounded-t" style={ fmt.Sprintf("height: %.1f%%", tagBarHeight(d.Amount, m.Max)) }>
							for _, c := range d.ByCategory {
								{{ _, hex, key := tagCatLook(c.Category) }}
								<div data-cat={ key } class="w-full shrink-0" style={ fmt.Sprintf("height: %.2f%%; background-color: %s", pctOf(c.Amount, d.Amount), hex) }></div>
							}
						</div>
					}
					@tagDayTooltip(s, d, i, n)
				</div>
			}
		</div>
		<div class="flex justify-between text-xs text-zinc-500">
			<span>{ m.Period.From.Format("Jan 2") }</span>
			<span>{ m.Period.From.AddDate(0, 0, n/2).Format("Jan 2") }</span>
			<span>{ m.Period.Last().Format("Jan 2") }</span>
		</div>
	</div>
}

// tagDayTooltip is a day's total and categories, the one under the pointer
// highlighted; over the chart's top, inside it (above it, a drawer scrolled
// to the chart clipped it), and kept inside at its edges.
templ tagDayTooltip(s *models.TagSummary, d models.TagDaySpend, i, n int) {
	{{ pos := "left-1/2 -translate-x-1/2" }}
	if i < n/4 {
		{{ pos = "left-0" }}
	} else if i >= n-n/4 {
		{{ pos = "right-0" }}
	}
	<div class={ "glass-tooltip hidden group-hover:block group-[.is-active]:block absolute top-0 z-10 min-w-40 text-xs pointer-events-none", pos }>
		<p class="flex justify-between gap-4 font-medium">
			<span>{ d.Day.Format("Mon, Jan 2") }</span>
			if d.Amount != 0 {
				<span class="sensitive tabular-nums">{ s.Currency.Format(d.Amount) }</span>
			}
		</p>
		if len(d.ByCategory) == 0 {
			<p class="text-zinc-400">Nothing spent</p>
		} else {
			<ul class="mt-1 grid gap-0.5 text-zinc-400">
				for _, c := range d.ByCategory {
					{{ name, hex, key := tagCatLook(c.Category) }}
					<li class="flex items-center gap-1.5" :class={ fmt.Sprintf("hoverCat === '%s' && 'text-zinc-100 font-semibold'", key) }>
						<span class="size-2 shrink-0 rounded-full" style={ "background-color:" + hex }></span>
						<span class="truncate">{ name }</span>
						<span class="ml-auto pl-3 tabular-nums"><span class="sensitive">{ s.Currency.Format(c.Amount) }</span> · { fmt.Sprintf("%.0f%%", pctOf(c.Amount, d.Amount)) }</span>
					</li>
				}
			</ul>
		}
	</div>
}

// tagDaysBreakdown is what the picked days (else the month) spent per
// category.
templ tagDaysBreakdown(s *models.TagSummary, m *models.TagMonth) {
	{{ r := m.Shown() }}
	<div class="grid gap-2 rounded-xl bg-zinc-800/30 p-3">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<p class="text-sm text-zinc-400">
					if m.Selection != nil {
						if r.Days() == 1 {
							{ r.From.Format("Mon, Jan 2") }
						} else {
							{ r.From.Format("Jan 2") } – { r.To.Format("Jan 2") } · { fmt.Sprint(r.Days()) } days
						}
					} else {
						{ m.Period.RangeLabel() }
					}
				</p>
				<p class="sensitive text-lg font-semibold tabular-nums">{ s.Currency.Format(r.Amount) }</p>
			</div>
			<div class="flex shrink-0 gap-2">
				if r.Amount != 0 {
					<a href={ templ.SafeURL(tagRangeTxsURL(s.Tag.ID, r)) } class="txd-action">
						@icons.Receipt("14")
						Transactions
					</a>
				}
				if m.Selection != nil {
					<button type="button" hx-get={ tagDaysURL(s.Tag.ID, m.Period.Key()) } class="txd-action">Clear</button>
				}
			</div>
		</div>
		if len(r.ByCategory) > 0 {
			<ul class="grid gap-2">
				for _, c := range r.ByCategory {
					@tagCategoryRow(s, c, r.ByCategory[0].Amount, r.Amount, tagRangeTxsURL(s.Tag.ID, r))
				}
			</ul>
		}
		if m.Selection == nil {
			<p class="text-xs text-zinc-500">Drag across the bars, or tap two, to see a range of days.</p>
		}
	</div>
}

func tagBarHeight(amount, top float64) float64 {
	if top <= 0 || amount <= 0 {
		return 0
	}
	return max(amount/top*100, 2)
}

templ CreateTagForm(fd *TagFD, curs []models.Currency, def *models.Currency) {
	@form.SheetForm("New tag", "/tags", "Add tag", "") {
		@tagFormBody("0", fd, curs, def)
	}
}

// EditTag is the tag's edit form, in a drawer in place of its details.
templ EditTag(id string, fd *TagFD, curs []models.Currency, def *models.Currency) {
	@components.Drawer(components.DrawerProps{Label: "Edit tag"}) {
		@EditTagForm(id, fd, curs, def)
	}
}

// EditTagForm is EditTag's form alone, answered with its errors; Cancel goes
// back to the details.
templ EditTagForm(id string, fd *TagFD, curs []models.Currency, def *models.Currency) {
	@form.DrawerForm(form.DrawerFormProps{
		Title: "Edit tag", Method: "put", URL: fmt.Sprintf("/tags/%s", id),
		Submit: "Save changes",
		CancelClick: fmt.Sprintf("confirmDiscard().then((ok) => ok && htmx.ajax('GET', '%s', {target: '#%s', swap: 'innerHTML'}))",
			tagDetailsURL(id), components.DrawerSlot),
	}) {
		@tagFormBody(id, fd, curs, def)
	}
}

templ tagFormBody(id string, fd *TagFD, curs []models.Currency, def *models.Currency) {
	@form.Field("Name", "name", id, icons.Pencil("15"), fd.Name.Error) {
		@form.Control("text", "name", "e.g. Dubai trip", id, fd.Name, templ.Attributes{"maxlength": "40"})
	}
	@form.SelectCategoryColor("color", id, fd.Color)
	<div class="grid gap-3 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
		<div>
			<p class="text-zinc-300">Trip days</p>
			<p class="text-sm text-zinc-500">Optional. With them, tag everything in its days at once.</p>
		</div>
		<div class="grid grid-cols-2 gap-3">
			@form.Field("From", "starts_on", id, icons.Calendar("15"), fd.StartsOn.Error) {
				@form.Control("text", "starts_on", "yyyy-mm-dd", id, fd.StartsOn, templ.Attributes{
					"autocomplete": "off", "x-mask": "9999-99-99", "data-datepicker": true,
				})
			}
			@form.Field("To", "ends_on", id, icons.Calendar("15"), fd.EndsOn.Error) {
				@form.Control("text", "ends_on", "yyyy-mm-dd", id, fd.EndsOn, templ.Attributes{
					"autocomplete": "off", "x-mask": "9999-99-99", "data-datepicker": true,
				})
			}
		</div>
		@form.Toggle("Tag new ones in its days", "auto_tag", id, icons.Zap("18"), fd.AutoTag, nil)
		<p class="-mt-1 text-sm text-zinc-500">Transactions added in its days (by hand, SMS or CSV) get the tag, transfers and goals’ aside.</p>
	</div>
	<div class="grid gap-3 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
		<div>
			<p class="text-zinc-300">Budget</p>
			<p class="text-sm text-zinc-500">Optional. Leave the amount empty for no budget.</p>
		</div>
		@form.AmountInputsWithCurrency(fd.Budget, id, curs, def)
	</div>
	@form.Field("Note", "note", id, icons.StickyNote("15"), fd.Note.Error) {
		@form.Textarea("note", "Anything to remember about it?", id, fd.Note, nil)
		@form.MarkdownHint()
	}
	if fd.Error != "" {
		<p role="alert" class="rounded-xl bg-red-400/10 px-4 py-3 text-sm text-red-300">{ fd.Error }</p>
	}
}

// TagRange is the preview of tagging everything in a trip's days, in a
// drawer in place of its details.
templ TagRange(t *models.Tag, n int, totals []models.CurrencyAmount) {
	@components.Drawer(components.DrawerProps{Label: "Tag " + t.Name + "'s days"}) {
		@form.DrawerForm(form.DrawerFormProps{
			Title: "Tag everything in its days", Method: "post", URL: fmt.Sprintf("/tags/%s/range", t.ID),
			Target: "#" + components.DrawerSlot, Swap: "innerHTML",
			Submit: fmt.Sprintf("Tag %d %s", n, plural(n, "transaction", "transactions")),
			CancelClick: fmt.Sprintf("htmx.ajax('GET', '%s', {target: '#%s', swap: 'innerHTML'})",
				tagDetailsURL(t.ID), components.DrawerSlot),
		}) {
			<p class="text-zinc-300">{ tagDays(t) }</p>
			if n == 0 {
				<p class="text-sm text-zinc-400">Every transaction in its days is tagged already.</p>
			} else {
				<p class="text-sm text-zinc-400">
					{ fmt.Sprint(n) } { plural(n, "transaction isn't", "transactions aren't") } tagged with { t.Name } yet. Transfers between your accounts, balance corrections, goals’ money and loan payments are left out.
				</p>
				<ul class="grid gap-1.5 text-sm">
					for _, c := range totals {
						<li class="flex justify-between gap-3">
							<span class="text-zinc-400">Moved in { c.Currency.String }</span>
							<span class="sensitive tabular-nums">{ c.Currency.Format(c.Amount) }</span>
						</li>
					}
				</ul>
			}
		}
	}
}
