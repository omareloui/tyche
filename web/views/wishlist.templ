package views

import (
	"fmt"
	"slices"
	"strconv"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
)

type WishlistItemFD struct {
	Name        form.FDInput
	PurchaseFD  *PurchaseFD
	CoolingDays form.FDInput
	URL         form.FDInput
	Note        form.FDInput
}

// CreateWishlistItemForm is the goals page's second create form, bound to
// openWishForm (the page's own is the goal's).
templ CreateWishlistItemForm(fd *WishlistItemFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.SheetFormBound(WishFormBind, "Add to wishlist", "/wishlist", "Add", "") {
		@wishlistItemFormBody("wl", fd, curs, defaultCur)
	}
}

// EditWishlistItem is the wish's edit form, in a drawer; saving re-renders
// the whole wishlist.
templ EditWishlistItem(id string, fd *WishlistItemFD, curs []models.Currency, defaultCur *models.Currency) {
	@components.Drawer(components.DrawerProps{Label: "Edit wish"}) {
		@EditWishlistItemForm(id, fd, curs, defaultCur)
	}
}

// EditWishlistItemForm is EditWishlistItem's form alone, answered with its
// errors.
templ EditWishlistItemForm(id string, fd *WishlistItemFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.DrawerForm(form.DrawerFormProps{
		Title: "Edit wish", Method: "put", URL: fmt.Sprintf("/wishlist/%s", id),
		Submit: "Save changes",
	}) {
		@wishlistItemFormBody(id, fd, curs, defaultCur)
	}
}

// WishGoal is the goal form saving for the wish, prefilled from it, in a
// drawer.
templ WishGoal(item *models.WishlistItem, fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@components.Drawer(components.DrawerProps{Label: "Save for " + item.Name}) {
		@WishGoalForm(item, fd, curs, defaultCur)
	}
}

// WishGoalForm is WishGoal's form alone, answered with its errors.
templ WishGoalForm(item *models.WishlistItem, fd *GoalFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.DrawerForm(form.DrawerFormProps{
		Title: "Save for it", Method: "post", URL: fmt.Sprintf("/wishlist/%s/goal", item.ID),
		Submit: "Create goal", Class: "[--accent:var(--color-violet-400)]",
	}) {
		<p class="text-sm text-zinc-500">
			A goal puts money aside for it. Buying the goal marks the wish bought, deleting it lets the wish go.
			if item.IsInstallments() {
				Its installment plan becomes the goal's plan next.
			}
		</p>
		@goalFormBody("wish-"+item.ID, fd, curs, defaultCur)
	}
}

templ wishlistItemFormBody(id string, fd *WishlistItemFD, curs []models.Currency, defaultCur *models.Currency) {
	@form.Field("What is it?", "name", id, icons.Star("15"), fd.Name.Error) {
		@form.Control("text", "name", "e.g. Noise cancelling headphones", id, fd.Name, nil)
	}
	@purchaseInputs(fd.PurchaseFD, id, curs, defaultCur, true)
	<div class="grid gap-2">
		<p class="flex items-center gap-2 text-zinc-300">
			@icons.Hourglass("15")
			Cooling-off period
		</p>
		@form.SegmentedRadio("Cooling-off period", "cooling_days", id, coolingOptions(), fd.CoolingDays, nil)
		<p class="text-sm text-zinc-500">Still want it after that? Then buy it.</p>
	</div>
	@form.Field("Link", "url", id, icons.ExternalLink("15"), fd.URL.Error) {
		@form.Control("url", "url", "https://", id, fd.URL, nil)
	}
	@form.Field("Note", "note", id, icons.Pencil("15"), fd.Note.Error) {
		@form.Control("text", "note", "Why do you want it?", id, fd.Note, nil)
	}
}

// Wishlist is every item, grouped by where it is in its cooling-off, with
// the stats on what was decided.
templ Wishlist(items []models.WishlistItem, ws *models.WorkSettings, defaultCur *models.Currency, oob bool) {
	{{ now := time.Now() }}
	{{ s := models.SummarizeWishlist(items, defaultCur) }}
	{{ ready, cooling, decided := groupWishlist(items, now) }}
	<section
		id="wishlist"
		if oob {
			hx-swap-oob="true"
		}
		class="grid gap-6"
	>
		if len(items) > 0 {
			@wishlistSummary(s, defaultCur)
		}
		if len(ready) > 0 {
			@wishlistGroup("Ready to decide", icons.Sparkles("16"), ready, ws, defaultCur)
		}
		if len(cooling) > 0 {
			@wishlistGroup("Cooling off", icons.Hourglass("16"), cooling, ws, defaultCur)
		}
		if len(ready)+len(cooling) == 0 {
			<div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-2xl border border-dashed border-zinc-800">
				<p class="max-w-md text-sm text-zinc-500">Want something? Add it and wait a week or a month. If you still want it then, buy it or save for it.</p>
				<div class="flex flex-wrap items-center gap-2">
					<button type="button" @click="openWishForm=true" class="btn-primary">
						@icons.Plus("18")
						Add a wish
					</button>
				</div>
			</div>
		}
		if len(decided) > 0 {
			<details class="group">
				<summary class="flex items-center gap-2 mb-3 list-none cursor-pointer select-none text-zinc-500 hover:text-zinc-300 [&::-webkit-details-marker]:hidden">
					@icons.Check("16")
					<h3 class="text-sm font-semibold uppercase tracking-wider">Decided</h3>
					@icons.ChevronDown("16", &templ.Attributes{"class": "transition-transform group-open:rotate-180"})
				</summary>
				<div class="grid sm:grid-cols-2 gap-4">
					for _, item := range decided {
						@WishlistItem(&item, ws, defaultCur)
					}
				</div>
			</details>
		}
	</section>
}

// wishlistSummary is the wishlist's stats, like the goals' summary: what
// letting go of wishes kept once some were decided, else the waiting ones.
templ wishlistSummary(s models.WishlistStats, defaultCur *models.Currency) {
	<section class="relative overflow-hidden grid grid-cols-1 gap-5 p-5 sm:p-6 rounded-3xl bg-zinc-700/20 ring-1 ring-zinc-800 [--accent:var(--color-emerald-400)]">
		<div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-16 size-64 rounded-full bg-(--accent)/15 blur-3xl"></div>
		<div aria-hidden="true" class="pointer-events-none absolute -bottom-28 -left-20 size-56 rounded-full bg-amber-300/10 blur-3xl"></div>
		<div class="relative flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
			if s.Bought+s.Abandoned > 0 {
				<div class="min-w-0">
					<p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-(--accent)">
						@icons.PiggyBank("14")
						Kept by letting go
					</p>
					<p class="sensitive mt-1 text-3xl sm:text-4xl font-bold tabular-nums font-(family-name:--font-biorhyme-expanded)">
						{ defaultCur.Format(s.Saved) }
					</p>
					<p class="text-sm text-zinc-500 tabular-nums">
						You let go of { fmt.Sprintf("%.0f%%", s.AbandonRate()) } of the wishes you decided on
					</p>
				</div>
			} else {
				<div class="min-w-0">
					<p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-amber-300">
						@icons.Hourglass("14")
						Cooling off
					</p>
					<p class="mt-1 text-2xl font-bold font-(family-name:--font-biorhyme-expanded)">Wait, then decide</p>
					<p class="text-sm text-zinc-500">Still want it once it cooled off? Buy it or save for it.</p>
				</div>
			}
			<div class="grid grid-flow-col auto-cols-fr gap-2 w-full sm:w-auto">
				@statTile(strconv.Itoa(s.Waiting), "Waiting", "text-zinc-100")
				if s.Saving > 0 {
					@statTile(strconv.Itoa(s.Saving), "Saving", "text-violet-400")
				}
				@statTile(strconv.Itoa(s.Bought), "Bought", "text-sky-400")
				@statTile(strconv.Itoa(s.Abandoned), "Let go", "text-emerald-400")
			</div>
		</div>
	</section>
}

templ wishlistGroup(title string, icon templ.Component, items []models.WishlistItem, ws *models.WorkSettings, defaultCur *models.Currency) {
	<div>
		<h3 class="flex items-center gap-2 mb-3 text-sm font-semibold uppercase tracking-wider text-zinc-500">
			@icon
			{ title }
		</h3>
		<div class="grid sm:grid-cols-2 gap-4">
			for _, item := range items {
				@WishlistItem(&item, ws, defaultCur)
			}
		</div>
	</div>
}

templ WishlistItem(item *models.WishlistItem, ws *models.WorkSettings, defaultCur *models.Currency) {
	{{ now := time.Now() }}
	{{ ready := item.IsReady(now) }}
	<div
		id={ WishlistItemID(item.ID) }
		hx-target="#wishlist"
		hx-swap="outerHTML"
		data-wl
		if item.Status == models.WishlistWaiting {
			data-waiting
		}
		class="relative min-w-0"
		x-data="{openMenu: false}"
	>
		@components.EntryMenuAt("openMenu", "top-13 right-3 origin-top-right", wishlistMenuItems(item))
		<div class={ "relative flex flex-col gap-3 h-full p-4 rounded-2xl bg-zinc-700/20 overflow-hidden", wishlistAccentClass(item, ready) }>
			<div class="flex items-start gap-3 min-w-0">
				<div class="flex-1 min-w-0">
					<p class="flex items-center gap-1.5 text-lg leading-tight">
						<span title={ item.Name } class="min-w-0 truncate">{ item.Name }</span>
						if item.URL != "" {
							<a href={ templ.SafeURL(item.URL) } target="_blank" rel="noopener noreferrer" hx-boost="false" aria-label="Open link" class="shrink-0 text-zinc-500 hover:text-(--accent)">
								@icons.ExternalLink("14")
							</a>
						}
					</p>
					<p class="text-sm text-zinc-500 tabular-nums truncate">
						if plan := item.ViewPlan(); plan != "" {
							{ plan } · cash { item.ViewPrice() }
						} else {
							{ item.ViewPrice() }
						}
						if v := item.ViewPriceIn(defaultCur); v != "" {
							<span title={ "In " + defaultCur.String }>· ≈ { v }</span>
						}
					</p>
				</div>
				@components.EntryMenuTrigger("openMenu", "Wish actions")
			</div>
			<div class="flex flex-wrap items-center gap-1.5">
				if hours := ws.ViewHoursFor(item.TotalCost(), &item.Currency); hours != "" {
					<span class="chip">
						@icons.Clock("12")
						{ hours } of work
					</span>
				}
				if item.Note != "" {
					<span class="text-sm text-zinc-500 truncate">{ item.Note }</span>
				}
			</div>
			switch item.Status {
				case models.WishlistWaiting:
					if !ready {
						<div>
							<div class="h-1.5 rounded-full bg-zinc-800 overflow-hidden">
								<div class="h-full rounded-full bg-(--accent)" style={ fmt.Sprintf("width: %.1f%%", item.CoolingProgress(now)*100) }></div>
							</div>
							<p class="mt-1.5 text-xs text-zinc-500">
								Ready in { fmt.Sprint(item.DaysLeft(now)) } { plural(item.DaysLeft(now), "day", "days") } · { item.ReadyAt().Local().Format("Jan 2") }
							</p>
						</div>
					} else {
						<p class="flex items-center gap-1.5 text-sm text-(--accent)">
							@icons.Sparkles("14")
							Cooled off { goalDay(item.ReadyAt()) }. Still want it?
						</p>
					}
					<div class="flex flex-wrap gap-2 mt-auto">
						<button
							hx-get={ AffordURL(item.ID) }
							hx-target={ "#" + components.DrawerSlot }
							hx-swap="innerHTML"
							data-opens-drawer
							class="wl-action"
						>
							@icons.Target("14")
							Plan it
						</button>
						<button
							hx-get={ fmt.Sprintf("/wishlist/%s/buy", item.ID) }
							hx-target={ "#" + WishSheetID }
							hx-swap="innerHTML"
							if !ready {
								hx-confirm="Buy it anyway? It's still cooling off."
								data-confirm-label="Buy anyway"
							}
							class={ "wl-action", templ.KV("wl-action-primary", ready) }
						>
							@icons.Check("14")
							Buy
						</button>
						<button
							hx-get={ fmt.Sprintf("/wishlist/%s/goal", item.ID) }
							hx-target={ "#" + components.DrawerSlot }
							hx-swap="innerHTML"
							data-opens-drawer
							class="wl-action"
						>
							@icons.Target("14")
							Save for it
						</button>
						<button hx-put={ fmt.Sprintf("/wishlist/%s/abandon", item.ID) } class="wl-action">
							@icons.Ban("14")
							Let it go
						</button>
					</div>
				case models.WishlistSaving:
					<div class="flex flex-wrap items-center justify-between gap-2 mt-auto">
						<p class="flex items-center gap-1.5 text-sm text-(--accent)">
							@icons.Target("14")
							Saving for it since { goalDay(item.DecidedAt) }
						</p>
						if item.GoalID != "" {
							<button
								hx-get={ goalDetailsURLOf(item.GoalID) }
								hx-target={ "#" + components.DrawerSlot }
								hx-swap="innerHTML"
								data-opens-drawer
								class="wl-action"
							>
								Open goal
							</button>
						}
					</div>
				case models.WishlistBought:
					<p class="flex items-center gap-1.5 mt-auto text-sm text-(--accent)">
						@icons.Check("14")
						Bought { goalDay(item.DecidedAt) }
					</p>
				case models.WishlistAbandoned:
					<p class="flex items-center gap-1.5 mt-auto text-sm text-(--accent)">
						@icons.PiggyBank("14")
						Let go { goalDay(item.DecidedAt) }, kept { item.Currency.Format(item.TotalCost()) }
					</p>
			}
		</div>
	</div>
}

func WishlistItemID(id string) string {
	return "wl-" + id
}

func coolingOptions() []form.RadioOption {
	opts := make([]form.RadioOption, len(models.WishlistCoolingDays))
	for i, d := range models.WishlistCoolingDays {
		opts[i] = form.RadioOption{Value: strconv.Itoa(d), Label: fmt.Sprintf("%d days", d)}
	}
	return opts
}

// groupWishlist splits the items into waiting ones ready to decide on (oldest
// ready first), still cooling off (soonest first) and decided ones (latest
// first).
func groupWishlist(items []models.WishlistItem, now time.Time) (ready, cooling, decided []models.WishlistItem) {
	for _, item := range items {
		switch {
		case item.Status != models.WishlistWaiting:
			decided = append(decided, item)
		case item.IsReady(now):
			ready = append(ready, item)
		default:
			cooling = append(cooling, item)
		}
	}
	byReadyAt := func(a, b models.WishlistItem) int { return a.ReadyAt().Compare(b.ReadyAt()) }
	slices.SortStableFunc(ready, byReadyAt)
	slices.SortStableFunc(cooling, byReadyAt)
	slices.SortStableFunc(decided, func(a, b models.WishlistItem) int { return b.DecidedAt.Compare(a.DecidedAt) })
	return ready, cooling, decided
}

func wishlistAccentClass(item *models.WishlistItem, ready bool) string {
	switch {
	case item.Status == models.WishlistBought:
		return "[--accent:var(--color-sky-400)]"
	case item.Status == models.WishlistAbandoned:
		return "[--accent:var(--color-emerald-400)]"
	case item.Status == models.WishlistSaving:
		return "[--accent:var(--color-violet-400)]"
	case ready:
		return "[--accent:var(--color-amber-300)]"
	}
	return "[--accent:var(--color-violet-400)]"
}

func wishlistMenuItems(item *models.WishlistItem) []templ.Component {
	items := []templ.Component{}
	switch item.Status {
	case models.WishlistWaiting:
		items = append(items, wishlistEditMenuItem(item.ID))
	case models.WishlistSaving:
		// Its goal decides it.
		if item.GoalID != "" {
			items = append(items, components.EntryMenuDrawerItem("Open goal", goalDetailsURLOf(item.GoalID),
				components.WithEntryMenuItemIcon(icons.Target("16"))))
		}
	default:
		items = append(items, components.EntryMenuAnchorItem("Back to waiting", "put", fmt.Sprintf("/wishlist/%s/restore", item.ID),
			components.WithEntryMenuItemIcon(icons.RotateCcw("16"))))
	}
	return append(items,
		components.EntryMenuSeparator(),
		components.EntryMenuDeleteItem(fmt.Sprintf("/wishlist/%s", item.ID)),
	)
}

// wishlistEditMenuItem swaps the card alone for its edit form, unlike the
// other actions re-rendering the whole wishlist.
func wishlistEditMenuItem(id string) templ.Component {
	return components.EntryMenuEditItem(fmt.Sprintf("/wishlist/%s/edit", id),
		components.WithEntryMenuItemAttrs(templ.Attributes{"hx-target": "#" + WishlistItemID(id)}))
}

// WishSheetID holds the transaction form buying a wish.
const WishSheetID = "wish-sheet"

// WishFormBind is the Alpine variable opening the wish create form.
const WishFormBind = "openWishForm"
