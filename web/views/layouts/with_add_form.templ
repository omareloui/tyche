package layouts

import "github.com/omareloui/tyche/internal/jwt"
import "github.com/omareloui/tyche/internal/models"
import "github.com/omareloui/tyche/web/views/components"

templ WithCreateForm(
	claims *jwt.AccessClaims, pageTitle, addLabel string, balances []models.Balance,
	form templ.Component,
) {
	@WithCreateFormActions(claims, pageTitle, addLabel, balances, form, nil) {
		{ children... }
	}
}

// WithCreateFormActions is WithCreateForm with more actions (when not nil)
// before the add button, in the openCreateForm scope.
templ WithCreateFormActions(
	claims *jwt.AccessClaims, pageTitle, addLabel string, balances []models.Balance,
	form, actions templ.Component,
) {
	@Main(claims, pageTitle, balances) {
		// The form is a drawer (form.SheetForm) shown by openCreateForm,
		// opened right away by ?new (the PWA's shortcuts), dropped from the
		// url so a reload doesn't open it again.
		<div x-data="{openCreateForm:false}" x-init="createFormFromURL($data)">
			@components.Container() {
				@components.PageHeader(pageTitle) {
					<div class="flex items-center gap-2">
						if actions != nil {
							@actions
						}
						@components.AddButton(addLabel, "", "openCreateForm=true")
					</div>
				}
				{ children... }
			}
			@form
		</div>
	}
}
