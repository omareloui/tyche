package views

import "github.com/omareloui/tyche/internal/models"
import "github.com/omareloui/tyche/internal/jwt"

type layoutOpts struct {
	includeDatePicker     bool
	includeAlpine         bool
	includeAlpineMask     bool
	includeAlpineCollapse bool
}

templ baseLayout(claims *jwt.AccessClaims, pageTitle string, balances []models.Balance, opts *layoutOpts) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ pageTitle }</title>
			<link rel="stylesheet" href="https://rsms.me/inter/inter.css"/>
			<link rel="icon" type="image/x-svg" href="/images/favicon.svg"/>
			<link rel="stylesheet" href="/styles/main.css"/>
			<script src="/js/vendor/htmx.lib.js"></script>
			if opts != nil && opts.includeDatePicker {
				<script src="/js/vendor/litepicker.lib.js"></script>
				<script defer src="/js/datepickers.js"></script>
			}
			<script defer src="/js/main.js"></script>
			if opts != nil && opts.includeAlpineMask {
				<script defer src="/js/vendor/alpine.mask.lib.js"></script>
			}
			if opts != nil && opts.includeAlpineCollapse {
				<script defer src="/js/vendor/alpine.collapse.lib.js"></script>
			}
			if opts != nil && opts.includeAlpine {
				<script defer src="/js/vendor/alpine.lib.js"></script>
			}
		</head>
		<body>
			@container() {
				@navbar(claims, balances)
			}
			<div class="pb-5">
				{ children... }
			</div>
			<script>
				document.body.addEventListener("htmx:beforeSwap", function (ev) {
					const status = ev.detail.xhr.status
					const statusesToShowResponseOn = [401, 403, 409, 422]
					if (statusesToShowResponseOn.includes(status)) {
						ev.detail.shouldSwap = true;
						ev.detail.isError = false;
					}
				})
			</script>
		</body>
	</html>
}

templ navbar(claims *jwt.AccessClaims, balances []models.Balance) {
	<nav class="flex gap-6 items-start my-4">
		<div hx-boost="true" class="flex gap-6 justify-between w-full">
			<div class="flex gap-4 items-start">
				@navlink("/")
				if claims != nil {
					@navlink("/accounts")
					@navlink("/categories")
					@navlink("/transactions")
					@navlink("/frequent-tx")
					@navlink("/goals")
					@navlink("/counterparties")
					@navlink("/currencies")
				}
			</div>
			<div class="flex gap-4 items-end">
				if claims != nil {
					<p>Hello, { claims.FirstName }.</p>
					@Balance(balances)
					@navlink("/signout")
				} else {
					@navlink("/oauth", templ.Attributes{"hx-disable": true})
				}
			</div>
		</div>
	</nav>
}
