package views

import (
	"fmt"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/slicesutils"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
	"github.com/omareloui/tyche/web/views/layouts"
	"strings"
	"time"
)

type TransactionFD struct {
	TransactionAmountsAndKindFD
	RecurrenceFD *RecurrenceFD
	ScheduledTo  form.FDInput
	Description  form.FDInput
	// WishlistID is the wishlist item being bought, if any.
	WishlistID string
}

type TransactionAmountsAndKindFD struct {
	AccountIFD     form.AccountIFD
	Kind           form.FDInput
	CategoryID     *form.FDInput
	CounterpartyID *form.FDInput
	ToAccountIFD   *form.AccountIFD
}

templ Transactions(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	list TxListData,
	fd *TransactionFD, accounts []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal, openTx string) {
	@layouts.WithCreateForm(claims, "Transactions", balances,
		txCreateSlot(CreateTransactionForm(fd, accounts, knds, cats, cps, &claims.DefaultCurrency))) {
		<div
			x-data="txPage"
			@keydown.window="onKey($event)"
			@click.capture="onSelectClick($event)"
			@click="onClick($event)"
			:class="$store.txSel.on && 'tx-selecting'"
		>
			<div id="tx-body" class="contents">
				@TxBody(list, accounts, knds, cats, cps, gls)
			</div>
			@txDetailsSlot(openTx)
			@txUndoToast()
			@txSelectionBar()
		</div>
	}
}

// TxBody is the filters and the list, re-rendered together when the
// filters change from outside their form (e.g. clearing them).
templ TxBody(list TxListData, accs []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal) {
	@txFilterBar(&list.Filter, list.Page.MonthStart, accs, knds, cats, cps, gls)
	@TxList(list)
}

// txCreateSlot gives the create form a stable target, e.g. for duplicating a
// transaction into it.
templ txCreateSlot(f templ.Component) {
	<div id="tx-create" class="contents">
		@f
	</div>
}

templ CreateTransactionForm(
	fd *TransactionFD, accounts []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty,
	defaultCur *models.Currency) {
	@form.SheetForm("New transaction", "/transactions", "Add transaction", "tx-form") {
		@transactionFormBody(fd, "0", accounts, knds, cats, cps, defaultCur)
	}
}

templ transactionFormBody(
	fd *TransactionFD, id string, accs []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty,
	defaultCur *models.Currency) {
	if fd.WishlistID != "" {
		<input type="hidden" name="wishlist_id" value={ fd.WishlistID }/>
	}
	@TransactionAmountsAndKindFormBody(&fd.TransactionAmountsAndKindFD, id, knds, cats, accs, cps, defaultCur)
	@form.Field("Description", "description", id, icons.Pencil("15"), fd.Description.Error) {
		@form.Control("text", "description", "What was it for?", id, fd.Description, nil)
	}
	<div x-data>
		@form.Field("Date", "scheduled_to", id, icons.Calendar("15"), fd.ScheduledTo.Error) {
			<div class="flex gap-2">
				<div class="flex-1 min-w-0">
					@form.Control("text", "scheduled_to", "yyyy-mm-dd", id, fd.ScheduledTo, templ.Attributes{
						"autocomplete":    "off",
						"x-mask":          "9999-99-99",
						"data-datepicker": true,
						"x-ref":           "date",
					})
				</div>
				@txDateChip("Today", 0)
				@txDateChip("Yesterday", 1)
			</div>
		}
	</div>
	if fd.RecurrenceFD != nil {
		@RecurrenceFormBody(id, fd.RecurrenceFD)
	}
}

// txDateChip sets the date input (x-ref "date") to daysAgo days before today.
templ txDateChip(label string, daysAgo int) {
	<button
		type="button"
		@click={ fmt.Sprintf("$refs.date.value = new Date(Date.now() - %d * 864e5).toLocaleDateString('en-CA')", daysAgo) }
		class="shrink-0 h-11 px-3 rounded-xl border border-zinc-700 text-sm text-zinc-300 cursor-pointer transition-colors hover:border-zinc-500 hover:text-white"
	>{ label }</button>
}

// txFilterBar narrows the list: changing it swaps the list and keeps the
// query string in the URL. The search is focused with "/" (transactions.js).
templ txFilterBar(f *models.TxFilter, start models.MonthStart, accs []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal) {
	<form
		id="tx-filters"
		hx-get="/transactions"
		hx-target="#tx-list"
		hx-swap="outerHTML"
		hx-replace-url="true"
		hx-sync="this:replace"
		hx-trigger="input changed delay:300ms from:find [data-filter-input], change, submit"
		x-init="syncFilters($el); if (activeFilters) filtersOpen = true"
		@change="syncFilters($el)"
		class="grid gap-3 mb-8"
	>
		<div class="flex items-center gap-2">
			<label
				class="flex flex-1 min-w-0 items-center gap-3 h-12 px-4 rounded-2xl border-2 border-zinc-700 bg-zinc-800/40 focus-within:border-zinc-400 transition-colors"
			>
				@icons.Search("20", &templ.Attributes{"class": "text-zinc-500 shrink-0"})
				<input
					type="search"
					name={ models.TxFilterQ }
					value={ f.Q }
					x-ref="q"
					data-filter-input
					autocomplete="off"
					enterkeyhint="search"
					placeholder="Search transactions"
					aria-label="Search transactions"
					@keydown.escape.prevent="if ($el.value) { $el.value = ''; $el.dispatchEvent(new Event('input', { bubbles: true })) } else { $el.blur() }"
					class="flex-1 min-w-0 bg-transparent outline-none placeholder:text-zinc-500 [&::-webkit-search-cancel-button]:hidden"
				/>
				<kbd class="hidden sm:grid place-items-center shrink-0 w-6 h-6 rounded border border-zinc-600 text-xs text-zinc-500">/</kbd>
			</label>
			<button
				type="button"
				@click="filtersOpen = !filtersOpen"
				:aria-expanded="filtersOpen"
				aria-controls="tx-filters-panel"
				title="Filters"
				:class="(filtersOpen || activeFilters) ? 'border-zinc-400 text-white' : 'border-zinc-700 text-zinc-400'"
				class="relative flex items-center gap-2 shrink-0 h-12 px-4 rounded-2xl border-2 bg-zinc-800/40 cursor-pointer transition-colors hover:border-zinc-500 hover:text-white"
			>
				@icons.Filter("18")
				<span class="hidden sm:inline">Filters</span>
				<span
					x-cloak
					x-show="activeFilters"
					x-text="activeFilters"
					class="grid place-items-center min-w-5 h-5 px-1 rounded-full bg-(--accent) text-xs font-semibold text-zinc-950"
				></span>
			</button>
		</div>
		// Shortcuts sit up here: the list scrolls on forever.
		@txShortcuts()
		<div id="tx-filters-panel" x-cloak x-show="filtersOpen" x-collapse>
			<div class="flex flex-wrap items-center gap-2 pt-1">
				@txFilterCombo(models.TxFilterKind, "Kind", "Any kind", f.KindValue(), false, txKindFilterOptions(knds))
				@txFilterCombo(models.TxFilterAccount, "Account", "Any account", f.AccountID, true, txAccountFilterOptions(accs))
				@txFilterCombo(models.TxFilterCategory, "Category", "Any category", f.CategoryID, true,
					append([]form.ComboOption{{Value: models.TxFilterNone, Label: "Uncategorized"}}, categoryComboOptions(cats)...))
				@txFilterCombo(models.TxFilterCounterparty, "Counterparty", "Any counterparty", f.CounterpartyID, true,
					append([]form.ComboOption{{Value: models.TxFilterNone, Label: "No counterparty"}}, counterpartyComboOptions(cps, f.CounterpartyID)...))
				if len(gls) > 0 {
					@txFilterCombo(models.TxFilterGoal, "Goal", "Any goal", f.GoalID, true, goalComboOptions(gls))
				}
				@txFilterCombo(models.TxFilterStatus, "Status", "Any status", string(f.Status), false, []form.ComboOption{
					{Value: string(models.TxStatusFulfilled), Label: "Fulfilled", Leading: icons.Check("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"})},
					{Value: string(models.TxStatusScheduled), Label: "Scheduled", Leading: icons.Calendar("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"})},
					{Value: string(models.TxStatusReview), Label: "Needs review", Leading: icons.Message("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"})},
				})
				@txFilterCombo(models.TxFilterSource, "Source", "Any source", string(f.Source), false, []form.ComboOption{
					{Value: string(models.TxSourceSMS), Label: "From SMS", Leading: icons.Smartphone("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"})},
					{Value: string(models.TxSourceManual), Label: "Added by hand", Leading: icons.Pencil("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"})},
				})
				@txDateRangeFilter(f)
				@txDatePresets(f, start)
				@txAmountFilter(models.TxFilterMin, "Min amount", f.MinAmount)
				<span class="text-zinc-600">–</span>
				@txAmountFilter(models.TxFilterMax, "Max amount", f.MaxAmount)
				<button
					type="button"
					x-show="activeFilters"
					hx-get={ txFilterURL(f.Without(txFilterKeysButQ()...)) }
					hx-target="#tx-body"
					hx-swap="innerHTML"
					hx-replace-url="true"
					class="flex items-center gap-1 h-10 px-3 rounded-full text-sm text-zinc-400 cursor-pointer transition-colors hover:bg-white/5 hover:text-white"
				>
					@icons.X("16")
					Clear
				</button>
			</div>
		</div>
	</form>
}

templ txShortcuts() {
	// Swiping has no visible cue on touch screens, told once.
	<p
		x-data="{ hint: false }"
		x-init="hint = (() => { try { return !localStorage.getItem('tx-swipe-hint') } catch { return false } })()"
		x-cloak
		x-show="hint"
		class="sm:hidden flex items-center gap-2 text-xs text-zinc-500"
	>
		<span class="flex-1">Swipe a transaction right to fulfill or mark it reviewed, left to delete it. Hold it to select several.</span>
		<button
			type="button"
			@click="hint = false; try { localStorage.setItem('tx-swipe-hint', '1') } catch {}"
			aria-label="Dismiss"
			class="shrink-0 grid place-items-center w-7 h-7 rounded-full cursor-pointer hover:bg-white/5 hover:text-zinc-300"
		>
			@icons.X("14")
		</button>
	</p>
	<p class="hidden sm:flex flex-wrap justify-end gap-x-4 gap-y-1 text-xs text-zinc-600">
		<span><kbd class="kbd">/</kbd> search</span>
		<span><kbd class="kbd">j</kbd> <kbd class="kbd">k</kbd> move</span>
		<span><kbd class="kbd">gg</kbd> <kbd class="kbd">G</kbd> top, bottom</span>
		<span><kbd class="kbd">e</kbd> edit</span>
		<span><kbd class="kbd">f</kbd> fulfill</span>
		<span><kbd class="kbd">r</kbd> reviewed</span>
		<span><kbd class="kbd">⌫</kbd> delete</span>
		<span><kbd class="kbd">x</kbd> <kbd class="kbd">space</kbd> select</span>
		<span><kbd class="kbd">n</kbd> new</span>
	</p>
}

templ txFilterCombo(name, label, anyLabel, value string, searchable bool, opts []form.ComboOption) {
	@form.Combobox(form.ComboboxProps{
		Name: name, ID: "filter", Label: label, Placeholder: anyLabel,
		Options: opts, Data: form.FDInput{Value: value},
		Nullable: true, NullLabel: anyLabel, Searchable: searchable, Chip: true,
		InputAttrs: templ.Attributes{"data-filter": true},
	})
}

// txDateRangeFilter picks the from and to days with one range picker
// (datepickers.js), the days kept in hidden inputs.
templ txDateRangeFilter(f *models.TxFilter) {
	{{ from, to := f.FromString(), f.ToString() }}
	<div class="relative" x-data>
		<input type="hidden" name={ models.TxFilterFrom } value={ from } data-filter/>
		<input type="hidden" name={ models.TxFilterTo } value={ to } data-filter/>
		@icons.Calendar("16", &templ.Attributes{"class": "pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-500"})
		<input
			type="text"
			readonly
			data-datepicker
			data-datepicker-range
			placeholder="Any date"
			aria-label="Dates"
			if from != "" || to != "" {
				value={ from + " → " + to }
			}
			class="combo-chip w-52 pl-9! placeholder:text-zinc-500"
		/>
	</div>
}

// txDatePresets set the date range to common periods in one click.
templ txDatePresets(f *models.TxFilter, start models.MonthStart) {
	<div class="flex flex-wrap gap-1">
		for _, p := range txDatePresetRanges(time.Now(), start) {
			{{ active := f.From.Equal(p.from) && f.To.Equal(p.to) }}
			{{ v := f.Values() }}
			{{ v.Set(models.TxFilterFrom, p.from.Format(time.DateOnly)) }}
			{{ v.Set(models.TxFilterTo, p.to.Format(time.DateOnly)) }}
			@txFilterLink(txFilterURL(v.Encode()), txDatePresetClass(active)) {
				{ p.label }
			}
		}
	</div>
}

func txDatePresetClass(active bool) string {
	c := "h-8 px-3 rounded-full text-sm cursor-pointer transition-colors "
	if active {
		return c + "bg-zinc-700 text-white"
	}
	return c + "text-zinc-400 hover:bg-white/5 hover:text-white"
}

type txDatePreset struct {
	label    string
	from, to time.Time
}

// txDatePresetRanges are the periods offered as presets, up to today.
func txDatePresetRanges(now time.Time, start models.MonthStart) []txDatePreset {
	today := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, time.UTC)
	month := start.Of(today)
	return []txDatePreset{
		{"This month", month.From, today},
		{"Last month", month.Prev().From, month.Prev().Last()},
		{"Last 30 days", today.AddDate(0, 0, -29), today},
		{"This year", time.Date(today.Year(), 1, 1, 0, 0, 0, 0, time.UTC), today},
	}
}

templ txAmountFilter(name, label string, value *float64) {
	<input
		type="text"
		name={ name }
		value={ models.FilterAmountString(value) }
		data-filter-input
		data-filter
		inputmode="decimal"
		autocomplete="off"
		placeholder={ label }
		aria-label={ label }
		class="combo-chip w-32 tabular-nums placeholder:text-zinc-500"
	/>
}

// txFilterKeysButQ are the filters cleared by "Clear", which keeps the search.
func txFilterKeysButQ() []string {
	return []string{
		models.TxFilterKind, models.TxFilterAccount, models.TxFilterCategory,
		models.TxFilterCounterparty, models.TxFilterGoal, models.TxFilterStatus,
		models.TxFilterSource, models.TxFilterFrom, models.TxFilterTo,
		models.TxFilterMin, models.TxFilterMax,
	}
}

func txKindFilterOptions(knds []models.TxKind) []form.ComboOption {
	opts := []form.ComboOption{}
	for _, k := range knds {
		if k != models.NilTxKind {
			opts = append(opts, form.ComboOption{Value: k.String(), Label: k.String()})
		}
	}
	return opts
}

func txAccountFilterOptions(accs []models.Account) []form.ComboOption {
	opts := make([]form.ComboOption, len(accs))
	for i := range accs {
		opts[i] = form.ComboOption{
			Value:   accs[i].ID,
			Label:   accs[i].Name,
			Leading: accKindIcon(accs[i].Kind.Enum, "16"),
		}
	}
	return form.SortComboOptions(opts)
}

// ReimbursePicker lets choosing the expense an income pays back.
templ ReimbursePicker(tx *models.Transaction, exps []models.ReimbursableExpense, errMsg string) {
	{{ v := newTxView(ctx, tx) }}
	<div data-tx hx-target="this" hx-swap="outerHTML" class="grid gap-3 px-4 py-3 rounded-2xl bg-zinc-700/20">
		<div class="flex items-center justify-between gap-4">
			<p>
				Which expense does <span class="font-semibold">{ v.title }</span>
				<span class="tabular-nums text-emerald-400">{ v.amount }</span> pay back?
			</p>
			<button hx-get={ fmt.Sprintf("/transactions/%s", tx.ID) } class="cursor-pointer text-sm text-zinc-400 hover:text-zinc-200">Cancel</button>
		</div>
		if errMsg != "" {
			<p class="text-sm text-red-500">{ errMsg }</p>
		}
		if len(exps) == 0 {
			<p class="text-sm text-zinc-400">No expense in the 90 days up to its day, in the same currency, has enough left to be paid back by it.</p>
		}
		<ul class="grid gap-2 max-h-96 overflow-y-auto">
			for _, e := range exps {
				<li>
					<button
						hx-put={ fmt.Sprintf("/transactions/%s/reimburses", tx.ID) }
						hx-vals={ fmt.Sprintf(`{"expense_id": %q}`, e.ID) }
						class="cursor-pointer w-full flex items-center gap-4 px-4 py-2 rounded-xl bg-zinc-700/30 text-left transition-colors hover:bg-zinc-600/40"
					>
						<div class="flex-1 min-w-0">
							<p class="truncate">{ e.Title }</p>
							<p class="text-xs text-zinc-400 truncate">
								if e.Subtitle != "" {
									{ e.Subtitle } ·
								}
								{ formatTxDay(e.ScheduledTo) } · { e.Account }
							</p>
							if e.Category != "" {
								<div class="flex mt-1">
									<span class="chip max-w-48">
										@categoryDot(e.CategoryColor)
										<span class="truncate">{ e.Category }</span>
									</span>
								</div>
							}
						</div>
						<div class="shrink-0 text-right tabular-nums">
							<p class="font-semibold">{ "-" + e.ViewAmount() }</p>
							if e.Reimbursed > 0 {
								<p class="text-xs text-zinc-400">{ "Net -" + e.ViewNetAmount() }</p>
							}
						</div>
					</button>
				</li>
			}
		</ul>
	</div>
}

// TransferPairPicker pairs a transaction by hand with the other side of a
// transfer between the user's accounts. The ones that look like it (amount
// and time) are flagged.
templ TransferPairPicker(tx *models.Transaction, cands []models.Transaction, errMsg string) {
	{{ v := newTxView(ctx, tx) }}
	<div data-tx hx-target="this" hx-swap="outerHTML" class="grid gap-3 px-4 py-3 rounded-2xl bg-zinc-700/20">
		<div class="flex items-center justify-between gap-4">
			<p>
				if tx.Kind == models.IncomeTxKind {
					Where did <span class="font-semibold">{ v.title }</span>
					<span class="tabular-nums text-emerald-400">{ v.amount }</span> into { tx.Account.Name } come from?
				} else {
					Where did <span class="font-semibold">{ v.title }</span>
					<span class="tabular-nums">{ v.amount }</span> from { tx.Account.Name } go?
				}
			</p>
			<button hx-get={ fmt.Sprintf("/transactions/%s", tx.ID) } class="cursor-pointer text-sm text-zinc-400 hover:text-zinc-200">Cancel</button>
		</div>
		if errMsg != "" {
			<p class="text-sm text-red-500">{ errMsg }</p>
		}
		if len(cands) == 0 {
			<p class="text-sm text-zinc-400">
				No unpaired
				if tx.Kind == models.IncomeTxKind {
					expense
				} else {
					income
				}
				in another account within a week of it.
			</p>
		}
		<ul class="grid gap-2 max-h-96 overflow-y-auto">
			for _, c := range cands {
				{{ cv := newTxView(ctx, &c) }}
				<li>
					<button
						hx-put={ fmt.Sprintf("/transactions/%s/transfer-pair", tx.ID) }
						hx-vals={ fmt.Sprintf(`{"other_id": %q}`, c.ID) }
						class="cursor-pointer w-full flex items-center gap-4 px-4 py-2 rounded-xl bg-zinc-700/30 text-left transition-colors hover:bg-zinc-600/40"
					>
						<div class="flex-1 min-w-0">
							<p class="flex items-center gap-2 min-w-0">
								<span class="truncate">{ cv.title }</span>
								if transferPairLikely(tx, &c) {
									<span class="chip shrink-0 bg-sky-400/10 text-sky-300">Likely</span>
								}
							</p>
							<p class="text-xs text-zinc-400 truncate">
								{ formatTxDay(c.ScheduledTo) }
								if cv.time != "" {
									· { cv.time }
								}
								· { c.Account.Name }
							</p>
						</div>
						<p class={ "shrink-0 font-semibold tabular-nums", templ.KV("text-emerald-400", cv.tone == txToneIn) }>{ cv.amount }</p>
					</button>
				</li>
			}
		</ul>
	</div>
}

// txAccount is the account of accs with the id, nil if none.
func txAccount(accs []models.Account, id string) *models.Account {
	for i := range accs {
		if accs[i].ID == id {
			return &accs[i]
		}
	}
	return nil
}

// transferPairLikely reports whether a and b look like the two sides of a
// transfer, as auto pairing would see them.
func transferPairLikely(a, b *models.Transaction) bool {
	out, in := a, b
	if out.Kind == models.IncomeTxKind {
		out, in = in, out
	}
	return models.MatchesTransferPair(out, in, func(from, to string) float64 {
		return (&models.Currency{String: from}).FxRate(to)
	})
}

templ TransactionAmountsAndKindFormBody(
	fd *TransactionAmountsAndKindFD, id string,
	knds []models.TxKind, cats []models.Category,
	accs []models.Account, cps []models.Counterparty,
	defaultCur *models.Currency) {
	{{ kind := models.GetTxKindFromString(fd.Kind.Value) }}
	{{ switched := isSwitched(accs, fd.AccountIFD.AccountID.Value) }}
	{{ onChange := templ.Attributes{"hx-post": fmt.Sprintf("/tx-inputs/%s", id), "hx-trigger": "change"} }}
	<div
		class="contents"
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="closest form:abort"
	>
		@form.SelectTxKind("kind", id, getTxKindsForAccounts(accs, knds), fd.Kind, onChange)
		// One shrinkable column, so long account names truncate in their chips
		// instead of widening the form past the screen.
		<div class="grid grid-cols-1 justify-items-center gap-3 py-2">
			{{ unit := txAccount(accs, fd.AccountIFD.AccountID.Value).AmountUnit(fd.AccountIFD.Unit.Value) }}
			@form.HeroAmountInput("Amount", "amount", form.GetAccoutSym(accs, fd.AccountIFD.AccountID.Value, defaultCur),
				models.AmountDigits(unit), id, fd.AccountIFD.Amount, templ.Attributes{
					"hx-post":    fmt.Sprintf("/tx-inputs/%s", id),
					"hx-trigger": "keyup changed delay:200ms",
				})
			if unit != "" {
				@form.MetalUnitToggle("amount_unit", id, unit, onChange)
			}
			<div class="flex items-center justify-center gap-2 w-full min-w-0">
				@form.SelectAccountChip(txAccountLabel(fd), "account_id", id, getTxAccs(accs, kind, switched), fd.AccountIFD.AccountID, onChange)
				if fd.ToAccountIFD != nil {
					<button
						type="button"
						hx-post={ fmt.Sprintf("/tx-inputs/switch/%s", id) }
						aria-label="Swap accounts"
						title="Swap accounts"
						class="grid place-items-center shrink-0 w-9 h-9 rounded-full border border-zinc-700 bg-zinc-800 text-zinc-300 cursor-pointer transition-colors hover:border-(--accent) hover:text-(--accent)"
					>
						@icons.Transfer("18")
					</button>
					@form.SelectAccountChip("To account", "to_account_id", id, getTxCounterAccs(accs, kind, switched),
						fd.ToAccountIFD.AccountID, onChange)
				}
			</div>
			@form.ErrorMessage(fd.AccountIFD.AccountID.Error)
			if fd.ToAccountIFD != nil {
				{{ toSym := form.GetAccoutSym(accs, fd.ToAccountIFD.AccountID.Value, defaultCur) }}
				{{ toUnit := txAccount(accs, fd.ToAccountIFD.AccountID.Value).AmountUnit(fd.ToAccountIFD.Unit.Value) }}
				<div class="flex flex-wrap items-center justify-center gap-2 text-sm text-zinc-400">
					<label class="flex items-center gap-2">
						Receives
						<input
							id={ "to_amount-" + id }
							type="text"
							name="to_amount"
							value={ fd.ToAccountIFD.Amount.Value }
							placeholder={ fmt.Sprintf("%s 0.%s", toSym, strings.Repeat("0", models.AmountDigits(toUnit))) }
							autocomplete="off"
							inputmode="decimal"
							x-mask:dynamic={ form.MoneyMask(toSym, models.AmountDigits(toUnit)) }
							class="input-field w-48! h-9! text-center tabular-nums font-(family-name:--font-biorhyme-expanded)"
							if fd.ToAccountIFD.Amount.Error != "" {
								aria-invalid="true"
							}
						/>
					</label>
					if toUnit != "" {
						@form.MetalUnitToggle("to_amount_unit", id, toUnit, onChange)
					}
				</div>
				@form.ErrorMessage(fd.ToAccountIFD.Amount.Error)
				@form.ErrorMessage(fd.ToAccountIFD.AccountID.Error)
			}
		</div>
		if fd.CategoryID != nil || fd.CounterpartyID != nil {
			<div class="grid gap-5 sm:grid-cols-2">
				if fd.CategoryID != nil {
					@form.Field("Category", "category_id", id, icons.Tag("15"), fd.CategoryID.Error) {
						@form.Combobox(form.ComboboxProps{
							Name: "category_id", ID: id, Label: "Category", Placeholder: "Select Category",
							Options: categoryComboOptions(getCategoriesOfKinds(cats, kind)),
							Data:    *fd.CategoryID, Nullable: true, Searchable: true,
							CreateURL: categoryCreateURL(kind),
						})
					}
				}
				if fd.CounterpartyID != nil {
					@form.Field("Counterparty", "counterparty_id", id, icons.User("15"), fd.CounterpartyID.Error) {
						@form.Combobox(form.ComboboxProps{
							Name: "counterparty_id", ID: id, Label: "Counterparty", Placeholder: "Select Counterparty",
							Options: counterpartyComboOptions(cps, fd.CounterpartyID.Value),
							Data:    *fd.CounterpartyID, Nullable: true, Searchable: true,
							CreateURL: "/counterparties/quick",
						})
					}
				}
			</div>
		}
	</div>
}

templ categoryDot(color string) {
	<span class="shrink-0 w-2.5 h-2.5 rounded-full" style={ fmt.Sprintf("background-color: %s", models.CategoryColorToHex(color)) }></span>
}

func categoryComboOption(c *models.Category) form.ComboOption {
	return form.ComboOption{Value: c.ID, Label: c.Name, Leading: categoryDot(c.Color)}
}

func categoryComboOptions(cats []models.Category) []form.ComboOption {
	opts := make([]form.ComboOption, len(cats))
	for i := range cats {
		opts[i] = categoryComboOption(&cats[i])
	}
	return form.SortComboOptions(opts)
}

// CategoryComboOption answers a category combobox's CreateURL.
func CategoryComboOption(c *models.Category) templ.Component {
	return form.ComboOptionItem(categoryComboOption(c), true)
}

// categoryCreateURL quick-creates categories allowing the tx kind.
func categoryCreateURL(kind models.TxKind) string {
	return "/categories/quick?kind=" + kind.CategoryKind().String()
}

func counterpartyComboOption(cp *models.Counterparty) form.ComboOption {
	return form.ComboOption{
		Value:   cp.ID,
		Label:   cp.Name,
		Search:  strings.Join(cp.Aliases, " "),
		Leading: components.CounterpartyIcon(cp.Name, cp.Icon, cp.Color, "w-5 h-5 text-[11px]"),
	}
}

// counterpartyComboOptions leaves out the archived counterparties, but the
// selected one.
func counterpartyComboOptions(cps []models.Counterparty, selected string) []form.ComboOption {
	opts := make([]form.ComboOption, 0, len(cps))
	for i := range cps {
		if cps[i].IsArchived && cps[i].ID != selected {
			continue
		}
		opts = append(opts, counterpartyComboOption(&cps[i]))
	}
	return form.SortComboOptions(opts)
}

// CounterpartyComboOption answers a counterparty combobox's CreateURL.
func CounterpartyComboOption(cp *models.Counterparty) templ.Component {
	return form.ComboOptionItem(counterpartyComboOption(cp), true)
}

func goalComboOptions(gls []models.Goal) []form.ComboOption {
	opts := make([]form.ComboOption, len(gls))
	for i := range gls {
		opts[i] = form.ComboOption{
			Value:   gls[i].ID,
			Label:   gls[i].Name,
			Leading: icons.Target("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"}),
		}
	}
	return form.SortComboOptions(opts)
}

// txAccountLabel names the account select by where the money goes.
func txAccountLabel(fd *TransactionAmountsAndKindFD) string {
	switch {
	case fd.ToAccountIFD != nil:
		return "From account"
	case models.GetTxKindFromString(fd.Kind.Value).IsIncoming():
		return "To account"
	default:
		return "Account"
	}
}

func getTxKindsForAccounts(accs []models.Account, knds []models.TxKind) []models.TxKind {
	// Adjustments only come from fixing balances on the accounts page.
	nknds := slicesutils.Filter(knds, func(k models.TxKind) bool {
		return k != models.NilTxKind && k != models.AdjustmentTxKind
	})
	notDebt := slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum != models.AccKindDebt })
	if len(notDebt) < 2 {
		nknds = slicesutils.Filter(nknds, func(k models.TxKind) bool { return k != models.TransferTxKind })
	}
	if len(notDebt) == len(accs) {
		nknds = slicesutils.Filter(nknds, func(k models.TxKind) bool { return k != models.DebtTxKind })
	}
	return nknds
}

func getTxAccs(accs []models.Account, txKind models.TxKind, isSwitched bool) []models.Account {
	if txKind == models.DebtTxKind && isSwitched {
		return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum == models.AccKindDebt })
	}

	return slicesutils.Filter(accs, func(a models.Account) bool {
		// Gam'yaas only move money by transfers, their installments and payouts.
		if a.Kind.Enum == models.AccKindGamyaa {
			return txKind == models.TransferTxKind
		}
		return a.Kind.Enum != models.AccKindDebt
	})
}

func getTxCounterAccs(accs []models.Account, txKind models.TxKind, isSwitched bool) []models.Account {
	if txKind != models.DebtTxKind || isSwitched {
		return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum != models.AccKindDebt })
	}

	return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum == models.AccKindDebt })
}

func isSwitched(accs []models.Account, accId string) bool {
	acc := slicesutils.Find(accs, func(a models.Account) bool { return a.ID == accId })
	return acc != nil && acc.Kind.Enum == models.AccKindDebt
}

func getCategoriesOfKinds(cats []models.Category, txKind models.TxKind) []models.Category {
	kndsCats := []models.Category{}
	for _, cat := range cats {
		for _, kind := range cat.Kinds {
			if kind == txKind.CategoryKind() {
				kndsCats = append(kndsCats, cat)
			}
		}
	}
	return kndsCats
}
