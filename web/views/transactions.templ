package views

import (
	"fmt"
	"time"
	"strconv"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/slicesutils"
	"github.com/omareloui/tyche/internal/jwt"
)

type TransactionFD struct {
	TransactionAmountsAndKindFD
	FrequencyFD *FrequencyFD
	ScheduledTo FDInput
	Description FDInput
}

type TransactionAmountsAndKindFD struct {
	AccountIFD     AccountIFD
	KindID         FDInput
	CategoryID     *FDInput
	CounterpartyID *FDInput
	ToAccountIFD   *AccountIFD
	GoalID         *FDInput
}

type AccountIFD struct {
	Amount    FDInput
	AccountID FDInput
}

templ Transactions(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	transactions []models.Transaction,
	fd *TransactionFD, accounts []models.Account,
	knds []models.TransactionKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal) {
	@baseLayout(claims, "Transactions", balances, &layoutOpts{includeAlpine: true, includeAlpineCollapse: true, includeAlpineMask: true}) {
		@container() {
			@mainHeader("Transactions")
			@CreateTransactionForm(fd, accounts, knds, cats, cps, gls, &claims.DefaultCurrency)
			@transactionsList(transactions)
		}
	}
}

templ CreateTransactionForm(
	fd *TransactionFD, accounts []models.Account,
	knds []models.TransactionKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal,
	defaultCur *models.Currency) {
	@creationForm("Create Transaction", "/transactions", "Create Transaction") {
		@transactionFormBody(fd, "0", accounts, knds, cats, cps, gls, defaultCur)
	}
}

templ transactionFormBody(
	fd *TransactionFD, id string, accs []models.Account,
	knds []models.TransactionKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal,
	defaultCur *models.Currency) {
	@TransactionAmountsAndKindFormBody(&fd.TransactionAmountsAndKindFD, id, knds, cats, accs, cps, gls, defaultCur)
	@input("Description", "text", "description", "Enter a description", id, fd.Description)
	@dateInput("Date", "scheduled_to", id, fd.ScheduledTo)
	if fd.FrequencyFD != nil {
		@FrequencyFormBody(id, fd.FrequencyFD)
	}
}

templ TransactionOOB(tx *models.Transaction) {
	<div id="tx-list" hx-swap-oob="afterbegin">
		@Transaction(tx)
	</div>
}

templ EditTransaction(
	tx *models.Transaction, fd *TransactionFD,
	accounts []models.Account, knds []models.TransactionKind,
	cats []models.Category, cps []models.Counterparty,
	gls []models.Goal, defaultCur *models.Currency) {
	@form("put", fmt.Sprintf("/transactions/%s", tx.ID), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { tx.ID }</p>
		@transactionFormBody(fd, tx.ID, accounts, knds, cats, cps, gls, defaultCur)
		@editFormButtons(fmt.Sprintf("/transactions/%s", tx.ID))
	}
}

templ transactionsList(transactions []models.Transaction) {
	@list("tx-list") {
		for _, t := range transactions {
			@Transaction(&t)
		}
	}
}

templ Transaction(tx *models.Transaction) {
	<div
		hx-target="this"
		if tx.FulfilledAt.IsZero() {
			class="entry-container"
		} else {
			class="entry-container stale"
		}
	>
		<p>ID: { tx.ID }</p>
		<p>Account: { tx.Account.Name }</p>
		<p>Amount: { tx.ViewAmount() }</p>
		if tx.ToAccount != nil {
			<p>To Account: { tx.ToAccount.Name }</p>
			<p>To Amount: { tx.ViewToAmount() }</p>
		}
		<p>Kind: { tx.Kind.Enum.String() }</p>
		if tx.Category != nil {
			<p>Category ID: { tx.Category.ID }</p>
			<p>Category Name: { tx.Category.Name }</p>
		}
		if tx.Counterparty != nil {
			<p>Counterparty ID: { tx.Counterparty.ID }</p>
			<p>Counterparty Name: { tx.Counterparty.Name }</p>
		}
		if tx.Description != "" {
			<p>Description: { tx.Description }</p>
		}
		if tx.Goal != nil {
			<p>Goal: { tx.Goal.Name }</p>
			<p>Goal Percentage: { strconv.FormatFloat(tx.GoalPercentage * 100, 'f', 2, 64) }%</p>
		}
		<p>Scheduled To: { tx.ScheduledTo.Format(time.DateOnly) }</p>
		if !tx.FulfilledAt.IsZero() {
			<p>Fulfilled At: { tx.FulfilledAt.Format(time.RFC1123Z) }</p>
		}
		<p>Created At: { tx.CreatedAt.Format(time.RFC1123Z) }</p>
		<div class="flex gap-4">
			if tx.FulfilledAt.IsZero() {
				@saveButton("Fulfill", fmt.Sprintf("/transactions/%s/fulfill", tx.ID))
			}
			@editButton(fmt.Sprintf("/transactions/%s/edit", tx.ID))
			@deleteButton(fmt.Sprintf("/transactions/%s", tx.ID))
		</div>
	</div>
}

templ TransactionAmountsAndKindFormBody(
	fd *TransactionAmountsAndKindFD, id string,
	knds []models.TransactionKind, cats []models.Category,
	accs []models.Account, cps []models.Counterparty,
	gls []models.Goal, defaultCur *models.Currency) {
	<div
		class="contents"
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="closest form:abort"
	>
		@selectTxKind("kind_id", id, getTxKindsForAccounts(accs, knds), fd.KindID, templ.Attributes{
			"hx-post":    fmt.Sprintf("/tx-inputs/%s", id),
			"hx-trigger": "change",
		})
		<div class="grid grid-cols-3 gap-4">
			@moneyInput("Amount", "amount", getCurSymbolByAccount(accs, fd.AccountIFD.AccountID.Value, defaultCur), id,
				fd.AccountIFD.Amount, "col-span-2", templ.Attributes{
					"hx-post":    fmt.Sprintf("/tx-inputs/%s", id),
					"hx-trigger": "keyup changed delay:200ms",
				})
			@selectAccount("account_id", id, getTxAccs(accs, knds, fd.KindID.Value, isSwitched(accs, fd.AccountIFD.AccountID.Value)), fd.AccountIFD.AccountID,
				templ.Attributes{
					"hx-post":    fmt.Sprintf("/tx-inputs/%s", id),
					"hx-trigger": "change",
				})
		</div>
		if fd.CategoryID != nil {
			@selectTxCat("category_id", id, getCategoriesOfKinds(cats, fd.KindID.Value), *fd.CategoryID)
		}
		if fd.CounterpartyID != nil {
			@selectCounterparty("counterparty_id", id, cps, *fd.CounterpartyID, true)
		}
		if fd.GoalID != nil {
			@selectGoal("goal_id", id, gls, *fd.GoalID)
		}
		if fd.ToAccountIFD != nil {
			<button hx-post={ fmt.Sprintf("/tx-inputs/switch/%s", id) }>Switch</button>
			<div class="grid grid-cols-3 gap-4">
				@moneyInput("To Amount", "to_amount",
					getCurSymbolByAccount(accs, fd.ToAccountIFD.AccountID.Value, defaultCur), id,
					fd.ToAccountIFD.Amount, "col-span-2")
				@selectToAccount("to_account_id", id, getTxCounterAccs(accs, knds, fd.KindID.Value, isSwitched(accs, fd.AccountIFD.AccountID.Value)),
					fd.ToAccountIFD.AccountID, templ.Attributes{
						"hx-post":    fmt.Sprintf("/tx-inputs/%s", id),
						"hx-trigger": "change",
					})
			</div>
		}
	</div>
}

func getTxKindsForAccounts(accs []models.Account, knds []models.TransactionKind) []models.TransactionKind {
	nknds := knds
	notDebt := slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum != models.AccKindDebt })
	if len(notDebt) < 2 {
		nknds = slicesutils.Filter(nknds, func(k models.TransactionKind) bool { return k.Enum != models.TransferTxKind })
	}
	if len(notDebt) == len(accs) {
		nknds = slicesutils.Filter(nknds, func(k models.TransactionKind) bool { return k.Enum != models.DebtTxKind })
	}
	return nknds
}

func getTxAccs(accs []models.Account, knds []models.TransactionKind, kndId string, isSwitched bool) []models.Account {
	knd := slicesutils.Find(knds, func(k models.TransactionKind) bool { return k.ID == kndId })

	if knd.Enum == models.DebtTxKind && isSwitched {
		return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum == models.AccKindDebt })
	}

	return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum != models.AccKindDebt })
}

func getTxCounterAccs(accs []models.Account, knds []models.TransactionKind, kndId string, isSwitched bool) []models.Account {
	knd := slicesutils.Find(knds, func(k models.TransactionKind) bool { return k.ID == kndId })

	if knd.Enum != models.DebtTxKind || isSwitched {
		return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum != models.AccKindDebt })
	}

	return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum == models.AccKindDebt })
}

func isSwitched(accs []models.Account, accId string) bool {
	acc := slicesutils.Find(accs, func(a models.Account) bool { return a.ID == accId })
	return acc != nil && acc.Kind.Enum == models.AccKindDebt
}

func getCategoriesOfKinds(cats []models.Category, kndId string) []models.Category {
	kndsCats := []models.Category{}
	for _, cat := range cats {
		if cat.Kind.ID == kndId {
			kndsCats = append(kndsCats, cat)
		}
	}
	return kndsCats
}
