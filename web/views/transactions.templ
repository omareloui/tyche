package views

import (
	"fmt"
	"time"
	"strconv"
	"github.com/omareloui/tyche/internal/models"
)

type TransactionFD struct {
	TransactionAmountsAndKindFD
	FrequencyFD *FrequencyFD
	ScheduledTo FDInput
	Description FDInput
}

templ Transactions(
	balances []models.Balance,
	transactions []models.Transaction,
	fd *TransactionFD, accounts []models.Account,
	knds []models.TransactionKind,
	cats []models.Category,
	cps []models.Counterparty) {
	@baseLayout("Transactions", balances) {
		@container() {
			@mainHeader("Transactions")
			@CreateTransactionForm(fd, accounts, knds, cats, cps)
			@transactionsList(transactions)
		}
	}
}

templ CreateTransactionForm(
	fd *TransactionFD,
	accounts []models.Account,
	knds []models.TransactionKind,
	cats []models.Category,
	cps []models.Counterparty) {
	@creationForm("Create Transaction", "/transactions", "Create Transaction") {
		@transactionFormBody(fd, "0", accounts, knds, cats, cps)
	}
}

templ transactionFormBody(
	fd *TransactionFD,
	id string,
	accs []models.Account,
	knds []models.TransactionKind,
	cats []models.Category,
	cps []models.Counterparty) {
	@TransactionAmountsAndKindFormBody(&fd.TransactionAmountsAndKindFD, id, knds, cats, accs, cps)
	@input("Description", "text", "description", "Enter a description", id, fd.Description)
	@dateInput("Date", "scheduled_to", id, fd.ScheduledTo)
	if fd.FrequencyFD != nil {
		@FrequencyFormBody(id, fd.FrequencyFD)
	}
}

templ TransactionOOB(tx *models.Transaction) {
	<div id="tx-list" hx-swap-oob="afterbegin">
		@Transaction(tx)
	</div>
}

templ EditTransaction(
	tx *models.Transaction,
	fd *TransactionFD,
	accounts []models.Account,
	knds []models.TransactionKind,
	cats []models.Category,
	cps []models.Counterparty) {
	@form("put", fmt.Sprintf("/transactions/%s", tx.ID), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { tx.ID }</p>
		@transactionFormBody(fd, tx.ID, accounts, knds, cats, cps)
		@editFormButtons(fmt.Sprintf("/transactions/%s", tx.ID))
	}
}

templ transactionsList(transactions []models.Transaction) {
	@list("tx-list") {
		for _, t := range transactions {
			@Transaction(&t)
		}
	}
}

templ Transaction(tx *models.Transaction) {
	<div
		hx-target="this"
		if tx.FulfilledOn.IsZero() {
			class="entry-container"
		} else {
			class="entry-container stale"
		}
	>
		<p>ID: { tx.ID }</p>
		<p>Account: { tx.Account.Name }</p>
		<p>Amount: { tx.ViewAmount() }</p>
		if tx.ToAccount != nil {
			<p>To Account: { tx.ToAccount.Name }</p>
			<p>To Amount: { tx.ViewToAmount() }</p>
		}
		<p>Kind: { tx.Kind.Kind }</p>
		if tx.Category != nil {
			<p>Category ID: { tx.Category.ID }</p>
			<p>Category Name: { tx.Category.Name }</p>
		}
		if tx.Counterparty != nil {
			<p>Counterparty ID: { tx.Counterparty.ID }</p>
			<p>Counterparty Name: { tx.Counterparty.Name }</p>
		}
		if tx.Description != "" {
			<p>Description: { tx.Description }</p>
		}
		if tx.GoalTitle != "" {
			<p>Goal: { tx.GoalTitle }</p>
			<p>Goal Percentage: { strconv.FormatFloat(tx.GoalPercentage * 100, 'f', 2, 64) }%</p>
		}
		<p>Scheduled To: { tx.ScheduledTo.Format(time.DateOnly) }</p>
		if !tx.FulfilledOn.IsZero() {
			<p>Fulfilled On: { tx.FulfilledOn.Format(time.RFC1123Z) }</p>
		}
		<p>Created At: { tx.CreatedAt.Format(time.RFC1123Z) }</p>
		<div class="flex gap-4">
			if tx.FulfilledOn.IsZero() {
				@saveButton("Fulfill", fmt.Sprintf("/transactions/%s/fulfill", tx.ID))
			}
			@editButton(fmt.Sprintf("/transactions/%s/edit", tx.ID))
			@deleteButton(fmt.Sprintf("/transactions/%s", tx.ID))
		</div>
	</div>
}
