package views

import "github.com/omareloui/financial-plans/internal/models"
import "time"

type TransactionFormData struct {
	Amount      FormInputData
	CurrencyID  FormInputData
	KindID      FormInputData
	IsRecurrent FormInputData
	ScheduledTo FormInputData
}

templ Transactions(
	formdata *TransactionFormData,
	transactions []models.Transaction,
	currencies map[string]string,
	kinds map[string]string,
	defaultCurrencySymbol string) {
	@baseLayout("Transactions") {
		@container() {
			<h2 class="text-3xl font-bold mb-3">Transactions</h2>
			@CreateTransactionForm(formdata, currencies, kinds, defaultCurrencySymbol)
			@transactionsList(transactions)
		}
	}
}

templ CreateTransactionForm(formdata *TransactionFormData, currencies map[string]string, kinds map[string]string, currencySymbol string) {
	@creationForm("Create Transaction", "/transactions", "Create Transaction") {
		<div class="grid grid-cols-3 gap-4">
			@moneyInput("Amount", "amount", currencySymbol, "", formdata.Amount, "col-span-2")
			@selectInput("Currency", "currency_id", "Select a Currency", "", currencies, formdata.CurrencyID)
		</div>
		@selectInput("Kind", "kind_id", "Selected a Kind", "", kinds, formdata.KindID)
		// TODO: show how recurrent it is on check
		@checkbox("Is Recurrent", "is_recurrent", "", formdata.IsRecurrent)
		@dateInput("Date", "scheduled_to", "", formdata.ScheduledTo)
	}
}

templ TransactionOOB(tx *models.Transaction) {
	<div id="tx-list" hx-swap-oob="beforeend">
		@transaction(tx)
	</div>
}

templ transactionsList(transactions []models.Transaction) {
	@list("tx-list") {
		for _, t := range transactions {
			@transaction(&t)
		}
	}
}

templ transaction(t *models.Transaction) {
	<div hx-target="this" class="entry-container">
		<p>ID: { t.ID }</p>
		<p>Amount: { t.ViewAmount() }</p>
		<p>Kind: { t.Kind.Kind }</p>
		if t.IsRecurrent {
			<p>Is Recurrent?: yes</p>
		} else {
			<p>Is Recurrent?: no</p>
		}
		<p>Scheduled To: { t.ScheduledTo.Format(time.DateOnly) }</p>
		<p>Created At: { t.CreatedAt.Format(time.RFC1123Z) }</p>
	</div>
}
