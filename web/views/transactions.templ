package views

import (
	"fmt"
	"time"
	"github.com/omareloui/financial-planner/internal/models"
)

type TransactionFD struct {
	AmountFD
	FrequencyFD
	KindID      FDInput
	ScheduledTo FDInput
	Description FDInput
}

type FrequencyFD struct {
	IsFrequent FDInput
	FrequentBy FDInput
	Frequency  FDInput
}

type AmountFD struct {
	Amount     FDInput
	CurrencyID FDInput
}

templ Transactions(
	balances []models.Balance,
	fd *TransactionFD,
	transactions []models.Transaction,
	currencies map[string]string,
	kinds map[string]string,
	defaultCurrencySymbol string) {
	@baseLayout("Transactions", balances) {
		@container() {
			@mainHeader("Transactions")
			@CreateTransactionForm(fd, currencies, kinds, defaultCurrencySymbol)
			@transactionsList(transactions)
		}
	}
}

templ CreateTransactionForm(fd *TransactionFD, currencies map[string]string, kinds map[string]string, currencySymbol string) {
	@creationForm("Create Transaction", "/transactions", "Create Transaction") {
		@transactionFormBody("", fd, currencies, kinds, currencySymbol)
	}
}

templ FrequencyFormBody(id string, fd *FrequencyFD) {
	<div data-frequency-form class="grid gap-2">
		@checkbox("Is Frequent", "is_frequent", id, fd.IsFrequent,
			templ.Attributes{
				"hx-post":    fmt.Sprintf("/frequency-form/%s", id),
				"hx-trigger": "change",
				"hx-target":  "closest [data-frequency-form]",
				"hx-swap":    "outerHTML",
				"hx-sync":    "closest form:abort",
			})
		if fd.IsFrequent.Value != "" {
			<div class="grid grid-cols-3 gap-4">
				@input("Frequency", "number", "frequent", "Frequent every", "", fd.Frequency, "col-span-2")
				@selectInput("Frequent By", "frequent_by", "Select a How Recurrent", "", map[string]string{"0": "DAY", "1": "MONTH", "2": "YEAR"}, fd.FrequentBy)
			</div>
		}
	</div>
}

templ transactionFormBody(id string, fd *TransactionFD, currencies map[string]string, kinds map[string]string, currencySymbol string) {
	@AmountInputs(&fd.AmountFD, currencies, currencySymbol)
	@selectInput("Kind", "kind_id", "Select a Kind", id, kinds, fd.KindID)
	@input("Description", "text", "description", "Enter a description", id, fd.Description)
	@FrequencyFormBody(id, &fd.FrequencyFD)
	@dateInput("Date", "scheduled_to", id, fd.ScheduledTo)
}

templ TransactionOOB(tx *models.Transaction) {
	<div id="tx-list" hx-swap-oob="afterbegin">
		@Transaction(tx)
	</div>
}

templ EditTransaction(tx *models.Transaction, fd *TransactionFD, currencies map[string]string, kinds map[string]string) {
	@form("put", fmt.Sprintf("/transactions/%s", tx.ID), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { tx.ID }</p>
		@transactionFormBody(tx.ID, fd, currencies, kinds, tx.Currency.Enum.Symbol())
		@editFormButtons(fmt.Sprintf("/transactions/%s", tx.ID))
	}
}

templ transactionsList(transactions []models.Transaction) {
	@list("tx-list") {
		for _, t := range transactions {
			@Transaction(&t)
		}
	}
}

templ Transaction(tx *models.Transaction) {
	<div
		hx-target="this"
		if tx.FulfilledOn.IsZero() {
			class="entry-container"
		} else {
			class="entry-container stale"
		}
	>
		<p>ID: { tx.ID }</p>
		<p>Amount: { tx.ViewAmount() }</p>
		<p>Kind: { tx.Kind.Kind }</p>
		if tx.Description != "" {
			<p>Description: { tx.Description }</p>
		}
		<p>Amount: { tx.ViewAmount() }</p>
		<p>Scheduled To: { tx.ScheduledTo.Format(time.DateOnly) }</p>
		if !tx.FulfilledOn.IsZero() {
			<p>Fulfilled On: { tx.FulfilledOn.Format(time.RFC1123Z) }</p>
		}
		<p>Created At: { tx.CreatedAt.Format(time.RFC1123Z) }</p>
		<div class="flex gap-4">
			if tx.FulfilledOn.IsZero() {
				@saveButton("Fulfill", fmt.Sprintf("/transactions/%s/fulfill", tx.ID))
			}
			@editButton(fmt.Sprintf("/transactions/%s/edit", tx.ID))
			@deleteButton(fmt.Sprintf("/transactions/%s", tx.ID))
		</div>
	</div>
}
