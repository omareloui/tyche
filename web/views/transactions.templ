package views

import (
	"fmt"
	"github.com/omareloui/tyche/internal/formatters"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/slicesutils"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
	"github.com/omareloui/tyche/web/views/layouts"
	"strings"
	"time"
)

type TransactionFD struct {
	TransactionAmountsAndKindFD
	RecurrenceFD *RecurrenceFD
	ScheduledTo  form.FDInput
	Description  form.FDInput
}

type TransactionAmountsAndKindFD struct {
	AccountIFD     form.AccountIFD
	Kind           form.FDInput
	CategoryID     *form.FDInput
	CounterpartyID *form.FDInput
	ToAccountIFD   *form.AccountIFD
	GoalID         *form.FDInput
}

templ Transactions(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	transactions []models.Transaction,
	fd *TransactionFD, accounts []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal) {
	@layouts.WithCreateForm(claims, "Transactions", balances,
		CreateTransactionForm(fd, accounts, knds, cats, cps, gls, &claims.DefaultCurrency),
		layouts.WithDatePicker(), layouts.WithAlpineMask()) {
		@transactionsList(transactions)
	}
}

templ CreateTransactionForm(
	fd *TransactionFD, accounts []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal,
	defaultCur *models.Currency) {
	@form.SheetForm("New transaction", "/transactions", "Add transaction", "tx-form") {
		@transactionFormBody(fd, "0", accounts, knds, cats, cps, gls, defaultCur)
	}
}

templ transactionFormBody(
	fd *TransactionFD, id string, accs []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty, gls []models.Goal,
	defaultCur *models.Currency) {
	@TransactionAmountsAndKindFormBody(&fd.TransactionAmountsAndKindFD, id, knds, cats, accs, cps, gls, defaultCur)
	@form.Field("Description", "description", id, icons.Pencil("15"), fd.Description.Error) {
		@form.Control("text", "description", "What was it for?", id, fd.Description, nil)
	}
	<div x-data>
		@form.Field("Date", "scheduled_to", id, icons.Calendar("15"), fd.ScheduledTo.Error) {
			<div class="flex gap-2">
				<div class="flex-1 min-w-0">
					@form.Control("text", "scheduled_to", "yyyy-mm-dd", id, fd.ScheduledTo, templ.Attributes{
						"autocomplete":    "off",
						"x-mask":          "9999-99-99",
						"data-datepicker": true,
						"x-ref":           "date",
					})
				</div>
				@txDateChip("Today", 0)
				@txDateChip("Yesterday", 1)
			</div>
		}
	</div>
	if fd.RecurrenceFD != nil {
		@RecurrenceFormBody(id, fd.RecurrenceFD)
	}
}

// txDateChip sets the date input (x-ref "date") to daysAgo days before today.
templ txDateChip(label string, daysAgo int) {
	<button
		type="button"
		@click={ fmt.Sprintf("$refs.date.value = new Date(Date.now() - %d * 864e5).toLocaleDateString('en-CA')", daysAgo) }
		class="shrink-0 h-11 px-3 rounded-xl border border-zinc-700 text-sm text-zinc-300 cursor-pointer transition-colors hover:border-zinc-500 hover:text-white"
	>{ label }</button>
}

templ TransactionsListOOB(transactions []models.Transaction) {
	<div id="tx-list" hx-swap-oob="outerHTML" class="grid gap-8 no-entries">
		@transactionsDays(transactions)
	</div>
}

templ EditTransaction(
	tx *models.Transaction, fd *TransactionFD,
	accounts []models.Account, knds []models.TxKind,
	cats []models.Category, cps []models.Counterparty,
	gls []models.Goal, defaultCur *models.Currency) {
	// data-tx keeps the day section visible while editing.
	<form
		hx-put={ string(templ.SafeURL(fmt.Sprintf("/transactions/%s", tx.ID))) }
		hx-target="this"
		hx-swap="outerHTML"
		data-tx
		class="tx-form grid gap-5 rounded-2xl bg-zinc-900 ring-1 ring-zinc-800 p-5 sm:p-6"
	>
		<header class="flex items-baseline justify-between gap-4">
			<h3 class="text-lg font-semibold">Edit transaction</h3>
			<span title="Transaction ID" class="truncate font-mono text-xs text-zinc-500">{ tx.ID }</span>
		</header>
		@transactionFormBody(fd, tx.ID, accounts, knds, cats, cps, gls, defaultCur)
		@form.SheetFormButtons("Save changes", fmt.Sprintf("/transactions/%s", tx.ID))
	</form>
}

templ transactionsList(transactions []models.Transaction) {
	@txSearchBar()
	<div id="tx-list" class="grid gap-8 no-entries">
		@transactionsDays(transactions)
	</div>
}

templ transactionsDays(transactions []models.Transaction) {
	for _, day := range groupTxsByDay(transactions) {
		// Hidden once all its transactions get deleted.
		<section class="hidden has-[[data-tx]]:grid gap-3">
			<h2 class="text-zinc-400">{ formatTxDay(day.Day) }</h2>
			for _, t := range day.Txs {
				@Transaction(&t)
			}
		</section>
	}
}

// txSMSPopup shows the SMS a transaction was created from on hovering its
// parent group.
templ txSMSPopup(body, hint string) {
	@components.HoverPopup("w-72 max-w-[80vw] px-3 py-2 text-sm") {
		<p class="whitespace-pre-wrap break-words">{ body }</p>
		if hint != "" {
			<p class="mt-2 text-xs text-amber-400">{ hint }</p>
		}
	}
}

// txGoalPopup shows the goal a transaction belongs to and its progress on
// hovering its parent group.
templ txGoalPopup(gl *models.Goal) {
	@components.HoverPopup("w-64 max-w-[80vw] px-3 py-2 text-sm") {
		<div class="flex items-baseline justify-between gap-3">
			<p class="truncate font-semibold">{ gl.Name }</p>
			<p class="shrink-0 text-xs text-zinc-400">{ formatters.FormatNum(gl.ProgressPercentage()) }%</p>
		</div>
		<div class="mt-2">
			@components.ProgressBar(gl.ProgressPercentage(), components.WithProgressBarSuccessStatus(gl.ProgressPercentage() >= 100 || !gl.FulfilledAt.IsZero()))
		</div>
		<p class="mt-2 text-xs text-zinc-400">{ gl.ViewProgress() } / { gl.ViewAmount() }</p>
	}
}

// TODO: wire up search; mock for now.
templ txSearchBar() {
	<label
		class="flex items-center gap-4 mb-8 px-5 py-3 rounded-2xl border-2 border-zinc-600 bg-zinc-800/40 focus-within:border-zinc-400 transition-colors"
	>
		@icons.Search("24", &templ.Attributes{"class": "text-zinc-500 shrink-0"})
		<input
			type="search"
			placeholder="Search transactions"
			class="flex-1 min-w-0 bg-transparent outline-none placeholder:text-zinc-500"
		/>
		<kbd class="hidden sm:grid place-items-center w-6 h-6 rounded border border-zinc-500 text-xs text-zinc-500">/</kbd>
	</label>
}

templ Transaction(tx *models.Transaction) {
	if tx.IsReimbursement() {
		@reimbursement(tx)
	} else {
		@transaction(tx)
	}
}

templ transaction(tx *models.Transaction) {
	{{ v := newTxView(tx) }}
	<div
		data-tx
		hx-target="this"
		hx-swap="outerHTML"
		class="relative"
		x-data="{openMenu: false, openReimbursements: false}"
	>
		@components.EntryMenu("openMenu", getTransactionMenuItems(tx))
		<div
			class={
				"flex items-center gap-4 px-4 py-3 rounded-2xl",
				templ.KV("bg-zinc-700/20", !v.isStale),
				templ.KV("bg-zinc-400/20 opacity-70", v.isStale),
			}
		>
			// TODO: per-category/kind icons.
			<div
				class={
					"grid place-items-center shrink-0 w-12 h-12 rounded-xl bg-zinc-700/40",
					templ.KV("text-violet-400", !v.isIncoming),
					templ.KV("text-emerald-400", v.isIncoming),
				}
			>
				if v.counterparty != nil {
					@components.CounterpartyIcon(v.counterparty.Name, v.counterparty.Icon, v.counterparty.Color, "w-7 h-7")
				} else if tx.Kind == models.DebtTxKind {
					@icons.Debt("24")
				} else {
					@icons.Tag("24")
				}
			</div>
			<div class="flex-1 min-w-0">
				<p class="text-lg truncate">{ v.title }</p>
				<p class="text-xs text-zinc-400 truncate">
					if v.subtitle != "" {
						<span class="text-sm">{ v.subtitle }</span>
						<span>·</span>
					}
					<span>{ v.time }</span>
				</p>
			</div>
			<div class="hidden md:flex flex-1 min-w-0 items-center gap-3">
				// TODO: per-account icons.
				@icons.Card("24", &templ.Attributes{"class": "shrink-0 text-zinc-300"})
				<span class="truncate">{ v.account }</span>
			</div>
			<div class="flex items-center gap-3 text-zinc-500">
				if tx.NeedsReview {
					<span class="group relative flex">
						<button
							hx-put={ fmt.Sprintf("/transactions/%s/reviewed", tx.ID) }
							aria-label="Added from SMS, needs review. Click to mark reviewed"
							class="cursor-pointer text-amber-400 transition-colors hover:text-amber-300"
						>
							@icons.Message("22")
						</button>
						@txSMSPopup(tx.SMSBody, "Needs review. Click to mark reviewed")
					</span>
				} else if tx.FromSMS {
					<span tabindex="0" aria-label="Added from SMS" class="group relative flex outline-none">
						@icons.Message("22")
						@txSMSPopup(tx.SMSBody, "")
					</span>
				}
				if tx.Kind == models.TransferTxKind {
					<span title="Transfer">
						@icons.Transfer("22")
					</span>
				}
				if tx.RecurrentTx != nil {
					<span title="Recurrent">
						@icons.Repeat("22")
					</span>
				}
				if tx.Goal != nil {
					<span tabindex="0" aria-label={ "Goal: " + tx.Goal.Name } class="group relative flex outline-none">
						@icons.Target("22")
						@txGoalPopup(tx.Goal)
					</span>
				}
				if len(tx.Reimbursements) > 0 {
					<button
						@click="openReimbursements = !openReimbursements"
						:class="openReimbursements && 'text-zinc-200'"
						aria-label="Show reimbursements"
						title="Reimbursed, click to show the breakdown"
						class="cursor-pointer flex items-center gap-1 transition-colors hover:text-zinc-300"
					>
						@icons.Users("22")
						<span class="text-sm tabular-nums">{ fmt.Sprint(len(tx.Reimbursements)) }</span>
					</button>
				}
			</div>
			<p
				class={
					"shrink-0 text-right tabular-nums font-semibold",
					templ.KV("text-emerald-400", v.isIncoming),
				}
			>
				{ v.amount }
			</p>
			<button
				@click="openMenu = !openMenu"
				class="cursor-pointer grid place-items-center shrink-0 w-6 h-6"
			>
				<img src="/icons/dots-menu.svg" class="h-5"/>
			</button>
		</div>
		if len(tx.Reimbursements) > 0 {
			@reimbursementsBreakdown(tx)
		}
	</div>
}

// reimbursementsBreakdown shows how an expense's net amount came to be: what
// got paid, minus each reimbursement.
templ reimbursementsBreakdown(tx *models.Transaction) {
	<div x-cloak x-show="openReimbursements" x-transition class="ml-6 md:ml-16 mt-2 grid gap-2 border-l-2 border-zinc-700 pl-4">
		<div class="flex justify-between px-4 text-sm text-zinc-400">
			<span>Paid</span>
			<span class="tabular-nums">{ "-" + tx.ViewAmount() }</span>
		</div>
		for _, rt := range tx.Reimbursements {
			@reimbursement(&rt)
		}
		<div class="flex justify-between px-4 text-sm font-semibold">
			<span>Net</span>
			<span class="tabular-nums">{ "-" + tx.ViewNetAmount() }</span>
		</div>
	</div>
}

// reimbursement is an income paying back (part of) an expense, shown under
// its expense.
templ reimbursement(tx *models.Transaction) {
	{{ v := newTxView(tx) }}
	<div
		data-tx
		hx-target="this"
		hx-swap="outerHTML"
		class="relative"
		x-data="{openMenu: false}"
	>
		@components.EntryMenu("openMenu", getReimbursementMenuItems(tx))
		<div class={ "flex items-center gap-3 px-4 py-2 rounded-xl bg-zinc-700/20", templ.KV("opacity-70", v.isStale) }>
			<div class="grid place-items-center shrink-0 w-9 h-9 rounded-lg bg-zinc-700/40 text-emerald-400">
				if v.counterparty != nil {
					@components.CounterpartyIcon(v.counterparty.Name, v.counterparty.Icon, v.counterparty.Color, "w-5 h-5")
				} else {
					@icons.Tag("18")
				}
			</div>
			<div class="flex-1 min-w-0">
				<p class="truncate">{ v.title }</p>
				<p class="text-xs text-zinc-400 truncate">
					{ formatTxDay(tx.ScheduledTo) } · { v.account }
				</p>
			</div>
			if tx.NeedsReview {
				<span class="group relative flex">
					<button
						hx-put={ fmt.Sprintf("/transactions/%s/reviewed", tx.ID) }
						aria-label="Added from SMS, needs review. Click to mark reviewed"
						class="cursor-pointer text-amber-400 transition-colors hover:text-amber-300"
					>
						@icons.Message("20")
					</button>
					@txSMSPopup(tx.SMSBody, "Needs review. Click to mark reviewed")
				</span>
			}
			<p class="shrink-0 text-right tabular-nums font-semibold text-emerald-400">{ v.amount }</p>
			<button
				@click="openMenu = !openMenu"
				class="cursor-pointer grid place-items-center shrink-0 w-6 h-6"
			>
				<img src="/icons/dots-menu.svg" class="h-5"/>
			</button>
		</div>
	</div>
}

// ReimbursePicker lets choosing the expense an income pays back.
templ ReimbursePicker(tx *models.Transaction, exps []models.ReimbursableExpense, errMsg string) {
	{{ v := newTxView(tx) }}
	<div data-tx hx-target="this" hx-swap="outerHTML" class="grid gap-3 px-4 py-3 rounded-2xl bg-zinc-700/20">
		<div class="flex items-center justify-between gap-4">
			<p>
				Which expense does <span class="font-semibold">{ v.title }</span>
				<span class="tabular-nums text-emerald-400">{ v.amount }</span> pay back?
			</p>
			<button hx-get={ fmt.Sprintf("/transactions/%s", tx.ID) } class="cursor-pointer text-sm text-zinc-400 hover:text-zinc-200">Cancel</button>
		</div>
		if errMsg != "" {
			<p class="text-sm text-red-500">{ errMsg }</p>
		}
		if len(exps) == 0 {
			<p class="text-sm text-zinc-400">No expense in the 90 days up to its day, in the same currency, has enough left to be paid back by it.</p>
		}
		<ul class="grid gap-2 max-h-96 overflow-y-auto">
			for _, e := range exps {
				<li>
					<button
						hx-put={ fmt.Sprintf("/transactions/%s/reimburses", tx.ID) }
						hx-vals={ fmt.Sprintf(`{"expense_id": %q}`, e.ID) }
						class="cursor-pointer w-full flex items-center gap-4 px-4 py-2 rounded-xl bg-zinc-700/30 text-left transition-colors hover:bg-zinc-600/40"
					>
						<div class="flex-1 min-w-0">
							<p class="truncate">{ e.Title }</p>
							<p class="text-xs text-zinc-400 truncate">
								if e.Subtitle != "" {
									{ e.Subtitle } ·
								}
								{ formatTxDay(e.ScheduledTo) } · { e.Account }
							</p>
						</div>
						<div class="shrink-0 text-right tabular-nums">
							<p class="font-semibold">{ "-" + e.ViewAmount() }</p>
							if e.Reimbursed > 0 {
								<p class="text-xs text-zinc-400">{ "Net -" + e.ViewNetAmount() }</p>
							}
						</div>
					</button>
				</li>
			}
		</ul>
	</div>
}

templ TransactionAmountsAndKindFormBody(
	fd *TransactionAmountsAndKindFD, id string,
	knds []models.TxKind, cats []models.Category,
	accs []models.Account, cps []models.Counterparty,
	gls []models.Goal, defaultCur *models.Currency) {
	{{ kind := models.GetTxKindFromString(fd.Kind.Value) }}
	{{ switched := isSwitched(accs, fd.AccountIFD.AccountID.Value) }}
	{{ onChange := templ.Attributes{"hx-post": fmt.Sprintf("/tx-inputs/%s", id), "hx-trigger": "change"} }}
	<div
		class="contents"
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="closest form:abort"
	>
		@form.SelectTxKind("kind", id, getTxKindsForAccounts(accs, knds), fd.Kind, onChange)
		<div class="grid justify-items-center gap-3 py-2">
			@form.HeroMoneyInput("Amount", "amount", form.GetAccoutSym(accs, fd.AccountIFD.AccountID.Value, defaultCur), id,
				fd.AccountIFD.Amount, templ.Attributes{
					"hx-post":    fmt.Sprintf("/tx-inputs/%s", id),
					"hx-trigger": "keyup changed delay:200ms",
				})
			<div class="flex items-center justify-center gap-2 max-w-full">
				@form.SelectAccountChip(txAccountLabel(fd), "account_id", id, getTxAccs(accs, kind, switched), fd.AccountIFD.AccountID, onChange)
				if fd.ToAccountIFD != nil {
					<button
						type="button"
						hx-post={ fmt.Sprintf("/tx-inputs/switch/%s", id) }
						aria-label="Swap accounts"
						title="Swap accounts"
						class="grid place-items-center shrink-0 w-9 h-9 rounded-full border border-zinc-700 bg-zinc-800 text-zinc-300 cursor-pointer transition-colors hover:border-(--accent) hover:text-(--accent)"
					>
						@icons.Transfer("18")
					</button>
					@form.SelectAccountChip("To account", "to_account_id", id, getTxCounterAccs(accs, kind, switched),
						fd.ToAccountIFD.AccountID, onChange)
				}
			</div>
			@form.ErrorMessage(fd.AccountIFD.AccountID.Error)
			if fd.ToAccountIFD != nil {
				{{ toSym := form.GetAccoutSym(accs, fd.ToAccountIFD.AccountID.Value, defaultCur) }}
				<label class="flex items-center gap-2 text-sm text-zinc-400">
					Receives
					<input
						id={ "to_amount-" + id }
						type="text"
						name="to_amount"
						value={ fd.ToAccountIFD.Amount.Value }
						placeholder={ toSym + " 0.00" }
						autocomplete="off"
						inputmode="decimal"
						x-mask:dynamic={ fmt.Sprintf("'%s ' + $money($input, '.', ',')", toSym) }
						class="input-field w-48! h-9! text-center tabular-nums font-(family-name:--font-biorhyme-expanded)"
						if fd.ToAccountIFD.Amount.Error != "" {
							aria-invalid="true"
						}
					/>
				</label>
				@form.ErrorMessage(fd.ToAccountIFD.Amount.Error)
				@form.ErrorMessage(fd.ToAccountIFD.AccountID.Error)
			}
		</div>
		if fd.CategoryID != nil || fd.CounterpartyID != nil || fd.GoalID != nil {
			<div class="grid gap-5 sm:grid-cols-2">
				if fd.CategoryID != nil {
					@form.Field("Category", "category_id", id, icons.Tag("15"), fd.CategoryID.Error) {
						@form.Combobox(form.ComboboxProps{
							Name: "category_id", ID: id, Label: "Category", Placeholder: "Select Category",
							Options: categoryComboOptions(getCategoriesOfKinds(cats, kind)),
							Data:    *fd.CategoryID, Nullable: true, Searchable: true,
						})
					}
				}
				if fd.CounterpartyID != nil {
					@form.Field("Counterparty", "counterparty_id", id, icons.User("15"), fd.CounterpartyID.Error) {
						@form.Combobox(form.ComboboxProps{
							Name: "counterparty_id", ID: id, Label: "Counterparty", Placeholder: "Select Counterparty",
							Options: counterpartyComboOptions(cps),
							Data:    *fd.CounterpartyID, Nullable: true, Searchable: true,
						})
					}
				}
				if fd.GoalID != nil {
					<div class="sm:col-span-2">
						@form.Field("Goal", "goal_id", id, icons.Target("15"), fd.GoalID.Error) {
							@form.Combobox(form.ComboboxProps{
								Name: "goal_id", ID: id, Label: "Goal", Placeholder: "Select Goal",
								Options: goalComboOptions(gls),
								Data:    *fd.GoalID, Nullable: true, Searchable: true,
							})
						}
					</div>
				}
			</div>
		}
	</div>
}

templ categoryDot(color string) {
	<span class="shrink-0 w-2.5 h-2.5 rounded-full" style={ fmt.Sprintf("background-color: %s", models.CategoryColorToHex(color)) }></span>
}

func categoryComboOptions(cats []models.Category) []form.ComboOption {
	opts := make([]form.ComboOption, len(cats))
	for i, c := range cats {
		opts[i] = form.ComboOption{Value: c.ID, Label: c.Name, Leading: categoryDot(c.Color)}
	}
	return form.SortComboOptions(opts)
}

func counterpartyComboOptions(cps []models.Counterparty) []form.ComboOption {
	opts := make([]form.ComboOption, len(cps))
	for i, cp := range cps {
		opts[i] = form.ComboOption{
			Value:   cp.ID,
			Label:   cp.Name,
			Search:  strings.Join(cp.Aliases, " "),
			Leading: components.CounterpartyIcon(cp.Name, cp.Icon, cp.Color, "w-5 h-5 text-[11px]"),
		}
	}
	return form.SortComboOptions(opts)
}

func goalComboOptions(gls []models.Goal) []form.ComboOption {
	opts := make([]form.ComboOption, len(gls))
	for i := range gls {
		opts[i] = form.ComboOption{
			Value:   gls[i].ID,
			Label:   gls[i].Name,
			Leading: icons.Target("16", &templ.Attributes{"class": "shrink-0 text-zinc-400"}),
		}
	}
	return form.SortComboOptions(opts)
}

// txAccountLabel names the account select by where the money goes.
func txAccountLabel(fd *TransactionAmountsAndKindFD) string {
	switch {
	case fd.ToAccountIFD != nil:
		return "From account"
	case models.GetTxKindFromString(fd.Kind.Value).IsIncoming():
		return "To account"
	default:
		return "Account"
	}
}

func getTxKindsForAccounts(accs []models.Account, knds []models.TxKind) []models.TxKind {
	nknds := slicesutils.Filter(knds, func(k models.TxKind) bool { return k != models.NilTxKind })
	notDebt := slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum != models.AccKindDebt })
	if len(notDebt) < 2 {
		nknds = slicesutils.Filter(nknds, func(k models.TxKind) bool { return k != models.TransferTxKind })
	}
	if len(notDebt) == len(accs) {
		nknds = slicesutils.Filter(nknds, func(k models.TxKind) bool { return k != models.DebtTxKind })
	}
	return nknds
}

func getTxAccs(accs []models.Account, txKind models.TxKind, isSwitched bool) []models.Account {
	if txKind == models.DebtTxKind && isSwitched {
		return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum == models.AccKindDebt })
	}

	return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum != models.AccKindDebt })
}

func getTxCounterAccs(accs []models.Account, txKind models.TxKind, isSwitched bool) []models.Account {
	if txKind != models.DebtTxKind || isSwitched {
		return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum != models.AccKindDebt })
	}

	return slicesutils.Filter(accs, func(a models.Account) bool { return a.Kind.Enum == models.AccKindDebt })
}

func isSwitched(accs []models.Account, accId string) bool {
	acc := slicesutils.Find(accs, func(a models.Account) bool { return a.ID == accId })
	return acc != nil && acc.Kind.Enum == models.AccKindDebt
}

func getCategoriesOfKinds(cats []models.Category, txKind models.TxKind) []models.Category {
	kndsCats := []models.Category{}
	for _, cat := range cats {
		for _, kind := range cat.Kinds {
			if kind == txKind.CategoryKind() {
				kndsCats = append(kndsCats, cat)
			}
		}
	}
	return kndsCats
}

func getTransactionMenuItems(tx *models.Transaction) []templ.Component {
	items := []templ.Component{}

	if tx.FulfilledAt.IsZero() {
		items = append(items,
			components.EntryMenuAnchorItem("Fulfill", "put", fmt.Sprintf("/transactions/%s/fulfill", tx.ID)))
	}

	if tx.NeedsReview {
		items = append(items,
			components.EntryMenuAnchorItem("Mark reviewed", "put", fmt.Sprintf("/transactions/%s/reviewed", tx.ID)))
	}

	if tx.Kind == models.IncomeTxKind {
		items = append(items,
			components.EntryMenuAnchorItem("Reimburses…", "get", fmt.Sprintf("/transactions/%s/reimburses", tx.ID)))
	}

	items = append(items,
		components.EntryMenuAnchorItem("Edit", "get", fmt.Sprintf("/transactions/%s/edit", tx.ID)),
		components.EntryMenuDeleteItem(fmt.Sprintf("/transactions/%s", tx.ID)),
	)

	return items
}

func getReimbursementMenuItems(tx *models.Transaction) []templ.Component {
	items := []templ.Component{}

	if tx.FulfilledAt.IsZero() {
		items = append(items,
			components.EntryMenuAnchorItem("Fulfill", "put", fmt.Sprintf("/transactions/%s/fulfill", tx.ID)))
	}

	if tx.NeedsReview {
		items = append(items,
			components.EntryMenuAnchorItem("Mark reviewed", "put", fmt.Sprintf("/transactions/%s/reviewed", tx.ID)))
	}

	return append(items,
		components.EntryMenuAnchorItem("Unlink reimbursement", "delete", fmt.Sprintf("/transactions/%s/reimburses", tx.ID)),
		components.EntryMenuAnchorItem("Edit", "get", fmt.Sprintf("/transactions/%s/edit", tx.ID)),
		components.EntryMenuDeleteItem(fmt.Sprintf("/transactions/%s", tx.ID)),
	)
}

type txDay struct {
	Day time.Time
	Txs []models.Transaction
}

// groupTxsByDay expects transactions already sorted by scheduled date.
func groupTxsByDay(txs []models.Transaction) []txDay {
	days := []txDay{}
	for _, tx := range txs {
		y, m, d := tx.ScheduledTo.Date()
		day := time.Date(y, m, d, 0, 0, 0, 0, tx.ScheduledTo.Location())
		if n := len(days); n > 0 && days[n-1].Day.Equal(day) {
			days[n-1].Txs = append(days[n-1].Txs, tx)
			continue
		}
		days = append(days, txDay{Day: day, Txs: []models.Transaction{tx}})
	}
	return days
}

func formatTxDay(day time.Time) string {
	if day.Year() != time.Now().Year() {
		return day.Format("January 2 2006, Monday")
	}
	return day.Format("January 2, Monday")
}

type txView struct {
	counterparty *models.Counterparty
	title        string
	subtitle     string
	time         string
	account      string
	amount       string
	isIncoming   bool
	isStale      bool
}

func newTxView(tx *models.Transaction) txView {
	v := txView{
		title:   tx.Description,
		account: tx.Account.Name,
		amount:  "-" + tx.ViewAmount(),
		isStale: tx.FulfilledAt.IsZero(),
		time:    "Scheduled",
	}
	if !v.isStale {
		v.time = tx.FulfilledAt.Format("3:04pm")
	}

	switch tx.Kind {
	case models.ExpenseTxKind:
		if tx.Reimbursed > 0 {
			v.amount = "-" + tx.ViewNetAmount()
		}
	case models.IncomeTxKind, models.RefundTxKind:
		v.amount = "+" + tx.ViewAmount()
		v.isIncoming = true
	case models.TransferTxKind:
		if tx.ToAccount != nil {
			v.title = tx.Account.Name
			v.account = tx.ToAccount.Name
			v.amount = tx.ViewToAmount()
			if tx.Account.Currency.ID != tx.ToAccount.Currency.ID {
				v.subtitle = "-" + tx.ViewAmount()
			} else if fee := tx.Amount - tx.ToAmount; fee > 0 {
				v.subtitle = "Fees " + formatters.FormatAmount(fee, tx.Account.Currency.Symbol)
			}
		}
		return v
	case models.DebtTxKind:
		if tx.ToAccount != nil {
			// Borrowing: money comes from the debt account into a real one.
			if tx.Account.Kind.Enum == models.AccKindDebt {
				v.title = debtPartyName(&tx.Account)
				v.account = tx.ToAccount.Name
				v.amount = "+" + tx.ViewToAmount()
				v.isIncoming = true
			} else {
				v.title = debtPartyName(tx.ToAccount)
			}
		}
		if tx.Description != "" {
			v.subtitle = tx.Description
		}
		return v
	}

	if v.title == "" && tx.Category != nil {
		v.title = tx.Category.Name
	}
	if tx.Counterparty != nil {
		v.counterparty = tx.Counterparty
		if v.title == "" {
			v.title = tx.Counterparty.Name
		} else {
			v.subtitle = tx.Counterparty.Name
		}
	}
	if v.title == "" {
		v.title = tx.Kind.String()
	}
	return v
}

func debtPartyName(acc *models.Account) string {
	if acc.Counterparty != nil && acc.Counterparty.Name != "" {
		return acc.Counterparty.Name
	}
	return acc.Name
}
