package views

import "github.com/omareloui/financial-plans/internal/models"

type TransactionFormData struct {
	Amount      FormInputData
	CurrencyID  FormInputData
	KindID      FormInputData
	IsRecurrent FormInputData
}

templ Transactions(transactions []models.Transaction, currencies map[string]string, kinds map[string]string, formdata *TransactionFormData) {
	@baseLayout("Transactions") {
		@container() {
			<h2 class="text-3xl font-bold mb-3">Transactions</h2>
			@CreateTransactionForm(currencies, kinds, formdata)
			@transactionsList(transactions)
		}
	}
}

templ CreateTransactionForm(currencies map[string]string, kinds map[string]string, formdata *TransactionFormData) {
	@form("post", "/transactions") {
		<div class="grid grid-cols-3 gap-4">
			@input("Amount", "number", "amount", "1000$", "", formdata.Amount, "col-span-2")
			@selectInput("Currency", "currency_id", "Select a Currency", "", currencies, formdata.CurrencyID)
		</div>
		@selectInput("Kind", "kind_id", "Selected a Kind", "", kinds, formdata.KindID)
		// TODO: show a date picker to select when to end the repeatation if this is true
		@checkbox("Is Recurrent", "is_recurrent", "", formdata.IsRecurrent)
		@sumbitButton("Create Transaction")
	}
}

templ TransactionOOB(tx *models.Transaction) {
	<div id="tx-list" hx-swap-oob="beforeend">
		@transaction(tx)
	</div>
}

templ transactionsList(transactions []models.Transaction) {
	@list("tx-list") {
		for _, t := range transactions {
			@transaction(&t)
		}
	}
}

templ transaction(t *models.Transaction) {
	<div hx-target="this" class="entry-container">
		<p>ID: { t.ID }</p>
		<p>Amount: { t.ViewAmount() }</p>
	</div>
}
