package views

import (
	"encoding/json"
	"fmt"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
	"github.com/omareloui/tyche/web/views/components"
)

const (
	PayCash         = "cash"
	PayInstallments = "installments"
)

// PurchaseFD is a price, paid cash or by an installment plan.
type PurchaseFD struct {
	AmountFD *form.AmountFD
	Mode     form.FDInput
	Plan     InstallmentPlanFD
}

type WorkSettingsFD struct {
	Salary       *form.AmountFD
	HoursPerWeek form.FDInput
}

// AffordURL opens the "Plan it" drawer, prefilled from the wish itemID, if
// any.
func AffordURL(itemID string) string {
	if itemID == "" {
		return "/decide/afford"
	}
	return "/decide/afford?wishlist_id=" + itemID
}

// PlanItFD is the "Plan it" form: what it is, its price and the plan.
type PlanItFD struct {
	Name     form.FDInput
	AmountFD *form.AmountFD
	// WishlistID is the wish it's planned for, if any.
	WishlistID string
	Plan       *GoalPlanFD
}

// AffordDrawer plans a purchase like a goal, from the money free now (the
// balance less the budgets and goal deposits left): by a monthly amount or
// the day it's bought, saving it all or with a down payment and a loan,
// weighed as it's typed against every month's money. It can be saved as a
// goal.
templ AffordDrawer(fd *PlanItFD, curs []models.Currency, defaultCur *models.Currency, ws *models.WorkSettings, money models.GoalPlanMoney, result templ.Component) {
	{{ mode := fd.Plan.Mode.Value }}
	if mode == "" {
		{{ mode = models.GoalPlanSave.String() }}
	}
	@components.Drawer(components.DrawerProps{Label: "Plan it"}) {
		<div class="drawer-panel flex flex-col flex-1 min-h-0 [--accent:var(--color-violet-400)]">
			<header class="flex items-start gap-3 px-5 sm:px-6 pt-5 pb-4">
				<div class="flex-1 min-w-0">
					<p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-(--accent)">
						@icons.Target("14")
						Plan it
					</p>
					if fd.WishlistID != "" {
						<h2 title={ fd.Name.Value } class="mt-1 text-lg font-bold leading-snug break-words line-clamp-2">{ fd.Name.Value }</h2>
					} else {
						<p class="mt-1 text-sm text-zinc-500">When can you get it, and what does it do to your money and goals?</p>
					}
				</div>
				@components.DrawerClose()
			</header>
			<form
				id="afford"
				hx-post="/decide/afford"
				hx-trigger="input delay:400ms, change"
				hx-target="#afford-result"
				hx-swap="innerHTML"
				class="flex-1 flex flex-col min-h-0"
				@submit.prevent
			>
				<div class="flex-1 grid grid-cols-1 auto-rows-max content-start gap-5 px-5 sm:px-6 pb-6 overflow-y-auto overscroll-contain">
					<div x-data={ moneyInputsData(curs, fd.AmountFD.CurrencyID.Value, defaultCur, mode, fd.Plan.Loan.strategy()) } @change="onChange($event)" class="grid gap-5">
						if fd.WishlistID != "" {
							<input type="hidden" name="wishlist_id" value={ fd.WishlistID }/>
							<input type="hidden" name="name" value={ fd.Name.Value }/>
						} else {
							@form.Field("What is it?", "name", "afford", icons.Star("15"), fd.Name.Error) {
								@form.Control("text", "name", "e.g. A new laptop", "afford", fd.Name, nil)
							}
						}
						@plainAmountInputs("Price", icons.Tag("15"), fd.AmountFD, "afford", curs, defaultCur, false)
						@planInputs(fd.Plan, "afford", mode)
					</div>
					<div id="afford-result">
						@result
					</div>
					@WorkSettingsSummary(ws)
				</div>
				<footer class="flex items-center justify-end gap-3 px-5 sm:px-6 py-4 border-t border-zinc-800">
					<p id="afford-save-error" class="mr-auto text-sm text-red-400"></p>
					<button
						type="button"
						hx-post="/decide/goal"
						hx-target="#afford-save-error"
						hx-swap="innerHTML"
						class="btn-primary"
					>
						@icons.Target("18")
						Save as a goal
					</button>
				</footer>
			</form>
		</div>
	}
}

// PlanItResult is the plan's options (saving it all or a down payment and
// a loan, from the money free now) and the picked one weighed on the day
// it's bought.
templ PlanItResult(gl *models.Goal, money models.GoalPlanMoney, opts GoalPlanOptions, a *models.Affordability, ws *models.WorkSettings) {
	<div class="grid gap-4">
		if gl.Progress() > 0.005 {
			<p class="text-sm text-zinc-500">
				Starting from the <span class="sensitive text-zinc-300 tabular-nums">{ gl.Currency.Format(gl.Progress()) }</span> free now: your balance less this month's budgets and goal deposits left.
			</p>
		}
		@GoalPlanPreview(gl, money, opts)
		if a != nil {
			@AffordResult(a, ws)
		}
	</div>
}

// purchaseInputs are a price, its currency and how it's paid: cash, or by
// an installment plan. withPreview sums the plan up as it's filled, for
// forms with no live result of their own.
templ purchaseInputs(fd *PurchaseFD, id string, curs []models.Currency, defaultCur *models.Currency, withPreview bool) {
	{{ mode := fd.Mode.Value }}
	if mode == "" {
		{{ mode = PayCash }}
	}
	<div x-data={ moneyInputsData(curs, fd.AmountFD.CurrencyID.Value, defaultCur, mode, fd.Plan.strategy()) } @change="onChange($event)" class="grid gap-4">
		@plainAmountInputs("Price", icons.Tag("15"), fd.AmountFD, id, curs, defaultCur, false)
		@form.SegmentedRadio("Paying", "mode", id, []form.RadioOption{
			{Value: PayCash, Label: "Cash"},
			{Value: PayInstallments, Label: "Installments"},
		}, form.FDInput{Value: mode}, nil)
		<div x-show={ fmt.Sprintf("mode === '%s'", PayInstallments) } x-cloak>
			@installmentPlanInputs(&fd.Plan, id, withPreview)
		</div>
	</div>
}

// moneyMask formats an amount with the symbol of the currency picked in the
// moneyInputs scope.
const moneyMask = "(sym ? sym + ' ' : '') + $money($input, '.', ',')"

// plainAmountInputs is a labeled amount and a currency picker with no
// requests of their own. It expects a moneyInputs scope for the symbol.
templ plainAmountInputs(label string, icon templ.Component, fd *form.AmountFD, id string, curs []models.Currency, defaultCur *models.Currency, sensitive bool) {
	{{ cur := fd.CurrencyID }}
	if cur.Value == "" && defaultCur != nil {
		{{ cur.Value = defaultCur.ID }}
	}
	<div class="grid grid-cols-[1fr_9rem] gap-3">
		@form.Field(label, "amount", id, icon, fd.Amount.Error) {
			<div class={ templ.KV("sensitive", sensitive) }>
				@form.Control("text", "amount", "", id, fd.Amount, templ.Attributes{
					"autocomplete":   "off",
					"inputmode":      "decimal",
					"data-money":     true,
					"x-mask:dynamic": moneyMask,
					":placeholder":   "money(1000)",
				})
			</div>
		}
		@form.Field("Currency", "currency_id", id, nil, fd.CurrencyID.Error) {
			@form.Combobox(form.ComboboxProps{
				Name: "currency_id", ID: id, Label: "Currency", Placeholder: "Currency",
				Options: form.CurrencyComboOptions(curs), Data: cur, Searchable: true,
			})
		}
	</div>
}

// moneyInputsData starts a moneyInputs scope with the currencies' symbols
// and the picked one's.
func moneyInputsData(curs []models.Currency, curID string, defaultCur *models.Currency, mode, strategy string) string {
	syms := make(map[string]string, len(curs))
	for _, c := range curs {
		syms[c.ID] = c.Symbol
	}
	symsJSON, _ := json.Marshal(syms)
	symJSON, _ := json.Marshal(form.GetCurOrDefaultSym(curs, curID, defaultCur))
	modeJSON, _ := json.Marshal(mode)
	strategyJSON, _ := json.Marshal(strategy)
	return fmt.Sprintf("moneyInputs(%s, %s, %s, %s)", symsJSON, symJSON, modeJSON, strategyJSON)
}

// AffordResult is the purchase's impact, or a hint when there's none yet.
templ AffordResult(a *models.Affordability, ws *models.WorkSettings) {
	if a == nil {
		@AffordHint("The verdict shows up here.")
	} else {
		<div class="grid gap-4">
			<div class={ "px-4 py-3 rounded-2xl ring-1", verdictClass(a.Verdict) }>
				<p class="font-semibold">
					{ a.Verdict.String() }
					if !a.IsToday() {
						<span class="font-normal opacity-80">on { affordDay(a.On) }</span>
					}
				</p>
				if len(a.Reasons) > 0 {
					<ul class="mt-1 text-sm opacity-80 list-disc pl-4">
						for _, reason := range a.Reasons {
							<li>{ reason }</li>
						}
					</ul>
				}
				if !a.Earliest.IsZero() {
					<p class="mt-2 flex items-center gap-1.5 text-sm font-medium">
						@icons.Calendar("14")
						It fits from { affordDay(a.Earliest) }
					</p>
				}
			</div>
			@affordBalance(a)
			<dl class="grid grid-cols-2 sm:grid-cols-3 gap-2">
				if a.Purchase.IsInstallments() {
					if a.PaidOnDay > 0 {
						@affordStat("Paid on the day", a.Currency.Format(a.PaidOnDay), "")
						@affordStat("Left after it", a.Currency.Format(a.BalanceAfter), "sensitive "+amountClass(a.BalanceAfter))
					}
					@affordStat("After the last payment", a.Currency.Format(a.BalanceAfterAll), "sensitive "+amountClass(a.BalanceAfterAll))
					if a.MinBalance < a.BalanceAfter-0.005 && a.MinBalance < a.BalanceAfterAll-0.005 {
						@affordStat("Lowest, "+a.MinOn.Format("Jan 2006"), a.Currency.Format(a.MinBalance), "sensitive "+amountClass(a.MinBalance))
					}
					@affordStat("In total", a.Currency.Format(a.TotalCost), "")
					if a.Extra > 0.005 {
						@affordStat("Over the cash price", a.Currency.Format(a.Extra), "text-amber-300")
					}
				} else {
					@affordStat("Left after buying", a.Currency.Format(a.BalanceAfter), "sensitive "+amountClass(a.BalanceAfter))
				}
				if a.SalaryShare > 0 {
					@affordStat(salaryShareLabel(a), fmt.Sprintf("%.0f%%", a.SalaryShare*100), "")
				}
			</dl>
			if a.Schedule != nil {
				@planBreakdownShort(a.Schedule, a.Purchase.Currency.Symbol, a.On, false, a.Short)
			}
			@affordMonth(a)
			if a.WorkHours > 0 {
				<p class="flex items-center gap-2 text-zinc-300">
					@icons.Clock("16", &templ.Attributes{"class": "shrink-0 text-(--accent)"})
					<span>That's <span class="font-semibold tabular-nums">{ ws.ViewHours(a.WorkHours) }</span> of work.</span>
				</p>
			}
			if len(a.Goals) > 0 {
				<div class="grid gap-2">
					<p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Your goals with no plan</p>
					for _, g := range a.Goals {
						@goalImpact(&g)
					}
				</div>
			}
		</div>
	}
}

// affordBalance works out the balance on the day: today's, less this
// month's budgets left and the goals' deposits due, plus the money free
// on the paydays until then.
templ affordBalance(a *models.Affordability) {
	if a.BudgetLeft > 0.005 || a.GoalsDue > 0.005 || a.Paydays > 0 {
		<dl class="grid gap-1.5 px-4 py-3 rounded-2xl bg-zinc-800/30 ring-1 ring-zinc-800 text-sm tabular-nums">
			@goalPlanMoneyRow("Balance now", a.Currency.Format(a.BalanceNow), "")
			if a.BudgetLeft > 0.005 {
				@goalPlanMoneyRow("Left in this month's budgets", "− "+a.Currency.Format(a.BudgetLeft), "")
			}
			if a.GoalsDue > 0.005 {
				@goalPlanMoneyRow("Goal deposits due now", "− "+a.Currency.Format(a.GoalsDue), "")
			}
			if a.Paydays > 0 {
				@goalPlanMoneyRow(fmt.Sprintf("Free over %d %s", a.Paydays, plural(a.Paydays, "month", "months")), signedAmount(&a.Currency, a.FreeUntil), "")
			}
			<div class="flex items-center justify-between gap-3 pt-1.5 border-t border-zinc-800">
				<dt class="font-medium text-zinc-200">
					if a.IsToday() {
						Yours to spend today
					} else {
						Yours on { affordDay(a.On) }
					}
				</dt>
				<dd class={ "sensitive font-bold text-(--accent)", amountClass(a.BalanceOn) }>{ a.Currency.Format(a.BalanceOn) }</dd>
			</div>
		</dl>
	} else {
		<dl class="grid grid-cols-1">
			@affordStat("Balance now", a.Currency.Format(a.BalanceNow), "sensitive")
		</dl>
	}
}

// affordMonth is a month's money around the day, like a goal plan's: the
// salary less the budgets and each goal's plan, and when the goals stop
// taking money.
templ affordMonth(a *models.Affordability) {
	if !a.HasSalary {
		<p class="flex items-start gap-2 px-4 py-3 rounded-2xl bg-zinc-800/30 ring-1 ring-zinc-800 text-sm text-zinc-400">
			@icons.Wallet("16", &templ.Attributes{"class": "shrink-0 mt-0.5"})
			<span>
				Set your monthly salary in <a href={ SettingsURL(SettingsWork) } class="text-(--accent) underline-offset-2 hover:underline">Settings</a> to count what's free every month after your budgets and goals. Until then it all comes out of your balance.
			</span>
		</p>
	} else if m := a.Month; m != nil {
		<div class="grid gap-2">
			<p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">
				Every month, from { affordDay(m.Payday) }
			</p>
			<dl class="grid gap-1.5 px-4 py-3 rounded-2xl bg-zinc-800/30 ring-1 ring-zinc-800 text-sm tabular-nums">
				@goalPlanMoneyRow("Salary", a.Currency.Format(m.Salary), "")
				@goalPlanMoneyRow("Budgets", "− "+a.Currency.Format(m.Budgets), "")
				for _, g := range m.Goals {
					@goalPlanMoneyRow(goalOutlayLabel(&g), "− "+a.Currency.Format(g.Amount), "")
				}
				<div class="flex items-center justify-between gap-3 pt-1.5 border-t border-zinc-800">
					<dt class="font-medium text-zinc-200">Free</dt>
					<dd class={ "sensitive font-bold text-(--accent)", amountClass(m.Free()) }>{ a.Currency.Format(m.Free()) }</dd>
				</div>
			</dl>
			if len(a.FreeDates) > 0 {
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-sm text-zinc-500">Start saving</span>
					for _, f := range a.FreeDates {
						<button type="button" class="wl-action" onclick={ templ.JSFuncCall("setPlanStart", f.On.Format(time.DateOnly)) }>
							@icons.Target("14")
							{ goalFreeLabel(&f) } · { affordDay(f.On) }
						</button>
					}
				</div>
			}
		</div>
	}
}

func affordDay(t time.Time) string {
	if t.Year() != time.Now().Year() {
		return t.Format("Jan 2, 2006")
	}
	return t.Format("Jan 2")
}

func signedAmount(cur *models.Currency, v float64) string {
	if v < 0 {
		return "− " + cur.Format(-v)
	}
	return "+ " + cur.Format(v)
}

func goalOutlayLabel(g *models.GoalOutlay) string {
	if g.Loan {
		return g.Goal.Name + " · loan"
	}
	return g.Goal.Name + " · saving"
}

func goalFreeLabel(f *models.GoalFreeDate) string {
	if f.Loan {
		return "After " + f.Goal.Name + "'s loan"
	}
	return "After " + f.Goal.Name
}

templ affordStat(label, value, valueClass string) {
	<div class="min-w-0 px-3 py-2 rounded-2xl bg-zinc-900/60 ring-1 ring-zinc-800">
		<dt class="text-xs text-zinc-500 truncate">{ label }</dt>
		<dd class={ "text-lg font-bold tabular-nums truncate", valueClass }>{ value }</dd>
	</div>
}

templ goalImpact(g *models.GoalImpact) {
	<div class="flex items-center gap-3 px-3 py-2 rounded-2xl bg-zinc-900/60 ring-1 ring-zinc-800">
		@icons.Target("16", &templ.Attributes{"class": "shrink-0 text-violet-400"})
		<div class="flex-1 min-w-0">
			<p class="truncate">{ g.Goal.Name }</p>
			<p class="text-xs text-zinc-500 tabular-nums">
				<span class="sensitive">{ g.Goal.Currency.Format(g.Remaining) }</span> left · this is { fmt.Sprintf("%.0f%%", g.PctOfRemaining) } of it
			</p>
		</div>
		<p class="shrink-0 text-sm text-right tabular-nums">
			if g.DelayMonths >= 0 {
				<span class={ delayClass(g.DelayMonths) }>+{ fmt.Sprintf("%.1f", g.DelayMonths) } mo</span>
			} else {
				<span class="text-zinc-500">no recent savings</span>
			}
		</p>
	</div>
}

templ AffordHint(msg string) {
	<p class="text-sm text-zinc-500">{ msg }</p>
}

func NewWorkSettingsFD(ws *models.WorkSettings) *WorkSettingsFD {
	amt := ""
	if ws.MonthlySalary > 0 {
		amt = fmt.Sprintf("%.2f", ws.MonthlySalary)
	}
	return &WorkSettingsFD{
		Salary: &form.AmountFD{
			Amount:     form.FDInput{Value: amt},
			CurrencyID: form.FDInput{Value: ws.Currency.ID},
		},
		HoursPerWeek: form.FDInput{Value: fmt.Sprintf("%g", ws.HoursPerWeek)},
	}
}

// WishlistBuySheet opens the prefilled transaction form (a form.SheetForm
// drawer) of its own over the page, right away, kept out of the url (?new
// would reopen the page's own create form).
templ WishlistBuySheet(f templ.Component) {
	<div x-data="{openCreateForm: true}" data-drawer-no-url>
		@f
	</div>
}

func verdictClass(v models.Verdict) string {
	switch v {
	case models.VerdictNo:
		return "bg-red-400/10 ring-red-400/30 text-red-300"
	case models.VerdictCareful:
		return "bg-amber-300/10 ring-amber-300/30 text-amber-200"
	}
	return "bg-emerald-400/10 ring-emerald-400/30 text-emerald-300"
}

func amountClass(amount float64) string {
	if amount < 0 {
		return "text-red-400"
	}
	return ""
}

func delayClass(months float64) string {
	if months > 1 {
		return "text-amber-300"
	}
	return "text-zinc-300"
}

func salaryShareLabel(a *models.Affordability) string {
	if a.Purchase.IsInstallments() {
		return "Of a month's salary, at most"
	}
	return "Of a month's salary"
}
