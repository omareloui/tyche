package views

import (
	"encoding/json"
	"fmt"
	"strconv"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
)

// BalanceFD is a balance typed as the bank shows it (Account.BankEntry), in
// Unit for metals.
type BalanceFD struct {
	Amount form.FDInput
	Unit   string
}

// NewBalanceFD is a's balance as its form starts.
func NewBalanceFD(a *models.Account) *BalanceFD {
	u := a.AmountUnit("")
	return &BalanceFD{
		Amount: form.FDInput{Value: strconv.FormatFloat(models.ToUnit(a.BankEntry(), u), 'f', models.AmountDigits(u), 64)},
		Unit:   string(u),
	}
}

// FixBalancesFD is the fix balances form: each account's BalanceFD by id,
// the error of the last submit and how many accounts it changed (-1 before
// any).
type FixBalancesFD struct {
	Balances map[string]*BalanceFD
	Error    string
	Changed  int
}

// NewFixBalancesFD is the fix balances form as it starts.
func NewFixBalancesFD(accs []models.Account) *FixBalancesFD {
	fd := &FixBalancesFD{Balances: map[string]*BalanceFD{}, Changed: -1}
	for i := range accs {
		fd.Balances[accs[i].ID] = NewBalanceFD(&accs[i])
	}
	return fd
}

// FixBalancesDrawer sets every active account's balance, one at a time, in
// a drawer.
templ FixBalancesDrawer(accs []models.Account, fd *FixBalancesFD) {
	@components.Drawer(components.DrawerProps{Label: "Fix balances"}) {
		@FixBalancesForm(accs, fd)
	}
}

// FixBalancesForm steps through the accounts (fixBalances, main.js), the
// current one's balance in a big input, the list of them all under it.
templ FixBalancesForm(accs []models.Account, fd *FixBalancesFD) {
	{{ accs = fixBalancesOrder(accs) }}
	@form.DrawerForm(form.DrawerFormProps{
		Title: "Fix balances", Method: "post", URL: "/accounts/fix-balances", Submit: "Save balances",
		Attrs: templ.Attributes{"hx-disabled-elt": "find button[type=submit]", "x-data": fmt.Sprintf("fixBalances(%d)", len(accs))},
	}) {
		if len(accs) == 0 {
			<p class="text-zinc-400">No accounts yet.</p>
		} else {
			<div class="grid gap-2">
				<div class="flex items-center justify-between text-xs text-zinc-500 tabular-nums">
					<span x-text="`${k + 1} of ${n}`">1 of { strconv.Itoa(len(accs)) }</span>
					<span x-cloak x-show="changed()" x-text="`${changed()} changed`" class="text-(--accent)"></span>
				</div>
				<div class="flex gap-1" aria-hidden="true">
					for i, a := range accs {
						<button
							type="button"
							tabindex="-1"
							@click={ fmt.Sprintf("go(%d)", i) }
							class="h-1.5 flex-1 rounded-full bg-zinc-800 cursor-pointer transition-colors"
							:class={ fmt.Sprintf("k === %d ? 'bg-(--accent)!' : (changes[%s] ? 'bg-(--accent)/40!' : '')", i, jsString(a.ID)) }
						></button>
					}
				</div>
			</div>
			for i, a := range accs {
				<div
					data-step={ strconv.Itoa(i) }
					x-show={ fmt.Sprintf("k === %d", i) }
					if i > 0 {
						x-cloak
					}
					class="grid gap-4"
				>
					<h3 class="flex items-center justify-center gap-2 font-medium text-zinc-200">
						<span class="text-zinc-400">
							@accKindIcon(a.Kind.Enum, "18")
						</span>
						<span class="truncate">{ a.Name }</span>
					</h3>
					{{ attrs := templ.Attributes{"@keydown.enter": "onEnter($event)"} }}
					if i == 0 {
						{{ attrs["x-init"] = "$nextTick(() => { $el.focus(); $el.select() })" }}
					}
					@balanceStep(&a, fd.Balances[a.ID], "-"+a.ID, attrs)
				</div>
			}
			<div class="flex items-center justify-between">
				<button type="button" @click="go(k - 1)" :disabled="k === 0" class="btn-ghost h-9! px-3! disabled:opacity-40 disabled:cursor-default">
					← Previous
				</button>
				<button type="button" @click="go(k + 1)" :disabled="k === n - 1" class="btn-ghost h-9! px-3! disabled:opacity-40 disabled:cursor-default">
					Next →
				</button>
			</div>
			@form.ErrorMessage(fd.Error)
			if fd.Changed == 0 {
				<p class="text-sm text-zinc-400">Nothing changed.</p>
			}
			<ul class="divide-y divide-zinc-800 border-t border-zinc-800">
				for i, a := range accs {
					<li>
						<button
							type="button"
							@click={ fmt.Sprintf("go(%d)", i) }
							class="flex w-full items-center gap-3 py-2.5 text-left text-sm cursor-pointer transition-colors hover:text-white"
							:class={ fmt.Sprintf("k === %d ? 'text-(--accent)' : 'text-zinc-300'", i) }
						>
							<span class="shrink-0 text-zinc-500">
								@accKindIcon(a.Kind.Enum, "16")
							</span>
							<span class="flex-1 min-w-0 truncate">{ a.Name }</span>
							<span class="shrink-0 tabular-nums text-zinc-500 sensitive">{ a.Currency.Format(a.BankEntry()) }</span>
							<span
								x-cloak
								x-show={ fmt.Sprintf("changes[%s]", jsString(a.ID)) }
								x-text={ fmt.Sprintf("changes[%s]", jsString(a.ID)) }
								class="shrink-0 w-24 text-right tabular-nums text-(--accent)"
							></span>
						</button>
					</li>
				}
			</ul>
			<p class="text-xs text-zinc-500">
				Enter goes to the next account. The differences are recorded as "Adjustment" transactions, out of every analysis; delete one to undo it.
			</p>
		}
	}
}

// AdjustBalanceDrawer sets one account's balance, in a drawer.
templ AdjustBalanceDrawer(a *models.Account, fd *BalanceFD) {
	@components.Drawer(components.DrawerProps{Label: "Adjust " + a.Name}) {
		@AdjustBalanceForm(a, fd)
	}
}

// AdjustBalanceForm is AdjustBalanceDrawer's form alone, answered with its
// errors.
templ AdjustBalanceForm(a *models.Account, fd *BalanceFD) {
	@form.DrawerForm(form.DrawerFormProps{
		Title: "Adjust " + a.Name, Method: "post", URL: fmt.Sprintf("/accounts/%s/adjust", a.ID), Submit: "Save balance",
		Attrs: templ.Attributes{"hx-disabled-elt": "find button[type=submit]"},
	}) {
		@balanceStep(a, fd, "", templ.Attributes{"autofocus": true, "x-init": "$nextTick(() => { $el.focus(); $el.select() })"})
		<p class="text-xs text-zinc-500 text-center">
			The difference is recorded as an "Adjustment" transaction, out of every analysis; delete it to undo.
		</p>
	}
}

// balanceStep is a's balance typed as the bank shows it (balanceFix,
// main.js) in the transaction form's big amount input, its fields named
// amount<suffix> and amount_unit<suffix>.
templ balanceStep(a *models.Account, fd *BalanceFD, suffix string, inputAttrs templ.Attributes) {
	{{ id := "balance-" + a.ID }}
	<div class="grid grid-cols-1 justify-items-center gap-3" x-data={ balanceFixData(a, fd) }>
		<label for={ id } class="text-sm text-zinc-400">
			What the bank shows
		</label>
		<input
			id={ id }
			type="text"
			name={ "amount" + suffix }
			value={ fd.Amount.Value }
			placeholder={ a.Currency.Symbol + " 0.00" }
			autocomplete="off"
			inputmode="decimal"
			x-mask:dynamic="mask($input, $money)"
			class="amount-hero"
			if fd.Amount.Error != "" {
				aria-invalid="true"
			}
			{ inputAttrs... }
		/>
		@form.ErrorMessage(fd.Amount.Error)
		if fd.Unit != "" {
			@form.MetalUnitToggle("amount_unit"+suffix, a.ID, models.ParseMetalUnit(fd.Unit), templ.Attributes{
				"@change": "unit = $event.target.value; remask()",
			})
		}
		<p class="text-sm text-zinc-500 tabular-nums">
			Now <span class="sensitive">{ a.Currency.Format(a.BankEntry()) }</span>
			<span x-cloak x-show="diff() !== 0" :class="up() ? 'text-emerald-400' : 'text-red-400'" x-text="fmtDiff()"></span>
		</p>
		if a.SetAside > 0 {
			<p class="max-w-xs text-center text-xs text-zinc-500">
				Includes <span class="sensitive tabular-nums">{ a.ViewSetAside() }</span> set aside for goals, out of this account's balance (<span class="sensitive tabular-nums">{ a.ViewAmount() }</span>).
			</p>
		}
	</div>
}

func balanceFixData(a *models.Account, fd *BalanceFD) string {
	cur, _ := json.Marshal(a.BankEntry())
	return fmt.Sprintf("balanceFix(%s, %s, %s, %s)",
		jsString(a.ID), cur, jsString(a.Currency.Symbol), jsString(fd.Unit))
}

func jsString(s string) string {
	b, _ := json.Marshal(s)
	return string(b)
}

// fixBalancesOrder is accs in the order of the accounts page's sections.
func fixBalancesOrder(accs []models.Account) []models.Account {
	var res []models.Account
	for _, s := range accountSections {
		res = append(res, accountsInSection(accs, s.ID)...)
	}
	return res
}
