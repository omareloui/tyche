package views

import (
	"fmt"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/web/views/layouts"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
)

type AccountFD struct {
	AccountPartialFD   AccountPartialFD
	Note               form.FDInput
	SmsRef             form.FDInput
	IsArchive          form.FDInput
	ExcludeFromBalance form.FDInput
}

type AccountPartialFD struct {
	Name           *form.FDInput
	KindID         form.FDInput
	CurrencyID     form.FDInput
	Iban           *form.FDInput
	CardNumber     *form.FDInput
	CounterpartyID *form.FDInput
	CardLimit      *form.FDInput
	NameOnCard     *form.FDInput
	ExpirationDate *form.FDInput
}

templ Accounts(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *AccountFD, aknds []models.AccountKind,
	curs []models.Currency, accounts []models.Account,
	cps []models.Counterparty) {
	@layouts.WithCreateForm(claims, "Accounts", balances,
		CreateAccountForm(fd, aknds, curs, cps, &claims.DefaultCurrency),
		layouts.WithAlpineMask()) {
		@accountsList(accounts)
	}
}

templ CreateAccountForm(fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@form.CreateForm("Create Account", "/accounts", "Create Account") {
		@accountFormBody("0", fd, aknds, curs, cps, defaultCur)
	}
}

templ EditAccount(id string, fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@form.Form("put", fmt.Sprintf("/accounts/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@accountFormBody(id, fd, aknds, curs, cps, defaultCur)
		@form.EditFormButtons(fmt.Sprintf("/accounts/%s", id))
	}
}

templ accountFormBody(id string, fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@AccountInputs(id, &fd.AccountPartialFD, aknds, curs, cps, defaultCur)
	@form.TextInput("Note", "note", "Enter note", id, fd.Note, nil, nil)
	@form.TextInput("SMS Reference", "sms_ref", "As in bank SMS, e.g. 123-456***-789 or 1234", id, fd.SmsRef, nil, nil)
	@form.Checkbox("Is Archive", "is_archive", id, fd.IsArchive, nil, nil)
	@form.Checkbox("Exclude From Balance", "exclude_from_balance", id, fd.ExcludeFromBalance, nil, nil)
}

templ AccountInputs(id string, fd *AccountPartialFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	<div
		class="contents"
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="closest form:abort"
	>
		@form.SelectAccKind("kind_id", id, aknds, fd.KindID, templ.Attributes{
			"hx-post": fmt.Sprintf("/accounts-inputs/%s", id),
		})
		@form.SelectCurrency("currency_id", id, curs, fd.CurrencyID,
			templ.Attributes{
				"hx-post": fmt.Sprintf("/accounts-inputs/%s", id),
			})
		if fd.Name != nil {
			@form.TextInput("Name", "name", "Enter account name", id, *fd.Name, nil, nil)
		}
		if fd.Iban != nil {
			@form.IBANInput("IBAN", "iban", id, form.GetCurOrDefaultIbanPrefix(curs, fd.CurrencyID.Value, nil), *fd.Iban, nil, nil)
		}
		if fd.CardNumber != nil {
			@form.CreditCardInput("Card Number", "card_number", id, *fd.CardNumber, nil, nil)
		}
		if fd.NameOnCard != nil {
			@form.TextInput("Name on card", "name_on_card", "John Doe", id, *fd.NameOnCard, nil, nil)
		}
		if fd.CardLimit != nil {
			@form.MoneyInput("Card Limit", "card_limit", form.GetCurOrDefaultSym(curs, fd.CurrencyID.Value, defaultCur), id, *fd.CardLimit, nil, nil)
		}
		if fd.ExpirationDate != nil {
			@form.DateInput("Expiration Date", "expiration_date", id, *fd.ExpirationDate, nil, nil)
		}
		if fd.CounterpartyID != nil {
			@form.SelectCounterparty("counterparty_id", id, cps, *fd.CounterpartyID, false, nil)
		}
	</div>
}

templ accountsList(accounts []models.Account) {
	@components.Grid2ColOnSMUp("accounts-list") {
		for _, a := range accounts {
			@Account(&a)
		}
	}
}

templ Account(a *models.Account) {
	@components.EntryCard(components.WithCardTitle(a.Name), components.WithCardMenu(getAccountMenuItems(a))) {
		<p>ID: { a.ID }</p>
		if a.IsDefault {
			<p class="text-green-500">DEFAULT</p>
		}
		<p>
			Amount: <span
	class={ templ.KV("text-red-500", a.Amount < 0) }
>{ a.ViewAmount() }</span>
		</p>
		<p>
			Actual Amount: <span
	class={ templ.KV("text-red-500", a.ActualAmount < 0) }
>{ a.ViewActualAmount() }</span>
		</p>
		<p>Kind: { a.Kind.Enum.String() } </p>
		if a.Iban != "" {
			<p>IBAN: { a.MaskIban() } </p>
		}
		if a.Counterparty != nil {
			<p>Counterparty ID: { a.Counterparty.ID }</p>
			<p>Counterparty: { a.Counterparty.Name }</p>
		}
		if a.CardNumber != "" {
			<p>Card Number: { a.MaskCardNumber() } </p>
		}
		if a.SmsRef != "" {
			<p>SMS Reference: { a.SmsRef } </p>
		}
		if a.CardLimit != 0 {
			<p>Card Limit: { a.ViewCardLimit() } </p>
		}
		if a.NameOnCard != "" {
			<p>Name on Card: { a.NameOnCard } </p>
		}
		if !a.ExpirationDate.IsZero() {
			<p>Expiration Date: { a.ExpirationDate.Format(time.DateOnly) } </p>
		}
		if a.Note != "" {
			<p>Note: { a.Note } </p>
		}
		<p>
			Is Archive:
			if a.IsArchive {
				true
			} else {
				false
			}
		</p>
		<p>
			Exclude From Balance:
			if a.ExcludeFromBalance {
				true
			} else {
				false
			}
		</p>
	}
}

templ AccountOOB(a *models.Account) {
	<div id="accounts-list" hx-swap-oob="afterbegin">
		@Account(a)
	</div>
}

func getAccountMenuItems(a *models.Account) []templ.Component {
	items := []templ.Component{
		components.EntryMenuAnchorItem("Edit", "get", fmt.Sprintf("/accounts/%s/edit", a.ID)),
	}

	if !a.IsDefault {
		items = append(items,
			components.EntryMenuAnchorItem("Set as Default", "put", fmt.Sprintf("/accounts/%s/default", a.ID)))
	}

	items = append(items, components.EntryMenuDeleteItem(fmt.Sprintf("/accounts/%s", a.ID)))

	return items
}
