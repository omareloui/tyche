package views

import (
	"fmt"
	"slices"
	"strings"
	"time"

	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
	"github.com/omareloui/tyche/web/views/layouts"
)

type AccountFD struct {
	AccountPartialFD   AccountPartialFD
	Note               form.FDInput
	SmsRefs            form.FDInput
	IsArchive          form.FDInput
	ExcludeFromBalance form.FDInput
}

type AccountPartialFD struct {
	Name           *form.FDInput
	KindID         form.FDInput
	CurrencyID     form.FDInput
	Iban           *form.FDInput
	CardNumber     *form.FDInput
	CounterpartyID *form.FDInput
	CardLimit      *form.FDInput
	NameOnCard     *form.FDInput
	ExpirationDate *form.FDInput
	// Cycle is set for credit cards.
	Cycle *CardCycleFD
	// Gamyaa is set for gam'yaa accounts.
	Gamyaa *GamyaaFD
}

// CardCycleFD is a credit card's statement cycle: the day it closes, then due
// DueValue days after (DueMode "days") or on that day of the next month
// ("day").
type CardCycleFD struct {
	StatementDay form.FDInput
	DueMode      form.FDInput
	DueValue     form.FDInput
}

type GamyaaFD struct {
	Installment form.FDInput
	Members     form.FDInput
	Shares      form.FDInput
	Turns       form.FDInput
	StartsOn    form.FDInput
	PayFromID   form.FDInput

	PayFromAccounts []models.Account
	// Gamyaa is the gam'yaa as filled so far, or as created when editing.
	Gamyaa   *models.Gamyaa
	Currency models.Currency
}

templ Accounts(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *AccountFD, aknds []models.AccountKind,
	curs []models.Currency, accounts []models.Account,
	cps []models.Counterparty) {
	@layouts.WithCreateForm(claims, "Accounts", balances,
		CreateAccountForm(fd, aknds, curs, cps, &claims.DefaultCurrency)) {
		if len(accounts) > 0 {
			<div class="flex justify-end -mt-3 mb-4">
				<a
					href="/accounts/fix-balances"
					class="inline-flex items-center gap-1.5 text-sm text-zinc-400 transition-colors hover:text-white"
				>
					@icons.Scale("16")
					Fix balances
				</a>
			</div>
		}
		@accountsList(accounts, &claims.DefaultCurrency)
	}
}

templ CreateAccountForm(fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@form.SheetForm("New account", "/accounts", "Add account", "acc-form") {
		@accountFormBody("0", fd, aknds, curs, cps, defaultCur)
	}
}

// EditAccount is the account's edit form, in a drawer.
templ EditAccount(id string, fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@components.Drawer(components.DrawerProps{Label: "Edit account"}) {
		@EditAccountForm(id, fd, aknds, curs, cps, defaultCur)
	}
}

// EditAccountForm is EditAccount's form alone, answered with its errors.
templ EditAccountForm(id string, fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@form.DrawerForm(form.DrawerFormProps{
		Title: "Edit account", Method: "put", URL: fmt.Sprintf("/accounts/%s", id),
		Submit: "Save changes", Class: "acc-form",
	}) {
		@accountFormBody(id, fd, aknds, curs, cps, defaultCur)
	}
}

templ accountFormBody(id string, fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@AccountInputs(id, &fd.AccountPartialFD, aknds, curs, cps, defaultCur)
	<div class="grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
		@form.Field("SMS references", "sms_refs", id, icons.Message("15"), fd.SmsRefs.Error) {
			@form.TagsInput("sms_refs", "As in bank SMS, e.g. 123-456***-789 or 1234", id, fd.SmsRefs)
		}
		<p class="-mt-2 text-sm text-zinc-500">Bank SMS mentioning any of them (e.g. the account and its debit card), or the card / IBAN's last digits, land in this account.</p>
	</div>
	@form.Field("Note", "note", id, icons.Pencil("15"), fd.Note.Error) {
		@form.Control("text", "note", "Anything to remember about it", id, fd.Note, nil)
	}
	<div class="grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
		<div>
			@form.Toggle("Exclude from balance", "exclude_from_balance", id, icons.EyeOff("18"), fd.ExcludeFromBalance, nil)
			<p class="mt-1 text-sm text-zinc-500">Its money doesn't count towards your total balance.</p>
		</div>
		<div>
			@form.Toggle("Archived", "is_archive", id, icons.Archive("18"), fd.IsArchive, nil)
			<p class="mt-1 text-sm text-zinc-500">Hidden from pickers, kept with its history.</p>
		</div>
	</div>
}

templ AccountInputs(id string, fd *AccountPartialFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	{{ kind := selectedAccKind(aknds, fd.KindID.Value) }}
	{{ cur := fd.CurrencyID }}
	if cur.Value == "" && defaultCur != nil {
		{{ cur.Value = defaultCur.ID }}
	}
	{{ onChange := templ.Attributes{"hx-post": fmt.Sprintf("/accounts-inputs/%s", id), "hx-trigger": "change"} }}
	<div
		class="contents"
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="closest form:abort"
		x-data="{name: $el.dataset.name, num: $el.dataset.num, holder: $el.dataset.holder, exp: $el.dataset.exp}"
		data-name={ fdValue(fd.Name) }
		data-num={ fdValue(fd.CardNumber) }
		data-holder={ fdValue(fd.NameOnCard) }
		data-exp={ fdValue(fd.ExpirationDate) }
	>
		if id != "0" && kind == models.AccKindGamyaa {
			<input type="radio" name="kind_id" value={ fd.KindID.Value } data-kind="gamyaa" class="hidden" checked/>
		} else {
			@selectAccKind("kind_id", id, editableAccKinds(aknds, id), fd.KindID, onChange)
		}
		<div class={ "grid gap-3", templ.KV("grid-cols-[1fr_9rem]", kind != models.AccKindGamyaa) }>
			if fd.Name != nil {
				@form.Field("Name", "name", id, icons.Pencil("15"), fd.Name.Error) {
					@form.Control("text", "name", accNamePlaceholder(kind), id, *fd.Name, templ.Attributes{"x-model": "name"})
				}
			}
			if fd.CounterpartyID != nil && kind == models.AccKindDebt {
				@form.Field("Who", "counterparty_id", id, icons.User("15"), fd.CounterpartyID.Error) {
					@form.Combobox(form.ComboboxProps{
						Name: "counterparty_id", ID: id, Label: "Who", Placeholder: "Select person",
						Options: counterpartyComboOptions(cps, fd.CounterpartyID.Value), Data: *fd.CounterpartyID, Searchable: true,
						CreateURL: "/counterparties/quick?person",
					})
				}
			}
			if kind == models.AccKindGamyaa {
				// Paid in its pay-from account's currency.
				<input type="hidden" name="currency_id" value={ cur.Value }/>
			} else {
				@form.Field("Currency", "currency_id", id, icons.Coins("15"), cur.Error) {
					@form.Combobox(form.ComboboxProps{
						Name: "currency_id", ID: id, Label: "Currency", Placeholder: "Currency",
						Options: form.CurrencyComboOptions(curs), Data: cur, Searchable: true,
						InputAttrs: onChange,
					})
				}
			}
		</div>
		if kind == models.AccKindDebt {
			<p class="-mt-2 text-sm text-zinc-500">The account takes the person's name. A positive balance means they owe you.</p>
		}
		if fd.Gamyaa != nil {
			if id == "0" {
				@gamyaaInputs(id, fd.Gamyaa, onChange)
			} else {
				@gamyaaSummary(fd.Gamyaa.Gamyaa, &fd.Gamyaa.Currency)
			}
			if fd.CounterpartyID != nil {
				@form.Field("Organizer", "counterparty_id", id, icons.User("15"), fd.CounterpartyID.Error) {
					@form.Combobox(form.ComboboxProps{
						Name: "counterparty_id", ID: id, Label: "Organizer", Placeholder: "Who collects it (optional)",
						Options: counterpartyComboOptions(cps, fd.CounterpartyID.Value), Data: *fd.CounterpartyID, Searchable: true, Nullable: true,
						CreateURL: "/counterparties/quick?person",
					})
				}
			}
		}
		if fd.CardNumber != nil || fd.Iban != nil {
			<div class="grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
				if fd.CardNumber != nil {
					@accountCardPreview(kind)
					@form.Field("Card number", "card_number", id, icons.Card("15"), fd.CardNumber.Error) {
						@form.Control("text", "card_number", "0000 0000 0000 0000", id, *fd.CardNumber, templ.Attributes{
							"autocomplete":   "off",
							"inputmode":      "numeric",
							"x-model":        "num",
							"x-mask:dynamic": "$input.startsWith('34') || $input.startsWith('37') ? '9999 999999 99999' : '9999 9999 9999 9999'",
						})
					}
				}
				<div class="grid grid-cols-[1fr_7rem] gap-3">
					if fd.NameOnCard != nil {
						<div class={ templ.KV("col-span-2", fd.ExpirationDate == nil) }>
							@form.Field("Name on card", "name_on_card", id, icons.User("15"), fd.NameOnCard.Error) {
								@form.Control("text", "name_on_card", "John Doe", id, *fd.NameOnCard, templ.Attributes{"x-model": "holder", "autocomplete": "off"})
							}
						</div>
					}
					if fd.ExpirationDate != nil {
						@form.Field("Expires", "expiration_date", id, icons.Calendar("15"), fd.ExpirationDate.Error) {
							@form.Control("text", "expiration_date", "MM/YY", id, *fd.ExpirationDate, templ.Attributes{
								"autocomplete": "off",
								"inputmode":    "numeric",
								"x-mask":       "99/99",
								"x-model":      "exp",
							})
						}
					}
				</div>
				if fd.CardLimit != nil {
					{{ sym := form.GetCurOrDefaultSym(curs, cur.Value, defaultCur) }}
					@form.Field("Credit limit", "card_limit", id, nil, fd.CardLimit.Error) {
						@form.Control("text", "card_limit", fmt.Sprintf("%s 1,000.00", sym), id, *fd.CardLimit, templ.Attributes{
							"autocomplete":   "off",
							"inputmode":      "decimal",
							"x-mask:dynamic": fmt.Sprintf("'%s ' + $money($input, '.', ',')", sym),
						})
					}
				}
				if fd.Cycle != nil {
					@cardCycleFields(fd.Cycle, id)
				}
				if fd.Iban != nil {
					{{ prefix := form.GetCurOrDefaultIbanPrefix(curs, cur.Value, nil) }}
					@form.Field("IBAN", "iban", id, icons.Hash("15"), fd.Iban.Error) {
						@form.Control("text", "iban", fmt.Sprintf("%s00 0000 0000 0000 0000 0000 0000 0", prefix), id, *fd.Iban, templ.Attributes{
							"autocomplete": "off",
							"x-mask":       fmt.Sprintf("%s99 9999 9999 9999 9999 9999 9999 9", prefix),
							"class":        "input-field font-mono tracking-wide",
						})
					}
				}
			</div>
		}
	</div>
}

// selectAccKind is a row of tiles, one per account kind. data-kind lets the
// .acc-form css pick the form's accent from the checked kind.
templ selectAccKind(name, id string, aknds []models.AccountKind, data form.FDInput, attrs templ.Attributes) {
	<fieldset id={ name + "-" + id } { attrs... }>
		<legend class="sr-only">Account kind</legend>
		<div class={ "grid gap-2", templ.KV("grid-cols-5", len(aknds) >= 5), templ.KV("grid-cols-4", len(aknds) < 5) }>
			for _, k := range sortedAccKinds(aknds) {
				<label
					class="flex flex-col items-center gap-1.5 min-w-0 py-3 px-1 rounded-2xl border border-zinc-800 bg-zinc-800/40 text-zinc-400 cursor-pointer select-none transition-colors hover:text-white hover:border-zinc-600 has-checked:border-(--accent) has-checked:bg-(--accent)/12 has-checked:text-(--accent) has-focus-visible:ring-2 has-focus-visible:ring-(--accent)"
				>
					<input
						type="radio"
						name={ name }
						value={ k.ID }
						data-kind={ accKindSlug(k.Enum) }
						class="sr-only"
						if k.ID == data.Value {
							checked
						}
					/>
					@accKindIcon(k.Enum, "22")
					<span class="text-sm font-medium truncate max-w-full">{ accKindShortName(k.Enum) }</span>
				</label>
			}
		</div>
		@form.ErrorMessage(data.Error)
	</fieldset>
}

// accountCardPreview mirrors the card fields as they're typed.
templ accountCardPreview(kind models.AccKind) {
	<div
		aria-hidden="true"
		class="relative w-full max-w-80 aspect-[1.586] mx-auto p-5 flex flex-col justify-between rounded-2xl overflow-hidden text-white shadow-xl shadow-black/40 ring-1 ring-white/10"
		style="background: radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--accent) 75%, transparent), transparent 60%), linear-gradient(135deg, color-mix(in oklab, var(--accent) 35%, #27272a), #18181b)"
	>
		<div class="absolute -right-10 -bottom-16 size-48 rounded-full bg-white/5"></div>
		<div class="flex items-start justify-between gap-3">
			<span x-text="name.trim() || 'Account'" class="font-semibold truncate"></span>
			<span class="shrink-0 text-xs uppercase tracking-widest text-white/60">
				if kind == models.AccKindCreditCard {
					Credit
				} else {
					Debit
				}
			</span>
		</div>
		<div class="w-10 h-7 rounded-md bg-gradient-to-br from-amber-200 to-amber-500 opacity-90"></div>
		<p x-text="num.trim() || '•••• •••• •••• ••••'" class="font-mono text-lg sm:text-xl tracking-wider tabular-nums"></p>
		<div class="flex items-end justify-between gap-3 text-sm">
			<span x-text="holder.trim().toUpperCase() || 'NAME ON CARD'" class="truncate tracking-wide text-white/80"></span>
			if kind == models.AccKindCreditCard {
				<span class="shrink-0 font-mono text-white/80" x-text="exp || 'MM/YY'"></span>
			}
		</div>
	</div>
}

// accountSections groups accounts by kind, archived ones last. Every section
// is rendered (hidden while empty) so created or moved accounts have a place.
type accountSection struct {
	ID    string
	Title string
	Kind  models.AccKind
}

var accountSections = []accountSection{
	{ID: "bank", Title: "Bank accounts", Kind: models.AccKindBankAcc},
	{ID: "credit", Title: "Credit cards", Kind: models.AccKindCreditCard},
	{ID: "cash", Title: "Cash", Kind: models.AccKindCash},
	{ID: "debt", Title: "Debts", Kind: models.AccKindDebt},
	{ID: "gamyaa", Title: "Gam'yaas", Kind: models.AccKindGamyaa},
	{ID: "archived", Title: "Archived"},
}

templ accountsList(accounts []models.Account, defaultCur *models.Currency) {
	<div id="accounts-list" class="grid gap-8">
		for _, s := range accountSections {
			{{ accs := accountsInSection(accounts, s.ID) }}
			if s.ID == "archived" {
				<details class="group hidden has-[[data-account]]:block">
					<summary class="flex items-center gap-2 mb-3 list-none cursor-pointer select-none text-zinc-500 hover:text-zinc-300 [&::-webkit-details-marker]:hidden">
						@icons.Archive("16")
						<h2 class="text-sm font-semibold uppercase tracking-wider">{ s.Title }</h2>
						@icons.ChevronDown("16", &templ.Attributes{"class": "transition-transform group-open:rotate-180"})
					</summary>
					@accountSectionGrid(s.ID, accs, defaultCur)
				</details>
			} else {
				<section class="hidden has-[[data-account]]:block">
					<h2 class="flex items-center gap-2 mb-3 text-sm font-semibold uppercase tracking-wider text-zinc-500">
						@accKindIcon(s.Kind, "16")
						{ s.Title }
					</h2>
					@accountSectionGrid(s.ID, accs, defaultCur)
				</section>
			}
		}
		@accountsEmpty()
	</div>
}

templ accountsEmpty() {
	<div class="accounts-empty hidden place-items-center gap-3 py-16 text-center">
		<div class="relative grid place-items-center w-16 h-16 rounded-2xl bg-violet-400/15 text-violet-400">
			<div aria-hidden="true" class="absolute inset-0 rounded-2xl bg-violet-400/20 blur-xl"></div>
			@icons.Wallet("30", &templ.Attributes{"class": "relative"})
		</div>
		<p class="mt-2 text-xl font-semibold">No accounts yet</p>
		<p class="max-w-sm text-zinc-500">Add your bank accounts, cards and cash to track where your money is and what's left to spend.</p>
		<button type="button" @click="openCreateForm=true" class="btn-primary mt-2">
			@icons.Plus("18")
			New account
		</button>
	</div>
}

templ accountSectionGrid(sectionID string, accs []models.Account, defaultCur *models.Currency) {
	<div id={ AccountSectionID(sectionID) } class="grid sm:grid-cols-2 gap-4">
		for _, a := range accs {
			@accountWrapper(&a, defaultCur)
		}
	</div>
}

templ Account(a *models.Account, defaultCur *models.Currency) {
	{{ cardLike := a.Kind.Enum == models.AccKindCreditCard || a.Kind.Enum == models.AccKindBankAcc }}
	<div
		hx-target="this"
		hx-swap="outerHTML"
		data-account
		class={ "relative", templ.KV("opacity-60 hover:opacity-100 transition-opacity", a.IsArchive) }
		x-data="{openMenu: false}"
		:class="{ 'z-30': openMenu }"
	>
		@components.EntryMenuAt("openMenu", cardMenuPosition, getAccountMenuItems(a))
		<div
			class={ "relative flex flex-col gap-4 h-full p-4 rounded-2xl bg-zinc-700/20 overflow-hidden", accKindAccentClass(a.Kind.Enum) }
		>
			<div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-(--accent)/10 blur-2xl"></div>
			<div class="relative flex items-center gap-3 min-w-0">
				if a.Kind.Enum == models.AccKindDebt && a.Counterparty != nil {
					<div class="grid place-items-center shrink-0 w-11 h-11 rounded-xl bg-(--accent)/15">
						@components.CounterpartyIcon(a.Counterparty.Name, a.Counterparty.Icon, a.Counterparty.Color, "w-7 h-7 text-sm")
					</div>
				} else {
					<div class="grid place-items-center shrink-0 w-11 h-11 rounded-xl bg-(--accent)/15 text-(--accent)">
						@accKindIcon(a.Kind.Enum, "22")
					</div>
				}
				<div class="flex-1 min-w-0">
					<p class="flex items-center gap-1.5 text-lg leading-tight">
						<span class="truncate">{ a.Name }</span>
						if a.IsDefault {
							<span title="Default account" class="shrink-0 text-amber-300">
								@icons.Star("15", &templ.Attributes{"fill": "currentColor"})
							</span>
						}
					</p>
					<p class="text-sm text-zinc-500 truncate">
						{ accountSubtitle(a, cardLike) }
					</p>
				</div>
				@components.EntryMenuTrigger("openMenu", "Account actions")
			</div>
			<div class="relative mt-auto">
				if a.Kind.Enum == models.AccKindDebt {
					<p class="text-xs text-zinc-500">{ debtCaption(a.Amount) }</p>
				} else if a.Kind.Enum == models.AccKindGamyaa {
					<p class="text-xs text-zinc-500">{ gamyaaCaption(a.Amount) }</p>
				}
				<p
					class={
						"sensitive text-2xl font-bold tabular-nums truncate font-(family-name:--font-biorhyme-expanded)",
						templ.KV("text-red-400", a.Amount < 0 && a.Kind.Enum != models.AccKindDebt && a.Kind.Enum != models.AccKindGamyaa),
					}
				>{ a.ViewAmount() }</p>
				if defaultCur != nil && a.Currency.String != defaultCur.String {
					if v := a.ViewAmountIn(defaultCur); v != "" {
						<p title={ "In " + defaultCur.String } class="sensitive text-sm text-zinc-500 tabular-nums">≈ { v }</p>
					}
				}
				if a.SetAside > 0 {
					<p title="Moved to goals in progress, still in the bank" class="sensitive flex items-center gap-1 text-sm text-zinc-500 tabular-nums">
						@icons.Target("12")
						+ { a.ViewSetAside() } set aside for goals
					</p>
					<p title="Its balance plus what's set aside for goals" class="sensitive flex items-center gap-1 text-sm text-zinc-400 tabular-nums">
						@icons.Bank("12")
						{ a.ViewInBank() } in the bank
					</p>
				}
			</div>
			if a.Kind.Enum == models.AccKindCreditCard && a.CardLimit > 0 {
				@creditUsage(a)
			}
			if a.Statement != nil {
				@cardStatement(a.Statement)
			}
			if a.Gamyaa != nil {
				@gamyaaProgress(a)
			}
			if a.IsDefault || a.ExcludeFromBalance || a.IsArchive || !a.ExpirationDate.IsZero() || a.Note != "" {
				<div class="relative flex flex-wrap items-center gap-1.5">
					if a.IsDefault {
						<span class="px-2 py-0.5 rounded-full bg-amber-300/10 text-xs text-amber-300">Default</span>
					}
					if a.ExcludeFromBalance {
						<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-zinc-800 text-xs text-zinc-400">
							@icons.EyeOff("12")
							Not in balance
						</span>
					}
					if a.IsArchive {
						<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-zinc-800 text-xs text-zinc-400">
							@icons.Archive("12")
							Archived
						</span>
					}
					if !a.ExpirationDate.IsZero() {
						@expiryChip(a.ExpirationDate)
					}
					if a.Note != "" {
						<span title={ a.Note } class="min-w-0 max-w-full truncate text-xs text-zinc-500">{ a.Note }</span>
					}
				</div>
			}
		</div>
	</div>
}

// creditUsage is a credit card's spent share of its limit, as its balance
// goes negative when spending.
templ creditUsage(a *models.Account) {
	{{ used := max(0, -a.Amount) }}
	{{ pct := min(100, used/a.CardLimit*100) }}
	<div class="relative">
		<div class="h-1.5 rounded-full bg-zinc-800 overflow-hidden">
			<div
				class={ "h-full rounded-full", templ.KV("bg-(--accent)", pct < 80), templ.KV("bg-red-400", pct >= 80) }
				style={ fmt.Sprintf("width: %.1f%%", pct) }
			></div>
		</div>
		<div class="flex justify-between gap-3 mt-1.5 text-xs text-zinc-500 tabular-nums">
			<span>{ fmt.Sprintf("%.0f%% used", pct) }</span>
			<span class="truncate">{ a.ViewAvailableCredit() } of { a.ViewCardLimit() } left</span>
		</div>
	</div>
}

// cardCycleFields are a credit card's statement day and due date.
templ cardCycleFields(fd *CardCycleFD, id string) {
	<div x-data={ fmt.Sprintf("{ dueMode: '%s' }", fd.DueMode.Value) } class="grid gap-3">
		<div class="grid grid-cols-2 gap-3">
			@form.Field("Statement day", "statement_day", id, icons.Calendar("15"), fd.StatementDay.Error) {
				@form.Control("text", "statement_day", "e.g. 25", id, fd.StatementDay, templ.Attributes{
					"autocomplete": "off",
					"inputmode":    "numeric",
					"x-mask":       "99",
				})
			}
			@form.Field("Due", "due_value", id, icons.Clock("15"), fd.DueValue.Error) {
				@form.Control("text", "due_value", "e.g. 20", id, fd.DueValue, templ.Attributes{
					"autocomplete": "off",
					"inputmode":    "numeric",
					"x-mask":       "99",
				})
			}
		</div>
		@form.SegmentedRadio("Due date", "due_mode", id, []form.RadioOption{
			{Value: "days", Label: "Days after statement"},
			{Value: "day", Label: "Day of next month"},
		}, fd.DueMode, templ.Attributes{"x-on:change": "dueMode = $event.target.value"})
		<p class="-mt-1 text-sm text-zinc-500">
			<span x-show="dueMode === 'days'">The statement closes on that day each month and is due that many days later.</span>
			<span x-show="dueMode === 'day'" x-cloak>The statement closes on that day each month and is due on the due day after it.</span>
			Pay it in full by then to avoid interest. Leave empty if you don’t track it.
		</p>
	</div>
}

// cardStatement is a credit card's last statement: what's left to pay by when
// to avoid interest, and how long a purchase made today stays free of it.
templ cardStatement(s *models.CardStatement) {
	{{ st := s.Status() }}
	<div class="relative grid gap-1.5 text-xs">
		<p
			class={
				"flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl",
				templ.KV("bg-emerald-400/10 text-emerald-300", st == models.StatementPaid),
				templ.KV("bg-amber-400/10 text-amber-200", st == models.StatementDue),
				templ.KV("bg-red-400/10 text-red-300", st == models.StatementDueSoon || st == models.StatementOverdue),
			}
		>
			switch st {
				case models.StatementPaid:
					@icons.Check("12")
					if s.Balance > 0 {
						<span>Statement of { s.ClosedOn.Format("Jan 2") } paid</span>
					} else {
						<span>Nothing due from the { s.ClosedOn.Format("Jan 2") } statement</span>
					}
				case models.StatementOverdue:
					@icons.Warning("12")
					<span>Pay <span class="sensitive font-semibold tabular-nums">{ s.ViewDue() }</span>, overdue since { s.DueOn.Format("Jan 2") }</span>
				default:
					@icons.Clock("12")
					<span>
						Pay <span class="sensitive font-semibold tabular-nums">{ s.ViewDue() }</span>
						by { s.DueOn.Format("Jan 2") } to avoid interest
						({ dueIn(s.DaysLeft()) })
					</span>
			}
		</p>
		<p class="flex flex-wrap justify-between gap-x-3 gap-y-0.5 text-zinc-500">
			<span>Next statement { s.NextClose().Format("Jan 2") }</span>
			<span title="A purchase made today is due with the next statement">
				Buy today → due { s.PurchaseDueOn().Format("Jan 2") } · { fmt.Sprint(s.InterestFreeDays()) } days interest-free
			</span>
		</p>
	</div>
}

// dueIn is how far a due date is, in days.
func dueIn(days int) string {
	switch days {
	case 0:
		return "today"
	case 1:
		return "tomorrow"
	default:
		return fmt.Sprintf("in %d days", days)
	}
}

templ expiryChip(exp time.Time) {
	{{ end := exp.AddDate(0, 1, 0) }}
	{{ expired := time.Now().After(end) }}
	{{ soon := !expired && time.Until(end) < 60*24*time.Hour }}
	<span
		title="Card expiry"
		class={
			"inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs tabular-nums",
			templ.KV("bg-zinc-800 text-zinc-400", !expired && !soon),
			templ.KV("bg-amber-400/10 text-amber-300", soon),
			templ.KV("bg-red-400/10 text-red-400", expired),
		}
	>
		@icons.Calendar("12")
		if expired {
			Expired { exp.Format("01/06") }
		} else {
			Exp { exp.Format("01/06") }
		}
	</span>
}

templ AccountOOB(a *models.Account, defaultCur *models.Currency) {
	<div id={ AccountSectionID(accountSectionOf(a)) } hx-swap-oob="afterbegin">
		@accountWrapper(a, defaultCur)
	</div>
}

// accountWrapper gives the card a stable target, as the edit form replaces
// the card itself.
templ accountWrapper(a *models.Account, defaultCur *models.Currency) {
	<div id={ AccountWrapperID(a.ID) } class="contents">
		@Account(a, defaultCur)
	</div>
}

templ AccountReplaceOOB(a *models.Account, defaultCur *models.Currency) {
	<div id={ AccountWrapperID(a.ID) } class="contents" hx-swap-oob="innerHTML">
		@Account(a, defaultCur)
	</div>
}

templ AccountDeleteOOB(id string) {
	<div id={ AccountWrapperID(id) } hx-swap-oob="delete"></div>
}

func AccountWrapperID(id string) string {
	return "account-" + id
}

func AccountSectionID(section string) string {
	return "accounts-" + section
}

// AccountSectionChanged tells if an edit moves the account to another
// section of the list.
func AccountSectionChanged(before, after *models.Account) bool {
	return accountSectionOf(before) != accountSectionOf(after)
}

func accountSectionOf(a *models.Account) string {
	if a.IsArchive {
		return "archived"
	}
	return accKindSlug(a.Kind.Enum)
}

func accountsInSection(accs []models.Account, section string) []models.Account {
	var res []models.Account
	for _, a := range accs {
		if accountSectionOf(&a) == section {
			res = append(res, a)
		}
	}
	return res
}

func accKindSlug(k models.AccKind) string {
	switch k {
	case models.AccKindBankAcc:
		return "bank"
	case models.AccKindCreditCard:
		return "credit"
	case models.AccKindCash:
		return "cash"
	case models.AccKindDebt:
		return "debt"
	case models.AccKindGamyaa:
		return "gamyaa"
	}
	return "other"
}

func accKindShortName(k models.AccKind) string {
	switch k {
	case models.AccKindBankAcc:
		return "Bank"
	case models.AccKindCreditCard:
		return "Credit"
	}
	return k.String()
}

// accKindAccentClass sets --accent to the kind's color, as on .acc-form.
func accKindAccentClass(k models.AccKind) string {
	switch k {
	case models.AccKindBankAcc:
		return "[--accent:var(--color-sky-400)]"
	case models.AccKindCash:
		return "[--accent:var(--color-emerald-400)]"
	case models.AccKindDebt:
		return "[--accent:var(--color-amber-400)]"
	case models.AccKindGamyaa:
		return "[--accent:var(--color-teal-400)]"
	}
	return "[--accent:var(--color-violet-400)]"
}

templ accKindIcon(k models.AccKind, size string) {
	switch k {
		case models.AccKindBankAcc:
			@icons.Bank(size)
		case models.AccKindCreditCard:
			@icons.Card(size)
		case models.AccKindCash:
			@icons.Banknote(size)
		case models.AccKindDebt:
			@icons.Debt(size)
		case models.AccKindGamyaa:
			@icons.Users(size)
	}
}

func sortedAccKinds(aknds []models.AccountKind) []models.AccountKind {
	order := []models.AccKind{models.AccKindBankAcc, models.AccKindCreditCard, models.AccKindCash, models.AccKindDebt, models.AccKindGamyaa}
	res := slices.Clone(aknds)
	slices.SortFunc(res, func(a, b models.AccountKind) int {
		return slices.Index(order, a.Enum) - slices.Index(order, b.Enum)
	})
	return res
}

func selectedAccKind(aknds []models.AccountKind, id string) models.AccKind {
	for _, k := range aknds {
		if k.ID == id {
			return k.Enum
		}
	}
	return models.DfltAccKind
}

func accNamePlaceholder(k models.AccKind) string {
	switch k {
	case models.AccKindCreditCard:
		return "e.g. HSBC Platinum"
	case models.AccKindCash:
		return "e.g. Wallet"
	case models.AccKindGamyaa:
		return "e.g. Office gam'yaa"
	}
	return "e.g. HSBC Current"
}

func accountSubtitle(a *models.Account, cardLike bool) string {
	parts := []string{a.Kind.Enum.String(), a.Currency.String}
	if cardLike && len(a.CardNumber) >= 4 {
		parts = append(parts, "•••• "+a.CardNumber[len(a.CardNumber)-4:])
	} else if len(a.Iban) >= 4 {
		parts = append(parts, "IBAN •••• "+a.Iban[len(a.Iban)-4:])
	}
	return strings.Join(parts, " · ")
}

// editableAccKinds are the kinds an account can be given: gam'yaas are only
// made from the create form, as they're created with their schedule.
func editableAccKinds(aknds []models.AccountKind, id string) []models.AccountKind {
	if id == "0" {
		return aknds
	}
	return slices.DeleteFunc(slices.Clone(aknds), func(k models.AccountKind) bool { return k.Enum == models.AccKindGamyaa })
}

func debtCaption(amount float64) string {
	switch {
	case amount > 0:
		return "Owes you"
	case amount < 0:
		return "You owe"
	}
	return "Settled"
}

func fdValue(fd *form.FDInput) string {
	if fd == nil {
		return ""
	}
	return fd.Value
}

// cardMenuPosition opens an entry card's menu under its trigger, on cards
// (accounts, recurrent txs) whose header holds a 44px tile.
const cardMenuPosition = "top-14 right-3 origin-top-right"

func getAccountMenuItems(a *models.Account) []templ.Component {
	items := []templ.Component{
		components.EntryMenuEditItem(fmt.Sprintf("/accounts/%s/edit", a.ID)),
	}

	if !a.IsDefault && !a.IsArchive {
		items = append(items,
			components.EntryMenuAnchorItem("Set as default", "put", fmt.Sprintf("/accounts/%s/default", a.ID),
				components.WithEntryMenuItemIcon(icons.Star("16"))))
	}

	if a.IsArchive {
		items = append(items, components.EntryMenuAnchorItem("Unarchive", "put", fmt.Sprintf("/accounts/%s/archive", a.ID),
			components.WithEntryMenuItemIcon(icons.RotateCcw("16"))))
	} else if !a.IsDefault {
		items = append(items, components.EntryMenuAnchorItem("Archive", "put", fmt.Sprintf("/accounts/%s/archive", a.ID),
			components.WithEntryMenuItemIcon(icons.Archive("16"))))
	}

	items = append(items, components.EntryMenuSeparator())
	if a.Amount > 0 {
		return append(items, components.EntryMenuDrawerItem("Delete", fmt.Sprintf("/accounts/%s/delete-form", a.ID),
			components.WithEntryMenuItemIcon(icons.Trash("16")), components.WithEntryMenuItemDanger()))
	}
	return append(items, components.EntryMenuDeleteItem(fmt.Sprintf("/accounts/%s", a.ID),
		components.WithEntryMenuItemConfirmMessage("Delete this account? Its transactions stay in the history.")))
}

// AccountDeleteFD is the form deleting an account with money in it: the
// account its balance moves to (none leaves it out of the totals) and what
// that one receives when their currencies differ.
type AccountDeleteFD struct {
	AccountID form.FDInput
	ToAmount  form.FDInput
}

// AccountDeleteForm deletes an account with money in it, in a drawer.
templ AccountDeleteForm(a *models.Account, fd *AccountDeleteFD, accs []models.Account) {
	@components.Drawer(components.DrawerProps{Label: "Delete " + a.Name}) {
		@AccountDeleteFormFields(a, fd, accs)
	}
}

// AccountDeleteFormFields is AccountDeleteForm's form alone, answered with
// its errors.
templ AccountDeleteFormFields(a *models.Account, fd *AccountDeleteFD, accs []models.Account) {
	@form.DrawerForm(form.DrawerFormProps{
		Title: "Delete " + a.Name, Method: "post", URL: fmt.Sprintf("/accounts/%s/delete", a.ID),
		Submit: "Delete account", Class: "[--accent:var(--color-red-400)]",
	}) {
		<p class="text-zinc-400">
			It still has <span class="sensitive text-zinc-100 tabular-nums">{ a.ViewAmount() }</span>.
			Move it to another account, or leave it and it drops out of your balance.
			Its transactions stay in the history.
		</p>
		@AccountDeleteInputs(a, fd, accs)
	}
}

// AccountDeleteInputs is where the balance moves, rendered again when the
// account (so the currency) changes.
templ AccountDeleteInputs(a *models.Account, fd *AccountDeleteFD, accs []models.Account) {
	{{ toSym := form.GetAccoutSym(accs, fd.AccountID.Value, &a.Currency) }}
	<div
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="closest form:abort"
		class="grid justify-items-center gap-3 py-2"
	>
		<div class="flex flex-wrap items-center justify-center gap-2 max-w-full">
			<span class="text-sm text-zinc-500">Move it to</span>
			@form.Combobox(form.ComboboxProps{
				Name: "account_id", ID: a.ID, Label: "Move to", Placeholder: "Don't move it",
				Options: form.AccountComboOptions(accs), Data: fd.AccountID,
				Nullable: true, Chip: true, Searchable: len(accs) > 7,
				InputAttrs: templ.Attributes{"hx-post": fmt.Sprintf("/accounts/%s/delete-inputs", a.ID), "hx-trigger": "change"},
			})
		</div>
		@form.ErrorMessage(fd.AccountID.Error)
		if fd.AccountID.Value != "" && toSym != a.Currency.Symbol {
			<label class="flex items-center gap-2 text-sm text-zinc-400">
				It receives
				<input
					id={ "to_amount-" + a.ID }
					type="text"
					name="to_amount"
					value={ fd.ToAmount.Value }
					placeholder={ toSym + " 0.00" }
					autocomplete="off"
					inputmode="decimal"
					x-data
					x-mask:dynamic={ fmt.Sprintf("'%s ' + $money($input, '.', ',')", toSym) }
					class="input-field w-48! h-9! text-center tabular-nums font-(family-name:--font-biorhyme-expanded)"
					if fd.ToAmount.Error != "" {
						aria-invalid="true"
					}
				/>
			</label>
			@form.ErrorMessage(fd.ToAmount.Error)
		}
	</div>
}
