package views

import (
	"fmt"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
)

type AccountFD struct {
	AccountPartialFD   AccountPartialFD
	Note               FDInput
	IsArchive          FDInput
	ExcludeFromBalance FDInput
}

type AccountPartialFD struct {
	Name           *FDInput
	KindID         FDInput
	CurrencyID     FDInput
	Iban           *FDInput
	CardNumber     *FDInput
	CounterpartyID *FDInput
	CardLimit      *FDInput
	NameOnCard     *FDInput
	ExpirationDate *FDInput
}

templ Accounts(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *AccountFD, aknds []models.AccountKind,
	curs []models.Currency, accounts []models.Account,
	cps []models.Counterparty) {
	@baseLayout(claims, "Accounts", balances, &layoutOpts{includeAlpine: true, includeAlpineCollapse: true}) {
		@container() {
			@mainHeader("Accounts")
			@CreateAccountForm(fd, aknds, curs, cps, &claims.DefaultCurrency)
			@accountsList(accounts)
		}
	}
}

templ CreateAccountForm(fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@creationForm("Create Account", "/accounts", "Create Account") {
		@accountFormBody("0", fd, aknds, curs, cps, defaultCur)
	}
}

templ EditAccount(id string, fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@form("put", fmt.Sprintf("/accounts/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@accountFormBody(id, fd, aknds, curs, cps, defaultCur)
		@editFormButtons(fmt.Sprintf("/accounts/%s", id))
	}
}

templ accountFormBody(id string, fd *AccountFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	@AccountInputs(id, &fd.AccountPartialFD, aknds, curs, cps, defaultCur)
	@input("Note", "text", "note", "Enter note", id, fd.Note)
	@checkbox("Is Archive", "is_archive", id, fd.IsArchive)
	@checkbox("Exclude From Balance", "exclude_from_balance", id, fd.ExcludeFromBalance)
}

templ AccountInputs(id string, fd *AccountPartialFD, aknds []models.AccountKind, curs []models.Currency, cps []models.Counterparty, defaultCur *models.Currency) {
	<div
		class="contents"
		hx-target="this"
		hx-swap="outerHTML"
		hx-sync="closest form:abort"
	>
		@selectAccKind("kind_id", id, aknds, fd.KindID, templ.Attributes{
			"hx-post": fmt.Sprintf("/accounts-inputs/%s", id),
		})
		@selectCurrency("currency_id", id, curs, fd.CurrencyID,
			templ.Attributes{
				"hx-post": fmt.Sprintf("/accounts-inputs/%s", id),
			})
		if fd.Name != nil {
			@input("Name", "text", "name", "Enter account name", id, *fd.Name)
		}
		if fd.Iban != nil {
			@ibanInput("IBAN", "iban", id, getCurIbanPrefixByCurrency(curs, fd.CurrencyID.Value), *fd.Iban)
		}
		if fd.CardNumber != nil {
			@creditCardInput("Card Number", "card_number", id, *fd.CardNumber)
		}
		if fd.NameOnCard != nil {
			@input("Name on card", "text", "name_on_card", "John Doe", id, *fd.NameOnCard)
		}
		if fd.CardLimit != nil {
			@moneyInput("Card Limit", "card_limit", getCurSymbolByCurrency(curs, fd.CurrencyID.Value, defaultCur), id, *fd.CardLimit, "")
		}
		if fd.ExpirationDate != nil {
			@dateInput("Expiration Date", "expiration_date", id, *fd.ExpirationDate)
		}
		if fd.CounterpartyID != nil {
			@selectCounterparty("counterparty_id", id, cps, *fd.CounterpartyID, false)
		}
	</div>
}

templ accountsList(accounts []models.Account) {
	@list("accounts-list") {
		for _, a := range accounts {
			@Account(&a)
		}
	}
}

templ Account(a *models.Account) {
	<div hx-target="this" class="entry-container">
		<p>ID: { a.ID }</p>
		if a.IsDefault {
			<p class="text-green-500">DEFAULT</p>
		}
		<p>Name: { a.Name }</p>
		<p>Amount: { a.ViewAmount() } </p>
		<p>Actual Amount: { a.ViewActualAmount() } </p>
		<p>Kind: { a.Kind.Enum.String() } </p>
		if a.Iban != "" {
			<p>IBAN: { a.MaskIban() } </p>
		}
		if a.Counterparty != nil {
			<p>Counterparty ID: { a.Counterparty.ID }</p>
			<p>Counterparty: { a.Counterparty.Name }</p>
		}
		if a.CardNumber != "" {
			<p>Card Number: { a.MaskCardNumber() } </p>
		}
		if a.CardLimit != 0 {
			<p>Card Limit: { a.ViewCardLimit() } </p>
		}
		if a.NameOnCard != "" {
			<p>Name on Card: { a.NameOnCard } </p>
		}
		if !a.ExpirationDate.IsZero() {
			<p>Expiration Date: { a.ExpirationDate.Format(time.DateOnly) } </p>
		}
		if a.Note != "" {
			<p>Note: { a.Note } </p>
		}
		<p>
			Is Archive:
			if a.IsArchive {
				true
			} else {
				false
			}
		</p>
		<p>
			Exclude From Balance:
			if a.ExcludeFromBalance {
				true
			} else {
				false
			}
		</p>
		<div class="flex gap-4">
			if !a.IsDefault {
				<button
					class="px-5 py-2.5 my-2 text-white bg-green-500 hover:bg-green-600 focus:outline-none focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm sm:w-auto text-center"
					hx-target="this"
					hx-swap="outerHTML"
					hx-put={ fmt.Sprintf("/accounts/%s/default", a.ID) }
					hx-sync="closest button:abort"
				>Set as Default</button>
			}
			@editButton(fmt.Sprintf("/accounts/%s/edit", a.ID))
			@deleteButton(fmt.Sprintf("/accounts/%s", a.ID))
		</div>
	</div>
}

templ AccountOOB(a *models.Account) {
	<div id="accounts-list" hx-swap-oob="afterbegin">
		@Account(a)
	</div>
}
