package views

import (
	"fmt"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/icons"
)

// RecurrentTxDetailsData is what a recurrent transaction's details drawer
// shows.
type RecurrentTxDetailsData struct {
	RecurrentTx *models.RecurrentTx
	// Upcoming are its scheduled transactions, soonest first; Past its
	// fulfilled ones, newest first.
	Upcoming, Past []models.Transaction
	Def            *models.Currency
}

// RecurrentTxDetailsParam is the recurring page's query param holding the
// recurrent transaction whose details are open.
const RecurrentTxDetailsParam = "rtx"

// RecurrentTxDetailsFrom is the from= value of the details' actions, which
// then answer the details again.
const RecurrentTxDetailsFrom = "details"

func recurrentTxDetailsURL(id string) string {
	return fmt.Sprintf("/recurrent-tx/%s/details", id)
}

// recurrentTxDetailsURLIf is the details url of id, empty for no id.
func recurrentTxDetailsURLIf(id string) string {
	if id == "" {
		return ""
	}
	return recurrentTxDetailsURL(id)
}

// RecurrentTxURL is the recurring page with the recurrent transaction id's
// details open.
func RecurrentTxURL(id string) templ.SafeURL {
	return templ.SafeURL("/recurrent-tx?" + RecurrentTxDetailsParam + "=" + id)
}

// RecurrentTxDetails is a recurrent transaction in full, in a drawer like an
// account's details: what it is, how often, and its transactions.
templ RecurrentTxDetails(d *RecurrentTxDetailsData) {
	{{ rt := d.RecurrentTx }}
	{{ tx := rt.AsTransaction() }}
	{{ v := newTxView(ctx, tx) }}
	{{ today := dateOf(time.Now()) }}
	{{ ended := rt.HasEnded(today) }}
	@components.Drawer(components.DrawerProps{Label: v.title + " details", URLParam: RecurrentTxDetailsParam, URLValue: rt.ID}) {
		<div class={ "drawer-panel flex flex-col flex-1 min-h-0", rtxAccentClass(rt.Kind) }>
			<header class="flex items-start gap-3 px-5 sm:px-6 pt-5 pb-4">
				@txTile(tx, &v)
				<div class="flex-1 min-w-0">
					<h2 class="text-lg font-bold leading-snug break-words">{ v.title }</h2>
					<p class="flex items-center gap-1.5 text-sm text-zinc-400 min-w-0">
						<span class="shrink-0">
							@accKindIcon(v.accKind, "14")
						</span>
						if v.subtitle != "" {
							<span class="truncate">{ v.subtitle }</span>
							<span class="shrink-0">·</span>
						}
						@txAccounts(&v)
					</p>
				</div>
				@components.DrawerClose()
			</header>
			<div class="flex-1 grid grid-cols-1 auto-rows-max content-start gap-6 px-5 sm:px-6 pb-6 overflow-y-auto overscroll-contain">
				@rtxDetailsHero(rt, &v, d.Def, ended)
				@rtxDetailsActions(rt, ended)
				@rtxDetailsMoney(d)
				@rtxDetailsTxs("Upcoming", d.Upcoming, skipURLs(rt)) {
					if len(d.Upcoming) == 0 {
						<p class="text-sm text-zinc-500">
							if ended {
								Ended { rt.StopsAt.Format("Jan 2, 2006") }.
							} else if rt.IsPaused() {
								Paused since { rt.PausedAt.Format("Jan 2, 2006") }.
							} else {
								Nothing scheduled ahead.
							}
						</p>
					}
				}
				@rtxDetailsTxs("History", d.Past, nil) {
					if len(d.Past) == 0 {
						<p class="text-sm text-zinc-500">None done yet.</p>
					}
				}
			</div>
		</div>
	}
}

templ rtxDetailsHero(rt *models.RecurrentTx, v *txView, def *models.Currency, ended bool) {
	<div class="grid gap-3">
		<p
			class={
				"sensitive text-3xl font-semibold font-(family-name:--font-biorhyme-expanded) tabular-nums break-words",
				templ.KV("text-emerald-400", v.tone == txToneIn),
				templ.KV("text-zinc-300", v.tone == txToneNeutral),
			}
		>{ v.amount }</p>
		<div class="flex flex-wrap items-center gap-1.5">
			<span class="inline-flex items-center gap-1.5 h-7 px-2.5 rounded-full bg-(--accent)/12 text-sm text-(--accent)">
				@icons.Repeat("14")
				{ rt.ViewRecurrence() }
			</span>
			if ended {
				<span class="chip">
					@icons.Archive("12")
					Ended
				</span>
			}
			if rt.Category != nil && rt.Category.Name != "" && rt.Category.Name != v.title {
				<span class="chip">
					@icons.Tag("12")
					{ rt.Category.Name }
				</span>
			}
		</div>
		if rt.Description != "" && rt.Description != v.title {
			<p class="text-sm text-zinc-400 break-words">{ rt.Description }</p>
		}
	</div>
}

// rtxDetailsActions answer the details again (from=details), or open their
// drawers in place of them; Back goes from them to the details.
templ rtxDetailsActions(rt *models.RecurrentTx, ended bool) {
	{{ slot := "#" + components.DrawerSlot }}
	<div class="flex flex-wrap gap-2">
		if rt.IsGamyaa() {
			<button type="button" hx-get={ accountDetailsURL(rt.GamyaaAccountID) } hx-target={ slot } hx-swap="innerHTML" class="txd-action">
				@icons.Users("14")
				Gam'yaa details
			</button>
			<p class="basis-full text-sm text-zinc-500">Its installments change through the gam'yaa's transactions.</p>
		} else {
			<button type="button" hx-get={ fmt.Sprintf("/recurrent-tx/%s/edit", rt.ID) } hx-target={ slot } hx-swap="innerHTML" class="txd-action">
				@icons.Pencil("14")
				Edit
			</button>
			if rt.IsPaused() {
				<button
					type="button"
					hx-put={ fmt.Sprintf("/recurrent-tx/%s/resume?from=%s", rt.ID, RecurrentTxDetailsFrom) }
					hx-target={ slot }
					hx-swap="innerHTML"
					class="txd-action"
				>
					@icons.Play("14")
					Resume
				</button>
			} else if !ended && !rt.FullyScheduled() {
				<button
					type="button"
					hx-put={ fmt.Sprintf("/recurrent-tx/%s/pause?from=%s", rt.ID, RecurrentTxDetailsFrom) }
					hx-confirm="Pause it? Its scheduled transactions from today on are deleted, and resuming starts again from that day."
					hx-target={ slot }
					hx-swap="innerHTML"
					class="txd-action"
				>
					@icons.Pause("14")
					Pause
				</button>
			}
			// The answer removes the card and closes the drawer.
			<button
				type="button"
				hx-delete={ fmt.Sprintf("/recurrent-tx/%s?from=%s", rt.ID, RecurrentTxDetailsFrom) }
				hx-confirm="Delete it with its upcoming scheduled transactions? Past ones are kept."
				hx-target={ "#" + RecurrentTxID(rt.ID) }
				hx-swap="outerHTML"
				class="txd-action text-red-300!"
			>
				@icons.Trash("14")
				Delete
			</button>
		}
	</div>
}

templ rtxDetailsMoney(d *RecurrentTxDetailsData) {
	{{ rt := d.RecurrentTx }}
	{{ cur := &rt.Account.Currency }}
	@txDetailsSection("Money") {
		<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-zinc-800/60 ring-1 ring-zinc-800">
			@counterpartyDetailsStat("Done", fmt.Sprintf("%d×", rt.FulfilledCount))
			@counterpartyDetailsStat("In all so far", cur.Format(rtxTotal(d.Past)))
			@counterpartyDetailsStat("In a month, avg", cur.Format(rt.Amount*rt.PerMonth()))
			@counterpartyDetailsStat("In a year", cur.Format(rt.Amount*rt.PerMonth()*12))
			@counterpartyDetailsStat("Since", rt.StartsAt.Format("Jan 2, 2006"))
			if rt.StopsAt.IsZero() {
				@counterpartyDetailsStat("Until", "Never stops")
			} else {
				@counterpartyDetailsStat("Until", rt.StopsAt.Format("Jan 2, 2006"))
			}
		</dl>
	}
}

// rtxTotal is what the transactions amount to, in their account's currency.
func rtxTotal(txs []models.Transaction) float64 {
	var total float64
	for _, tx := range txs {
		total += tx.Amount
	}
	return total
}

// rtxDetailsTxs lists transactions, each linking to its details.
// rtxDetailsTxs lists txs, each with a Skip button when skip gives its url.
templ rtxDetailsTxs(title string, txs []models.Transaction, skip func(*models.Transaction) string) {
	@txDetailsSection(title) {
		for _, tx := range txs {
			{{ v := txMiniView(ctx, &tx) }}
			<div class="flex items-center gap-1.5">
				<a
					href={ goalTxURL(&tx) }
					class="flex flex-1 min-w-0 items-center gap-3 px-3 py-2 rounded-xl bg-tx-row text-left transition hover:ring-1 hover:ring-zinc-700"
				>
					<div class="flex-1 min-w-0">
						<p class="truncate text-sm">{ formatTxDay(tx.ScheduledTo) }</p>
						<p class="truncate text-xs text-zinc-500">
							{ tx.ScheduledTo.Format("Monday, Jan 2, 2006") }
							if tx.FulfilledAt.IsZero() && tx.ScheduledTo.Before(dateOf(time.Now())) {
								· <span class="text-red-400">Overdue</span>
							}
						</p>
					</div>
					<p
						class={
							"shrink-0 text-sm font-semibold tabular-nums",
							templ.KV("text-emerald-400", v.tone == txToneIn),
							templ.KV("text-zinc-400", v.tone == txToneNeutral),
						}
					>{ v.amount }</p>
				</a>
				if skip != nil && tx.FulfilledAt.IsZero() {
					<button
						type="button"
						hx-delete={ skip(&tx) }
						hx-target={ "#" + components.DrawerSlot }
						hx-swap="innerHTML"
						title="Skip this one"
						aria-label={ "Skip " + formatTxDay(tx.ScheduledTo) }
						class="grid shrink-0 place-items-center size-9 rounded-xl text-zinc-400 cursor-pointer transition-colors hover:bg-white/8 hover:text-zinc-100"
					>
						@icons.SkipForward("15")
					</button>
				}
			</div>
		}
		{ children... }
	}
}

// skipURLs gives the url skipping one of rt's scheduled transactions, nil for
// a gam'yaa's.
func skipURLs(rt *models.RecurrentTx) func(*models.Transaction) string {
	if rt.IsGamyaa() {
		return nil
	}
	return func(tx *models.Transaction) string {
		return fmt.Sprintf("/recurrent-tx/%s/occurrences/%s?from=%s", rt.ID, tx.ID, RecurrentTxDetailsFrom)
	}
}
