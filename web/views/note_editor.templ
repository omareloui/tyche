package views

import (
	"encoding/json"

	"github.com/omareloui/tyche/internal/markdown"
	"github.com/omareloui/tyche/web/views/icons"
)

// NoteEditorProps is a note shown in details, edited in place.
type NoteEditorProps struct {
	// ID is the editor's element id, its answer replacing it.
	ID string
	// URL takes a PUT of the note alone (`note`).
	URL  string
	Note string
	// Editable shows the edit button ("Add a note" when there's none).
	Editable bool
	// Draft and Error are a refused save's, reopening the editor with them.
	Draft, Error string
	// Vals are sent with the note (e.g. from=details).
	Vals map[string]string
}

// NoteEditorID is the editor's id for an entity's note.
func NoteEditorID(kind, id string) string {
	return "note-" + kind + "-" + id
}

func noteVals(vals map[string]string) string {
	if len(vals) == 0 {
		return ""
	}
	b, _ := json.Marshal(vals)
	return string(b)
}

// NoteEditor shows a note (Markdown, through markdown.HTML) edited in place:
// clicking it (or "Add a note") turns it into a quiet textarea growing with
// its text, saved when it loses focus or on Ctrl/Cmd+Enter (unchanged, it
// just closes), Escape or "Cancel" dropping the changes. Nothing when there's
// no note and it can't be edited.
templ NoteEditor(p NoteEditorProps) {
	if p.Note != "" || p.Editable {
		{{ editing := p.Error != "" }}
		<div
			id={ p.ID }
			if editing {
				x-data="{ editing: true }"
			} else {
				x-data="{ editing: false }"
			}
		>
			<div x-show="!editing">
				if p.Note != "" {
					if p.Editable {
						<div
							role="button"
							tabindex="0"
							title="Edit the note"
							@click="if (!$event.target.closest('a')) { editing = true; $nextTick(() => $refs.note.focus()) }"
							@keydown.enter.prevent="editing = true; $nextTick(() => $refs.note.focus())"
							class="md-note -mx-2 -my-1 px-2 py-1 rounded-lg break-words text-sm text-zinc-300 cursor-text transition-colors hover:bg-zinc-800/60"
						>
							@markdown.HTML(p.Note)
						</div>
					} else {
						<div class="md-note break-words text-sm text-zinc-300">
							@markdown.HTML(p.Note)
						</div>
					}
				} else {
					<button
						type="button"
						@click="editing = true; $nextTick(() => $refs.note.focus())"
						class="flex items-center gap-2 w-full px-4 py-3 rounded-2xl border border-dashed border-zinc-700 text-left text-sm text-zinc-400 cursor-pointer transition-colors hover:border-violet-400 hover:text-violet-300"
					>
						@icons.Plus("15", &templ.Attributes{"class": "shrink-0"})
						Add a note
					</button>
				}
			</div>
			if p.Editable {
				{{ draft := p.Note }}
				if editing {
					{{ draft = p.Draft }}
				}
				<form
					x-show="editing"
					if !editing {
						x-cloak
					}
					hx-put={ p.URL }
					hx-target={ "#" + p.ID }
					hx-swap="outerHTML"
					if v := noteVals(p.Vals); v != "" {
						hx-vals={ v }
					}
					x-data="{ saving: false, cancel() { $refs.note.value = $refs.note.defaultValue; editing = false }, save() { if (this.saving) return; if ($refs.note.value === $refs.note.defaultValue) { editing = false } else { this.saving = true; $el.requestSubmit() } } }"
					@keydown.escape.stop.prevent="cancel()"
					@keydown.ctrl.enter.prevent="save()"
					@keydown.meta.enter.prevent="save()"
					class="grid gap-1"
				>
					<textarea
						x-ref="note"
						name="note"
						id={ "note-" + p.ID }
						rows="2"
						dir="auto"
						placeholder="Anything to remember?"
						aria-label="Note"
						@blur="save()"
						class="w-full resize-none [field-sizing:content] min-h-[3.5rem] max-h-80 rounded-lg bg-zinc-800/50 px-2 py-1.5 -mx-2 text-sm text-zinc-200 placeholder:text-zinc-500 outline-none ring-1 ring-zinc-700/50 focus:ring-zinc-500/70"
						if p.Error != "" {
							aria-invalid="true"
						}
					>{ draft }</textarea>
					if p.Error != "" {
						<p class="text-sm text-red-400">{ p.Error }</p>
					}
					<p class="flex flex-wrap items-center gap-x-1.5 text-xs text-zinc-500">
						<span>Saves when you click away · Markdown works</span>
						<span aria-hidden="true">·</span>
						<button type="button" @mousedown.prevent @click="cancel()" class="cursor-pointer hover:text-zinc-200">Cancel</button>
					</p>
				</form>
			}
		</div>
	}
}
