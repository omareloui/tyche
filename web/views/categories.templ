package views

import (
	"fmt"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/web/views/layouts"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
)

type CategoryFD struct {
	Name           form.FDInput
	Color          form.FDInput
	KindID         form.FDInput
	BudgetAmountFD *form.AmountFD
}

templ Categories(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *CategoryFD,
	knds []models.TransactionKind,
	categories []models.Category,
	curs []models.Currency) {
	@layouts.WithCreateForm(claims, "Categories", balances,
		CreateCategoryForm(fd, knds, curs, &claims.DefaultCurrency),
		layouts.WithAlpineMask()) {
		@categoriesList(categories)
	}
}

templ CreateCategoryForm(fd *CategoryFD, knds []models.TransactionKind, curs []models.Currency, defaultCur *models.Currency) {
	@form.CreateForm("Create Category", "/categories", "Create Category") {
		@categoryFormBody(fd, "", knds, curs, defaultCur)
	}
}

templ EditCategory(fd *CategoryFD, id string, knds []models.TransactionKind, curs []models.Currency, defaultCur *models.Currency) {
	@form.Form("put", fmt.Sprintf("/categories/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@categoryFormBody(fd, id, knds, curs, defaultCur)
		@form.EditFormButtons(fmt.Sprintf("/categories/%s", id))
	}
}

templ categoryFormBody(fd *CategoryFD, id string, knds []models.TransactionKind, curs []models.Currency, defaultCur *models.Currency) {
	@form.TextInput("Name", "name", "Enter category name", id, fd.Name, nil, nil)
	@form.SelectColor("color", id, models.CategoryColorOptions(), fd.Color, nil)
	@form.SelectTxKind("kind_id", id, knds, fd.KindID, nil)
	@form.AmountInputsWithCurrency(fd.BudgetAmountFD, id, curs, defaultCur)
}

templ categoriesList(categories []models.Category) {
	@components.Grid2ColOnSMUp("categories-list") {
		for _, cat := range categories {
			@Category(&cat)
		}
	}
}

templ Category(cat *models.Category) {
	@components.EntryCard(components.WithCardTitle(cat.Name), components.WithCardMenu([]templ.Component{
		components.EntryMenuAnchorItem("Edit", "get", fmt.Sprintf("/categories/%s/edit", cat.ID)),
		components.EntryMenuDeleteItem(fmt.Sprintf("/categories/%s", cat.ID)),
	})) {
		<p>ID: { cat.ID }</p>
		<p class="flex items-center gap-2">
			<span>Name:</span>
			<span class="inline-block w-3 h-3 rounded-full" style={ fmt.Sprintf("background-color: %s", models.CategoryColorToHex(cat.Color)) }></span>
			<span>{ cat.Name }</span>
		</p>
		<p>Kind ID: { cat.Kind.ID }</p>
		if cat.Kind.Enum != models.NilTxKind {
			<p>Kind: { cat.Kind.Enum.String() }</p>
		}
		if cat.BudgetCurrency != nil && cat.BudgetAmount > 0 {
			<p>
				Budget: { cat.ViewBudgetAmount() }
			</p>
		}
	}
}

templ CategoryOOB(cat *models.Category) {
	<div id="categories-list" hx-swap-oob="afterbegin">
		@Category(cat)
	</div>
}
