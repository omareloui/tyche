package views

import (
	"fmt"

	"github.com/omareloui/financial-planner/internal/models"
)

type CategoryFD struct {
	Name        FDInput
	KindID      FDInput
	BudgetInEgp FDInput
}

templ Categories(
	balances []models.Balance,
	fd *CategoryFD,
	knds []models.TransactionKind,
	categories []models.Category) {
	@baseLayout("Categories", balances) {
		@container() {
			@mainHeader("Categories")
			@CreateCategoryForm(fd, knds)
			@categoriesList(categories)
		}
	}
}

templ CreateCategoryForm(fd *CategoryFD, knds []models.TransactionKind) {
	@creationForm("Create Category", "/categories", "Create Category") {
		@categoryFormBody(fd, "", knds)
	}
}

templ EditCategory(fd *CategoryFD, id string, knds []models.TransactionKind) {
	@form("put", fmt.Sprintf("/categories/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@categoryFormBody(fd, id, knds)
		@editFormButtons(fmt.Sprintf("/categories/%s", id))
	}
}

templ categoryFormBody(fd *CategoryFD, id string, knds []models.TransactionKind) {
	@input("Name", "text", "name", "Enter category name", id, fd.Name)
	@selectTxKind("kind_id", id, knds, fd.KindID)
	@numberInput("Budget in EGP", "budget_in_egp", "Enter budget amount in EGP", id, fd.BudgetInEgp)
}

templ categoriesList(categories []models.Category) {
	@list("categories-list") {
		for _, cat := range categories {
			@Category(&cat)
		}
	}
}

templ Category(cat *models.Category) {
	<div hx-target="this" class="entry-container">
		<p>ID: { cat.ID }</p>
		<p>Name: { cat.Name }</p>
		<p>Kind ID: { cat.Kind.ID }</p>
		if cat.Kind.Kind != "" {
			<p>Kind: { cat.Kind.Kind }</p>
		}
		<p>
			Budget: { cat.ViewBudgetInEgp() }
		</p>
		<div class="flex gap-4">
			@editButton(fmt.Sprintf("/categories/%s/edit", cat.ID))
			@deleteButton(fmt.Sprintf("/categories/%s", cat.ID))
		</div>
	</div>
}

templ CategoryOOB(cat *models.Category) {
	<div id="categories-list" hx-swap-oob="afterbegin">
		@Category(cat)
	</div>
}
