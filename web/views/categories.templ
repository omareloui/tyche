package views

import (
	"fmt"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
)

type CategoryFD struct {
	Name           FDInput
	KindID         FDInput
	BudgetAmountFD *AmountFD
}

templ Categories(
	claims *jwt.AccessClaims,
	balances []models.Balance,
	fd *CategoryFD,
	knds []models.TransactionKind,
	categories []models.Category,
	curs []models.Currency) {
	@baseLayout(claims, "Categories", balances, &layoutOpts{includeAlpine: true, includeAlpineCollapse: true}) {
		@container() {
			@mainHeader("Categories")
			@CreateCategoryForm(fd, knds, curs)
			@categoriesList(categories)
		}
	}
}

templ CreateCategoryForm(fd *CategoryFD, knds []models.TransactionKind, curs []models.Currency) {
	@creationForm("Create Category", "/categories", "Create Category") {
		@categoryFormBody(fd, "", knds, curs)
	}
}

templ EditCategory(fd *CategoryFD, id string, knds []models.TransactionKind, curs []models.Currency) {
	@form("put", fmt.Sprintf("/categories/%s", id), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { id }</p>
		@categoryFormBody(fd, id, knds, curs)
		@editFormButtons(fmt.Sprintf("/categories/%s", id))
	}
}

templ categoryFormBody(fd *CategoryFD, id string, knds []models.TransactionKind, curs []models.Currency) {
	@input("Name", "text", "name", "Enter category name", id, fd.Name)
	@selectTxKind("kind_id", id, knds, fd.KindID)
	@AmountInputsWithCurrency(fd.BudgetAmountFD, id, curs)
}

templ categoriesList(categories []models.Category) {
	@list("categories-list") {
		for _, cat := range categories {
			@Category(&cat)
		}
	}
}

templ Category(cat *models.Category) {
	<div hx-target="this" class="entry-container">
		<p>ID: { cat.ID }</p>
		<p>Name: { cat.Name }</p>
		<p>Kind ID: { cat.Kind.ID }</p>
		if cat.Kind.Enum != models.NilTxKind {
			<p>Kind: { cat.Kind.Enum.String() }</p>
		}
		if cat.BudgetCurrency != nil && cat.BudgetAmount > 0 {
			<p>
				Budget: { cat.ViewBudgetAmount() }
			</p>
		}
		<div class="flex gap-4">
			@editButton(fmt.Sprintf("/categories/%s/edit", cat.ID))
			@deleteButton(fmt.Sprintf("/categories/%s", cat.ID))
		</div>
	</div>
}

templ CategoryOOB(cat *models.Category) {
	<div id="categories-list" hx-swap-oob="afterbegin">
		@Category(cat)
	</div>
}
