package views

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
)

// GoalPlanFD is the goal plan form: the monthly amount, the mode and the
// loan of the installments mode.
type GoalPlanFD struct {
	// From is GoalFromDetails when opened from the goal's details.
	From string
	// StartsOn is the day saving starts, empty for today, and Milestones
	// the days the other goals' plans free money from (in Currency, the
	// goal's).
	StartsOn   form.FDInput
	Milestones []models.PlanMilestone
	Currency   models.Currency
	// By is PlanByMonthly or PlanByMonths: what's given, the monthly amount
	// or the number of months (Months), the other worked out.
	By      form.FDInput
	Monthly form.FDInput
	Months  form.FDInput
	Mode    form.FDInput
	Loan    InstallmentPlanFD
}

// What a plan is given by.
const (
	PlanByMonthly = "monthly"
	PlanByMonths  = "months"
)

func (fd *GoalPlanFD) by() string {
	if fd.By.Value == PlanByMonths {
		return PlanByMonths
	}
	return PlanByMonthly
}

// GoalPlanOptions are the ways to pay for a goal at the plan's monthly
// amount: saving the whole price, or a down payment and a loan.
type GoalPlanOptions struct {
	Mode models.GoalPlanMode
	// Monthly is the amount put aside every month: the plan's, or the
	// picked option's worked out from its months for a sized one.
	Monthly float64
	// Months is a sized plan's.
	Months int
	// Save and Loan are nil without a monthly amount, Loan also with a
	// LoanProblem.
	Save, Loan  *models.GoalProjection
	LoanProblem string
}

// Picked is the projection of the option picked, nil without one.
func (o *GoalPlanOptions) Picked() *models.GoalProjection {
	if o.Mode == models.GoalPlanInstallments {
		return o.Loan
	}
	return o.Save
}

// GoalPlanCard is a planned goal's projection and next deposit, on its card.
type GoalPlanCard struct {
	Projection *models.GoalProjection
	// Problem is set when the plan doesn't work out anymore.
	Problem string
	// Next is the next deposit (0 once saved), on NextOn, from Source.
	Next    float64
	NextOn  time.Time
	Source  models.GoalSource
	NextURL string
}

// CanSaveNext tells if the accounts have the money for the next deposit.
func (c *GoalPlanCard) CanSaveNext() bool {
	return c.Source.Account != nil && c.Source.Available >= c.Next-0.005
}

func goalPlanURL(gl *models.Goal) string {
	return fmt.Sprintf("/goals/%s/plan", gl.ID)
}

templ GoalPlanForm(gl *models.Goal, fd *GoalPlanFD, money models.GoalPlanMoney, opts GoalPlanOptions) {
	@components.Drawer(components.DrawerProps{Label: "Plan " + gl.Name}) {
		@GoalPlanFormFields(gl, fd, money, opts)
	}
}

// GoalPlanFormFields is GoalPlanForm's form alone, answered with its errors.
templ GoalPlanFormFields(gl *models.Goal, fd *GoalPlanFD, money models.GoalPlanMoney, opts GoalPlanOptions) {
	{{ id := "plan-" + gl.ID }}
	{{ mode := fd.Mode.Value }}
	if mode == "" {
		{{ mode = models.GoalPlanSave.String() }}
	}
	@form.DrawerForm(form.DrawerFormProps{
		Header: goalPlanHeader(gl), Method: "put", URL: goalPlanURL(gl),
		Submit: "Save plan", Class: "[--accent:var(--color-violet-400)]",
		CancelClick: goalBackCancel(gl.ID, fd.From),
	}) {
		@goalFromInput(fd.From)
		<div x-data={ goalPlanData(gl, mode, fd.Loan.strategy()) } data-price={ fmt.Sprint(gl.Price) } @change="onChange($event)" class="grid gap-5">
			@planInputs(fd, id, mode)
			<div
				hx-post={ goalPlanURL(gl) + "/preview" }
				hx-trigger="input delay:400ms from:closest form, change from:closest form"
				hx-target="this"
				hx-swap="innerHTML"
				hx-sync="this:replace"
			>
				@GoalPlanPreview(gl, money, opts)
			</div>
		</div>
	}
}

// planInputs are a plan's: the day saving starts, the monthly amount put
// aside or the months to save over, and how it's paid for: saving it all,
// or a down payment then a loan. They expect a moneyInputs scope.
templ planInputs(fd *GoalPlanFD, id string, mode string) {
	@form.Field("Start saving on", "starts_on", id, icons.Calendar("15"), fd.StartsOn.Error) {
		@form.Control("text", "starts_on", "Today", id, fd.StartsOn, templ.Attributes{
			"autocomplete":           "off",
			"x-mask":                 "9999-99-99",
			"data-datepicker":        true,
			"data-datepicker-change": true,
			"data-plan-starts-on":    true,
			"x-ref":                  "startsOn",
		})
		<p class="mt-1 text-xs text-zinc-500">The first deposit's day. Later on frees more of your month when other goals are done by then.</p>
	}
	if len(fd.Milestones) > 0 {
		@planTimeline(fd)
	}
	<div class="grid gap-2">
		<div class="flex items-center justify-between gap-3">
			<span class="text-sm font-medium text-zinc-400">Save by</span>
			@unitToggle("plan_by", id, fd.by(), []form.RadioOption{
				{Value: PlanByMonthly, Label: "Monthly amount"},
				{Value: PlanByMonths, Label: "Months"},
			})
		</div>
		<div x-show={ fmt.Sprintf("planBy === '%s'", PlanByMonthly) }>
			@form.Field("Put aside every month", "monthly", id, icons.PiggyBank("15"), fd.Monthly.Error) {
				@form.Control("text", "monthly", "", id, fd.Monthly, templ.Attributes{
					"autocomplete":   "off",
					"inputmode":      "decimal",
					"data-money":     true,
					"x-mask:dynamic": moneyMask,
					":placeholder":   "money(1000)",
					"x-ref":          "monthly",
				})
			}
		</div>
		<div x-show={ fmt.Sprintf("planBy === '%s'", PlanByMonths) } x-cloak>
			@form.Field("Months to save over", "months", id, icons.Calendar("15"), fd.Months.Error) {
				@form.Control("text", "months", "e.g. 12", id, fd.Months, templ.Attributes{
					"inputmode": "numeric", "autocomplete": "off", "x-mask": "999",
				})
			}
		</div>
	</div>
	@form.SegmentedRadio("How to pay for it", "mode", id, []form.RadioOption{
		{Value: models.GoalPlanSave.String(), Label: "Save it all"},
		{Value: models.GoalPlanInstallments.String(), Label: "Down payment + loan"},
	}, form.FDInput{Value: mode}, nil)
	<div x-show={ fmt.Sprintf("mode === '%s'", models.GoalPlanInstallments) } x-cloak class="grid gap-2">
		<p class="text-sm text-zinc-500">
			Save the down payment (and the fees paid on the day), then the loan's payments come out of the same monthly amount. Leave the months empty to take the shortest loan it pays.
		</p>
		@installmentPlanInputs(&fd.Loan, id, false)
	</div>
}

// planTimeline is when the other goals' plans free money, each starting the
// saving then on a click.
templ planTimeline(fd *GoalPlanFD) {
	<div class="grid gap-1.5 -mt-2">
		<p class="text-xs text-zinc-500">When your other plans free money</p>
		<div class="no-scrollbar overflow-x-auto overscroll-x-contain">
			<ol class="relative flex gap-2 min-w-max pt-3">
				<div aria-hidden="true" class="absolute top-[5px] inset-x-3 h-px bg-zinc-800"></div>
				<li>
					@planMilestoneButton("", "Today", "", "")
				</li>
				for _, m := range fd.Milestones {
					<li>
						@planMilestoneButton(m.On.Format(time.DateOnly), m.On.Format("Jan 2006"), planMilestoneLabel(&m), fd.Currency.Format(m.Free)+" free")
					</li>
				}
			</ol>
		</div>
	</div>
}

templ planMilestoneButton(day, when, label, free string) {
	<button
		type="button"
		@click={ fmt.Sprintf("$refs.startsOn.value = '%s'; $refs.startsOn.dispatchEvent(new Event('change', {bubbles: true}))", day) }
		:class={ fmt.Sprintf("{'is-active': (tick, $refs.startsOn.value === '%s')}", day) }
		class="plan-milestone"
	>
		<span aria-hidden="true" class="plan-milestone-dot"></span>
		<span class="text-xs text-zinc-500">{ when }</span>
		if label != "" {
			<span class="text-sm text-zinc-200">{ label }</span>
		}
		if free != "" {
			<span class="sensitive text-xs tabular-nums text-(--accent)">{ free }</span>
		}
	</button>
}

// planMilestoneLabel names what frees the money then, e.g. "TV done · Car
// saved", or "First free money".
func planMilestoneLabel(m *models.PlanMilestone) string {
	names := func(gls []*models.Goal) string {
		s := make([]string, len(gls))
		for i, g := range gls {
			s[i] = g.Name
		}
		return strings.Join(s, ", ")
	}
	var parts []string
	if len(m.Done) > 0 {
		parts = append(parts, names(m.Done)+" done")
	}
	if len(m.Saved) > 0 {
		parts = append(parts, names(m.Saved)+" saved")
	}
	if len(parts) == 0 && m.FirstFree {
		return "First free money"
	}
	label := strings.Join(parts, " · ")
	if m.FirstFree {
		label += " · first free money"
	}
	return label
}

// goalPlanData starts the form's moneyInputs scope in the goal's currency.
func goalPlanData(gl *models.Goal, mode, strategy string) string {
	symJSON, _ := json.Marshal(gl.Currency.Symbol)
	modeJSON, _ := json.Marshal(mode)
	strategyJSON, _ := json.Marshal(strategy)
	return fmt.Sprintf("moneyInputs({}, %s, %s, %s)", symJSON, modeJSON, strategyJSON)
}

templ goalPlanHeader(gl *models.Goal) {
	<div class="flex items-center gap-3">
		@goalRing(gl.ShownPercentage(), goalStateOf(gl), "size-11", "text-[0.65rem]")
		<div class="min-w-0">
			<h2 class="text-lg font-bold truncate">Plan { gl.Name }</h2>
			<p class="sensitive text-sm text-zinc-500 tabular-nums">{ gl.ViewProgress() } of { gl.ViewAmount() } saved</p>
		</div>
	</div>
}

// goalPlanMoney is what's free every month: the salary less the budgets and
// the other goals' plans.
templ goalPlanMoney(m models.GoalPlanMoney) {
	if !m.HasSalary() {
		<p class="flex items-start gap-2 px-4 py-3 rounded-2xl bg-zinc-800/30 ring-1 ring-zinc-800 text-sm text-zinc-400">
			@icons.Wallet("16", &templ.Attributes{"class": "shrink-0 mt-0.5"})
			<span>
				Set your monthly salary in <a href={ SettingsURL(SettingsWork) } class="text-(--accent) underline-offset-2 hover:underline">Settings</a> to see what's free after your budgets. You can still type an amount.
			</span>
		</p>
	} else {
		<div class="grid gap-2">
			<dl class="grid gap-1.5 px-4 py-3 rounded-2xl bg-zinc-800/30 ring-1 ring-zinc-800 text-sm tabular-nums">
				if !m.IsCurrent(time.Now()) {
					<p class="text-xs font-semibold uppercase tracking-wider text-zinc-500">In { m.Month.RangeLabel() }</p>
				}
				@goalPlanMoneyRow("Salary", m.Currency.Format(m.Salary), "")
				@goalPlanMoneyRow("Budgets", "− "+m.Currency.Format(m.Budgets), "")
				if m.OtherPlans > 0 {
					@goalPlanMoneyRow("Other goals' plans", "− "+m.Currency.Format(m.OtherPlans), "")
				}
				<div class="flex items-center justify-between gap-3 pt-1.5 border-t border-zinc-800">
					<dt class="font-medium text-zinc-200">Free every month</dt>
					<dd class="sensitive font-bold text-(--accent)">{ m.Currency.Format(m.Free()) }</dd>
				</div>
			</dl>
			if m.Free() > 0 {
				<button
					type="button"
					@click={ fmt.Sprintf("planBy = '%s'; $root.querySelector('[name=plan_by][value=%s]').checked = true; $refs.monthly.value = '%.2f'; $refs.monthly.dispatchEvent(new Event('input', {bubbles: true})); $refs.monthly.focus()", PlanByMonthly, PlanByMonthly, m.Free()) }
					class="justify-self-start inline-flex items-center gap-1.5 h-8 px-3 rounded-full border border-zinc-700 text-sm text-zinc-300 cursor-pointer transition-colors hover:border-(--accent) hover:text-(--accent)"
				>
					@icons.Sparkles("14")
					Use all that's free · <span class="sensitive tabular-nums">{ m.Currency.Format(m.Free()) }</span>
				</button>
			}
		</div>
	}
}

templ goalPlanMoneyRow(label, value, class string) {
	<div class="flex items-center justify-between gap-3">
		<dt class="text-zinc-500">{ label }</dt>
		<dd class={ "sensitive text-zinc-300", class }>{ value }</dd>
	</div>
}

templ GoalPlanHint(msg string) {
	<p class="text-sm text-zinc-500">{ msg }</p>
}

// GoalPlanPreview compares saving the whole price with a down payment and a
// loan, the picked one highlighted.
templ GoalPlanPreview(gl *models.Goal, money models.GoalPlanMoney, opts GoalPlanOptions) {
	<div class="grid gap-4">
		@goalPlanMoney(money)
		if opts.Save == nil && opts.Loan == nil && opts.LoanProblem == "" {
			@GoalPlanHint("Enter how much to put aside every month, or the months to save over, to see when you'd get it.")
		} else {
			<div class="grid gap-3">
				if money.HasSalary() && opts.Monthly > money.Free()+0.005 {
					<p class="flex items-center gap-2 text-sm text-amber-300">
						@icons.Warning("16", &templ.Attributes{"class": "shrink-0"})
						<span>That's more than the <span class="sensitive tabular-nums">{ money.Currency.Format(money.Free()) }</span> free every month.</span>
					</p>
				}
				<div class="grid sm:grid-cols-2 gap-3">
					@goalOptionCard("Save it all", opts.Mode == models.GoalPlanSave) {
						if opts.Save != nil {
							{{ pr := opts.Save }}
							@goalOptionOwn(pr, &gl.Currency)
							<p class="text-sm text-zinc-400">
								if pr.SaveMonths > 0 {
									{ fmt.Sprint(pr.SaveMonths) } { plural(pr.SaveMonths, "month", "months") } of saving
								} else {
									Already saved
								}
							</p>
							<p class="sensitive text-sm text-zinc-500 tabular-nums">{ gl.Currency.Format(pr.TotalCost) } in total, nothing extra</p>
						}
					}
					@goalOptionCard("Down payment + loan", opts.Mode == models.GoalPlanInstallments) {
						if opts.LoanProblem != "" {
							<p class="text-sm text-zinc-500">{ opts.LoanProblem }</p>
						} else if opts.Loan != nil {
							{{ pr := opts.Loan }}
							@goalOptionOwn(pr, &gl.Currency)
							<p class="text-sm text-zinc-400">
								<span class="sensitive tabular-nums">{ gl.Currency.Format(pr.Target) }</span> down
								if pr.SaveMonths > 0 {
									in { fmt.Sprint(pr.SaveMonths) } { plural(pr.SaveMonths, "month", "months") }
								} else {
									already saved
								}
							</p>
							<p class="text-sm text-zinc-400">
								then <span class="sensitive tabular-nums">{ planMonthly(pr.Loan, gl.Currency.Symbol) }</span> × { fmt.Sprint(len(pr.Loan.Rows)) } to { pr.DoneOn.Format("Jan 2006") }
							</p>
							<p class="sensitive text-sm text-zinc-500 tabular-nums">
								{ gl.Currency.Format(pr.TotalCost) } in total
								if pr.Extra > 0.005 {
									· <span class="text-zinc-300">{ gl.Currency.Format(pr.Extra) }</span> extra · <span class={ aprClass(pr.Loan.APR) }>{ models.ViewRate(pr.Loan.APR) }</span> a year
								}
							</p>
							if pr.LoanOverMonthly {
								<p class="text-sm text-amber-300">Its payments are more than your monthly amount.</p>
							}
						}
					}
				</div>
				if opts.Save != nil && opts.Loan != nil {
					{{ sooner := monthsApart(opts.Loan.BuyOn, opts.Save.BuyOn) }}
					if sooner > 0 {
						<p class="text-sm text-zinc-400">
							The loan gets it { fmt.Sprint(sooner) } { plural(sooner, "month", "months") } sooner
							if opts.Loan.Extra > 0.005 {
								and costs <span class="sensitive tabular-nums">{ gl.Currency.Format(opts.Loan.Extra) }</span> more
							}
						</p>
						<p class="text-xs text-zinc-500">You'd be paying until { opts.Loan.DoneOn.Format("Jan 2006") } instead of owning it outright by { opts.Save.BuyOn.Format("Jan 2006") }</p>
					}
				}
			</div>
		}
	</div>
}

templ goalOptionCard(title string, picked bool) {
	<div
		class={ "grid content-start gap-1.5 px-4 py-3 rounded-2xl ring-1 transition-colors",
			templ.KV("bg-(--accent)/8 ring-(--accent)/40", picked),
			templ.KV("bg-zinc-800/30 ring-zinc-800", !picked) }
	>
		<p class="flex items-center justify-between gap-2 text-xs font-semibold uppercase tracking-wider text-zinc-500">
			{ title }
			if picked {
				@icons.Check("14", &templ.Attributes{"class": "text-(--accent)"})
			}
		</p>
		{ children... }
	</div>
}

templ goalOptionOwn(pr *models.GoalProjection, cur *models.Currency) {
	<p class="text-xs text-zinc-500">Yours by</p>
	<p class="text-xl font-bold font-(family-name:--font-biorhyme-expanded)">
		if pr.Left <= 0.005 {
			Now
		} else {
			{ pr.BuyOn.Format("Jan 2006") }
		}
	</p>
	if pr.Plan.IsSized() && pr.Left > 0.005 {
		<p class="text-sm text-zinc-300">
			<span class="sensitive font-semibold tabular-nums">{ cur.Format(pr.Plan.Monthly) }</span> a month
		</p>
	}
}

// monthsApart is how many months from goes before to.
func monthsApart(from, to time.Time) int {
	return (to.Year()-from.Year())*12 + int(to.Month()) - int(from.Month())
}

// goalPlanSummary is a planned goal's projection on its card, with its next
// deposit.
templ goalPlanSummary(gl *models.Goal, card *GoalPlanCard, inDetails bool) {
	<div class="relative grid gap-2 pt-3 border-t border-zinc-800/80 text-sm">
		if card.Problem != "" || card.Projection == nil {
			<p class="text-zinc-500">{ card.Problem }</p>
		} else {
			{{ pr := card.Projection }}
			<div class="flex flex-wrap items-center justify-between gap-2">
				<p class="text-zinc-500 tabular-nums">
					<span class="sensitive text-zinc-200">{ gl.Currency.Format(pr.Plan.Monthly) }</span>/mo
					if pr.Left > 0.005 {
						· { goalPlanBuyLabel(pr) } { pr.BuyOn.Format("Jan 2006") }
					}
				</p>
				@goalPlanStatus(gl, pr)
			</div>
			<div class="flex flex-wrap items-center gap-1.5">
				if pr.Plan.StartsOn.After(time.Now()) && pr.Left > 0.005 {
					<span class="chip text-(--accent)">
						@icons.PiggyBank("12")
						Starts saving { affordDay(pr.Plan.StartsOn) }
					</span>
				}
				<span class="chip">
					@icons.Calendar("12")
					if pr.Left > 0.005 {
						Buy { goalInMonths(monthsApart(time.Now(), pr.BuyOn)) }
					} else {
						Ready to buy
					}
				</span>
				if pr.Loan != nil {
					<span class="chip">
						@icons.Hourglass("12")
						Paid off { goalInMonths(monthsApart(time.Now(), pr.DoneOn)) }
					</span>
				}
			</div>
			if pr.Loan != nil {
				<p class="text-xs text-zinc-500 tabular-nums">
					<span class="sensitive">{ gl.Currency.Format(pr.Target) }</span> down, then <span class="sensitive">{ planMonthly(pr.Loan, gl.Currency.Symbol) }</span> × { fmt.Sprint(len(pr.Loan.Rows)) } to { pr.DoneOn.Format("Jan 2006") }
				</p>
			}
			if card.Next > 0 {
				<div class="flex flex-wrap items-center gap-2">
					if card.CanSaveNext() {
						<button
							if inDetails {
								hx-get={ fromDetails(card.NextURL) }
							} else {
								hx-get={ card.NextURL }
							}
							hx-target={ "#" + components.DrawerSlot }
							hx-swap="innerHTML"
							class="inline-flex items-center gap-1.5 h-8 px-3 rounded-full bg-(--accent) text-sm font-semibold text-zinc-950 cursor-pointer transition hover:brightness-110 active:scale-[.98]"
						>
							@icons.PiggyBank("14")
							Save next · <span class="sensitive tabular-nums">{ gl.Currency.Format(card.Next) }</span>
						</button>
						<span class="text-xs text-zinc-500 truncate">
							if card.NextOn.After(time.Now()) {
								{ card.NextOn.Format("January") }'s ·
							}
							from { card.Source.Account.Name }
						</span>
					} else {
						<button
							type="button"
							disabled
							class="inline-flex items-center gap-1.5 h-8 px-3 rounded-full bg-zinc-800 text-sm text-zinc-500 cursor-not-allowed"
						>
							@icons.PiggyBank("14")
							Save next · <span class="sensitive tabular-nums">{ gl.Currency.Format(card.Next) }</span>
						</button>
						<span class="text-xs text-zinc-500">
							Need <span class="sensitive tabular-nums">{ gl.Currency.Format(card.Next - card.Source.Available) }</span> more in your accounts
						</span>
					}
				</div>
			}
		}
	</div>
}

// goalInMonths is how far a month is from now, e.g. "in 5 months" or "this
// month".
func goalInMonths(n int) string {
	switch {
	case n <= 0:
		return "this month"
	case n == 1:
		return "in 1 month"
	}
	return fmt.Sprintf("in %d months", n)
}

func goalPlanBuyLabel(pr *models.GoalProjection) string {
	if pr.Loan != nil {
		return "down payment by"
	}
	return "own it by"
}

// goalPlanStatus tells if the goal keeps up with its plan.
templ goalPlanStatus(gl *models.Goal, pr *models.GoalProjection) {
	if pr.Left <= 0.005 {
		<span class="chip text-emerald-400">
			@icons.Check("12")
			Saved
		</span>
	} else if pr.Behind() > 0.005 {
		<span class="chip text-amber-300">
			<span class="sensitive tabular-nums">{ gl.Currency.Format(pr.Behind()) }</span> behind
		</span>
	} else if pr.Ahead() > 0.005 {
		<span class="chip text-emerald-400">
			<span class="sensitive tabular-nums">{ gl.Currency.Format(pr.Ahead()) }</span> ahead
		</span>
	} else {
		<span class="chip">On track</span>
	}
}

// goalBuyLoan schedules the plan's loan payments on buying the goal.
templ goalBuyLoan(gl *models.Goal, fd *GoalBuyFD, loan *models.InstallmentSchedule, accs []models.Account) {
	<div class="grid gap-3 px-4 py-3 rounded-2xl bg-zinc-800/30 ring-1 ring-zinc-800">
		@form.Toggle("Schedule the loan's payments", "schedule_loan", gl.ID, icons.Calendar("15"), fd.ScheduleLoan, nil)
		<p class="sensitive text-sm text-zinc-400 tabular-nums">
			{ planMonthly(loan, gl.Currency.Symbol) } × { fmt.Sprint(len(loan.Rows)) }, from a month after the purchase, as expenses
		</p>
		<div class="flex flex-wrap items-center gap-2">
			<span class="text-sm text-zinc-500">paid from</span>
			@form.SelectAccountChip("Account", "loan_account_id", gl.ID, accs, fd.LoanAccountID, nil)
		</div>
		@form.ErrorMessage(fd.LoanAccountID.Error)
	</div>
}
