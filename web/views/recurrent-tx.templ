package views

import (
	"fmt"
	"slices"
	"time"

	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
	"github.com/omareloui/tyche/web/views/icons"
	"github.com/omareloui/tyche/web/views/layouts"
)

type RecurrenceFD struct {
	IsRecurrent form.FDInput
	Unit        form.FDInput
	Every       form.FDInput
	StopsOn     form.FDInput
	AutoFulfill form.FDInput
	// NextOn is the day of the next occurrence, the others counted from it:
	// only on the edit form (WithNextOn).
	NextOn     form.FDInput
	WithNextOn bool
}

templ RecurrentTxs(
	claims *jwt.AccessClaims, balances []models.Balance, rtxs []models.RecurrentTx,
	fd *TransactionFD, accs []models.Account, knds []models.TxKind,
	cats []models.Category, cps []models.Counterparty, openID string) {
	@layouts.WithCreateForm(claims, "Recurring", "New recurring", balances,
		CreateRecurrentTxForm(fd, accs, knds, cats, cps, &claims.DefaultCurrency)) {
		@rtxsList(rtxs, &claims.DefaultCurrency, false)
		@components.DrawerOnLoad(recurrentTxDetailsURLIf(openID))
	}
}

// CreateRecurrentTxForm is the page's create form: a transaction on its
// start date, repeating from it.
templ CreateRecurrentTxForm(
	fd *TransactionFD, accs []models.Account,
	knds []models.TxKind, cats []models.Category,
	cps []models.Counterparty,
	defaultCur *models.Currency) {
	@form.SheetForm("New recurring transaction", "/recurrent-tx", "Add", "tx-form") {
		@TransactionAmountsAndKindFormBody(&fd.TransactionAmountsAndKindFD, "0", knds, cats, accs, cps, defaultCur)
		@form.Field("Description", "description", "0", icons.Pencil("15"), fd.Description.Error) {
			@form.Control("text", "description", "What is it for?", "0", fd.Description, nil)
		}
		@txItemsField("0", fd.Items, &ReceiptFD{})
		<div>
			@form.Field("Starts on", "scheduled_to", "0", icons.Calendar("15"), fd.ScheduledTo.Error) {
				@form.Control("text", "scheduled_to", "yyyy-mm-dd", "0", fd.ScheduledTo, templ.Attributes{
					"autocomplete":    "off",
					"x-mask":          "9999-99-99",
					"data-datepicker": true,
				})
			}
			<p class="mt-1.5 text-sm text-zinc-500">The first one, then it repeats from it.</p>
		</div>
		<input type="hidden" name="is_recurrent" value="on"/>
		@rtxRepeatsBox("0", fd.RecurrenceFD)
	}
}

templ RecurrenceFormBody(id string, fd *RecurrenceFD) {
	<div data-recurrence-form class="grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
		@form.Toggle("Repeat", "is_recurrent", id, icons.Repeat("18"), fd.IsRecurrent,
			templ.Attributes{
				"hx-post":    fmt.Sprintf("/recurrence-form/%s", id),
				"hx-trigger": "change",
				"hx-target":  "closest [data-recurrence-form]",
				"hx-swap":    "outerHTML",
				"hx-sync":    "closest form:abort",
			})
		if fd.IsRecurrent.Value != "" {
			@recurrenceFormBody(id, fd)
		}
	</div>
}

type RecurrentTxFD struct {
	RecurrenceFD
	TransactionAmountsAndKindFD
	Description form.FDInput
	// Items are its lines, copied to its occurrences.
	Items []TxItemFD
}

templ rtxFormBody(
	id string, fd *RecurrentTxFD,
	accs []models.Account, knds []models.TxKind,
	cats []models.Category, cps []models.Counterparty,
	defaultCur *models.Currency) {
	@TransactionAmountsAndKindFormBody(&fd.TransactionAmountsAndKindFD, id, knds, cats, accs, cps, defaultCur)
	@form.Field("Description", "description", id, icons.Pencil("15"), fd.Description.Error) {
		@form.Control("text", "description", "What is it for?", id, fd.Description, nil)
	}
	@txItemsField(id, fd.Items, &ReceiptFD{})
	@rtxRepeatsBox(id, &fd.RecurrenceFD)
}

templ rtxRepeatsBox(id string, fd *RecurrenceFD) {
	<div class="grid gap-4 rounded-2xl border border-zinc-800 bg-zinc-800/20 p-4">
		<p class="inline-flex items-center gap-2 text-zinc-300">
			@icons.Repeat("18")
			Repeats
		</p>
		@recurrenceFormBody(id, fd)
	</div>
}

templ recurrenceFormBody(id string, fd *RecurrenceFD) {
	<div class="grid grid-cols-[5.5rem_1fr] gap-3">
		@form.Field("Every", "every", id, nil, fd.Every.Error) {
			@form.Control("number", "every", "1", id, fd.Every, templ.Attributes{"min": "1", "inputmode": "numeric", "class": "input-field text-center tabular-nums"})
		}
		<div class="min-w-0">
			@form.SelectRecurrentUnit("unit", id, fd.Unit)
		</div>
	</div>
	<div>
		@form.Field("Stops on", "stops_on", id, icons.Calendar("15"), fd.StopsOn.Error) {
			@form.ClearableDate("stops_on", "Never", id, fd.StopsOn)
		}
		<p class="mt-1.5 text-sm text-zinc-500">Leave it empty to keep it going.</p>
	</div>
	if fd.WithNextOn {
		<div>
			@form.Field("Next on", "next_on", id, icons.Calendar("15"), fd.NextOn.Error) {
				@form.Control("text", "next_on", "yyyy-mm-dd", id, fd.NextOn, templ.Attributes{
					"autocomplete":    "off",
					"x-mask":          "9999-99-99",
					"data-datepicker": true,
				})
			}
			<p class="mt-1.5 text-sm text-zinc-500">The next ones are counted from it.</p>
		</div>
	}
	<div>
		@form.Toggle("Pays by itself", "auto_fulfill", id, icons.Zap("18"), fd.AutoFulfill, nil)
		<p class="mt-1.5 text-sm text-zinc-500">Fulfilled on its day, as a direct debit, for you to review.</p>
	</div>
}

// EditRecurrentTx is the recurrent transaction's edit form, in a drawer.
templ EditRecurrentTx(
	rtx *models.RecurrentTx, fd *RecurrentTxFD,
	accs []models.Account, knds []models.TxKind,
	cats []models.Category, cps []models.Counterparty,
	defaultCur *models.Currency) {
	@components.Drawer(components.DrawerProps{Label: "Edit recurring transaction"}) {
		@EditRecurrentTxForm(rtx, fd, accs, knds, cats, cps, defaultCur)
	}
}

// EditRecurrentTxForm is EditRecurrentTx's form alone, answered with its
// errors.
templ EditRecurrentTxForm(
	rtx *models.RecurrentTx, fd *RecurrentTxFD,
	accs []models.Account, knds []models.TxKind,
	cats []models.Category, cps []models.Counterparty,
	defaultCur *models.Currency) {
	@form.DrawerForm(form.DrawerFormProps{
		Header: rtxEditHeader(), Method: "put", URL: fmt.Sprintf("/recurrent-tx/%s", rtx.ID),
		Submit: "Save changes", Class: "tx-form",
	}) {
		@rtxFormBody(rtx.ID, fd, accs, knds, cats, cps, defaultCur)
	}
}

templ rtxEditHeader() {
	<h2 class="text-lg font-bold">Edit recurring transaction</h2>
	<p class="text-sm text-zinc-500">Its upcoming scheduled transactions follow, but the ones edited on their own.</p>
}

templ rtxsList(rtxs []models.RecurrentTx, def *models.Currency, oob bool) {
	{{ active, ended := splitRecurrentTxs(rtxs) }}
	<div
		id="rtx-list"
		class="grid gap-8"
		if oob {
			hx-swap-oob="true"
		}
	>
		@rtxSummary(rtxs, def, false)
		if len(rtxs) > 0 {
			@rtxSMSMatchHint()
		}
		<section class="hidden has-[[data-rtx]]:block">
			<h2 class="flex items-center gap-2 mb-3 text-sm font-semibold uppercase tracking-wider text-zinc-500">
				@icons.Repeat("16")
				Active
			</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				for _, rt := range active {
					@RecurrentTx(&rt)
				}
			</div>
		</section>
		<details class="group hidden has-[[data-rtx]]:block">
			<summary class="flex items-center gap-2 mb-3 list-none cursor-pointer select-none text-zinc-500 hover:text-zinc-300 [&::-webkit-details-marker]:hidden">
				@icons.Archive("16")
				<h2 class="text-sm font-semibold uppercase tracking-wider">Ended</h2>
				@icons.ChevronDown("16", &templ.Attributes{"class": "transition-transform group-open:rotate-180"})
			</summary>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				for _, rt := range ended {
					@RecurrentTx(&rt)
				}
			</div>
		</details>
		<div class="rtx-empty hidden place-items-center gap-3 py-16 text-center">
			<div class="relative grid place-items-center w-16 h-16 rounded-2xl bg-violet-400/15 text-violet-400">
				<div aria-hidden="true" class="absolute inset-0 rounded-2xl bg-violet-400/20 blur-xl"></div>
				@icons.Repeat("30", &templ.Attributes{"class": "relative"})
			</div>
			<p class="mt-2 text-xl font-semibold">Nothing recurring yet</p>
			<p class="max-w-sm text-zinc-500">Rent, salary, subscriptions… add one here, or turn on <span class="text-zinc-300">Repeat</span> when adding a transaction.</p>
			<button type="button" class="btn-primary mt-2" @click="openCreateForm=true">
				Add recurring transaction
				@icons.Repeat("18")
			</button>
		</div>
	</div>
}

// rtxSummary is what the active recurring transactions add up to in an
// average month, in the default currency.
templ rtxSummary(rtxs []models.RecurrentTx, def *models.Currency, oob bool) {
	{{ s := summarizeRecurrentTxs(rtxs, def) }}
	<div
		id="rtx-summary"
		if oob {
			hx-swap-oob="true"
		}
	>
		if s.Active > 0 {
			@components.GlassCard("grid gap-5 p-5 sm:p-6", "bg-violet-400/12", "bg-emerald-400/10") {
				<div class="relative flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
					<div class="min-w-0">
						<p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-violet-400">
							@icons.Calendar("14")
							In a typical month
						</p>
						<div class="sensitive flex flex-wrap items-baseline gap-x-5 gap-y-1 mt-1">
							<p class="text-3xl sm:text-4xl font-bold tabular-nums font-(family-name:--font-biorhyme-expanded)">
								{ formatSignedAmount(-s.Out, def) }
							</p>
							if s.In > 0 {
								<p class="text-xl font-bold tabular-nums text-emerald-400 font-(family-name:--font-biorhyme-expanded)">
									{ formatSignedAmount(s.In, def) }
								</p>
							}
						</div>
						<p class="text-sm text-zinc-500">
							going out
							if s.In > 0 {
								· coming in
							}
							across { fmt.Sprint(s.Active) } recurring { plural(s.Active, "transaction", "transactions") }
						</p>
					</div>
					<div class="flex gap-2">
						@statTile(fmt.Sprint(s.Active), "Active", "text-zinc-100")
						@statTile(fmt.Sprint(s.DueThisWeek), "This week", rtxStatClass(s.DueThisWeek > 0, "text-sky-300"))
						if s.Overdue > 0 {
							@statTile(fmt.Sprint(s.Overdue), "Overdue", "text-red-400")
						}
					</div>
				</div>
			}
		}
	</div>
}

templ RecurrentTx(rt *models.RecurrentTx) {
	@recurrentTxCard(rt, false)
}

// RecurrentTxOOB swaps the card in place, e.g. after an action of its
// details.
templ RecurrentTxOOB(rt *models.RecurrentTx) {
	@recurrentTxCard(rt, true)
}

templ recurrentTxCard(rt *models.RecurrentTx, oob bool) {
	{{ tx := rt.AsTransaction() }}
	{{ v := newTxView(ctx, tx) }}
	{{ today := dateOf(time.Now()) }}
	{{ ended := rt.HasEnded(today) }}
	<div
		id={ RecurrentTxID(rt.ID) }
		hx-target="this"
		hx-swap="outerHTML"
		if oob {
			hx-swap-oob="true"
		}
		data-rtx
		class={ "relative", templ.KV("opacity-60 hover:opacity-100 transition-opacity", ended) }
		x-data={ accountCardData }
		:class="{ 'z-30': openMenu }"
	>
		@components.EntryMenuAt("openMenu", cardMenuPosition, getRecurrentTxMenuItems(rt))
		<div
			tabindex="0"
			data-details={ recurrentTxDetailsURL(rt.ID) }
			@click="openDetails($event, $el)"
			@keydown.enter.self="openDetails($event, $el)"
			aria-label={ v.title + " details" }
			class={ "relative flex flex-col gap-4 h-full p-4 rounded-2xl bg-zinc-700/20 overflow-hidden cursor-pointer transition hover:bg-zinc-700/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--accent)/60", rtxAccentClass(rt.Kind) }
		>
			<div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-(--accent)/10 blur-2xl"></div>
			<div class="relative flex items-center gap-3 min-w-0">
				@txTile(tx, &v)
				<div class="flex-1 min-w-0">
					<p class="text-lg leading-tight truncate">{ v.title }</p>
					<p class="flex items-center gap-1.5 text-sm text-zinc-500 min-w-0">
						<span class="shrink-0">
							@accKindIcon(v.accKind, "14")
						</span>
						if v.subtitle != "" {
							<span class="truncate">{ v.subtitle }</span>
							<span class="shrink-0">·</span>
						}
						@txAccounts(&v)
					</p>
				</div>
				@components.EntryMenuTrigger("openMenu", "Recurring transaction actions")
			</div>
			<div class="relative flex items-end justify-between gap-3">
				<p
					class={
						"sensitive text-2xl font-bold tabular-nums truncate font-(family-name:--font-biorhyme-expanded)",
						templ.KV("text-emerald-400", v.tone == txToneIn),
						templ.KV("text-zinc-300", v.tone == txToneNeutral),
					}
				>{ v.amount }</p>
				<span class="inline-flex shrink-0 items-center gap-1.5 h-7 px-2.5 rounded-full bg-(--accent)/12 text-sm text-(--accent)">
					@icons.Repeat("14")
					{ rt.ViewRecurrence() }
				</span>
			</div>
			@rtxSchedule(rt, today, ended)
			@rtxChips(rt, v.title)
		</div>
	</div>
}

// rtxSchedule is when it happens next, followed by the dates after.
templ rtxSchedule(rt *models.RecurrentTx, today time.Time, ended bool) {
	<div class="relative mt-auto pt-3 border-t border-zinc-800/80">
		if len(rt.Upcoming) > 0 {
			{{ next := rt.Upcoming[0] }}
			{{ overdue := next.Before(today) }}
			<div class="flex items-center gap-3">
				<div
					class={
						"grid shrink-0 w-11 py-1 rounded-xl text-center leading-none",
						templ.KV("bg-(--accent)/12 text-(--accent)", !overdue),
						templ.KV("bg-red-400/12 text-red-400", overdue),
					}
				>
					<span class="text-[0.65rem] font-semibold uppercase tracking-wider">{ next.Format("Jan") }</span>
					<span class="text-lg font-bold tabular-nums">{ next.Format("2") }</span>
				</div>
				<div class="flex-1 min-w-0">
					<p class="text-xs text-zinc-500">
						if overdue {
							Overdue
						} else {
							Next
						}
					</p>
					<p class={ "truncate", templ.KV("text-red-400", overdue) }>
						{ next.Format("Monday") } · { relDay(next, today) }
					</p>
				</div>
				if len(rt.Upcoming) > 1 {
					<div class="hidden min-[420px]:flex items-center gap-1" title="Scheduled after">
						for _, d := range rt.Upcoming[1:min(4, len(rt.Upcoming))] {
							<span class="px-2 py-0.5 rounded-full bg-zinc-800 text-xs text-zinc-400 tabular-nums">{ d.Format("Jan 2") }</span>
						}
					</div>
				}
			</div>
		} else if ended {
			<p class="flex items-center gap-2 text-sm text-zinc-500">
				@icons.Archive("16")
				Ended { rt.StopsAt.Format("Jan 2, 2006") }
			</p>
		} else if rt.IsPaused() {
			<div class="flex items-center justify-between gap-3">
				<p class="flex items-center gap-2 text-sm text-zinc-400">
					@icons.Pause("16")
					Paused since { rt.PausedAt.Format("Jan 2") }
				</p>
				<button
					hx-put={ fmt.Sprintf("/recurrent-tx/%s/resume", rt.ID) }
					class="inline-flex shrink-0 items-center gap-1.5 h-9 pl-3 pr-4 rounded-full bg-(--accent)/15 text-sm font-medium text-(--accent) cursor-pointer transition-colors hover:bg-(--accent)/25"
				>
					@icons.Play("15")
					Resume
				</button>
			</div>
		} else {
			<p class="text-sm text-zinc-400">Nothing scheduled ahead.</p>
		}
	</div>
}

// rtxSMSMatchHint tells how an SMS becomes the payment of a scheduled
// occurrence instead of a transaction of its own (models.MatchesRecurrentOccurrence).
templ rtxSMSMatchHint() {
	<details class="group rounded-2xl bg-zinc-700/20 px-4 py-3">
		<summary class="flex items-center gap-2 list-none cursor-pointer select-none text-sm text-zinc-400 hover:text-zinc-200 [&::-webkit-details-marker]:hidden">
			@icons.Message("16", &templ.Attributes{"class": "shrink-0"})
			<span class="flex-1">Bank SMS are matched with these, so a payment isn't counted twice</span>
			@icons.ChevronDown("16", &templ.Attributes{"class": "shrink-0 transition-transform group-open:rotate-180"})
		</summary>
		<div class="grid gap-2 mt-3 text-sm text-zinc-400">
			<p>An SMS becomes the scheduled transaction it pays, taking its amount and date (your category and counterparty are kept), when it's:</p>
			<ul class="grid gap-1 pl-5 list-disc marker:text-zinc-600">
				<li>On the same account.</li>
				<li>A debit for an expense or a transfer out, a credit for an income.</li>
				<li>Within { fmt.Sprint(int(models.RecurrentMatchWindow.Hours() / 24)) } days of its date, before or after.</li>
				<li>Within { fmt.Sprintf("%.0f%%", models.RecurrentMatchTolerance*100) } of its amount.</li>
				<li>From its merchant, when it's paid to one.</li>
			</ul>
			<p>
				It matches one still scheduled, or one that paid by itself (Auto) with no SMS yet; one from the same counterparty wins, then the closest in date.
				The ones that don't match stay transactions of their own: “Match to scheduled…” in their menu matches them by hand,
				with any scheduled one on the account within { fmt.Sprint(int(models.RecurrentManualMatchWindow.Hours() / 24)) } days.
			</p>
		</div>
	</details>
}

templ rtxChips(rt *models.RecurrentTx, title string) {
	<div class="relative flex flex-wrap items-center gap-1.5">
		if rt.AutoFulfill {
			<span class="chip" title="Fulfilled on its day by itself">
				@icons.Zap("12")
				Auto
			</span>
		}
		if rt.IsGamyaa() {
			<span class="chip" title="Changed through the gam'yaa's transactions">
				@icons.Lock("12")
				Gam'yaa
			</span>
		}
		if rt.FulfilledCount > 0 {
			<span class="chip" title={ "Last on " + rt.LastFulfilledOn.Format("Jan 2, 2006") }>
				@icons.Check("12")
				{ fmt.Sprintf("Done %d×", rt.FulfilledCount) }
			</span>
		}
		if rt.Category != nil && rt.Category.Name != "" && rt.Category.Name != title {
			<span class="chip">
				@icons.Tag("12")
				{ rt.Category.Name }
			</span>
		}
		if !rt.StopsAt.IsZero() {
			<span class="chip">
				@icons.Calendar("12")
				Until { rt.StopsAt.Format("Jan 2006") }
			</span>
		} else {
			<span class="text-xs text-zinc-500">Since { rt.StartsAt.Format("Jan 2006") }</span>
		}
	</div>
}

// RecurrentTxsListOOB re-renders the whole list, e.g. with a new one in its
// place.
templ RecurrentTxsListOOB(rtxs []models.RecurrentTx, def *models.Currency) {
	@rtxsList(rtxs, def, true)
}

templ RecurrentTxsSummaryOOB(rtxs []models.RecurrentTx, def *models.Currency) {
	@rtxSummary(rtxs, def, true)
}

func RecurrentTxID(id string) string {
	return "rtx-" + id
}

// splitRecurrentTxs splits the active ones, soonest due first, from the ended
// ones.
func splitRecurrentTxs(rtxs []models.RecurrentTx) (active, ended []models.RecurrentTx) {
	today := dateOf(time.Now())
	for _, rt := range rtxs {
		if rt.HasEnded(today) {
			ended = append(ended, rt)
		} else {
			active = append(active, rt)
		}
	}
	slices.SortStableFunc(active, func(a, b models.RecurrentTx) int {
		return nextDue(&a).Compare(nextDue(&b))
	})
	return active, ended
}

// nextDue is the next scheduled date, or far ahead with none (paused).
func nextDue(rt *models.RecurrentTx) time.Time {
	if len(rt.Upcoming) == 0 || rt.IsPaused() {
		return time.Date(9999, 1, 1, 0, 0, 0, 0, time.UTC)
	}
	return rt.Upcoming[0]
}

type rtxSummaryData struct {
	In, Out             float64
	Active, DueThisWeek int
	Overdue             int
}

func summarizeRecurrentTxs(rtxs []models.RecurrentTx, def *models.Currency) rtxSummaryData {
	var s rtxSummaryData
	today := dateOf(time.Now())
	weekEnd := today.AddDate(0, 0, 7)
	for _, rt := range rtxs {
		if rt.HasEnded(today) {
			continue
		}
		// Its scheduled ones still count as due, not its monthly flow.
		for _, d := range rt.Upcoming {
			if d.Before(today) {
				s.Overdue++
			} else if d.Before(weekEnd) {
				s.DueThisWeek++
			}
		}
		if rt.IsPaused() {
			continue
		}
		s.Active++
		in, out := txFlow(rt.AsTransaction(), def)
		s.In += in * rt.PerMonth()
		s.Out += out * rt.PerMonth()
	}
	return s
}

func rtxStatClass(on bool, class string) string {
	if on {
		return class
	}
	return "text-zinc-100"
}

// rtxAccentClass tints the card by kind, as the transaction form does.
func rtxAccentClass(k models.TxKind) string {
	switch k {
	case models.IncomeTxKind, models.RefundTxKind:
		return "[--accent:var(--color-emerald-400)]"
	case models.TransferTxKind:
		return "[--accent:var(--color-sky-400)]"
	case models.DebtTxKind:
		return "[--accent:var(--color-amber-400)]"
	}
	return "[--accent:var(--color-violet-400)]"
}

// relDay is how far day is from today, e.g. "tomorrow" or "in 5 days".
func relDay(day, today time.Time) string {
	days := int(dateOf(day).Sub(today).Hours() / 24)
	switch {
	case days == 0:
		return "today"
	case days == 1:
		return "tomorrow"
	case days == -1:
		return "yesterday"
	case days < 0:
		return fmt.Sprintf("%d days ago", -days)
	case days < 14:
		return fmt.Sprintf("in %d days", days)
	case days < 60:
		return fmt.Sprintf("in %d weeks", days/7)
	}
	return fmt.Sprintf("in %d months", days/30)
}

func getRecurrentTxMenuItems(rt *models.RecurrentTx) []templ.Component {
	items := []templ.Component{
		components.EntryMenuDrawerItem("Details", recurrentTxDetailsURL(rt.ID),
			components.WithEntryMenuItemIcon(icons.Eye("16"))),
	}
	if rt.IsGamyaa() {
		return append(items, components.EntryMenuDrawerItem("Gam'yaa details", accountDetailsURL(rt.GamyaaAccountID),
			components.WithEntryMenuItemIcon(icons.Users("16"))))
	}
	if rt.IsPaused() {
		items = append(items, components.EntryMenuAnchorItem("Resume", "put", fmt.Sprintf("/recurrent-tx/%s/resume", rt.ID),
			components.WithEntryMenuItemIcon(icons.Play("16"))))
	} else if !rt.HasEnded(dateOf(time.Now())) && !rt.FullyScheduled() {
		items = append(items, components.EntryMenuAnchorItem("Pause", "put", fmt.Sprintf("/recurrent-tx/%s/pause", rt.ID),
			components.WithEntryMenuItemIcon(icons.Pause("16")),
			components.WithEntryMenuItemConfirmMessage("Pause it? Its scheduled transactions from today on are deleted, and resuming starts again from that day.")))
	}
	return append(items,
		components.EntryMenuSeparator(),
		components.EntryMenuEditItem(fmt.Sprintf("/recurrent-tx/%s/edit", rt.ID)),
		components.EntryMenuSeparator(),
		components.EntryMenuDeleteItem(fmt.Sprintf("/recurrent-tx/%s", rt.ID),
			components.WithEntryMenuItemConfirmMessage("Delete it with its upcoming scheduled transactions? Past ones are kept."),
		),
	)
}
