package views

import (
	"fmt"
	"time"
	"github.com/omareloui/tyche/internal/models"
	"github.com/omareloui/tyche/internal/jwt"
	"github.com/omareloui/tyche/web/views/layouts"
	"github.com/omareloui/tyche/web/views/components"
	"github.com/omareloui/tyche/web/views/form"
)

type RecurrenceFD struct {
	IsRecurrent form.FDInput
	Unit        form.FDInput
	Every       form.FDInput
	StopsOn     form.FDInput
}

templ RecurrentTxs(claims *jwt.AccessClaims, balances []models.Balance, rtxs []models.RecurrentTx) {
	@layouts.WithTitle(claims, "Recurrent Transactions", balances) {
		@rtxsList(rtxs)
	}
}

templ RecurrenceFormBody(id string, fd *RecurrenceFD) {
	<div data-recurrence-form class="grid gap-2">
		@form.Checkbox("Is Recurrent", "is_recurrent", id, fd.IsRecurrent,
			templ.Attributes{
				"hx-post":    fmt.Sprintf("/recurrence-form/%s", id),
				"hx-trigger": "change",
				"hx-target":  "closest [data-recurrence-form]",
				"hx-swap":    "outerHTML",
				"hx-sync":    "closest form:abort",
			}, nil)
		if fd.IsRecurrent.Value != "" {
			@recurrenceFormBody(id, fd)
		}
	</div>
}

type RecurrentTxFD struct {
	RecurrenceFD
	TransactionAmountsAndKindFD
	Description form.FDInput
}

templ rtxFormBody(
	id string, fd *RecurrentTxFD,
	accs []models.Account, knds []models.TransactionKind,
	cats []models.Category, cps []models.Counterparty,
	gls []models.Goal, defaultCur *models.Currency) {
	@TransactionAmountsAndKindFormBody(&fd.TransactionAmountsAndKindFD, id, knds, cats, accs, cps, gls, defaultCur)
	@form.TextInput("Description", "description", "Enter a description", id, fd.Description, nil, nil)
	@recurrenceFormBody(id, &fd.RecurrenceFD)
}

templ recurrenceFormBody(id string, fd *RecurrenceFD) {
	<div class="grid grid-cols-3 gap-4">
		@form.NumberInput("Every", "every", "Recurrent every...", id, fd.Every, nil, nil)
		@form.SelectInput("Unit", "unit", "How recurrent", id, models.RecurrentUnitOptions(), fd.Unit, false, nil, nil)
		@form.DateInput("Stops on", "stops_on", id, fd.StopsOn, nil, nil)
	</div>
}

templ RecurrentTransactionOOB(rtx *models.RecurrentTx) {
	<div id="tx-list" hx-swap-oob="afterbegin">
		@RecurrentTx(rtx)
	</div>
}

templ EditRecurrentTx(
	rtx *models.RecurrentTx, fd *RecurrentTxFD,
	accs []models.Account, knds []models.TransactionKind,
	cats []models.Category, cps []models.Counterparty,
	gls []models.Goal, defaultCur *models.Currency) {
	@form.Form("put", fmt.Sprintf("/recurrent-tx/%s", rtx.ID), templ.Attributes{"hx-target": "this"}) {
		<p>ID: { rtx.ID }</p>
		@rtxFormBody(rtx.ID, fd, accs, knds, cats, cps, gls, defaultCur)
		@form.EditFormButtons(fmt.Sprintf("/recurrent-tx/%s", rtx.ID))
	}
}

templ rtxsList(recurrentTx []models.RecurrentTx) {
	@components.List("tx-list") {
		for _, rt := range recurrentTx {
			@RecurrentTx(&rt)
		}
	}
}

templ RecurrentTx(rtx *models.RecurrentTx) {
	@components.EntryCard(
		components.WithCardTitle(rtx.ID),
		components.WithCardMenu([]templ.Component{
			components.EntryMenuAnchorItem("Generate Transactions", "post", fmt.Sprintf("/recurrent-tx/%s/generate-txs", rtx.ID)),
			components.EntryMenuAnchorItem("Edit", "put", fmt.Sprintf("/recurrent-tx/%s/edit", rtx.ID)),
			components.EntryMenuDeleteItem(fmt.Sprintf("/recurrent-tx/%s", rtx.ID)),
		}),
	) {
		<p>ID: { rtx.ID }</p>
		<p>Account: { rtx.Account.Name }</p>
		<p>Amount: { rtx.ViewAmount() }</p>
		if rtx.ToAccount != nil {
			<p>To Account: { rtx.ToAccount.Name }</p>
			<p>To Amount: { rtx.ViewToAmount() }</p>
		}
		<p>Kind: { rtx.Kind.Enum.String() }</p>
		if rtx.Description != "" {
			<p>Description: { rtx.Description }</p>
		}
		if rtx.Category != nil {
			<p>Category ID: { rtx.Category.ID }</p>
			<p>Category Name: { rtx.Category.Name }</p>
		}
		if rtx.Counterparty != nil {
			<p>Counterparty ID: { rtx.Counterparty.ID }</p>
			<p>Counterparty Name: { rtx.Counterparty.Name }</p>
		}
		if rtx.Goal != nil {
			<p>Goal ID: { rtx.Goal.ID }</p>
			<p>Goal Name: { rtx.Goal.Name }</p>
		}
		<p>Recurrence: { rtx.ViewRecurrence() }</p>
		<p>Starts At: { rtx.StartsAt.Format(time.RFC1123Z) }</p>
		if !rtx.StopsAt.IsZero() {
			<p>Stops At: { rtx.StopsAt.Format(time.RFC1123Z) }</p>
		}
		<p>Last Transaction Scheduled To: { rtx.LastTransactionScheduledTo.Format(time.RFC1123Z) }</p>
		<p>Created At: { rtx.CreatedAt.Format(time.RFC1123Z) }</p>
	}
}
