{
  "family": "tyche-task",
  "requiresCompatibilities": ["EC2"],
  "networkMode": "host",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::__ACCOUNT__:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "tyche-container",
      "image": "__IMAGE__",
      "essential": true,
      "memoryReservation": 384,
      "stopTimeout": 30,
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "PORT", "value": "3333" },
        { "name": "LOG_LEVEL", "value": "0" },
        { "name": "OAUTH_CB_ORIGIN", "value": "https://__DOMAIN__" },
        { "name": "FX_RATE_FETCH_INTERVAL_HOURS", "value": "6" },
        { "name": "VAPID_SUBJECT", "value": "https://__DOMAIN__" },
        { "name": "GEMINI_MODEL", "value": "gemini-3.8-flash" },
        { "name": "GEMINI_PRICE_INPUT_PER_M", "value": "0.75" },
        { "name": "GEMINI_PRICE_OUTPUT_PER_M", "value": "3.75" },
        { "name": "RECEIPT_SCANS_PER_MONTH", "value": "10" }
      ],
      "secrets": [
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/tyche/JWT_SECRET" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/tyche/GOOGLE_CLIENT_ID" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/tyche/GOOGLE_CLIENT_SECRET" },
        { "name": "ADMIN_TENANT_IDS", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/tyche/ADMIN_TENANT_IDS" },
        { "name": "VAPID_PUBLIC_KEY", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/tyche/VAPID_PUBLIC_KEY" },
        { "name": "VAPID_PRIVATE_KEY", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/tyche/VAPID_PRIVATE_KEY" },
        { "name": "GEMINI_API_KEY", "valueFrom": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/tyche/GEMINI_API_KEY" }
      ],
      "mountPoints": [
        { "sourceVolume": "data", "containerPath": "/app/data" },
        { "sourceVolume": "logs", "containerPath": "/app/logs" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tyche",
          "awslogs-region": "__REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "caddy",
      "image": "public.ecr.aws/docker/library/caddy:2-alpine",
      "essential": true,
      "memoryReservation": 64,
      "environment": [
        { "name": "DOMAIN", "value": "__DOMAIN__" },
        { "name": "REDIRECT_FROM", "value": "__REDIRECT_FROM__" }
      ],
      "entryPoint": ["sh", "-c"],
      "command": [
        "set -e; { printf '%s {\\n\\treverse_proxy localhost:3333\\n}\\n' \"$DOMAIN\"; [ -z \"$REDIRECT_FROM\" ] || printf '%s {\\n\\tredir https://%s{uri} permanent\\n}\\n' \"$REDIRECT_FROM\" \"$DOMAIN\"; } >/etc/caddy/Caddyfile; exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile"
      ],
      "dependsOn": [{ "containerName": "tyche-container", "condition": "START" }],
      "mountPoints": [
        { "sourceVolume": "caddy-data", "containerPath": "/data" },
        { "sourceVolume": "caddy-config", "containerPath": "/config" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tyche",
          "awslogs-region": "__REGION__",
          "awslogs-stream-prefix": "caddy"
        }
      }
    }
  ],
  "volumes": [
    { "name": "data", "host": { "sourcePath": "/srv/tyche/data" } },
    { "name": "logs", "host": { "sourcePath": "/srv/tyche/logs" } },
    { "name": "caddy-data", "host": { "sourcePath": "/srv/tyche/caddy/data" } },
    { "name": "caddy-config", "host": { "sourcePath": "/srv/tyche/caddy/config" } }
  ]
}
