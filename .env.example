PORT=3333
APP_ENV="development"
LOG_LEVEL=-1

JWT_SECRET="thisshouldbearandomstring"

OAUTH_CB_ORIGIN="http://localhost:3333"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# Shared (all users) database, holds the fx rates and the shared sms templates
SHARED_DB_PATH="./data/shared.sqlite"
FX_RATE_FETCH_INTERVAL_HOURS=6
# How often the cost of living calculator refetches its price data (days)
COL_FETCH_INTERVAL_DAYS=30

# Comma separated tenant IDs ({provider_prefix}_{oauth_id}, as the data/*.sqlite
# file names, e.g. GL_1234567890) allowed on the admin pages (/admin/fx-rates)
ADMIN_TENANT_IDS=""

SIMPLE_ICONS_DIR="./third_party/simple-icons"
EXTRA_BRAND_ICONS_DIR="./web/brand-icons"

# Web Push (the installed app's badge), generate with `go run ./cmd/vapid`.
# Empty keys turn the badge's notifications off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Reading receipts (scan from the transaction form / details) with Gemini.
# An empty key turns it off. Prices (dollars per million tokens, thinking
# billed as output) only estimate the usage shown on /admin/ai.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_THINKING_LEVEL="LOW"
# Model matching the sms' unknown merchants (runs on every ingest: a cheap one fits), GEMINI_MODEL when empty
GEMINI_MERCHANT_MODEL=""
# Its thinking level (MINIMAL only on models taking it), GEMINI_THINKING_LEVEL when empty
GEMINI_MERCHANT_THINKING_LEVEL=""
GEMINI_PRICE_INPUT_PER_M=0.75
GEMINI_PRICE_OUTPUT_PER_M=3.75
# Grounding with Google Search (city estimates), dollars per 1000 queries
GEMINI_PRICE_SEARCH_PER_K=14
# Default calls per tenant a calendar month (UTC) of each kind, changeable
# per tenant on /admin/ai/limits
# Receipt scans
RECEIPT_SCANS_PER_MONTH=50
# sms templates a user may have guessed by the AI a calendar month (UTC)
SMS_GUESSES_PER_MONTH=30
# City estimates (cost of living calculator, AI) a user may ask for a calendar month (UTC)
COL_ESTIMATES_PER_MONTH=20
# Tax rules lookups (salary calculator, AI, countries without built in rules) a user may ask for a calendar month (UTC)
TAX_RULES_PER_MONTH=10
# Visa requirements lookups (visa readiness, AI, visas without built in rules) a user may ask for a calendar month (UTC)
VISA_RULES_PER_MONTH=10
# Merchant matching calls (sms' unknown merchants, AI, one per ingested batch with some) a user may make a calendar month (UTC)
MERCHANT_GUESSES_PER_MONTH=100
# Model reading quick add's texts ("coffee 85 cib yesterday"), GEMINI_MODEL when empty
GEMINI_QUICK_MODEL=""
# Quick add texts read by AI a user may send a calendar month (UTC); a plain amount or "name amount" never calls it
QUICK_ADDS_PER_MONTH=200
# Split bills read from a sentence by AI ("Sara had the pizza, drinks for everyone") a user may ask for a calendar month (UTC)
SPLIT_GUESSES_PER_MONTH=30
