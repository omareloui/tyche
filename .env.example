PORT=3333
APP_ENV="development"
LOG_LEVEL=-1

JWT_SECRET="thisshouldbearandomstring"

OAUTH_CB_ORIGIN="http://localhost:3333"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# Shared (all users) database, holds the fx rates and the shared sms templates
SHARED_DB_PATH="./data/shared.sqlite"
FX_RATE_FETCH_INTERVAL_HOURS=6

# Comma separated tenant IDs ({provider_prefix}_{oauth_id}, as the data/*.sqlite
# file names, e.g. GL_1234567890) allowed on the admin pages (/admin/fx-rates)
ADMIN_TENANT_IDS=""

SIMPLE_ICONS_DIR="./third_party/simple-icons"
EXTRA_BRAND_ICONS_DIR="./web/brand-icons"

# Web Push (the installed app's badge), generate with `go run ./cmd/vapid`.
# Empty keys turn the badge's notifications off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
